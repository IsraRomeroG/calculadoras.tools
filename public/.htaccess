
# DO NOT REMOVE THIS LINE AND THE LINES BELOW ERRORPAGEID:lTmDswB1KX
ErrorDocument 404 /404.html
# DO NOT REMOVE THIS LINE AND THE LINES ABOVE lTmDswB1KX:ERRORPAGEID

RewriteEngine On

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Eliminar WWW
RewriteCond %{HTTP_HOST} ^www\.calculadoras\.tools$ [NC]
RewriteRule ^(.*)$ https://calculadoras.tools/$1 [R=301,L]

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Legacy calculator URLs.
  RewriteRule ^calculadora-deficit-calorico/?$ /salud/calculadora-deficit-calorico [R=301,L]
  RewriteRule ^calculadora-de-edad/?$ /fecha-tiempo/calculadora-de-edad [R=301,L]

  # Legacy calculator category URLs.
  RewriteRule ^categoria/legal-e-impuestos/?$ /legal-impuestos [R=301,L]
  RewriteRule ^categoria/fecha-y-tiempo/?$ /fecha-tiempo [R=301,L]
  RewriteRule ^categoria/(fecha-tiempo|finanzas|inmuebles|legal-impuestos|matematicas|salud)/?$ /$1 [R=301,L]

  # Legacy blog category URLs.
  RewriteRule ^blog/categoria/legal-e-impuestos/?$ /blog/legal-impuestos [R=301,L]
  RewriteRule ^blog/categoria/legal-e-impuestos/pagina/([0-9]+)/?$ /blog/legal-impuestos/pagina/$1 [R=301,L]
  RewriteRule ^blog/legal-e-impuestos/?$ /blog/legal-impuestos [R=301,L]
  RewriteRule ^blog/legal-e-impuestos/(.+?)/?$ /blog/legal-impuestos/$1 [R=301,L]
  RewriteRule ^blog/categoria/(finanzas|inmuebles|legal-impuestos|matematicas|salud)/?$ /blog/$1 [R=301,L]
  RewriteRule ^blog/categoria/(finanzas|inmuebles|legal-impuestos|matematicas|salud)/pagina/([0-9]+)/?$ /blog/$1/pagina/$2 [R=301,L]

  # Consolidated repetitive blog article URLs.
  RewriteRule ^blog/salud/(cuanto-debo-pesar-si-mido-150|cuanto-debo-pesar-si-mido-155|cuanto-debo-pesar-si-mido-160|cuanto-debo-pesar-si-mido-165|cuanto-debo-pesar-si-mido-170|cuanto-debo-pesar-si-mido-175|cuanto-debo-pesar-si-mido-180|cuanto-debo-pesar-si-mido-185|tabla-peso-saludable-150-195)/?$ /blog/salud/peso-saludable-segun-estatura [R=301,L]
  RewriteRule ^blog/(cuanto-debo-pesar-si-mido-150|cuanto-debo-pesar-si-mido-155|cuanto-debo-pesar-si-mido-160|cuanto-debo-pesar-si-mido-165|cuanto-debo-pesar-si-mido-170|cuanto-debo-pesar-si-mido-175|cuanto-debo-pesar-si-mido-180|cuanto-debo-pesar-si-mido-185|tabla-peso-saludable-150-195)/?$ /blog/salud/peso-saludable-segun-estatura [R=301,L]
  RewriteRule ^blog/inmuebles/(hipoteca-1000000-cuanto-pago|hipoteca-1500000-cuanto-pago|hipoteca-2000000-cuanto-pago|hipoteca-3000000-cuanto-pago)/?$ /blog/inmuebles/comparar-creditos-hipotecarios [R=301,L]
  RewriteRule ^blog/(hipoteca-1000000-cuanto-pago|hipoteca-1500000-cuanto-pago|hipoteca-2000000-cuanto-pago|hipoteca-3000000-cuanto-pago)/?$ /blog/inmuebles/comparar-creditos-hipotecarios [R=301,L]
  RewriteRule ^blog/finanzas/(prestamo-50000-cuanto-pago|prestamo-100000-cuanto-pago)/?$ /blog/finanzas/comparar-dos-prestamos [R=301,L]
  RewriteRule ^blog/(prestamo-50000-cuanto-pago|prestamo-100000-cuanto-pago)/?$ /blog/finanzas/comparar-dos-prestamos [R=301,L]

  # Legacy one-segment blog article URLs.
  RewriteRule ^blog/(cagr-tasa-crecimiento-anual-compuesto|cat-vs-tasa-interes|cetes-interes-compuesto-reinversion|comision-apertura-prestamo|como-calcular-cuota-mensual-prestamo|como-calcular-intereses-prestamo|comparar-dos-prestamos|credito-automotriz-calcular-mensualidad|cuanto-ahorrar-al-mes-para-una-meta|cuanto-puedo-pedir-prestado-segun-ingreso|descuentos-sucesivos|errores-calculadora-interes-compuesto|formula-interes-compuesto|inflacion-interes-compuesto-valor-real|interes-compuesto-aportaciones-mensuales|interes-compuesto-retiro|interes-simple-vs-compuesto|microcreditos-apps-prestamos-caros|pagos-extra-prestamo-abono-capital|porcentaje-de-descuento|porcentaje-de-ganancia-y-margen|prestamo-12-24-36-48-meses|prestamo-nomina-vs-prestamo-personal|prestamo-personal-vs-tarjeta-credito|prestamos-entre-particulares|que-es-interes-compuesto|regla-del-72|seguro-mensual-credito|sistema-frances-amortizacion|tabla-amortizacion-excel|tabla-amortizacion-prestamo|tasa-anual-mensual-diaria-prestamo|tasa-nominal-vs-tasa-efectiva)/?$ /blog/finanzas/$1 [R=301,L]
  RewriteRule ^blog/(amortizacion-anticipada-reducir-plazo-o-cuota|apoyo-infonavit-hipoteca-bancaria|cat-vs-tasa-credito-hipotecario|como-calcular-cuota-mensual-hipoteca|comparar-creditos-hipotecarios|credito-hipotecario-banco-vs-infonavit|cuanto-puedo-pedir-prestado-para-casa|enganche-para-casa-hipoteca|errores-comunes-al-calcular-hipoteca|formula-cuota-hipoteca-excel-google-sheets|gastos-notariales-avaluo-impuestos-hipoteca|hipoteca-15-20-25-30-anos|pagos-extra-hipoteca-abono-capital|precio-enganche-monto-prestamo-hipotecario|que-incluye-cuota-hipotecaria|sistema-frances-hipoteca|tabla-amortizacion-hipoteca|tabla-amortizacion-hipoteca-excel|tasa-anual-a-mensual-hipoteca|tasa-fija-vs-variable-hipoteca|total-intereses-hipoteca)/?$ /blog/inmuebles/$1 [R=301,L]
  RewriteRule ^blog/(como-calcular-iva|como-desglosar-iva|como-sumar-iva-a-un-precio|errores-comunes-al-calcular-iva|igv-peru|iva-colombia|iva-espana|iva-incluido-vs-sin-iva|iva-mexico|tasas-de-iva-por-pais)/?$ /blog/legal-impuestos/$1 [R=301,L]
  RewriteRule ^blog/(aumento-porcentual|calificaciones-con-porcentajes|como-calcular-porcentajes|como-restar-un-porcentaje|como-sumar-un-porcentaje|convertir-fracciones-decimales-a-porcentajes|diferencia-porcentual-vs-variacion-porcentual|disminucion-porcentual|formulas-porcentajes-excel-google-sheets|porcentaje-inverso|porcentaje-vs-puntos-porcentuales|que-porcentaje-es-una-cantidad-de-otra|regla-de-tres)/?$ /blog/matematicas/$1 [R=301,L]
  RewriteRule ^blog/(bajar-subir-peso-segun-imc|bajo-peso-segun-imc-menor-18-5|calcular-imc-libras-pies-pulgadas|calorias-diarias-e-imc|como-interpretar-resultado-imc|cuanto-deberia-pesar-segun-estatura|formula-imc-excel-google-sheets|imc-18-20-22-25-27-30-35-40|imc-30-o-mas-que-significa|imc-adultos-mayores|imc-embarazo|imc-hombres-mujeres|imc-masa-muscular-ejercicio|imc-menor-a-16-que-significa|imc-ninos-adolescentes-percentiles|imc-normal-rango-saludable-adultos|imc-vs-indice-cintura-altura|imc-vs-porcentaje-grasa-corporal|limitaciones-del-imc|obesidad-clase-1-2-3-imc|peso-ideal-vs-peso-saludable|peso-saludable-segun-estatura|que-es-el-imc-y-como-se-calcula|sobrepeso-segun-imc-25-29-9|tabla-imc-adultos-rangos-categorias)/?$ /blog/salud/$1 [R=301,L]

  RewriteRule ^eventos-sociales/calculadora-de-propina/?$ /restaurantes/calculadora-de-propina [R=301,L]
  RewriteRule ^eventos-sociales/dividir-cuenta-en-restaurante/?$ /restaurantes/dividir-cuenta-en-restaurante [R=301,L]
  RewriteRule ^eventos-sociales/?$ /restaurantes [R=301,L]

  # Redirect requested URLs with trailing slashes to their canonical form.
  # THE_REQUEST prevents internal rewrites from triggering this redirect.
  RewriteCond %{THE_REQUEST} \s/+(.+?)/+[?\s] [NC]
  RewriteRule ^(.+?)/+$ /$1 [R=301,L,NE]

  # Serve Astro's directory-format output without redirecting canonical URLs
  # back to their physical directory path with a trailing slash.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>
