
# DO NOT REMOVE THIS LINE AND THE LINES BELOW ERRORPAGEID:lTmDswB1KX
ErrorDocument 404 /404.html
# DO NOT REMOVE THIS LINE AND THE LINES ABOVE lTmDswB1KX:ERRORPAGEID

RewriteEngine On

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Eliminar WWW
RewriteCond %{HTTP_HOST} ^www\.calculadoras\.tools$ [NC]
RewriteRule ^(.*)$ https://calculadoras.tools/$1 [R=301,L]

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Preserve the meaning of the former generic English legal-tax URLs.
  RewriteRule ^en/legal-tax/vat-calculator/?$ /en/legal-tax/indirect-tax-calculator [R=301,L,NE]
  RewriteRule ^en/legal-tax/income-tax-calculator/?$ /en/legal-tax/mexico-income-tax-calculator [R=301,L,NE]
  RewriteRule ^en/legal-tax/net-salary-calculator/?$ /en/legal-tax/mexico-net-salary-calculator [R=301,L,NE]
  RewriteRule ^en/legal-tax/proportional-vacation-calculator/?$ /en/legal-tax/mexico-proportional-vacation-calculator [R=301,L,NE]
  RewriteRule ^en/legal-tax/termination-pay-calculator/?$ /en/legal-tax/mexico-termination-pay-calculator [R=301,L,NE]

  # Redirect requested URLs with trailing slashes to their canonical form.
  # THE_REQUEST prevents internal rewrites from triggering this redirect.
  RewriteCond %{THE_REQUEST} \s/+(.+?)/+[?\s] [NC]
  RewriteRule ^(.+?)/+$ /$1 [R=301,L,NE]

  # Serve Astro's directory-format output without redirecting canonical URLs
  # back to their physical directory path with a trailing slash.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>
