calculateTriangleAreaFromBaseHeight(base, height)
calculateCircle(radius)
calculateRegularPolygon(sideCount, sideLength)
parseMeasurement(value)
validatePositiveMeasurement(value)
formatLinearMeasurement(value, unit, decimals)
