---
import BaseLayout from "@layouts/BaseLayout.astro";
import robot404Url from "../svg/404 robot-cuate.svg?url";
import Breadcrumb from "@components/shared/Breadcrumb.astro";
---

<BaseLayout
  title="Página no encontrada"
  description="No encontramos la página que estás buscando en calculadoras.tools."
>
  <main class="bg-gray-900 text-gray-100">
    <section>
      <div class="mx-auto max-w-5xl px-6 py-10">
        <Breadcrumb
          class="mb-8"
          items={[
            { label: "Inicio", href: "/", ariaLabel: "Inicio" },
            { label: "Error 404" },
          ]}
        />
        <div class="order-2 text-center md:order-1 md:text-left">
          <div class="order-1 md:order-2">
            <img
              src={robot404Url}
              alt="Robot junto al número 404"
              class="mx-auto w-full max-w-[40rem]"
              loading="eager"
              decoding="async"
            />
          </div>
          <h1
            class="mt-4 text-4xl font-bold leading-tight text-center tracking-tight text-white sm:text-5xl md:text-6xl"
          >
            Esta página no existe
          </h1>

          <p
            class="mx-auto mt-5 text-base text-center leading-relaxed text-gray-400 md:mx-0"
          >
            La ruta pudo haber cambiado, el enlace puede estar incompleto o no
            disponible.
          </p>

          <div class="mt-8 flex flex-col gap-3 md:flex-row justify-center">
            <a
              href="/"
              class="inline-flex min-h-12 items-center justify-center rounded-lg bg-amber-400 px-5 py-3 text-sm font-semibold text-gray-950 transition-colors hover:bg-amber-300"
            >
              Volver al inicio
            </a>
            <a
              href="/#calculadoras"
              class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gray-700 px-5 py-3 text-sm font-semibold text-gray-200 transition-colors hover:border-gray-500 hover:bg-gray-800"
            >
              Ver calculadoras
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
