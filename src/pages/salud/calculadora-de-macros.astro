---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import {
  DIET_PRESET_OPTIONS,
  MACRO_GOAL_OPTIONS,
} from "@lib/calculators/salud/calculadora-de-macros/macros";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Calculadora de Macros — Proteínas, Carbohidratos y Grasas";
const description =
  "Calcula tus macros diarios estimados según tus calorías, peso y objetivo. Obtén gramos de proteína, carbohidratos y grasas como punto de partida.";
const canonical = "/salud/calculadora-de-macros";

const faqs = [
  {
    question: "¿Qué son los macronutrientes?",
    answer:
      "Son nutrientes que aportan energía: proteína, carbohidratos y grasas. Cada uno cumple funciones distintas y se mide en gramos.",
  },
  {
    question: "¿Cómo se calculan los macros diarios?",
    answer:
      "Esta calculadora parte de tus calorías objetivo. En el método principal fija proteína por kg de peso, asigna grasas y calcula carbohidratos con las calorías restantes.",
  },
  {
    question: "¿Cuánta proteína debo comer al día?",
    answer:
      "Depende de peso, objetivo, entrenamiento y contexto de salud. La calculadora usa rangos orientativos y permite ajustar gramos por kg.",
  },
  {
    question: "¿Qué distribución de macros sirve para perder grasa?",
    answer:
      "Suele ayudar priorizar suficiente proteína, mantener grasas en un rango razonable y ajustar carbohidratos con el resto de calorías. El déficit calórico sigue siendo el factor principal.",
  },
  {
    question: "¿Qué macros se usan para ganar músculo?",
    answer:
      "Un punto de partida común es proteína suficiente, grasas moderadas y carbohidratos suficientes para entrenar. También importan entrenamiento, descanso y progresión.",
  },
  {
    question: "¿Cuántos carbohidratos necesito al día?",
    answer:
      "Varía mucho según calorías, actividad y dieta. En el método principal se calculan como el resto después de proteína y grasas.",
  },
  {
    question: "¿Cuánta grasa debo comer al día?",
    answer:
      "La calculadora usa porcentajes orientativos. Grasas demasiado bajas pueden dificultar cubrir ácidos grasos esenciales y vitaminas liposolubles.",
  },
  {
    question: "¿Qué macros tiene una dieta keto?",
    answer:
      "En keto los carbohidratos se suelen limitar en gramos. Esta calculadora usa un límite editable de carbohidratos y calcula grasas como resto.",
  },
  {
    question: "¿Cómo calcular macros en una dieta vegana?",
    answer:
      "Puedes usar el preset vegano como punto de partida y cuidar variedad de fuentes vegetales de proteína como legumbres, soja, cereales, semillas y frutos secos.",
  },
  {
    question: "¿Tengo que comer exactamente estos gramos todos los días?",
    answer:
      "No. Los resultados son una referencia educativa. Puedes usarlos como rango práctico y ajustar según energía, hambre, rendimiento y evolución real.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);

const macroSummaries = [
  {
    title: "Proteína",
    text: "Se calcula primero en el método principal para que el objetivo escale con tu peso.",
    tone: "border-sky-400/40 bg-sky-400/10 text-sky-100",
  },
  {
    title: "Carbohidratos",
    text: "Se calculan con las calorías restantes, salvo en keto donde se fija un límite en gramos.",
    tone: "border-orange-400/40 bg-orange-400/10 text-orange-100",
  },
  {
    title: "Grasas",
    text: "Se asignan como porcentaje o como resto en keto para mantener una distribución coherente.",
    tone: "border-emerald-400/40 bg-emerald-400/10 text-emerald-100",
  },
];

const foodExamples = [
  {
    title: "Fuentes de proteína",
    items: [
      "1 huevo grande: aprox. 6 g",
      "100 g pechuga de pollo cocida: aprox. 31 g",
      "100 g atún enlatado drenado: aprox. 25 g",
      "100 g lentejas cocidas: aprox. 9 g",
    ],
  },
  {
    title: "Fuentes de carbohidratos",
    items: [
      "100 g arroz blanco cocido: aprox. 28 g",
      "1 plátano mediano: aprox. 27 g",
      "1 rebanada de pan integral: aprox. 12 g",
      "1 papa mediana cocida: aprox. 37 g",
    ],
  },
  {
    title: "Fuentes de grasas",
    items: [
      "1/2 aguacate mediano: aprox. 15 g",
      "1 cucharada de aceite de oliva: aprox. 14 g",
      "30 g almendras: aprox. 14 g",
      "100 g salmón cocido: aprox. 13 g",
    ],
  },
];

const sources = [
  {
    label: "National Academies: Dietary Reference Intakes for macronutrients",
    href: "https://www.nationalacademies.org/cdn/materials/9fb9fae1-63a0-4048-88ad-3f972639149a",
  },
  {
    label: "National Academies Press: The Essential Guide to Nutrient Requirements",
    href: "https://www.nationalacademies.org/read/11537/chapter/7",
  },
  {
    label: "International Society of Sports Nutrition: protein and exercise",
    href: "https://link.springer.com/article/10.1186/s12970-017-0177-8",
  },
  {
    label: "USDA FoodData Central",
    href: "https://fdc.nal.usda.gov/",
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Calculadora de macros"
      description="Convierte tus calorías objetivo en gramos diarios de proteína, carbohidratos y grasas con un método orientativo y editable."
      kicker="Salud"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Salud", href: "/salud", optional: true },
        { label: "Calculadora de macros", truncate: true },
      ]}
    />

    <Container as="section" class="py-6 md:py-8">
      <section
        id="macro-calculator"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <div class="grid gap-0 xl:grid-cols-[minmax(0,1fr)_minmax(21rem,0.78fr)]">
          <div class="p-4 sm:p-6">
            <div class="mb-5">
              <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">
                Cálculo principal
              </p>
              <h2 id="calculator-heading" class="mt-2 text-2xl font-semibold">
                Calcula tus macros diarios
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-gray-400">
                Ingresa tus calorías objetivo y peso. Si todavía no conoces tus
                calorías, calcula primero tu TDEE.
              </p>
            </div>

            <div class="mb-5 rounded-lg border border-gray-800 bg-gray-900/70 p-4">
              <p class="text-sm font-semibold text-gray-100">
                ¿No conoces tus calorías objetivo?
              </p>
              <p class="mt-1 text-sm leading-relaxed text-gray-400">
                Usa la calculadora de calorías diarias y vuelve con ese número.
              </p>
              <a
                class="mt-3 inline-flex min-h-10 items-center justify-center rounded-lg border border-amber-400/50 px-3 py-2 text-sm font-semibold text-amber-200 transition hover:bg-amber-400/10 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                href="/salud/calculadora-de-calorias-diarias-tdee"
              >
                Calcular TDEE
              </a>
            </div>

            <div class="mb-5">
              <span class="block text-sm font-medium text-gray-200">
                Sistema de unidades
              </span>
              <div
                class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 p-1"
                role="group"
                aria-label="Sistema de unidades"
              >
                <button
                  class="min-h-11 flex-1 rounded-md px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  aria-pressed="true"
                  data-unit-option="metric"
                >
                  Métrico
                </button>
                <button
                  class="min-h-11 flex-1 rounded-md px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  aria-pressed="false"
                  data-unit-option="imperial"
                >
                  Imperial
                </button>
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label
                  for="macro-calories"
                  class="block text-sm font-medium text-gray-200"
                >
                  Calorías objetivo
                </label>
                <div
                  class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                >
                  <input
                    id="macro-calories"
                    class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder="1818"
                    aria-describedby="macro-calories-error"
                    data-input="calories"
                  />
                  <span class="flex items-center px-4 text-gray-500">kcal</span>
                </div>
                <p
                  id="macro-calories-error"
                  class="mt-2 hidden text-sm text-red-300"
                  data-error-for="calories"
                >
                </p>
              </div>

              <div data-unit-panel="metric">
                <label
                  for="macro-weight-kg"
                  class="block text-sm font-medium text-gray-200"
                >
                  Peso
                </label>
                <div
                  class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                >
                  <input
                    id="macro-weight-kg"
                    class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder="65"
                    aria-describedby="macro-weight-kg-error"
                    data-input="weightKg"
                  />
                  <span class="flex items-center px-4 text-gray-500">kg</span>
                </div>
                <p
                  id="macro-weight-kg-error"
                  class="mt-2 hidden text-sm text-red-300"
                  data-error-for="weightKg"
                >
                </p>
              </div>

              <div class="hidden" data-unit-panel="imperial">
                <label
                  for="macro-weight-lb"
                  class="block text-sm font-medium text-gray-200"
                >
                  Peso
                </label>
                <div
                  class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                >
                  <input
                    id="macro-weight-lb"
                    class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder="143"
                    aria-describedby="macro-weight-lb-error"
                    data-input="weightLb"
                  />
                  <span class="flex items-center px-4 text-gray-500">lb</span>
                </div>
                <p
                  id="macro-weight-lb-error"
                  class="mt-2 hidden text-sm text-red-300"
                  data-error-for="weightLb"
                >
                </p>
              </div>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div>
                <label
                  for="macro-goal"
                  class="block text-sm font-medium text-gray-200"
                >
                  Objetivo
                </label>
                <select
                  id="macro-goal"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  data-input="goal"
                >
                  {
                    MACRO_GOAL_OPTIONS.map((goal) => (
                      <option value={goal.key}>{goal.label}</option>
                    ))
                  }
                </select>
              </div>

              <div>
                <label
                  for="macro-diet"
                  class="block text-sm font-medium text-gray-200"
                >
                  Enfoque dietético
                </label>
                <select
                  id="macro-diet"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  data-input="dietPreset"
                >
                  {
                    DIET_PRESET_OPTIONS.map((diet) => (
                      <option value={diet.key}>{diet.label}</option>
                    ))
                  }
                </select>
              </div>
            </div>

            <div class="mt-5">
              <span class="block text-sm font-medium text-gray-200">
                Método de cálculo
              </span>
              <div
                class="mt-2 grid gap-2 rounded-lg border border-gray-700 bg-gray-900 p-1 sm:grid-cols-2"
                role="group"
                aria-label="Método de cálculo"
              >
                <button
                  class="min-h-11 rounded-md px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  aria-pressed="true"
                  data-method-option="protein-first"
                >
                  Proteína primero
                </button>
                <button
                  class="min-h-11 rounded-md px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  aria-pressed="false"
                  data-method-option="percentages"
                >
                  Por porcentajes
                </button>
              </div>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-2" data-method-panel="protein-first">
              <div>
                <label
                  for="macro-protein-kg"
                  class="block text-sm font-medium text-gray-200"
                >
                  Proteína
                </label>
                <div
                  class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                >
                  <input
                    id="macro-protein-kg"
                    class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder="1.8"
                    aria-describedby="macro-protein-kg-error"
                    data-input="proteinGramsPerKg"
                  />
                  <span class="flex items-center px-4 text-gray-500">g/kg</span>
                </div>
                <p
                  id="macro-protein-kg-error"
                  class="mt-2 hidden text-sm text-red-300"
                  data-error-for="proteinGramsPerKg"
                >
                </p>
              </div>

              <div data-fat-percent-field>
                <label
                  for="macro-fat-percent"
                  class="block text-sm font-medium text-gray-200"
                >
                  Grasas
                </label>
                <div
                  class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                >
                  <input
                    id="macro-fat-percent"
                    class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder="30"
                    aria-describedby="macro-fat-percent-error"
                    data-input="fatPercent"
                  />
                  <span class="flex items-center px-4 text-gray-500">%</span>
                </div>
                <p
                  id="macro-fat-percent-error"
                  class="mt-2 hidden text-sm text-red-300"
                  data-error-for="fatPercent"
                >
                </p>
              </div>

              <div class="hidden sm:col-span-2" data-keto-carb-field>
                <label
                  for="macro-keto-carbs"
                  class="block text-sm font-medium text-gray-200"
                >
                  Carbohidratos en keto
                </label>
                <div
                  class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                >
                  <input
                    id="macro-keto-carbs"
                    class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder="30"
                    aria-describedby="macro-keto-carbs-error"
                    data-input="carbLimitGrams"
                  />
                  <span class="flex items-center px-4 text-gray-500">g/día</span>
                </div>
                <p class="mt-2 text-xs leading-relaxed text-gray-500">
                  En keto las grasas se calculan como el resto de calorías.
                </p>
                <p
                  id="macro-keto-carbs-error"
                  class="mt-2 hidden text-sm text-red-300"
                  data-error-for="carbLimitGrams"
                >
                </p>
              </div>
            </div>

            <div class="mt-5 hidden" data-method-panel="percentages">
              <div class="grid gap-4 sm:grid-cols-3">
                <div>
                  <label
                    for="macro-protein-percent"
                    class="block text-sm font-medium text-gray-200"
                  >
                    Proteína
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                  >
                    <input
                      id="macro-protein-percent"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      aria-describedby="macro-protein-percent-error"
                      data-input="proteinPercent"
                    />
                    <span class="flex items-center px-4 text-gray-500">%</span>
                  </div>
                  <p
                    id="macro-protein-percent-error"
                    class="mt-2 hidden text-sm text-red-300"
                    data-error-for="proteinPercent"
                  >
                  </p>
                </div>

                <div>
                  <label
                    for="macro-carbs-percent"
                    class="block text-sm font-medium text-gray-200"
                  >
                    Carbohidratos
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                  >
                    <input
                      id="macro-carbs-percent"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      aria-describedby="macro-carbs-percent-error"
                      data-input="carbsPercent"
                    />
                    <span class="flex items-center px-4 text-gray-500">%</span>
                  </div>
                  <p
                    id="macro-carbs-percent-error"
                    class="mt-2 hidden text-sm text-red-300"
                    data-error-for="carbsPercent"
                  >
                  </p>
                </div>

                <div>
                  <label
                    for="macro-fat-percent-manual"
                    class="block text-sm font-medium text-gray-200"
                  >
                    Grasas
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                  >
                    <input
                      id="macro-fat-percent-manual"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      aria-describedby="macro-fat-percent-manual-error"
                      data-input="fatPercentManual"
                    />
                    <span class="flex items-center px-4 text-gray-500">%</span>
                  </div>
                  <p
                    id="macro-fat-percent-manual-error"
                    class="mt-2 hidden text-sm text-red-300"
                    data-error-for="fatPercentManual"
                  >
                  </p>
                </div>
              </div>

              <div
                class="mt-3 flex flex-col gap-3 rounded-lg border border-gray-800 bg-gray-900/70 p-3 sm:flex-row sm:items-center sm:justify-between"
              >
                <p class="text-sm font-semibold text-gray-200" data-percent-total>
                  Total: 100%
                </p>
                <button
                  class="inline-flex min-h-10 items-center justify-center rounded-lg border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  data-fill-remainder
                >
                  Ajustar carbos al resto
                </button>
              </div>
              <p
                class="mt-2 hidden text-sm text-red-300"
                data-error-for="percentageTotal"
              >
              </p>
            </div>

            <div class="mt-5 max-w-xs">
              <label
                for="macro-meals"
                class="block text-sm font-medium text-gray-200"
              >
                Número de comidas
              </label>
              <select
                id="macro-meals"
                class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                aria-describedby="macro-meals-error"
                data-input="meals"
              >
                {[1, 2, 3, 4, 5, 6, 7].map((meal) => (
                  <option value={meal} selected={meal === 3}>
                    {meal}
                  </option>
                ))}
              </select>
              <p
                id="macro-meals-error"
                class="mt-2 hidden text-sm text-red-300"
                data-error-for="meals"
              >
              </p>
            </div>

            <div
              class="mt-6 flex flex-col gap-3 border-t border-gray-800 pt-5 sm:flex-row sm:flex-wrap"
            >
              <button
                class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                data-fill-example
              >
                Usar ejemplo
              </button>
              <button
                class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                data-clear-calculator
              >
                Limpiar
              </button>
              <button
                class="hidden min-h-11 items-center justify-center rounded-lg bg-amber-400 px-4 py-2 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                data-copy-result
              >
                <span data-copy-label>Copiar resultado</span>
              </button>
              <p class="sr-only" aria-live="polite" data-copy-status></p>
            </div>
          </div>

          <aside
            class="border-t border-gray-800 bg-gray-900/70 p-4 sm:p-6 xl:border-l xl:border-t-0"
            aria-live="polite"
            data-result-region
          >
            <p
              class="text-sm font-semibold uppercase tracking-wide text-amber-400"
              data-result-kicker
            >
              Resultado
