<script>
  import {
    buildDailyWaterCopyText,
    calculateDailyWaterResult,
    convertKgToLb,
    convertLbToKg,
    DailyWaterCalculationError,
    formatContainerRange,
    formatDailyWaterMlRange,
    formatDailyWaterRange,
    formatMl,
    getSweatLevelLabel,
    parseHealthInput,
    roundTo,
    validateDailyWaterInput,
  } from "@lib/calculators/salud/calculadora-de-agua-diaria/dailyWater";

  const form = document.querySelector("[data-calculator-form]");
  const unitButtons = document.querySelectorAll("[data-unit-option]");
  const unitPanels = document.querySelectorAll("[data-unit-panel]");
  const exerciseButtons = document.querySelectorAll("[data-exercise-option]");
  const heatButtons = document.querySelectorAll("[data-heat-option]");
  const sweatButtons = document.querySelectorAll("[data-sweat-option]");
  const containerButtons = document.querySelectorAll("[data-container-option]");
  const exercisePanel = document.querySelector("[data-exercise-panel]");
  const customContainerPanel = document.querySelector(
    "[data-custom-container-panel]",
  );
  const calculationError = document.querySelector("[data-calculation-error]");
  const resultHeading = document.querySelector("[data-result-heading]");
  const resultPlaceholder = document.querySelector("[data-result-placeholder]");
  const placeholderText = document.querySelector("[data-placeholder-text]");
  const resultContent = document.querySelector("[data-result-content]");
  const resultStatus = document.querySelector("[data-result-status]");
  const mainResult = document.querySelector("[data-main-result]");
  const mlResult = document.querySelector("[data-ml-result]");
  const containerResult = document.querySelector("[data-container-result]");
  const containerDetail = document.querySelector("[data-container-detail]");
  const baseResult = document.querySelector("[data-base-result]");
  const exerciseBreakdown = document.querySelector("[data-exercise-breakdown]");
  const exerciseDetail = document.querySelector("[data-exercise-detail]");
  const exerciseResult = document.querySelector("[data-exercise-result]");
  const heatBreakdown = document.querySelector("[data-heat-breakdown]");
  const heatDetail = document.querySelector("[data-heat-detail]");
  const heatResult = document.querySelector("[data-heat-result]");
  const exercisePlanNote = document.querySelector("[data-exercise-plan-note]");
  const warningPanel = document.querySelector("[data-warning-panel]");
  const warningList = document.querySelector("[data-warning-list]");
  const fillExampleButton = document.querySelector("[data-fill-example]");
  const clearButton = document.querySelector("[data-clear-button]");
  const copyButton = document.querySelector("[data-copy-button]");
  const copyLabel = document.querySelector("[data-copy-label]");
  const copyStatus = document.querySelector("[data-copy-status]");
  const inputs = {
    adultConfirmed: document.querySelector('[data-input="adultConfirmed"]'),
    fluidRestriction: document.querySelector('[data-input="fluidRestriction"]'),
    kidneyHeart: document.querySelector('[data-input="kidneyHeart"]'),
    pregnant: document.querySelector('[data-input="pregnant"]'),
    lactating: document.querySelector('[data-input="lactating"]'),
    weightKg: document.querySelector('[data-input="weightKg"]'),
    weightLb: document.querySelector('[data-input="weightLb"]'),
    exerciseMinutes: document.querySelector('[data-input="exerciseMinutes"]'),
    containerMl: document.querySelector('[data-input="containerMl"]'),
  };

  const parseMessages = {
    required: "Ingresa un valor.",
    invalid: "Ingresa un número válido.",
    negative: "Ingresa un valor positivo.",
    too_many_decimals: "Usa como máximo dos decimales.",
  };
  const validationMessages = {
    adultConfirmed: {
      required: "Confirma que eres adulto para usar esta calculadora.",
    },
    weightKg: {
      required: "Ingresa tu peso.",
      out_of_range: "El peso debe estar entre 30 y 250 kg, o su equivalente.",
    },
    exerciseToday: {
      required: "Indica si harás ejercicio hoy.",
    },
    exerciseMinutes: {
      required: "Ingresa la duración aproximada.",
      out_of_range: "La duración debe estar entre 1 y 300 minutos.",
    },
    sweatLevel: {
      required: "Selecciona la sudoración percibida.",
    },
    heatExposure: {
      required: "Indica si tendrás exposición prolongada al calor.",
    },
    containerMl: {
      required: "Ingresa el tamaño de tu recipiente.",
      out_of_range: "El recipiente debe estar entre 100 y 2,000 ml.",
    },
  };
  const blockerMessages = {
    not_adult:
      "Esta calculadora está diseñada para adultos. Las necesidades de menores deben revisarse con una fuente o profesional apropiado.",
    fluid_restriction:
      "Una recomendación general podría contradecir tu indicación médica. Sigue el límite o plan indicado por tu profesional de salud.",
    kidney_or_heart_condition:
      "Una meta genérica puede no ser apropiada con enfermedad renal o cardíaca. Sigue la orientación de tu profesional de salud.",
  };
  const warningMessages = {
    pregnancy:
      "El embarazo puede cambiar las necesidades. Esta versión no aplica un ajuste específico.",
    lactation:
      "La lactancia puede cambiar las necesidades. Esta versión no aplica un ajuste específico.",
    high_variability:
      "El ajuste contextual es amplio frente a la base. Considera una estrategia individual o una medición de tasa de sudor.",
    review_high_total:
      "El resultado supera el umbral de revisión de esta herramienta.",
  };

  let currentUnit = "metric";
  let exerciseToday;
  let heatExposure;
  let sweatLevel;
  let selectedContainer = 500;
  let usesCustomContainer = false;
  let currentResult = null;
  let copyResetTimeout = 0;

  function updateChoiceButtons(buttons, dataKey, selectedValue) {
    buttons.forEach((button) => {
      const isSelected = String(button.dataset[dataKey]) === String(selectedValue);
      const usesCardStyle = dataKey === "sweatOption";
      button.setAttribute("aria-pressed", String(isSelected));
      button.classList.toggle("border-amber-400", isSelected);
      button.classList.toggle("border-gray-700", usesCardStyle && !isSelected);
      button.classList.toggle("bg-amber-400/10", isSelected && usesCardStyle);
      button.classList.toggle("bg-gray-950", usesCardStyle && !isSelected);
      button.classList.toggle("bg-amber-400", isSelected && !usesCardStyle);
      button.classList.toggle("text-gray-950", isSelected && !usesCardStyle);
      button.classList.toggle("font-bold", isSelected);
      button.classList.toggle("text-gray-300", !isSelected);
      button.classList.toggle("hover:bg-gray-800", !isSelected);
    });
  }

  function updateControls() {
    updateChoiceButtons(unitButtons, "unitOption", currentUnit);
    updateChoiceButtons(exerciseButtons, "exerciseOption", exerciseToday);
    updateChoiceButtons(heatButtons, "heatOption", heatExposure);
    updateChoiceButtons(sweatButtons, "sweatOption", sweatLevel);

    unitPanels.forEach((panel) => {
      panel.classList.toggle("hidden", panel.dataset.unitPanel !== currentUnit);
    });
    exercisePanel.classList.toggle("hidden", exerciseToday !== true);
    customContainerPanel.classList.toggle("hidden", !usesCustomContainer);

    containerButtons.forEach((button) => {
      const value = button.dataset.containerOption;
      const isSelected = usesCustomContainer
        ? value === "custom"
        : Number(value) === selectedContainer;
      button.setAttribute("aria-pressed", String(isSelected));
      button.classList.toggle("border-amber-400", isSelected);
      button.classList.toggle("bg-amber-400/10", isSelected);
      button.classList.toggle("border-gray-700", !isSelected);
      button.classList.toggle("bg-gray-900", !isSelected);
    });
  }

  function clearErrors() {
    calculationError.textContent = "";
    calculationError.classList.add("hidden");

    document.querySelectorAll("[data-error-for]").forEach((element) => {
      element.textContent = "";
      element.classList.add("hidden");
    });
    document.querySelectorAll("[data-wrapper-for], [data-choice-group]").forEach((element) => {
      element.classList.remove("border-red-400");
    });
    document.querySelectorAll("[data-field]").forEach((input) => {
      input.removeAttribute("aria-invalid");
    });
  }

  function clearFieldError(field) {
    document.querySelectorAll(`[data-error-for="${field}"]`).forEach((element) => {
      element.textContent = "";
      element.classList.add("hidden");
    });
    document.querySelectorAll(`[data-wrapper-for="${field}"], [data-choice-group="${field}"]`).forEach((element) => {
      element.classList.remove("border-red-400");
    });
    document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
      input.removeAttribute("aria-invalid");
    });
  }

  function showFieldError(field, message) {
    document.querySelectorAll(`[data-error-for="${field}"]`).forEach((element) => {
      element.textContent = message;
      element.classList.remove("hidden");
    });
    document.querySelectorAll(`[data-wrapper-for="${field}"], [data-choice-group="${field}"]`).forEach((element) => {
      element.classList.add("border-red-400");
    });
    document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
      input.setAttribute("aria-invalid", "true");
    });
  }

  function showCalculationError(message) {
    calculationError.textContent = message;
    calculationError.classList.remove("hidden");
  }

  function parseField(rawValue, field, options = {}) {
    const parsed = parseHealthInput(rawValue, options);

    if (!parsed.ok) {
      showFieldError(field, parseMessages[parsed.error]);
      return null;
    }

    return parsed.value;
  }

  function readInput() {
    const weightRaw =
      currentUnit === "metric" ? inputs.weightKg.value : inputs.weightLb.value;
    const parsedWeight = parseField(weightRaw, "weightKg");
    const weightKg =
      parsedWeight === null
        ? null
        : currentUnit === "metric"
          ? parsedWeight
          : convertLbToKg(parsedWeight);
    const exerciseMinutes =
      exerciseToday === true
        ? parseField(inputs.exerciseMinutes.value, "exerciseMinutes", {
            maxDecimals: 0,
          })
        : undefined;
    const containerMl = usesCustomContainer
      ? parseField(inputs.containerMl.value, "containerMl", { maxDecimals: 0 })
      : selectedContainer;

    if (
      weightKg === null ||
      exerciseMinutes === null ||
      containerMl === null
    ) {
      return null;
    }

    const input = {
      adultConfirmed: inputs.adultConfirmed.checked,
      hasFluidRestriction: inputs.fluidRestriction.checked,
      hasKidneyOrHeartCondition: inputs.kidneyHeart.checked,
      isPregnant: inputs.pregnant.checked,
      isLactating: inputs.lactating.checked,
      weightKg,
      exerciseToday,
      exerciseMinutes,
      sweatLevel,
      heatExposure,
      containerMl,
    };
    const validation = validateDailyWaterInput(input);

    Object.entries(validation.errors).forEach(([field, code]) => {
      const message =
        validationMessages[field]?.[code] ?? "Revisa este valor.";
      showFieldError(field, message);
    });

    if (validation.blockers.length > 0) {
      renderBlocked(validation.blockers);
      return null;
    }

    return validation.isValid ? input : null;
  }

  function calculateAndRender({ focusResult = true } = {}) {
    clearErrors();
    const immediateBlockers = getImmediateBlockers();

    if (immediateBlockers.length > 0) {
      if (!inputs.adultConfirmed.checked) {
        showFieldError(
          "adultConfirmed",
          validationMessages.adultConfirmed.required,
        );
      }
      renderBlocked(immediateBlockers, focusResult);
      return;
    }

    const input = readInput();

    if (!input) {
      if (!resultHeading.textContent.includes("No generamos")) {
        setInvalidResult("Revisa los campos marcados para calcular.");
      }
      focusFirstError();
      return;
    }

    try {
      const result = calculateDailyWaterResult(input);

      if (result.requiresReview) {
        renderReview(result, focusResult);
      } else {
        renderResult(result, focusResult);
      }
    } catch (error) {
      if (error instanceof DailyWaterCalculationError) {
        setInvalidResult("Revisa los datos antes de calcular.");
      } else {
        setInvalidResult("No se pudo calcular el rango. Revisa los datos.");
      }
      showCalculationError("No se pudo calcular el rango. Revisa los datos.");
    }
  }

  function getImmediateBlockers() {
    const blockers = [];

    if (!inputs.adultConfirmed.checked) {
      blockers.push("not_adult");
    }
    if (inputs.fluidRestriction.checked) {
      blockers.push("fluid_restriction");
    }
    if (inputs.kidneyHeart.checked) {
      blockers.push("kidney_or_heart_condition");
    }

    return blockers;
  }

  function renderBlocked(blockers, focusResult = true) {
    currentResult = null;
    resultHeading.textContent = "No generamos una meta genérica";
    placeholderText.textContent = blockers
      .map((blocker) => blockerMessages[blocker])
      .join(" ");
    resultPlaceholder.classList.remove("hidden");
    resultContent.classList.add("hidden");
    resultStatus.textContent = "Cálculo bloqueado por una condición de seguridad.";
    copyStatus.textContent = "";
    resetCopyLabel();
    focusResultHeading(focusResult);
  }

  function renderReview(result, focusResult = true) {
    currentResult = null;
    resultHeading.textContent = "Revisa los datos antes de usar una referencia";
    placeholderText.textContent =
      "El extremo alto supera 6 L al día. Esta herramienta no lo mostrará como una meta normal. Revisa peso, duración, sudoración y calor, y considera orientación individual.";
    resultPlaceholder.classList.remove("hidden");
    resultContent.classList.add("hidden");
    resultStatus.textContent =
      "El resultado superó el umbral de revisión de esta herramienta.";
    copyStatus.textContent = "";
    resetCopyLabel();
    focusResultHeading(focusResult);
  }

  function renderResult(result, focusResult) {
    currentResult = result;
    resultHeading.textContent = "Tu rango orientativo para hoy";
    resultPlaceholder.classList.add("hidden");
    resultContent.classList.remove("hidden");
    mainResult.textContent = formatDailyWaterRange(result.total);
    mlResult.textContent = formatDailyWaterMlRange(result.total);
    containerResult.textContent = `${formatContainerRange(result.containerRange)} recipientes`;
    containerDetail.textContent = `Cada recipiente: ${formatMl(result.input.containerMl)}`;
    baseResult.textContent = formatDailyWaterRange(result.base);

    const hasExercise = result.input.exerciseToday;
    exerciseBreakdown.classList.toggle("hidden", !hasExercise);
    exercisePlanNote.classList.toggle("hidden", !hasExercise);

    if (hasExercise) {
      exerciseResult.textContent = formatDailyWaterRange(
        result.exerciseAdjustment,
      );
      exerciseDetail.textContent =
        `${result.input.exerciseMinutes} min · sudoración ${getSweatLevelLabel(result.input.sweatLevel).toLowerCase()}`;
    }

    const hasHeat = result.input.heatExposure;
    heatBreakdown.classList.toggle("hidden", !hasHeat);

    if (hasHeat) {
      heatResult.textContent = formatDailyWaterRange(result.heatAdjustment);
      heatDetail.textContent = hasExercise
        ? "Solo amplía el extremo alto para evitar contar dos veces la sudoración."
        : "Exposición prolongada al calor sin ejercicio.";
    }

    result.plan.forEach((item) => {
      const element = document.querySelector(
        `[data-plan-amount="${item.key}"]`,
      );
      element.textContent = formatMl(item.amountMl);
    });

    renderWarnings(result.warnings);
    resultStatus.textContent =
      `Cálculo completado. Rango orientativo: ${formatDailyWaterRange(result.total)}.`;
    focusResultHeading(focusResult);
  }

  function renderWarnings(warnings) {
    warningList.innerHTML = "";

    warnings
      .filter((warning) => warning !== "review_high_total")
      .forEach((warning) => {
        const item = document.createElement("li");
        item.textContent = warningMessages[warning];
        warningList.append(item);
      });

    warningPanel.classList.toggle("hidden", warningList.children.length === 0);
  }

  function setNeutralResult() {
    currentResult = null;
    resultHeading.textContent = "Tu rango aparecerá aquí";
    placeholderText.textContent =
      "Completa el formulario para ver un rango, sus ajustes y una equivalencia aproximada en tu recipiente habitual.";
    resultPlaceholder.classList.remove("hidden");
    resultContent.classList.add("hidden");
    resultStatus.textContent = "";
    copyStatus.textContent = "";
    resetCopyLabel();
  }

  function setInvalidResult(message) {
    currentResult = null;
    resultHeading.textContent = "Revisa los datos";
    placeholderText.textContent = message;
    resultPlaceholder.classList.remove("hidden");
    resultContent.classList.add("hidden");
    resultStatus.textContent = message;
    copyStatus.textContent = "";
    resetCopyLabel();
  }

  function focusResultHeading(shouldFocus) {
    if (!shouldFocus) {
      return;
    }

    resultHeading.focus({ preventScroll: true });
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    resultHeading.scrollIntoView({
      behavior: reduceMotion ? "auto" : "smooth",
      block: "start",
    });
  }

  function focusFirstError() {
    const firstInvalid = form.querySelector('[aria-invalid="true"]');

    if (firstInvalid) {
      firstInvalid.focus();
      return;
    }

    const firstErrorGroup = form.querySelector(".border-red-400 button");
    firstErrorGroup?.focus();
  }

  function setExercise(value) {
    exerciseToday = value;

    if (!value) {
      sweatLevel = undefined;
      clearFieldError("exerciseMinutes");
      clearFieldError("sweatLevel");
    }

    updateControls();
    clearFieldError("exerciseToday");
    setNeutralResult();
  }

  function setHeat(value) {
    heatExposure = value;
    updateControls();
    clearFieldError("heatExposure");
    setNeutralResult();
  }

  function setSweat(value) {
    sweatLevel = value;
    updateControls();
    clearFieldError("sweatLevel");
    setNeutralResult();
  }

  function selectContainer(value) {
    usesCustomContainer = value === "custom";

    if (!usesCustomContainer) {
      selectedContainer = Number(value);
      clearFieldError("containerMl");
    }

    updateControls();
    setNeutralResult();

    if (usesCustomContainer) {
      inputs.containerMl.focus();
    }
  }

  function switchUnit(nextUnit) {
    if (nextUnit === currentUnit) {
      return;
    }

    if (currentUnit === "metric") {
      const parsed = parseHealthInput(inputs.weightKg.value);
      inputs.weightLb.value = parsed.ok
        ? String(roundTo(convertKgToLb(parsed.value), 1))
        : "";
    } else {
      const parsed = parseHealthInput(inputs.weightLb.value);
      inputs.weightKg.value = parsed.ok
        ? String(roundTo(convertLbToKg(parsed.value), 1))
        : "";
    }

    currentUnit = nextUnit;
    updateControls();
    clearFieldError("weightKg");
    setNeutralResult();
  }

  function fillExample() {
    form.reset();
    currentUnit = "metric";
    exerciseToday = true;
    heatExposure = false;
    sweatLevel = "moderate";
    selectedContainer = 500;
    usesCustomContainer = false;
    inputs.adultConfirmed.checked = true;
    inputs.weightKg.value = "70";
    inputs.weightLb.value = "";
    inputs.exerciseMinutes.value = "60";
    inputs.containerMl.value = "";
    updateControls();
    clearErrors();
    calculateAndRender();
  }

  function clearCalculator() {
    form.reset();
    currentUnit = "metric";
    exerciseToday = undefined;
    heatExposure = undefined;
    sweatLevel = undefined;
    selectedContainer = 500;
    usesCustomContainer = false;
    updateControls();
    clearErrors();
    setNeutralResult();
    inputs.adultConfirmed.focus();
  }

  function resetCopyLabel() {
    window.clearTimeout(copyResetTimeout);
    copyLabel.textContent = "Copiar resultado";
  }

  async function copyResult() {
    if (!currentResult) {
      return;
    }

    const text = buildDailyWaterCopyText(currentResult, currentUnit);

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
      } else {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.setAttribute("readonly", "");
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.append(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
      }

      copyLabel.textContent = "Resultado copiado";
      copyStatus.textContent = "Resultado copiado al portapapeles.";
    } catch {
      copyLabel.textContent = "No se pudo copiar";
      copyStatus.textContent = "No se pudo copiar el resultado.";
    }

    window.clearTimeout(copyResetTimeout);
    copyResetTimeout = window.setTimeout(resetCopyLabel, 2500);
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    calculateAndRender();
  });

  unitButtons.forEach((button) => {
    button.addEventListener("click", () => switchUnit(button.dataset.unitOption));
  });
  exerciseButtons.forEach((button) => {
    button.addEventListener("click", () =>
      setExercise(button.dataset.exerciseOption === "true"),
    );
  });
  heatButtons.forEach((button) => {
    button.addEventListener("click", () =>
      setHeat(button.dataset.heatOption === "true"),
    );
  });
  sweatButtons.forEach((button) => {
    button.addEventListener("click", () => setSweat(button.dataset.sweatOption));
  });
  containerButtons.forEach((button) => {
    button.addEventListener("click", () =>
      selectContainer(button.dataset.containerOption),
    );
  });
  document.querySelectorAll("[data-input]").forEach((input) => {
    input.addEventListener("input", () => {
      if (input.dataset.field) {
        clearFieldError(input.dataset.field);
      }
      setNeutralResult();
    });
    input.addEventListener("change", () => setNeutralResult());
  });

  fillExampleButton.addEventListener("click", fillExample);
  clearButton.addEventListener("click", clearCalculator);
  copyButton.addEventListener("click", copyResult);

  updateControls();
  setNeutralResult();
</script>
