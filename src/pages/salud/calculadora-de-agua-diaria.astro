---
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Calculadora de Agua Diaria: Rango Orientativo de Líquidos";
const description =
  "Estima un rango orientativo de líquidos para beber según tu peso, ejercicio, sudoración y calor. Consulta litros, botellas y un plan flexible.";
const canonical = "/salud/calculadora-de-agua-diaria";
const englishCanonical = "/en/health/daily-water-intake-calculator";
const alternates = buildAlternateLinks({ es: canonical, en: englishCanonical }, Astro.site ?? Astro.url);

const faqs = [
  {
    question: "¿El resultado incluye agua de alimentos y otras bebidas?",
    answer:
      "La calculadora estima un rango orientativo de líquidos para beber. Otras bebidas y alimentos también aportan agua, pero la herramienta no intenta medir ni restar ese aporte. Por eso no necesitas forzar el extremo alto.",
  },
  {
    question: "¿Debo alcanzar siempre el extremo alto del rango?",
    answer:
      "No. El rango representa una referencia flexible, no una meta rígida. La sed, las comidas, el clima, la actividad y las indicaciones médicas pueden cambiar lo apropiado para cada persona.",
  },
  {
    question: "¿Cómo cambia la estimación si hago ejercicio?",
    answer:
      "La calculadora amplía el rango según la duración y la sudoración percibida. Es una clasificación aproximada; medir tu tasa de sudor ofrece una referencia más individual.",
  },
  {
    question: "¿Qué ocurre si hago ejercicio con calor?",
    answer:
      "El calor y la sudoración pueden representar la misma pérdida de líquido. Para evitar contarla dos veces, la calculadora solo amplía el extremo superior del ajuste de ejercicio.",
  },
  {
    question: "¿Qué pasa si tengo restricción médica de líquidos?",
    answer:
      "Una recomendación general podría contradecir tu plan médico. La calculadora no genera cifras cuando indicas restricción de líquidos o enfermedad renal o cardíaca.",
  },
  {
    question: "¿Puedo beber toda el agua pendiente al final del día?",
    answer:
      "No conviene intentar alcanzar rápidamente una cifra pendiente. Distribuye los líquidos durante el día y sigue cualquier indicación médica individual.",
  },
  {
    question: "¿Cuántos vasos o botellas son un litro?",
    answer:
      "Un litro equivale a cuatro vasos de 250 ml, dos botellas de 500 ml o aproximadamente 1.3 botellas de 750 ml.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);
const sweatOptions = [
  {
    key: "low",
    label: "Poca",
    description: "Ropa casi seca y pocas gotas visibles.",
  },
  {
    key: "moderate",
    label: "Moderada",
    description: "Sudor visible y ropa parcialmente húmeda.",
  },
  {
    key: "high",
    label: "Mucha",
    description: "Ropa muy húmeda o sudor abundante.",
  },
];
const containerOptions = [
  { value: 250, label: "Vaso", detail: "250 ml" },
  { value: 500, label: "Botella", detail: "500 ml" },
  { value: 750, label: "Botella grande", detail: "750 ml" },
];
const planItems = [
  { key: "morning", label: "Mañana", percentage: "30%" },
  { key: "midday", label: "Mediodía y comida", percentage: "30%" },
  { key: "afternoon", label: "Tarde", percentage: "25%" },
  { key: "evening", label: "Noche", percentage: "15%" },
];
---

<BaseLayout title={title} description={description} canonical={canonical} alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Calculadora de agua diaria"
      description="Estima un rango orientativo de líquidos para beber según tu peso y el contexto de hoy."
      kicker="Salud"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Salud", href: "/salud", optional: true },
        { label: "Agua diaria", truncate: true },
      ]}
    />

    <Container as="section" class="py-4 md:py-8">
      <div
        class="mb-4 rounded-lg border border-sky-400/30 bg-sky-400/10 p-4 text-sm leading-relaxed text-sky-100/85"
      >
        Esta herramienta ofrece una referencia educativa para adultos. No es una
        necesidad exacta ni sustituye una indicación médica de líquidos.
      </div>

      <section
        id="daily-water-calculator"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <div
          class="grid gap-0 xl:grid-cols-[minmax(0,0.92fr)_minmax(22rem,0.78fr)]"
        >
          <form class="p-4 sm:p-6" data-calculator-form novalidate>
            <div>
              <p
                class="text-sm font-semibold uppercase tracking-wide text-amber-400"
              >
                Referencia para hoy
              </p>
              <h2 id="calculator-heading" class="mt-2 text-2xl font-semibold">
                Describe tu contexto
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-gray-400">
                Mostraremos un rango y el origen de cada ajuste. No selecciones
                actividad o calor si no corresponden a tu día.
              </p>
            </div>

            <fieldset class="mt-6">
              <legend class="text-sm font-semibold text-gray-200">
                1. Antes de calcular
              </legend>
              <label
                class="mt-3 flex min-h-12 cursor-pointer items-start gap-3 rounded-lg border border-gray-700 bg-gray-900 p-3"
                data-wrapper-for="adultConfirmed"
              >
                <input
                  class="mt-1 size-4 shrink-0 border-gray-600 bg-gray-950 text-amber-400 focus:ring-amber-400"
                  type="checkbox"
                  data-input="adultConfirmed"
                  data-field="adultConfirmed"
                  aria-describedby="daily-water-adult-error"
                />
                <span class="text-sm leading-relaxed text-gray-200">
                  Confirmo que soy adulto.
                </span>
              </label>
              <p
                id="daily-water-adult-error"
                class="mt-2 hidden text-sm font-medium text-red-300"
                data-error-for="adultConfirmed"
              >
              </p>

              <p class="mt-5 text-sm font-semibold text-gray-200">
                Marca cualquier situación que aplique
              </p>
              <p class="mt-1 text-xs leading-relaxed text-gray-500">
                Puedes marcar más de una. La restricción médica y las
                enfermedades renal o cardíaca bloquean una meta genérica.
              </p>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                <label
                  class="flex min-h-12 cursor-pointer items-start gap-3 rounded-lg border border-gray-800 bg-gray-900/70 p-3"
                >
                  <input
                    class="mt-1 size-4 shrink-0 border-gray-600 bg-gray-950 text-amber-400 focus:ring-amber-400"
                    type="checkbox"
                    data-input="fluidRestriction"
                  />
                  <span class="text-sm leading-relaxed text-gray-300">
                    Tengo indicación de limitar o controlar líquidos
                  </span>
                </label>
                <label
                  class="flex min-h-12 cursor-pointer items-start gap-3 rounded-lg border border-gray-800 bg-gray-900/70 p-3"
                >
                  <input
                    class="mt-1 size-4 shrink-0 border-gray-600 bg-gray-950 text-amber-400 focus:ring-amber-400"
                    type="checkbox"
                    data-input="kidneyHeart"
                  />
                  <span class="text-sm leading-relaxed text-gray-300">
                    Tengo enfermedad renal o cardíaca
                  </span>
                </label>
                <label
                  class="flex min-h-12 cursor-pointer items-start gap-3 rounded-lg border border-gray-800 bg-gray-900/70 p-3"
                >
                  <input
                    class="mt-1 size-4 shrink-0 border-gray-600 bg-gray-950 text-amber-400 focus:ring-amber-400"
                    type="checkbox"
                    data-input="pregnant"
                  />
                  <span class="text-sm leading-relaxed text-gray-300">
                    Estoy embarazada
                  </span>
                </label>
                <label
                  class="flex min-h-12 cursor-pointer items-start gap-3 rounded-lg border border-gray-800 bg-gray-900/70 p-3"
                >
                  <input
                    class="mt-1 size-4 shrink-0 border-gray-600 bg-gray-950 text-amber-400 focus:ring-amber-400"
                    type="checkbox"
                    data-input="lactating"
                  />
                  <span class="text-sm leading-relaxed text-gray-300">
                    Estoy en lactancia
                  </span>
                </label>
              </div>
            </fieldset>

            <fieldset class="mt-7 border-t border-gray-800 pt-6">
              <legend class="text-sm font-semibold text-gray-200">
                2. Datos básicos
              </legend>
              <div
                class="mt-3 grid grid-cols-2 gap-2 rounded-lg border border-gray-700 bg-gray-900 p-1"
                role="group"
                aria-label="Sistema de unidades"
              >
                <button
                  class="min-h-12 rounded-md bg-amber-400 px-3 py-2 text-sm font-bold text-gray-950 transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-300/50"
                  type="button"
                  aria-pressed="true"
                  data-unit-option="metric"
                >
                  Kilogramos
                </button>
                <button
                  class="min-h-12 rounded-md px-3 py-2 text-sm font-semibold text-gray-300 transition hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  aria-pressed="false"
                  data-unit-option="imperial"
                >
                  Libras
                </button>
              </div>
            </fieldset>

            <div class="mt-4" data-unit-panel="metric">
              <label
                for="daily-water-weight-kg"
                class="block text-sm font-semibold text-gray-200"
              >
                Peso
              </label>
              <div
                class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                data-wrapper-for="weightKg"
              >
                <input
                  id="daily-water-weight-kg"
                  class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  placeholder="70"
                  aria-describedby="daily-water-weight-help daily-water-weight-error"
                  data-input="weightKg"
                  data-field="weightKg"
                />
                <span class="flex items-center px-4 text-sm text-gray-500">
                  kg
                </span>
              </div>
            </div>

            <div class="mt-4 hidden" data-unit-panel="imperial">
              <label
                for="daily-water-weight-lb"
                class="block text-sm font-semibold text-gray-200"
              >
                Peso
              </label>
              <div
                class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                data-wrapper-for="weightKg"
              >
                <input
                  id="daily-water-weight-lb"
                  class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  placeholder="154"
                  aria-describedby="daily-water-weight-help daily-water-weight-error"
                  data-input="weightLb"
                  data-field="weightKg"
                />
                <span class="flex items-center px-4 text-sm text-gray-500">
                  lb
                </span>
              </div>
            </div>
            <p
              id="daily-water-weight-help"
              class="mt-2 text-xs leading-relaxed text-gray-500"
            >
              La estimación está diseñada para pesos entre 30 y 250 kg, o su
              equivalente.
            </p>
            <p
              id="daily-water-weight-error"
              class="mt-2 hidden text-sm font-medium text-red-300"
              data-error-for="weightKg"
            >
            </p>

            <fieldset class="mt-7 border-t border-gray-800 pt-6">
              <legend class="text-sm font-semibold text-gray-200">
                3. Contexto de hoy
              </legend>

              <div class="mt-3">
                <span class="block text-sm font-semibold text-gray-200">
                  ¿Harás ejercicio hoy?
                </span>
                <div
                  class="mt-2 grid grid-cols-2 gap-2 rounded-lg border border-gray-700 bg-gray-900 p-1"
                  role="group"
                  aria-label="Ejercicio de hoy"
                  data-choice-group="exerciseToday"
                >
                  <button
                    class="min-h-12 rounded-md px-3 py-2 text-sm font-semibold text-gray-300 transition hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                    type="button"
                    aria-pressed="false"
                    data-exercise-option="true"
                  >
                    Sí
                  </button>
                  <button
                    class="min-h-12 rounded-md px-3 py-2 text-sm font-semibold text-gray-300 transition hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                    type="button"
                    aria-pressed="false"
                    data-exercise-option="false"
                  >
                    No
                  </button>
                </div>
                <p
                  class="mt-2 hidden text-sm font-medium text-red-300"
                  data-error-for="exerciseToday"
                >
                </p>
              </div>

              <div
                class="mt-5 hidden rounded-lg border border-gray-800 bg-gray-900/50 p-4"
                data-exercise-panel
              >
                <div>
                  <label
                    for="daily-water-exercise-minutes"
                    class="block text-sm font-semibold text-gray-200"
                  >
                    Duración aproximada
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    data-wrapper-for="exerciseMinutes"
                  >
                    <input
                      id="daily-water-exercise-minutes"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      placeholder="60"
                      aria-describedby="daily-water-exercise-error"
                      data-input="exerciseMinutes"
                      data-field="exerciseMinutes"
                    />
                    <span class="flex items-center px-4 text-sm text-gray-500">
                      min
                    </span>
                  </div>
                  <p
                    id="daily-water-exercise-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="exerciseMinutes"
                  >
                  </p>
                </div>

                <div class="mt-5">
                  <span class="block text-sm font-semibold text-gray-200">
                    Sudoración percibida
                  </span>
                  <div
                    class="mt-3 grid gap-2"
                    data-choice-group="sweatLevel"
                  >
                    {
                      sweatOptions.map((option) => (
                        <button
                          class="min-h-16 rounded-lg border border-gray-700 bg-gray-950 p-3 text-left transition hover:border-amber-400/60 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                          type="button"
                          aria-pressed="false"
                          data-sweat-option={option.key}
                        >
                          <span class="block text-sm font-semibold text-white">
                            {option.label}
                          </span>
                          <span class="mt-1 block text-xs leading-relaxed text-gray-500">
                            {option.description}
                          </span>
                        </button>
                      ))
                    }
                  </div>
                  <p
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="sweatLevel"
                  >
                  </p>
                </div>
              </div>

              <div class="mt-5">
                <span class="block text-sm font-semibold text-gray-200">
                  ¿Tendrás exposición prolongada al calor?
                </span>
                <p class="mt-1 text-xs leading-relaxed text-gray-500">
                  Varias horas en ambiente caluroso, especialmente al aire libre
                  o realizando actividad.
                </p>
                <div
                  class="mt-2 grid grid-cols-2 gap-2 rounded-lg border border-gray-700 bg-gray-900 p-1"
                  role="group"
                  aria-label="Exposición prolongada al calor"
                  data-choice-group="heatExposure"
                >
                  <button
                    class="min-h-12 rounded-md px-3 py-2 text-sm font-semibold text-gray-300 transition hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                    type="button"
                    aria-pressed="false"
                    data-heat-option="true"
                  >
                    Sí
                  </button>
                  <button
                    class="min-h-12 rounded-md px-3 py-2 text-sm font-semibold text-gray-300 transition hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                    type="button"
                    aria-pressed="false"
                    data-heat-option="false"
                  >
                    No
                  </button>
                </div>
                <p
                  class="mt-2 hidden text-sm font-medium text-red-300"
                  data-error-for="heatExposure"
                >
                </p>
              </div>
            </fieldset>

            <fieldset class="mt-7 border-t border-gray-800 pt-6">
              <legend class="text-sm font-semibold text-gray-200">
                4. Tu recipiente habitual
              </legend>
              <p class="mt-2 text-xs leading-relaxed text-gray-500">
                Solo cambia la equivalencia en vasos o botellas, no el rango.
              </p>
              <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
                {
                  containerOptions.map((option) => (
                    <button
                      class:list={[
                        "min-h-16 rounded-lg border p-3 text-left transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40",
                        option.value === 500
                          ? "border-amber-400 bg-amber-400/10"
                          : "border-gray-700 bg-gray-900 hover:border-amber-400/60",
                      ]}
                      type="button"
                      aria-pressed={option.value === 500 ? "true" : "false"}
                      data-container-option={option.value}
                    >
                      <span class="block text-sm font-semibold text-white">
                        {option.label}
                      </span>
                      <span class="mt-1 block text-xs text-gray-500">
                        {option.detail}
                      </span>
                    </button>
                  ))
                }
                <button
                  class="min-h-16 rounded-lg border border-gray-700 bg-gray-900 p-3 text-left transition hover:border-amber-400/60 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  aria-pressed="false"
                  data-container-option="custom"
                >
                  <span class="block text-sm font-semibold text-white">
                    Personalizado
                  </span>
                  <span class="mt-1 block text-xs text-gray-500">
                    100 a 2,000 ml
                  </span>
                </button>
              </div>

              <div class="mt-4 hidden" data-custom-container-panel>
                <label
                  for="daily-water-container-ml"
                  class="block text-sm font-semibold text-gray-200"
                >
                  Tamaño personalizado
                </label>
                <div
                  class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                  data-wrapper-for="containerMl"
                >
                  <input
                    id="daily-water-container-ml"
                    class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    placeholder="600"
                    aria-describedby="daily-water-container-error"
                    data-input="containerMl"
                    data-field="containerMl"
                  />
                  <span class="flex items-center px-4 text-sm text-gray-500">
                    ml
                  </span>
                </div>
              </div>
              <p
                id="daily-water-container-error"
                class="mt-2 hidden text-sm font-medium text-red-300"
                data-error-for="containerMl"
              >
              </p>
            </fieldset>

            <p
              class="mt-5 hidden rounded-lg border border-red-400/30 bg-red-400/10 p-3 text-sm font-medium leading-relaxed text-red-200"
              role="alert"
              data-calculation-error
            >
            </p>

            <button
              class="mt-6 min-h-12 w-full rounded-lg bg-amber-400 px-5 py-3 text-base font-bold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-300/50"
              type="submit"
            >
              Calcular rango orientativo
            </button>

            <div class="mt-3 grid grid-cols-2 gap-3">
              <button
                class="min-h-12 rounded-lg border border-gray-700 bg-gray-900 px-3 py-3 text-sm font-semibold text-gray-200 transition hover:border-amber-400/60 hover:text-amber-200 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/30"
                type="button"
                data-fill-example
              >
                Probar ejemplo
              </button>
              <button
                class="min-h-12 rounded-lg border border-gray-700 bg-gray-900 px-3 py-3 text-sm font-semibold text-gray-200 transition hover:border-gray-500 hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/30"
                type="button"
                data-clear-button
              >
                Limpiar
              </button>
            </div>
          </form>

          <section
            class="border-t border-gray-800 bg-gray-900/60 p-4 sm:p-6 xl:border-l xl:border-t-0"
            aria-labelledby="result-heading"
            data-result-region
          >
            <p class="text-sm font-semibold uppercase tracking-wide text-sky-300">
              Resultado
            </p>
            <h2
              id="result-heading"
              class="mt-2 text-xl font-semibold text-white outline-none"
              tabindex="-1"
              data-result-heading
            >
              Tu rango aparecerá aquí
            </h2>

            <div
              class="mt-4 rounded-lg border border-gray-700 bg-gray-950 p-5"
              data-result-placeholder
            >
              <p
                class="text-sm leading-relaxed text-gray-400"
                data-placeholder-text
              >
                Completa el formulario para ver un rango, sus ajustes y una
                equivalencia aproximada en tu recipiente habitual.
              </p>
              <div class="mt-4 grid grid-cols-3 gap-2" aria-hidden="true">
                <div class="h-16 rounded-lg bg-sky-400/10"></div>
                <div class="h-16 rounded-lg bg-amber-400/10"></div>
                <div class="h-16 rounded-lg bg-emerald-400/10"></div>
              </div>
            </div>

            <div class="mt-4 hidden" data-result-content>
              <div
                class="rounded-lg border border-sky-400/35 bg-sky-400/10 p-5"
              >
                <p class="text-xs font-bold uppercase tracking-wide text-sky-200">
                  Rango orientativo de líquidos para beber
                </p>
                <p
                  class="mt-2 text-4xl font-bold tracking-tight text-white"
                  data-main-result
                >
                --
                </p>
                <p class="mt-2 text-sm font-semibold text-sky-100" data-ml-result>
                --
                </p>
                <p class="mt-3 text-xs leading-relaxed text-sky-100/75">
                  Otras bebidas y alimentos también aportan agua; no necesitas
                  forzar el extremo alto.
                </p>
              </div>

              <div
                class="mt-4 rounded-lg border border-amber-400/30 bg-amber-400/10 p-4"
              >
                <p class="text-xs font-bold uppercase tracking-wide text-amber-200">
                  Equivalencia aproximada
                </p>
                <p class="mt-2 text-2xl font-bold text-white" data-container-result>
                  --
                </p>
