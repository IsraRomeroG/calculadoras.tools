<script>
  import {
    BodyFatCalculationError,
    buildBodyFatCopyText,
    calculateBodyFatResult,
    convertCmToIn,
    convertInToCm,
    convertKgToLb,
    convertLbToKg,
    formatBodyFatMass,
    formatBodyFatMeasurementSummary,
    formatBodyFatPercentage,
    getBodyFatFormulaLabel,
    validateBodyFatInput,
  } from "@lib/calculators/salud/calculadora-de-porcentaje-de-grasa-corporal/bodyFat";
  import {
    parseHealthInput,
    roundTo,
  } from "@lib/calculators/salud/calculadora-de-imc/bmi";

  const form = document.querySelector("[data-calculator-form]");
  const formulaButtons = document.querySelectorAll("[data-formula-option]");
  const unitButtons = document.querySelectorAll("[data-unit-option]");
  const unitPanels = document.querySelectorAll("[data-unit-panel]");
  const hipPanels = document.querySelectorAll("[data-hip-panel]");
  const waistGuides = document.querySelectorAll("[data-waist-guide]");
  const formulaGroup = document.querySelector("[data-formula-group]");
  const formulaError = document.querySelector("[data-formula-error]");
  const calculationError = document.querySelector("[data-calculation-error]");
  const resultHeading = document.querySelector("[data-result-heading]");
  const resultPlaceholder = document.querySelector("[data-result-placeholder]");
  const placeholderText = document.querySelector("[data-placeholder-text]");
  const resultContent = document.querySelector("[data-result-content]");
  const resultStatus = document.querySelector("[data-result-status]");
  const mainResult = document.querySelector("[data-main-result]");
  const sensitivity = document.querySelector("[data-sensitivity]");
  const sensitivityNote = document.querySelector("[data-sensitivity-note]");
  const compositionPanel = document.querySelector("[data-composition-panel]");
  const fatMass = document.querySelector("[data-fat-mass]");
  const fatFreeMass = document.querySelector("[data-fat-free-mass]");
  const unusualWarning = document.querySelector("[data-unusual-warning]");
  const formulaLabel = document.querySelector("[data-formula-label]");
  const measurementSummary = document.querySelector("[data-measurement-summary]");
  const fillExampleButton = document.querySelector("[data-fill-example]");
  const clearButton = document.querySelector("[data-clear-button]");
  const copyButton = document.querySelector("[data-copy-button]");
  const copyLabel = document.querySelector("[data-copy-label]");
  const copyStatus = document.querySelector("[data-copy-status]");
  const inputs = {
    heightCm: document.querySelector('[data-input="heightCm"]'),
    neckCm: document.querySelector('[data-input="neckCm"]'),
    waistCm: document.querySelector('[data-input="waistCm"]'),
    hipCm: document.querySelector('[data-input="hipCm"]'),
    weightKg: document.querySelector('[data-input="weightKg"]'),
    heightFt: document.querySelector('[data-input="heightFt"]'),
    heightIn: document.querySelector('[data-input="heightIn"]'),
    neckIn: document.querySelector('[data-input="neckIn"]'),
    waistIn: document.querySelector('[data-input="waistIn"]'),
    hipIn: document.querySelector('[data-input="hipIn"]'),
    weightLb: document.querySelector('[data-input="weightLb"]'),
  };

  const parseMessages = {
    required: "Este campo es obligatorio.",
    invalid: "Ingresa un número válido.",
    negative: "Ingresa un valor positivo.",
    too_many_decimals: "Usa como máximo dos decimales.",
  };
  const validationMessages = {
    height: {
      required: "Ingresa tu altura.",
      out_of_range: "La altura debe estar entre 100 y 250 cm, o su equivalente.",
    },
    neck: {
      required: "Ingresa la medida del cuello.",
      out_of_range: "El cuello debe estar entre 20 y 80 cm, o su equivalente.",
    },
    waist: {
      required: "Ingresa la medida de la cintura.",
      out_of_range: "La cintura debe estar entre 40 y 250 cm, o su equivalente.",
      waist_not_above_neck:
        "En la fórmula masculina, la cintura debe ser mayor que el cuello.",
    },
    hip: {
      required: "La fórmula femenina necesita la medida de cadera.",
      out_of_range: "La cadera debe estar entre 50 y 250 cm, o su equivalente.",
      invalid_female_combination:
        "La combinación de cintura, cadera y cuello no permite aplicar la fórmula.",
    },
    weight: {
      out_of_range: "El peso debe estar entre 20 y 500 kg, o su equivalente.",
    },
  };
  const fieldMap = {
    heightCm: "height",
    neckCm: "neck",
    waistCm: "waist",
    hipCm: "hip",
    weightKg: "weight",
  };

  let currentFormula = null;
  let currentUnit = "metric";
  let currentResult = null;
  let copyResetTimeout = 0;

  function updateChoiceButtons(buttons, dataKey, selectedValue) {
    buttons.forEach((button) => {
      const isSelected = button.dataset[dataKey] === selectedValue;
      button.setAttribute("aria-pressed", String(isSelected));
      button.classList.toggle("bg-amber-400", isSelected);
      button.classList.toggle("text-gray-950", isSelected);
      button.classList.toggle("font-bold", isSelected);
      button.classList.toggle("text-gray-300", !isSelected);
      button.classList.toggle("font-semibold", !isSelected);
      button.classList.toggle("hover:bg-gray-800", !isSelected);
    });
  }

  function updateControls() {
    updateChoiceButtons(formulaButtons, "formulaOption", currentFormula);
    updateChoiceButtons(unitButtons, "unitOption", currentUnit);

    unitPanels.forEach((panel) => {
      panel.classList.toggle("hidden", panel.dataset.unitPanel !== currentUnit);
    });

    const usesHip = currentFormula === "female";
    hipPanels.forEach((panel) => {
      panel.classList.toggle("hidden", !usesHip);
    });

    waistGuides.forEach((guide) => {
      guide.textContent =
        currentFormula === "male"
          ? "Mide el abdomen a la altura del ombligo, relajado y al final de una exhalación normal."
          : currentFormula === "female"
            ? "Mide la cintura natural, normalmente en el punto más estrecho del torso."
            : "Selecciona una fórmula para ver el punto de medición.";
    });
  }

  function clearErrors() {
    formulaError.classList.add("hidden");
    formulaGroup.classList.remove("border-red-400");
    calculationError.textContent = "";
    calculationError.classList.add("hidden");

    document.querySelectorAll("[data-error-for]").forEach((element) => {
      element.textContent = "";
      element.classList.add("hidden");
    });
    document.querySelectorAll("[data-wrapper-for]").forEach((element) => {
      element.classList.remove("border-red-400");
    });
    document.querySelectorAll("[data-field]").forEach((input) => {
      input.removeAttribute("aria-invalid");
    });
  }

  function clearFieldError(field) {
    document.querySelectorAll(`[data-error-for="${field}"]`).forEach((element) => {
      element.textContent = "";
      element.classList.add("hidden");
    });
    document.querySelectorAll(`[data-wrapper-for="${field}"]`).forEach((element) => {
      element.classList.remove("border-red-400");
    });
    document.querySelectorAll(`[data-field="${field}"]`).forEach((input) => {
      input.removeAttribute("aria-invalid");
    });
  }

  function showFieldError(field, message) {
    document.querySelectorAll(`[data-error-for="${field}"]`).forEach((element) => {
      element.textContent = message;
      element.classList.remove("hidden");
    });
    document.querySelectorAll(`[data-wrapper-for="${field}"]`).forEach((element) => {
      element.classList.add("border-red-400");
    });
    getActiveFieldInputs(field).forEach((input) => {
      input.setAttribute("aria-invalid", "true");
    });
  }

  function getActiveFieldInputs(field) {
    const activePanel = document.querySelector(`[data-unit-panel="${currentUnit}"]`);
    return Array.from(activePanel.querySelectorAll(`[data-field="${field}"]`));
  }

  function showFormulaError() {
    formulaError.classList.remove("hidden");
    formulaGroup.classList.add("border-red-400");
  }

  function showCalculationError(message) {
    calculationError.textContent = message;
    calculationError.classList.remove("hidden");
  }

  function parseRequired(rawValue, field, options = {}) {
    const parsed = parseHealthInput(rawValue, options);

    if (!parsed.ok) {
      showFieldError(field, parseMessages[parsed.error]);
      return null;
    }

    return parsed.value;
  }

  function parseOptional(rawValue, field) {
    if (!rawValue.trim()) {
      return undefined;
    }

    const parsed = parseHealthInput(rawValue);

    if (!parsed.ok) {
      showFieldError(field, parseMessages[parsed.error]);
      return null;
    }

    return parsed.value;
  }

  function readMetricInput() {
    const heightCm = parseRequired(inputs.heightCm.value, "height", {
      convertMetersToCentimeters: true,
    });
    const neckCm = parseRequired(inputs.neckCm.value, "neck");
    const waistCm = parseRequired(inputs.waistCm.value, "waist");
    const hipCm =
      currentFormula === "female"
        ? parseRequired(inputs.hipCm.value, "hip")
        : undefined;
    const weightKg = parseOptional(inputs.weightKg.value, "weight");

    if (
      heightCm === null ||
      neckCm === null ||
      waistCm === null ||
      hipCm === null ||
      weightKg === null
    ) {
      return null;
    }

    return {
      formula: currentFormula,
      heightCm,
      neckCm,
      waistCm,
      hipCm,
      weightKg,
    };
  }

  function readImperialInput() {
    const heightFt = parseRequired(inputs.heightFt.value, "height", {
      maxDecimals: 0,
    });
    const heightIn = parseRequired(inputs.heightIn.value, "height");
    const neckIn = parseRequired(inputs.neckIn.value, "neck");
    const waistIn = parseRequired(inputs.waistIn.value, "waist");
    const hipIn =
      currentFormula === "female"
        ? parseRequired(inputs.hipIn.value, "hip")
        : undefined;
    const weightLb = parseOptional(inputs.weightLb.value, "weight");

    if (
      heightFt === null ||
      heightIn === null ||
      neckIn === null ||
      waistIn === null ||
      hipIn === null ||
      weightLb === null
    ) {
      return null;
    }

    if (heightIn >= 12) {
      showFieldError(
        "height",
        "Ingresa las pulgadas de altura entre 0 y menos de 12.",
      );
      return null;
    }

    return {
      formula: currentFormula,
      heightCm: convertInToCm(heightFt * 12 + heightIn),
      neckCm: convertInToCm(neckIn),
      waistCm: convertInToCm(waistIn),
      hipCm: hipIn === undefined ? undefined : convertInToCm(hipIn),
      weightKg: weightLb === undefined ? undefined : convertLbToKg(weightLb),
    };
  }

  function readInput() {
    if (!currentFormula) {
      showFormulaError();
      return null;
    }

    const input =
      currentUnit === "metric" ? readMetricInput() : readImperialInput();

    if (!input) {
      return null;
    }

    const validation = validateBodyFatInput(input);

    if (!validation.isValid) {
      Object.entries(validation.errors).forEach(([canonicalField, code]) => {
        const field = fieldMap[canonicalField];
        const message =
          validationMessages[field]?.[code] ?? "Revisa este valor.";
        showFieldError(field, message);
      });
      return null;
    }

    return input;
  }

  function calculateAndRender({ focusResult = true } = {}) {
    clearErrors();
    const input = readInput();

    if (!input) {
      setInvalidResult("Revisa los campos marcados para calcular.");
      focusFirstError();
      return;
    }

    try {
      renderResult(calculateBodyFatResult(input), focusResult);
    } catch (error) {
      setInvalidResult(
        "El resultado quedó fuera del rango utilizable de esta fórmula.",
      );

      if (error instanceof BodyFatCalculationError) {
        showCalculationError(
          error.code === "result_out_of_range"
            ? "El resultado quedó fuera del rango utilizable. Revisa dónde y cómo tomaste las medidas."
            : error.message,
        );
      } else {
        showCalculationError(
          "No se pudo calcular la estimación. Revisa las medidas.",
        );
      }
    }
  }

  function renderResult(result, focusResult) {
    currentResult = result;
    resultHeading.textContent = "Tu estimación de grasa corporal";
    resultPlaceholder.classList.add("hidden");
    resultContent.classList.remove("hidden");
    mainResult.textContent = formatBodyFatPercentage(result.percentage);

    if (result.sensitivity) {
      sensitivity.textContent = `${formatBodyFatPercentage(result.sensitivity.minPercentage)} a ${formatBodyFatPercentage(result.sensitivity.maxPercentage)}`;
      sensitivityNote.textContent =
        "Escenario conservador si cada perímetro variara hasta ±1 cm; no es un intervalo clínico.";
    } else {
      sensitivity.textContent = "No disponible";
      sensitivityNote.textContent =
        "La variación de ±1 cm produciría un escenario fuera del rango utilizable. Revisa las medidas.";
    }

    const hasComposition = Boolean(result.composition);
    compositionPanel.classList.toggle("hidden", !hasComposition);
    compositionPanel.classList.toggle("grid", hasComposition);

    if (result.composition) {
      const unit = currentUnit === "metric" ? "kg" : "lb";
      const fatValue =
        currentUnit === "metric"
          ? result.composition.fatMassKg
          : convertKgToLb(result.composition.fatMassKg);
      const fatFreeValue =
        currentUnit === "metric"
          ? result.composition.fatFreeMassKg
          : convertKgToLb(result.composition.fatFreeMassKg);

      fatMass.textContent = formatBodyFatMass(fatValue, unit);
      fatFreeMass.textContent = formatBodyFatMass(fatFreeValue, unit);
    }

    unusualWarning.classList.toggle("hidden", !result.isUnusual);
    formulaLabel.textContent = getBodyFatFormulaLabel(result.input.formula);
    measurementSummary.textContent = formatBodyFatMeasurementSummary(
      result.input,
      currentUnit,
    );
    resultStatus.textContent =
      `Cálculo completado. Porcentaje estimado: ${formatBodyFatPercentage(result.percentage)}.`;

    if (focusResult) {
      resultHeading.focus({ preventScroll: true });
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      resultHeading.scrollIntoView({
        behavior: reduceMotion ? "auto" : "smooth",
        block: "start",
      });
    }
  }

  function setNeutralResult() {
    currentResult = null;
    resultHeading.textContent = "Tu estimación aparecerá aquí";
    placeholderText.textContent =
      "Selecciona una fórmula e ingresa tus medidas. El peso es opcional.";
    resultPlaceholder.classList.remove("hidden");
    resultContent.classList.add("hidden");
    resultStatus.textContent = "";
    copyStatus.textContent = "";
    resetCopyLabel();
  }

  function setInvalidResult(message) {
    currentResult = null;
    resultHeading.textContent = "Revisa los datos";
    placeholderText.textContent = message;
    resultPlaceholder.classList.remove("hidden");
    resultContent.classList.add("hidden");
    resultStatus.textContent = message;
    copyStatus.textContent = "";
    resetCopyLabel();
  }

  function focusFirstError() {
    const formulaInvalid = !currentFormula;

    if (formulaInvalid) {
      formulaButtons[0]?.focus();
      return;
    }

    const firstInvalid = form.querySelector('[aria-invalid="true"]');
    firstInvalid?.focus();
  }

  function setFormula(formula) {
    currentFormula = formula;
    updateControls();
    clearErrors();
    setNeutralResult();
  }

  function switchUnit(nextUnit) {
    if (nextUnit === currentUnit) {
      return;
    }

    if (currentUnit === "metric") {
      convertMetricInputsToImperial();
    } else {
      convertImperialInputsToMetric();
    }

    currentUnit = nextUnit;
    updateControls();
    clearErrors();
    setNeutralResult();
  }

  function parseForConversion(value, options = {}) {
    const parsed = parseHealthInput(value, options);
    return parsed.ok ? parsed.value : undefined;
  }

  function convertMetricInputsToImperial() {
    const heightCm = parseForConversion(inputs.heightCm.value, {
      convertMetersToCentimeters: true,
    });

    if (heightCm !== undefined) {
      const totalInches = convertCmToIn(heightCm);
      const feet = Math.floor(totalInches / 12);
      inputs.heightFt.value = String(feet);
      inputs.heightIn.value = String(roundTo(totalInches - feet * 12, 1));
    } else {
      inputs.heightFt.value = "";
      inputs.heightIn.value = "";
    }

    convertInput(inputs.neckCm, inputs.neckIn, convertCmToIn);
    convertInput(inputs.waistCm, inputs.waistIn, convertCmToIn);
    convertInput(inputs.hipCm, inputs.hipIn, convertCmToIn);
    convertInput(inputs.weightKg, inputs.weightLb, convertKgToLb);
  }

  function convertImperialInputsToMetric() {
    const feet = parseForConversion(inputs.heightFt.value, { maxDecimals: 0 });
    const inches = parseForConversion(inputs.heightIn.value);

    if (feet !== undefined && inches !== undefined) {
      inputs.heightCm.value = String(roundTo(convertInToCm(feet * 12 + inches), 1));
    } else {
      inputs.heightCm.value = "";
    }

    convertInput(inputs.neckIn, inputs.neckCm, convertInToCm);
    convertInput(inputs.waistIn, inputs.waistCm, convertInToCm);
    convertInput(inputs.hipIn, inputs.hipCm, convertInToCm);
    convertInput(inputs.weightLb, inputs.weightKg, convertLbToKg);
  }

  function convertInput(source, target, converter) {
    if (!source.value.trim()) {
      target.value = "";
      return;
    }

    const value = parseForConversion(source.value);

    if (value !== undefined) {
      target.value = String(roundTo(converter(value), 1));
    } else {
      target.value = "";
    }
  }

  function fillExample() {
    currentFormula = "male";
    currentUnit = "metric";
    form.reset();
    inputs.heightCm.value = "180";
    inputs.neckCm.value = "40";
    inputs.waistCm.value = "90";
    inputs.weightKg.value = "80";
    updateControls();
    calculateAndRender();
  }

  function clearCalculator() {
    currentFormula = null;
    currentUnit = "metric";
    form.reset();
    updateControls();
    clearErrors();
    setNeutralResult();
    formulaButtons[0]?.focus();
  }

  function resetCopyLabel() {
    window.clearTimeout(copyResetTimeout);
    copyLabel.textContent = "Copiar resultado";
  }

  async function copyResult() {
    if (!currentResult) {
      return;
    }

    const text = buildBodyFatCopyText(currentResult, currentUnit);

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
      } else {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.setAttribute("readonly", "");
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.append(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
      }

      copyLabel.textContent = "Resultado copiado";
      copyStatus.textContent = "Resultado copiado al portapapeles.";
    } catch {
      copyLabel.textContent = "No se pudo copiar";
      copyStatus.textContent = "No se pudo copiar el resultado.";
    }

    window.clearTimeout(copyResetTimeout);
    copyResetTimeout = window.setTimeout(resetCopyLabel, 2500);
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    calculateAndRender();
  });

  formulaButtons.forEach((button) => {
    button.addEventListener("click", () => {
      setFormula(button.dataset.formulaOption);
    });
  });

  unitButtons.forEach((button) => {
    button.addEventListener("click", () => {
      switchUnit(button.dataset.unitOption);
    });
  });

  Object.values(inputs).forEach((input) => {
    input.addEventListener("input", () => {
      clearFieldError(input.dataset.field);
      calculationError.textContent = "";
      calculationError.classList.add("hidden");

      if (currentResult) {
        setNeutralResult();
      }
    });
  });

  fillExampleButton.addEventListener("click", fillExample);
  clearButton.addEventListener("click", clearCalculator);
  copyButton.addEventListener("click", copyResult);

  updateControls();
  setNeutralResult();
</script>
