---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Calculadora de Porcentaje de Grasa Corporal";
const description =
  "Estima tu porcentaje de grasa corporal con medidas de cintura, cuello, altura y cadera. Incluye guía de medición y sensibilidad del resultado.";
const canonical = "/salud/calculadora-de-porcentaje-de-grasa-corporal";

const faqs = [
  {
    question: "¿Qué tan exacta es esta calculadora?",
    answer:
      "Es una estimación basada en circunferencias corporales y una fórmula poblacional. La técnica de medición, la distribución corporal y pequeñas diferencias en la cinta pueden cambiar el resultado. No equivale a una medición clínica.",
  },
  {
    question: "¿Cómo debo medir cuello, cintura y cadera?",
    answer:
      "Usa una cinta flexible sin comprimir la piel. El cuello se mide debajo de la laringe; la fórmula masculina usa el abdomen a la altura del ombligo; la femenina usa la cintura natural y también la parte más ancha de la cadera.",
  },
  {
    question: "¿Por qué el resultado cambia si mido un centímetro diferente?",
    answer:
      "La fórmula utiliza diferencias entre perímetros. Por eso, una variación pequeña en cintura, cuello o cadera puede cambiar la estimación. La calculadora muestra una sensibilidad conservadora de ±1 cm.",
  },
  {
    question: "¿Necesito conocer mi peso?",
    answer:
      "No. El peso no participa en el cálculo del porcentaje. Solo se utiliza para estimar masa grasa y masa libre de grasa.",
  },
  {
    question: "¿La masa libre de grasa es lo mismo que músculo?",
    answer:
      "No. La masa libre de grasa incluye músculo, agua, huesos, órganos y otros tejidos. Esta calculadora no estima masa muscular.",
  },
  {
    question: "¿Sirve para atletas?",
    answer:
      "Puede ser menos precisa en atletas de alto rendimiento, culturistas y personas con mucha masa muscular o distribuciones corporales alejadas de la población usada para desarrollar la fórmula.",
  },
  {
    question: "¿Se puede usar durante el embarazo?",
    answer:
      "No se recomienda interpretar esta fórmula durante el embarazo, porque los cambios corporales hacen que las circunferencias no representen la composición corporal de la misma forma.",
  },
  {
    question: "¿Es lo mismo que IMC?",
    answer:
      "No. El IMC relaciona peso y altura; esta herramienta intenta estimar qué proporción del peso corresponde a grasa mediante circunferencias.",
    relatedHref: "/blog/salud/imc-vs-porcentaje-grasa-corporal",
    relatedLabel: "Comparar IMC y porcentaje de grasa",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Calculadora de grasa corporal"
      description="Estima tu porcentaje de grasa corporal con circunferencias y revisa cuánto puede cambiar ante pequeñas diferencias al medir."
      kicker="Salud"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Salud", href: "/salud", optional: true },
        { label: "Grasa corporal", truncate: true },
      ]}
    />

    <Container as="section" class="py-4 md:py-8">
      <div
        class="mb-4 rounded-lg border border-amber-400/30 bg-amber-400/10 p-4 text-sm leading-relaxed text-amber-100/85"
      >
        Esta herramienta ofrece una estimación orientativa para adultos. No
        debe interpretarse durante el embarazo ni como diagnóstico o medición
        clínica.
      </div>

      <section
        id="body-fat-calculator"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <div
          class="grid gap-0 xl:grid-cols-[minmax(0,0.92fr)_minmax(22rem,0.78fr)]"
        >
          <form class="p-4 sm:p-6" data-calculator-form novalidate>
            <div>
              <p
                class="text-sm font-semibold uppercase tracking-wide text-amber-400"
              >
                Método de circunferencias
              </p>
              <h2 id="calculator-heading" class="mt-2 text-2xl font-semibold">
                Ingresa tus medidas
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-gray-400">
                Para comparar resultados, mide siempre en los mismos puntos y
                bajo condiciones parecidas.
              </p>
            </div>

            <fieldset class="mt-6">
              <legend class="text-sm font-semibold text-gray-200">
                1. Fórmula
              </legend>
              <p class="mt-2 text-xs leading-relaxed text-gray-500">
                Selecciona la fórmula que corresponda a tu fisiología corporal.
                Esta variable solo elige la ecuación.
              </p>
              <div
                class="mt-3 grid gap-2 rounded-lg border border-gray-700 bg-gray-900 p-1 sm:grid-cols-2"
                role="group"
                aria-label="Fórmula de grasa corporal"
                data-formula-group
              >
                <button
                  class="min-h-12 rounded-md px-3 py-2 text-sm font-semibold text-gray-300 transition hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  aria-pressed="false"
                  data-formula-option="male"
                >
                  Fórmula masculina
                </button>
                <button
                  class="min-h-12 rounded-md px-3 py-2 text-sm font-semibold text-gray-300 transition hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  aria-pressed="false"
                  data-formula-option="female"
                >
                  Fórmula femenina
                </button>
              </div>
              <p
                class="mt-2 hidden text-sm font-medium text-red-300"
                data-formula-error
              >
                Selecciona la fórmula que deseas utilizar.
              </p>
            </fieldset>

            <fieldset class="mt-6">
              <legend class="text-sm font-semibold text-gray-200">
                2. Sistema de unidades
              </legend>
              <div
                class="mt-3 grid grid-cols-2 gap-2 rounded-lg border border-gray-700 bg-gray-900 p-1"
                role="group"
                aria-label="Sistema de unidades"
              >
                <button
                  class="min-h-12 rounded-md bg-amber-400 px-3 py-2 text-sm font-bold text-gray-950 transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-300/50"
                  type="button"
                  aria-pressed="true"
                  data-unit-option="metric"
                >
                  Métrico
                </button>
                <button
                  class="min-h-12 rounded-md px-3 py-2 text-sm font-semibold text-gray-300 transition hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  aria-pressed="false"
                  data-unit-option="imperial"
                >
                  Imperial
                </button>
              </div>
            </fieldset>

            <div class="mt-6" data-unit-panel="metric">
              <div class="grid gap-5">
                <div>
                  <label
                    for="body-fat-height-cm"
                    class="block text-sm font-semibold text-gray-200"
                  >
                    Altura
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    data-wrapper-for="height"
                  >
                    <input
                      id="body-fat-height-cm"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="180"
                      aria-describedby="body-fat-height-help body-fat-height-error"
                      data-input="heightCm"
                      data-field="height"
                    />
                    <span class="flex items-center px-4 text-sm text-gray-500">
                      cm
                    </span>
                  </div>
                  <details
                    id="body-fat-height-help"
                    class="mt-2 text-xs leading-relaxed text-gray-500"
                  >
                    <summary
                      class="min-h-11 cursor-pointer py-2 font-semibold text-amber-300"
                    >
                      Cómo medir
                    </summary>
                    <p>
                      Mide sin calzado, de pie y con la mirada al frente. Usa la
                      altura total sin redondearla si conoces el dato.
                    </p>
                  </details>
                  <p
                    id="body-fat-height-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="height"
                  >
                  </p>
                </div>

                <div>
                  <label
                    for="body-fat-neck-cm"
                    class="block text-sm font-semibold text-gray-200"
                  >
                    Cuello
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    data-wrapper-for="neck"
                  >
                    <input
                      id="body-fat-neck-cm"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="40"
                      aria-describedby="body-fat-neck-help body-fat-neck-error"
                      data-input="neckCm"
                      data-field="neck"
                    />
                    <span class="flex items-center px-4 text-sm text-gray-500">
                      cm
                    </span>
                  </div>
                  <details
                    id="body-fat-neck-help"
                    class="mt-2 text-xs leading-relaxed text-gray-500"
                  >
                    <summary
                      class="min-h-11 cursor-pointer py-2 font-semibold text-amber-300"
                    >
                      Cómo medir
                    </summary>
                    <p>
                      Coloca la cinta debajo de la laringe, ligeramente
                      inclinada hacia abajo al frente y sin comprimir la piel.
                    </p>
                  </details>
                  <p
                    id="body-fat-neck-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="neck"
                  >
                  </p>
                </div>

                <div>
                  <label
                    for="body-fat-waist-cm"
                    class="block text-sm font-semibold text-gray-200"
                  >
                    Cintura
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    data-wrapper-for="waist"
                  >
                    <input
                      id="body-fat-waist-cm"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="90"
                      aria-describedby="body-fat-waist-help body-fat-waist-error"
                      data-input="waistCm"
                      data-field="waist"
                    />
                    <span class="flex items-center px-4 text-sm text-gray-500">
                      cm
                    </span>
                  </div>
                  <details
                    id="body-fat-waist-help"
                    class="mt-2 text-xs leading-relaxed text-gray-500"
                  >
                    <summary
                      class="min-h-11 cursor-pointer py-2 font-semibold text-amber-300"
                    >
                      Cómo medir
                    </summary>
                    <p data-waist-guide>
                      Selecciona una fórmula para ver el punto de medición.
                    </p>
                  </details>
                  <p
                    id="body-fat-waist-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="waist"
                  >
                  </p>
                </div>

                <div class="hidden" data-hip-panel>
                  <label
                    for="body-fat-hip-cm"
                    class="block text-sm font-semibold text-gray-200"
                  >
                    Cadera
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    data-wrapper-for="hip"
                  >
                    <input
                      id="body-fat-hip-cm"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="100"
                      aria-describedby="body-fat-hip-help body-fat-hip-error"
                      data-input="hipCm"
                      data-field="hip"
                    />
                    <span class="flex items-center px-4 text-sm text-gray-500">
                      cm
                    </span>
                  </div>
                  <details
                    id="body-fat-hip-help"
                    class="mt-2 text-xs leading-relaxed text-gray-500"
                  >
                    <summary
                      class="min-h-11 cursor-pointer py-2 font-semibold text-amber-300"
                    >
                      Cómo medir
                    </summary>
                    <p>
                      Rodea la parte más ancha de glúteos y cadera, manteniendo
                      la cinta paralela al suelo.
                    </p>
                  </details>
                  <p
                    id="body-fat-hip-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="hip"
                  >
                  </p>
                </div>

                <div>
                  <label
                    for="body-fat-weight-kg"
                    class="block text-sm font-semibold text-gray-200"
                  >
                    Peso <span class="font-normal text-gray-500">opcional</span>
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    data-wrapper-for="weight"
                  >
                    <input
                      id="body-fat-weight-kg"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="80"
                      aria-describedby="body-fat-weight-help body-fat-weight-error"
                      data-input="weightKg"
                      data-field="weight"
                    />
                    <span class="flex items-center px-4 text-sm text-gray-500">
                      kg
                    </span>
                  </div>
                  <p
                    id="body-fat-weight-help"
                    class="mt-2 text-xs leading-relaxed text-gray-500"
                  >
                    Solo se usa para estimar masa grasa y masa libre de grasa.
                  </p>
                  <p
                    id="body-fat-weight-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="weight"
                  >
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-6 hidden" data-unit-panel="imperial">
              <div class="grid gap-5">
                <div>
                  <span class="block text-sm font-semibold text-gray-200">
                    Altura
                  </span>
                  <div class="mt-2 grid grid-cols-2 gap-3">
                    <div
                      class="flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                      data-wrapper-for="height"
                    >
                      <input
                        class="min-h-12 min-w-0 w-full bg-transparent px-3 text-base text-white outline-none placeholder:text-gray-600"
                        type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      placeholder="5"
                      aria-label="Altura en pies"
                      aria-describedby="body-fat-height-imperial-help body-fat-height-imperial-error"
                      data-input="heightFt"
                      data-field="height"
                    />
                      <span class="flex items-center px-3 text-sm text-gray-500">
                        ft
                      </span>
                    </div>
                    <div
                      class="flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                      data-wrapper-for="height"
                    >
                      <input
                        class="min-h-12 min-w-0 w-full bg-transparent px-3 text-base text-white outline-none placeholder:text-gray-600"
                        type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="11"
                      aria-label="Altura en pulgadas"
                      aria-describedby="body-fat-height-imperial-help body-fat-height-imperial-error"
                      data-input="heightIn"
                      data-field="height"
                    />
                      <span class="flex items-center px-3 text-sm text-gray-500">
                        in
                      </span>
                    </div>
                  </div>
                  <details
                    id="body-fat-height-imperial-help"
                    class="mt-2 text-xs leading-relaxed text-gray-500"
                  >
                    <summary
                      class="min-h-11 cursor-pointer py-2 font-semibold text-amber-300"
                    >
                      Cómo medir
                    </summary>
                    <p>
                      Mide sin calzado, de pie y con la mirada al frente. Usa
                      entre 0 y menos de 12 pulgadas además de los pies.
                    </p>
                  </details>
                  <p
                    id="body-fat-height-imperial-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="height"
                  >
                  </p>
                </div>

                <div>
                  <label
                    for="body-fat-neck-in"
                    class="block text-sm font-semibold text-gray-200"
                  >
                    Cuello
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    data-wrapper-for="neck"
                  >
                    <input
                      id="body-fat-neck-in"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="15.7"
                      aria-describedby="body-fat-neck-imperial-help body-fat-neck-imperial-error"
                      data-input="neckIn"
                      data-field="neck"
                    />
                    <span class="flex items-center px-4 text-sm text-gray-500">
                      in
                    </span>
                  </div>
                  <details
                    id="body-fat-neck-imperial-help"
                    class="mt-2 text-xs leading-relaxed text-gray-500"
                  >
                    <summary
                      class="min-h-11 cursor-pointer py-2 font-semibold text-amber-300"
                    >
                      Cómo medir
                    </summary>
                    <p>
                      Coloca la cinta debajo de la laringe, ligeramente
                      inclinada hacia abajo al frente y sin comprimir la piel.
                    </p>
                  </details>
                  <p
                    id="body-fat-neck-imperial-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="neck"
                  >
                  </p>
                </div>

                <div>
                  <label
                    for="body-fat-waist-in"
                    class="block text-sm font-semibold text-gray-200"
                  >
                    Cintura
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    data-wrapper-for="waist"
                  >
                    <input
                      id="body-fat-waist-in"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="35.4"
                      aria-describedby="body-fat-waist-imperial-help body-fat-waist-imperial-error"
                      data-input="waistIn"
                      data-field="waist"
                    />
                    <span class="flex items-center px-4 text-sm text-gray-500">
                      in
                    </span>
                  </div>
                  <p
                    id="body-fat-waist-imperial-help"
                    class="mt-2 text-xs leading-relaxed text-gray-500"
                    data-waist-guide
                  >
                    Selecciona una fórmula para ver el punto de medición.
                  </p>
                  <p
                    id="body-fat-waist-imperial-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="waist"
                  >
                  </p>
                </div>

                <div class="hidden" data-hip-panel>
                  <label
                    for="body-fat-hip-in"
                    class="block text-sm font-semibold text-gray-200"
                  >
                    Cadera
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    data-wrapper-for="hip"
                  >
                    <input
                      id="body-fat-hip-in"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="39.4"
                      aria-describedby="body-fat-hip-imperial-help body-fat-hip-imperial-error"
                      data-input="hipIn"
                      data-field="hip"
                    />
                    <span class="flex items-center px-4 text-sm text-gray-500">
                      in
                    </span>
                  </div>
                  <p
                    id="body-fat-hip-imperial-help"
                    class="mt-2 text-xs leading-relaxed text-gray-500"
                  >
                    Mide la parte más ancha de glúteos y cadera.
                  </p>
                  <p
                    id="body-fat-hip-imperial-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="hip"
                  >
                  </p>
                </div>

                <div>
                  <label
                    for="body-fat-weight-lb"
                    class="block text-sm font-semibold text-gray-200"
                  >
                    Peso <span class="font-normal text-gray-500">opcional</span>
                  </label>
                  <div
                    class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 transition focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    data-wrapper-for="weight"
                  >
                    <input
                      id="body-fat-weight-lb"
                      class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="176.4"
                      aria-describedby="body-fat-weight-imperial-help body-fat-weight-imperial-error"
                      data-input="weightLb"
                      data-field="weight"
                    />
                    <span class="flex items-center px-4 text-sm text-gray-500">
                      lb
                    </span>
                  </div>
                  <p
                    id="body-fat-weight-imperial-help"
                    class="mt-2 text-xs leading-relaxed text-gray-500"
                  >
                    Solo se usa para estimar masa grasa y masa libre de grasa.
                  </p>
                  <p
                    id="body-fat-weight-imperial-error"
                    class="mt-2 hidden text-sm font-medium text-red-300"
                    data-error-for="weight"
                  >
                  </p>
                </div>
              </div>
            </div>

            <p
              class="mt-5 hidden rounded-lg border border-red-400/30 bg-red-400/10 p-3 text-sm font-medium leading-relaxed text-red-200"
              role="alert"
              data-calculation-error
            >
            </p>

            <button
              class="mt-6 min-h-12 w-full rounded-lg bg-amber-400 px-5 py-3 text-base font-bold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-300/50"
              type="submit"
            >
              Calcular estimación
            </button>

            <div class="mt-3 grid grid-cols-2 gap-3">
              <button
