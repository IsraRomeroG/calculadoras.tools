---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Calculadora de Diferencia entre Fechas - Días, Semanas y Meses";
const description =
  "Calcula cuántos días hay entre dos fechas, cuántos días faltan para un evento o qué fecha será dentro de X días. Incluye días hábiles sin fines de semana.";
const canonical = "/fecha-tiempo/diferencia-entre-fechas";

const faqs = [
  {
    question: "¿Cómo calculo la diferencia entre dos fechas en días?",
    answer:
      "Ingresa la fecha inicial y la fecha final. La calculadora muestra los días de calendario entre ambas fechas y, si lo eliges, los días hábiles sin sábados ni domingos.",
  },
  {
    question: "¿Se cuenta el día inicial al calcular días entre fechas?",
    answer:
      "Por defecto no se cuenta la fecha inicial. Del 1 al 2 de enero hay 1 día. Si necesitas contar ambos extremos, activa el conteo inclusivo.",
  },
  {
    question: "¿Cuál es la diferencia entre días naturales y días hábiles?",
    answer:
      "Los días naturales cuentan todos los días del calendario. Los días hábiles de esta versión excluyen sábados y domingos, pero no descuentan festivos.",
  },
  {
    question: "¿Cómo calculo qué fecha será dentro de 30 días?",
    answer:
      "Usa el modo Sumar o restar, elige una fecha de inicio, escribe 30 y selecciona días. El resultado indica la fecha, el día de la semana, la semana del año y el día del año.",
  },
  {
    question: "¿Cómo calculo 30 días hábiles después de una fecha?",
    answer:
      "En el modo Sumar o restar, selecciona la unidad días hábiles. La calculadora avanza solo por lunes a viernes y omite sábados y domingos.",
  },
  {
    question: "¿La calculadora descuenta festivos?",
    answer:
      "En este MVP no. Los días hábiles solo excluyen sábados y domingos. Los festivos por país quedan para una fase posterior con dataset local mantenible.",
  },
  {
    question: "¿Sirve para plazos legales o laborales?",
    answer:
      "Sirve como ayuda de cálculo, pero no sustituye reglas legales, laborales, fiscales ni contractuales. Verifica siempre el criterio aplicable a tu caso.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);

const monthOptions = [
  { value: "1", label: "Enero" },
  { value: "2", label: "Febrero" },
  { value: "3", label: "Marzo" },
  { value: "4", label: "Abril" },
  { value: "5", label: "Mayo" },
  { value: "6", label: "Junio" },
  { value: "7", label: "Julio" },
  { value: "8", label: "Agosto" },
  { value: "9", label: "Septiembre" },
  { value: "10", label: "Octubre" },
  { value: "11", label: "Noviembre" },
  { value: "12", label: "Diciembre" },
];

const modeButtons = [
  { value: "difference", label: "Entre fechas" },
  { value: "add", label: "Sumar o restar" },
  { value: "event", label: "Hasta evento" },
];

const dateUnits = [
  { value: "days", label: "Días" },
  { value: "businessDays", label: "Días hábiles" },
  { value: "weeks", label: "Semanas" },
  { value: "months", label: "Meses" },
  { value: "years", label: "Años" },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Calculadora de diferencia entre fechas"
      description="Cuenta días entre fechas, suma o resta tiempo y revisa días hábiles sin fines de semana."
      kicker="Fecha y tiempo"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Fecha y tiempo", href: "/fecha-tiempo", optional: true },
        { label: "Diferencia entre fechas", truncate: true },
      ]}
    />

    <Container as="section" class="py-6 md:py-8">
      <section
        id="date-difference-calculator"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <div
          class="grid gap-0 xl:grid-cols-[minmax(0,1.08fr)_minmax(21rem,0.82fr)]"
        >
          <div class="p-4 sm:p-6">
            <div>
              <p class="text-sm font-semibold text-amber-400">
                Cálculo principal
              </p>
              <h2 id="calculator-heading" class="mt-2 text-2xl font-semibold">
                Fechas y plazos
              </h2>
            </div>

            <div
              class="mt-5 grid gap-2 rounded-lg border border-gray-800 bg-gray-900/70 p-2 sm:grid-cols-3"
              role="group"
              aria-label="Modo de cálculo"
            >
              {
                modeButtons.map((mode) => (
                  <button
                    class="min-h-11 rounded-md px-3 py-2 text-sm font-semibold text-gray-300 transition hover:bg-gray-800 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40 data-[active=true]:bg-amber-400 data-[active=true]:text-gray-950"
                    type="button"
                    data-mode-button={mode.value}
                    data-active={mode.value === "difference" ? "true" : "false"}
                    aria-pressed={mode.value === "difference" ? "true" : "false"}
                  >
                    {mode.label}
                  </button>
                ))
              }
            </div>

            <div class="mt-6 space-y-6">
              <div data-mode-panel="difference">
                <div class="grid gap-4 lg:grid-cols-2">
                  <fieldset class="rounded-lg border border-gray-800 bg-gray-900/60 p-4">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <legend class="text-sm font-semibold text-gray-200">
                        Fecha inicial
                      </legend>
                      <button
                        class="inline-flex min-h-10 items-center justify-center rounded-md border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                        type="button"
                        data-use-today="difference-start"
                      >
                        Hoy
                      </button>
                    </div>

                    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-[0.65fr_1fr_0.8fr]">
                      <div>
                        <label
                          for="difference-start-day"
                          class="block text-sm text-gray-300"
                        >
                          Día
                        </label>
                        <input
                          id="difference-start-day"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="numeric"
                          maxlength="2"
                          placeholder="15"
                          data-date-input="difference-start-day"
                        />
                      </div>

                      <div>
                        <label
                          for="difference-start-month"
                          class="block text-sm text-gray-300"
                        >
                          Mes
                        </label>
                        <select
                          id="difference-start-month"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          data-date-input="difference-start-month"
                        >
                          {
                            monthOptions.map((month) => (
                              <option value={month.value}>{month.label}</option>
                            ))
                          }
                        </select>
                      </div>

                      <div class="col-span-2 sm:col-span-1">
                        <label
                          for="difference-start-year"
                          class="block text-sm text-gray-300"
                        >
                          Año
                        </label>
                        <input
                          id="difference-start-year"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="numeric"
                          maxlength="4"
                          placeholder="2026"
                          data-date-input="difference-start-year"
                        />
                      </div>
                    </div>
                  </fieldset>

                  <fieldset class="rounded-lg border border-gray-800 bg-gray-900/60 p-4">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <legend class="text-sm font-semibold text-gray-200">
                        Fecha final
                      </legend>
                      <button
                        class="inline-flex min-h-10 items-center justify-center rounded-md border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                        type="button"
                        data-use-today="difference-end"
                      >
                        Hoy
                      </button>
                    </div>

                    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-[0.65fr_1fr_0.8fr]">
                      <div>
                        <label
                          for="difference-end-day"
                          class="block text-sm text-gray-300"
                        >
                          Día
                        </label>
                        <input
                          id="difference-end-day"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="numeric"
                          maxlength="2"
                          placeholder="30"
                          data-date-input="difference-end-day"
                        />
                      </div>

                      <div>
                        <label
                          for="difference-end-month"
                          class="block text-sm text-gray-300"
                        >
                          Mes
                        </label>
                        <select
                          id="difference-end-month"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          data-date-input="difference-end-month"
                        >
                          <option value="">Mes</option>
                          {
                            monthOptions.map((month) => (
                              <option value={month.value}>{month.label}</option>
                            ))
                          }
                        </select>
                      </div>

                      <div class="col-span-2 sm:col-span-1">
                        <label
                          for="difference-end-year"
                          class="block text-sm text-gray-300"
                        >
                          Año
                        </label>
                        <input
                          id="difference-end-year"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="numeric"
                          maxlength="4"
                          placeholder="2026"
                          data-date-input="difference-end-year"
                        />
                      </div>
                    </div>
                  </fieldset>
                </div>

                <p
                  id="difference-error"
                  class="mt-3 hidden text-sm text-red-300"
                  data-error="difference"
                >
                </p>

                <div class="mt-5 grid gap-4 lg:grid-cols-2">
                  <fieldset>
                    <legend class="text-sm font-semibold text-gray-200">
                      Conteo
                    </legend>
                    <div class="mt-2 grid gap-2 sm:grid-cols-2">
                      <label class="flex min-h-11 items-center rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm text-gray-200">
                        <input
                          class="mr-2 accent-amber-400"
                          type="radio"
                          name="difference-count-mode"
                          value="standard"
                          checked
                          data-option-input
                        />
                        Estándar
                      </label>
                      <label class="flex min-h-11 items-center rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm text-gray-200">
                        <input
                          class="mr-2 accent-amber-400"
                          type="radio"
                          name="difference-count-mode"
                          value="inclusive"
                          data-option-input
                        />
                        Inclusivo
                      </label>
                    </div>
                  </fieldset>

                  <fieldset>
                    <legend class="text-sm font-semibold text-gray-200">
                      Tipo de días
                    </legend>
                    <div class="mt-2 grid gap-2 sm:grid-cols-2">
                      <label class="flex min-h-11 items-center rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm text-gray-200">
                        <input
                          class="mr-2 accent-amber-400"
                          type="radio"
                          name="difference-day-type"
                          value="calendar"
                          checked
                          data-option-input
                        />
                        Todos
                      </label>
                      <label class="flex min-h-11 items-center rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm text-gray-200">
                        <input
                          class="mr-2 accent-amber-400"
                          type="radio"
                          name="difference-day-type"
                          value="business"
                          data-option-input
                        />
                        Hábiles
                      </label>
                    </div>
                  </fieldset>
                </div>

                <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                  <button
                    class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                    type="button"
                    data-swap-dates
                  >
                    Intercambiar fechas
                  </button>
                </div>
              </div>

              <div class="hidden" data-mode-panel="add">
                <fieldset class="rounded-lg border border-gray-800 bg-gray-900/60 p-4">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <legend class="text-sm font-semibold text-gray-200">
                      Fecha de inicio
                    </legend>
                    <button
                      class="inline-flex min-h-10 items-center justify-center rounded-md border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                      type="button"
                      data-use-today="operation-start"
                    >
                      Hoy
                    </button>
                  </div>

                  <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-[0.65fr_1fr_0.8fr]">
                    <div>
                      <label
                        for="operation-start-day"
                        class="block text-sm text-gray-300"
                      >
                        Día
                      </label>
                      <input
                        id="operation-start-day"
                        class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                        type="text"
                        inputmode="numeric"
                        maxlength="2"
                        placeholder="1"
                        data-date-input="operation-start-day"
                      />
                    </div>

                    <div>
                      <label
                        for="operation-start-month"
                        class="block text-sm text-gray-300"
                      >
                        Mes
                      </label>
                      <select
                        id="operation-start-month"
                        class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                        data-date-input="operation-start-month"
                      >
                        {
                          monthOptions.map((month) => (
                            <option value={month.value}>{month.label}</option>
                          ))
                        }
                      </select>
                    </div>

                    <div class="col-span-2 sm:col-span-1">
                      <label
                        for="operation-start-year"
                        class="block text-sm text-gray-300"
                      >
                        Año
                      </label>
                      <input
                        id="operation-start-year"
                        class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                        type="text"
                        inputmode="numeric"
                        maxlength="4"
                        placeholder="2026"
                        data-date-input="operation-start-year"
                      />
                    </div>
                  </div>
                </fieldset>

                <div class="mt-5 grid gap-4 lg:grid-cols-[0.8fr_0.8fr_1fr]">
                  <fieldset>
                    <legend class="text-sm font-semibold text-gray-200">
                      Operación
                    </legend>
                    <div class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-1">
                      <label class="flex min-h-11 items-center rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm text-gray-200">
                        <input
                          class="mr-2 accent-amber-400"
                          type="radio"
                          name="date-operation"
                          value="add"
                          checked
                          data-option-input
                        />
                        Sumar
                      </label>
                      <label class="flex min-h-11 items-center rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm text-gray-200">
                        <input
                          class="mr-2 accent-amber-400"
                          type="radio"
                          name="date-operation"
                          value="subtract"
                          data-option-input
                        />
                        Restar
                      </label>
                    </div>
                  </fieldset>

                  <div>
                    <label
                      for="operation-amount"
                      class="block text-sm font-semibold text-gray-200"
                    >
                      Cantidad
                    </label>
                    <input
                      id="operation-amount"
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      type="text"
                      inputmode="numeric"
                      placeholder="90"
                      data-operation-amount
                    />
                  </div>

                  <div>
                    <label
                      for="operation-unit"
                      class="block text-sm font-semibold text-gray-200"
                    >
                      Unidad
                    </label>
                    <select
                      id="operation-unit"
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      data-operation-unit
                    >
                      {
                        dateUnits.map((unit) => (
                          <option value={unit.value}>{unit.label}</option>
                        ))
                      }
                    </select>
                  </div>
                </div>

                <p
                  class="mt-3 hidden text-sm text-red-300"
                  data-error="operation"
                >
                </p>
              </div>

              <div class="hidden" data-mode-panel="event">
                <div class="grid gap-4 lg:grid-cols-2">
                  <fieldset class="rounded-lg border border-gray-800 bg-gray-900/60 p-4">
                    <legend class="text-sm font-semibold text-gray-200">
                      Fecha del evento
                    </legend>

                    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-[0.65fr_1fr_0.8fr]">
                      <div>
                        <label
                          for="event-day"
                          class="block text-sm text-gray-300"
                        >
                          Día
                        </label>
                        <input
                          id="event-day"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="numeric"
                          maxlength="2"
                          placeholder="31"
                          data-date-input="event-day"
                        />
                      </div>

                      <div>
                        <label
                          for="event-month"
                          class="block text-sm text-gray-300"
                        >
                          Mes
                        </label>
                        <select
                          id="event-month"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          data-date-input="event-month"
                        >
                          <option value="">Mes</option>
                          {
                            monthOptions.map((month) => (
                              <option value={month.value}>{month.label}</option>
                            ))
                          }
                        </select>
                      </div>

                      <div class="col-span-2 sm:col-span-1">
                        <label
                          for="event-year"
                          class="block text-sm text-gray-300"
                        >
                          Año
                        </label>
                        <input
                          id="event-year"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="numeric"
                          maxlength="4"
                          placeholder="2026"
                          data-date-input="event-year"
                        />
                      </div>
                    </div>

                    <div class="mt-4">
                      <label
                        for="event-label"
                        class="block text-sm text-gray-300"
                      >
                        Nombre
                      </label>
                      <input
                        id="event-label"
                        class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                        type="text"
                        maxlength="40"
                        placeholder="Fin de año"
                        data-event-label
                      />
                    </div>
                  </fieldset>

                  <fieldset class="rounded-lg border border-gray-800 bg-gray-900/60 p-4">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <legend class="text-sm font-semibold text-gray-200">
                        Fecha base
                      </legend>
                      <button
                        class="inline-flex min-h-10 items-center justify-center rounded-md border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                        type="button"
                        data-use-today="event-base"
                      >
                        Hoy
                      </button>
                    </div>

                    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-[0.65fr_1fr_0.8fr]">
                      <div>
                        <label
                          for="event-base-day"
                          class="block text-sm text-gray-300"
                        >
                          Día
                        </label>
                        <input
                          id="event-base-day"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="numeric"
                          maxlength="2"
                          data-date-input="event-base-day"
                        />
                      </div>

                      <div>
                        <label
                          for="event-base-month"
                          class="block text-sm text-gray-300"
                        >
                          Mes
                        </label>
                        <select
                          id="event-base-month"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          data-date-input="event-base-month"
                        >
                          {
                            monthOptions.map((month) => (
                              <option value={month.value}>{month.label}</option>
                            ))
                          }
                        </select>
                      </div>

                      <div class="col-span-2 sm:col-span-1">
                        <label
                          for="event-base-year"
                          class="block text-sm text-gray-300"
                        >
                          Año
                        </label>
                        <input
                          id="event-base-year"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="numeric"
                          maxlength="4"
                          data-date-input="event-base-year"
                        />
                      </div>
                    </div>
                  </fieldset>
                </div>

                <div class="mt-5 grid gap-4 lg:grid-cols-2">
                  <fieldset>
                    <legend class="text-sm font-semibold text-gray-200">
                      Conteo
                    </legend>
                    <div class="mt-2 grid gap-2 sm:grid-cols-2">
                      <label class="flex min-h-11 items-center rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm text-gray-200">
                        <input
                          class="mr-2 accent-amber-400"
                          type="radio"
                          name="event-count-mode"
                          value="standard"
                          checked
                          data-option-input
                        />
                        Estándar
                      </label>
                      <label class="flex min-h-11 items-center rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm text-gray-200">
                        <input
                          class="mr-2 accent-amber-400"
                          type="radio"
                          name="event-count-mode"
                          value="inclusive"
                          data-option-input
                        />
                        Inclusivo
                      </label>
                    </div>
                  </fieldset>

                  <fieldset>
                    <legend class="text-sm font-semibold text-gray-200">
                      Tipo de días
                    </legend>
                    <div class="mt-2 grid gap-2 sm:grid-cols-2">
                      <label class="flex min-h-11 items-center rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm text-gray-200">
                        <input
                          class="mr-2 accent-amber-400"
                          type="radio"
                          name="event-day-type"
                          value="calendar"
                          checked
                          data-option-input
                        />
                        Todos
                      </label>
                      <label class="flex min-h-11 items-center rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm text-gray-200">
                        <input
                          class="mr-2 accent-amber-400"
                          type="radio"
                          name="event-day-type"
                          value="business"
                          data-option-input
                        />
                        Hábiles
                      </label>
                    </div>
                  </fieldset>
                </div>

                <p class="mt-3 hidden text-sm text-red-300" data-error="event">
                </p>
              </div>
            </div>

            <div
              class="mt-6 flex flex-col gap-3 border-t border-gray-800 pt-5 sm:flex-row sm:flex-wrap"
            >
              <button
                class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                data-fill-example
              >
                Usar ejemplo
              </button>
              <button
                class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                data-clear-calculator
              >
                Limpiar
              </button>
              <button
                class="hidden min-h-11 items-center justify-center rounded-lg bg-amber-400 px-4 py-2 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                data-copy-result
              >
                <span data-copy-label>Copiar resultado</span>
              </button>
              <p class="sr-only" aria-live="polite" data-copy-status></p>
            </div>
          </div>

          <aside
            class="border-t border-gray-800 bg-gray-900/70 p-4 sm:p-6 xl:border-l xl:border-t-0"
            aria-live="polite"
            data-result-region
          >
            <p class="text-sm font-semibold text-amber-400" data-result-kicker>
              Resultado
            </p>
            <p
              class="mt-3 break-words text-3xl font-bold leading-tight text-white md:text-4xl"
              data-main-result
            >
              Ingresa las fechas
            </p>
            <p class="mt-3 text-sm leading-relaxed text-gray-400" data-result-note>
              Completa los campos para ver el cálculo.
            </p>

            <div
              class="mt-5 hidden rounded-lg border border-amber-400/40 bg-amber-400/10 p-4"
              data-warning-panel
            >
              <p class="text-sm font-semibold text-amber-200">
                Revisa este detalle
              </p>
              <ul
                class="mt-2 space-y-2 text-sm leading-relaxed text-amber-100"
                data-warning-list
              >
              </ul>
            </div>

            <div class="mt-5 grid gap-3" data-detail-list></div>
          </aside>
        </div>
      </section>
    </Container>

    <Container as="section" class="py-6 md:py-8">
      <SectionIntro
        title="Cómo se cuentan los días"
        description="El conteo estándar no cuenta la fecha inicial. El conteo inclusivo suma la fecha inicial cuando necesitas contar ambos extremos del periodo."
      />

      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-gray-800 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold">Estándar</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Del 1 al 2 de enero hay 1 día. Es la convención más común para
            medir tiempo transcurrido.
          </p>
        </div>
        <div class="rounded-lg border border-gray-800 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold">Inclusivo</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Cuenta la fecha inicial. Es útil para estancias, reportes o
            conteos donde ambos extremos forman parte del periodo.
          </p>
        </div>
        <div class="rounded-lg border border-gray-800 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold">Hábiles</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            En esta versión se excluyen sábados y domingos. Los festivos por
            país quedan fuera del MVP.
          </p>
        </div>
      </div>
    </Container>

    <Container as="section" class="py-6 md:py-8">
      <div class="rounded-lg border border-gray-700 bg-gray-950 p-5">
        <h2 class="text-xl font-semibold">Aviso</h2>
        <p class="mt-3 text-sm leading-relaxed text-gray-400">
          Esta calculadora ayuda a contar fechas, pero no sustituye reglas
          legales, laborales, fiscales ni contractuales. Verifica siempre el
          criterio aplicable a tu caso.
        </p>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<script>
  import {
    DEFAULT_COUNT_MODE,
    DEFAULT_DAY_COUNT_TYPE,
    MAX_AMOUNT,
    MAX_YEAR,
    MIN_YEAR,
    buildDateDifferenceCopyText,
    calculateDateDifference,
    calculateDateOperation,
    comparePlainDates,
    formatCompactDuration,
    formatFullPlainDate,
    formatNumber,
    formatPlainDate,
    formatWeekDuration,
    parseDateParts,
    todayInLocalTimeZone,
  } from "@lib/calculators/fecha-tiempo/diferencia-entre-fechas/date-difference";

  const ERROR_MESSAGES = {
    required: "Completa día, mes y año.",
    invalid: "Ingresa una fecha válida.",
    year_four_digits: "Ingresa el año con 4 dígitos.",
    date_invalid: "Esa fecha no existe en el calendario.",
    year_range: "La fecha está fuera del rango permitido.",
    amount_required: "Ingresa una cantidad.",
    amount_invalid: "Ingresa una cantidad entera mayor a cero.",
    amount_too_large: "La cantidad máxima es 36,500.",
    result_out_of_range: "La fecha calculada queda fuera del rango soportado.",
  };

  const DATE_GROUPS = {
    "difference-start": {
      day: document.querySelector('[data-date-input="difference-start-day"]'),
      month: document.querySelector('[data-date-input="difference-start-month"]'),
      year: document.querySelector('[data-date-input="difference-start-year"]'),
    },
    "difference-end": {
      day: document.querySelector('[data-date-input="difference-end-day"]'),
      month: document.querySelector('[data-date-input="difference-end-month"]'),
      year: document.querySelector('[data-date-input="difference-end-year"]'),
    },
    "operation-start": {
      day: document.querySelector('[data-date-input="operation-start-day"]'),
      month: document.querySelector('[data-date-input="operation-start-month"]'),
      year: document.querySelector('[data-date-input="operation-start-year"]'),
    },
    event: {
      day: document.querySelector('[data-date-input="event-day"]'),
      month: document.querySelector('[data-date-input="event-month"]'),
      year: document.querySelector('[data-date-input="event-year"]'),
    },
    "event-base": {
      day: document.querySelector('[data-date-input="event-base-day"]'),
      month: document.querySelector('[data-date-input="event-base-month"]'),
      year: document.querySelector('[data-date-input="event-base-year"]'),
    },
  };

  const modeButtons = document.querySelectorAll("[data-mode-button]");
  const modePanels = document.querySelectorAll("[data-mode-panel]");
  const allDateInputs = document.querySelectorAll("[data-date-input]");
  const optionInputs = document.querySelectorAll("[data-option-input]");
  const errors = {
    difference: document.querySelector('[data-error="difference"]'),
    operation: document.querySelector('[data-error="operation"]'),
    event: document.querySelector('[data-error="event"]'),
  };
  const amountInput = document.querySelector("[data-operation-amount]");
  const unitSelect = document.querySelector("[data-operation-unit]");
  const eventLabelInput = document.querySelector("[data-event-label]");
  const resultKicker = document.querySelector("[data-result-kicker]");
  const mainResult = document.querySelector("[data-main-result]");
  const resultNote = document.querySelector("[data-result-note]");
  const detailList = document.querySelector("[data-detail-list]");
  const warningPanel = document.querySelector("[data-warning-panel]");
  const warningList = document.querySelector("[data-warning-list]");
  const copyButton = document.querySelector("[data-copy-result]");
  const copyLabel = document.querySelector("[data-copy-label]");
  const copyStatus = document.querySelector("[data-copy-status]");
  const clearButton = document.querySelector("[data-clear-calculator]");
  const exampleButton = document.querySelector("[data-fill-example]");
  const swapButton = document.querySelector("[data-swap-dates]");
  const todayButtons = document.querySelectorAll("[data-use-today]");

  let currentMode = "difference";
  let currentCopyText = "";
  let copiedTimeout = 0;
  let differenceStartUsesToday = true;
  let operationStartUsesToday = true;
  let eventBaseUsesToday = true;

  function getToday() {
    return todayInLocalTimeZone();
  }

  function setDateInputs(group, date) {
    group.day.value = String(date.day);
    group.month.value = String(date.month);
    group.year.value = String(date.year);
  }

  function parseDateFromGroup(group) {
    return parseDateParts({
      day: group.day?.value ?? "",
      month: group.month?.value ?? "",
      year: group.year?.value ?? "",
      minYear: MIN_YEAR,
      maxYear: MAX_YEAR,
    });
  }

  function getCheckedValue(name, fallback) {
    return (
      document.querySelector(`input[name="${name}"]:checked`)?.value ?? fallback
    );
  }

  function hasGroupStarted(group) {
    return [group.day, group.month, group.year].some(
      (input) => input?.value.trim() !== "",
    );
  }

  function hasCurrentModeStarted() {
    if (currentMode === "difference") {
      return (
        !differenceStartUsesToday ||
        hasGroupStarted(DATE_GROUPS["difference-end"])
      );
    }

    if (currentMode === "add") {
      return (
        !operationStartUsesToday ||
        amountInput?.value.trim() !== ""
      );
    }

    return (
      hasGroupStarted(DATE_GROUPS.event) ||
      !eventBaseUsesToday ||
      eventLabelInput?.value.trim() !== ""
    );
  }

  function setNeutralState() {
    currentCopyText = "";
    resultKicker.textContent = "Resultado";
    mainResult.textContent = "Ingresa las fechas";
    resultNote.textContent = "Completa los campos para ver el cálculo.";
    renderDetails([]);
    renderWarnings([]);
    setCopyVisible(false);
  }

  function setInvalidState(mode, message) {
    currentCopyText = "";
    resultKicker.textContent = "Revisa los campos";
    mainResult.textContent = "No se puede calcular todavía";
    resultNote.textContent = message;
    renderDetails([]);
    renderWarnings([]);
    setCopyVisible(false);
    showError(errors[mode], message);
  }

  function updateCalculator() {
    clearErrors();

    if (!hasCurrentModeStarted()) {
      setNeutralState();
      return;
    }

    if (currentMode === "difference") {
      renderDifferenceMode();
      return;
    }

    if (currentMode === "add") {
      renderOperationMode();
      return;
    }

    renderEventMode();
  }

  function renderDifferenceMode() {
    const start = parseDateFromGroup(DATE_GROUPS["difference-start"]);
    const end = parseDateFromGroup(DATE_GROUPS["difference-end"]);
    const countMode = getCheckedValue(
      "difference-count-mode",
      DEFAULT_COUNT_MODE,
    );
    const dayType = getCheckedValue(
      "difference-day-type",
      DEFAULT_DAY_COUNT_TYPE,
    );

    if (!start.ok || !end.ok) {
      setInvalidState(
        "difference",
        "Completa fechas válidas para calcular la diferencia.",
      );
      return;
    }

    const result = calculateDateDifference({
      startDate: start.value,
      endDate: end.value,
      countMode,
    });
    const primaryDays =
      dayType === "business" ? result.businessDays : result.totalDays;
    const primaryText = formatUnit(
      primaryDays,
      dayType === "business" ? "día hábil" : "día",
      dayType === "business" ? "días hábiles" : "días",
    );

    resultKicker.textContent =
      dayType === "business" ? "Días hábiles" : "Días entre fechas";
    mainResult.textContent = buildDifferenceHeadline(result.sign, primaryText);
    resultNote.textContent = buildDifferenceNote(countMode, dayType);
    renderDetails([
      ["Fecha inicial", formatFullPlainDate(start.value)],
      ["Fecha final", formatFullPlainDate(end.value)],
      ["Equivalente calendario", formatCompactDuration(result.calendar)],
      ["Semanas", formatWeekDuration(result.weeks)],
      ["Días calendario", formatUnit(result.totalDays, "día", "días")],
      [
        "Días hábiles sin festivos",
        formatUnit(result.businessDays, "día hábil", "días hábiles"),
      ],
      ["Fines de semana", formatUnit(result.weekendDays, "día", "días")],
      ["Horas aprox.", `${formatNumber(result.totalDays * 24)} h`],
      ["Minutos aprox.", `${formatNumber(result.totalDays * 24 * 60)} min`],
    ]);
    renderWarnings(buildDateWarnings(result, dayType, countMode));
    setCopyVisible(true);
    currentCopyText = buildDateDifferenceCopyText({
      startDate: start.value,
      endDate: end.value,
      countMode,
      result,
    });
  }

  function renderOperationMode() {
    const start = parseDateFromGroup(DATE_GROUPS["operation-start"]);
    const amountResult = parseAmount();
    const operation = getCheckedValue("date-operation", "add");
    const unit = unitSelect?.value ?? "days";

    if (!start.ok) {
      setInvalidState(
        "operation",
        "Completa una fecha de inicio válida para calcular.",
      );
      return;
    }

    if (!amountResult.ok) {
      setInvalidState("operation", ERROR_MESSAGES[amountResult.error]);
      return;
    }

    let result;

    try {
      result = calculateDateOperation({
        startDate: start.value,
        operation,
        amount: amountResult.value,
        unit,
      });
    } catch {
      setInvalidState("operation", ERROR_MESSAGES.result_out_of_range);
      return;
    }

    const unitLabel = formatAmountUnit(amountResult.value, unit);
    const directionLabel = operation === "add" ? "después" : "antes";

    resultKicker.textContent = "Fecha calculada";
    mainResult.textContent = `${unitLabel} ${directionLabel} será ${formatFullPlainDate(
      result.date,
    )}.`;
    resultNote.textContent = `Fecha de inicio: ${formatPlainDate(start.value)}.`;
    renderDetails([
      ["Fecha de inicio", formatFullPlainDate(start.value)],
      ["Fecha resultado", formatFullPlainDate(result.date)],
      ["Día de la semana", result.weekday],
      ["Semana ISO", `semana ${formatNumber(result.isoWeek)}`],
      ["Día del año", `día ${formatNumber(result.dayOfYear)}`],
      ["Trimestre", `Q${result.quarter}`],
      [
        "Siguiente día hábil",
        result.nextBusinessDay
          ? formatFullPlainDate(result.nextBusinessDay)
          : "No aplica",
      ],
    ]);
    renderWarnings(buildOperationWarnings(result, unit));
    setCopyVisible(true);
    currentCopyText = [
      "Calculadora de diferencia entre fechas - calculadoras.tools",
      `Fecha de inicio: ${formatFullPlainDate(start.value)}`,
      `Operación: ${operation === "add" ? "sumar" : "restar"} ${unitLabel}`,
      `Resultado: ${formatFullPlainDate(result.date)}`,
      `Semana ISO: ${formatNumber(result.isoWeek)}`,
      `Día del año: ${formatNumber(result.dayOfYear)}`,
    ].join("\n");
  }

  function renderEventMode() {
    const eventDate = parseDateFromGroup(DATE_GROUPS.event);
    const baseDate = parseDateFromGroup(DATE_GROUPS["event-base"]);
    const countMode = getCheckedValue("event-count-mode", DEFAULT_COUNT_MODE);
    const dayType = getCheckedValue("event-day-type", DEFAULT_DAY_COUNT_TYPE);
    const label = eventLabelInput?.value.trim() || "la fecha";

    if (!eventDate.ok || !baseDate.ok) {
      setInvalidState(
        "event",
        "Completa la fecha del evento y una fecha base válida.",
      );
      return;
    }

    const result = calculateDateDifference({
      startDate: baseDate.value,
      endDate: eventDate.value,
      countMode,
    });
    const primaryDays =
      dayType === "business" ? result.businessDays : result.totalDays;
    const primaryText = formatUnit(
      primaryDays,
      dayType === "business" ? "día hábil" : "día",
      dayType === "business" ? "días hábiles" : "días",
    );

    resultKicker.textContent = "Cuenta hacia evento";
    mainResult.textContent = buildEventHeadline(result.sign, primaryText, label);
    resultNote.textContent = `Evento: ${formatFullPlainDate(eventDate.value)}.`;
    renderDetails([
      ["Fecha base", formatFullPlainDate(baseDate.value)],
      ["Fecha del evento", formatFullPlainDate(eventDate.value)],
      ["Equivalente calendario", formatCompactDuration(result.calendar)],
      ["Semanas", formatWeekDuration(result.weeks)],
      ["Días calendario", formatUnit(result.totalDays, "día", "días")],
      [
        "Días hábiles sin festivos",
        formatUnit(result.businessDays, "día hábil", "días hábiles"),
      ],
      ["Fines de semana", formatUnit(result.weekendDays, "día", "días")],
    ]);
    renderWarnings(buildDateWarnings(result, dayType, countMode));
    setCopyVisible(true);
    currentCopyText = [
      "Calculadora de diferencia entre fechas - calculadoras.tools",
      `Evento: ${label}`,
      `Fecha base: ${formatFullPlainDate(baseDate.value)}`,
      `Fecha del evento: ${formatFullPlainDate(eventDate.value)}`,
      `Resultado: ${mainResult.textContent}`,
      `Semanas: ${formatWeekDuration(result.weeks)}`,
      `Días hábiles sin festivos: ${formatNumber(result.businessDays)}`,
    ].join("\n");
  }

  function buildDifferenceHeadline(sign, primaryText) {
    if (sign > 0) {
      return `Entre estas fechas hay ${primaryText}.`;
    }

    if (sign < 0) {
      return `La fecha final es ${primaryText} antes de la fecha inicial.`;
    }

    return `Las fechas son iguales: ${primaryText}.`;
  }

  function buildEventHeadline(sign, primaryText, label) {
    if (sign > 0) {
      return `Faltan ${primaryText} para ${label}.`;
    }

    if (sign < 0) {
      return `${capitalize(label)} fue hace ${primaryText}.`;
    }

    return `${capitalize(label)} es hoy.`;
  }

  function buildDifferenceNote(countMode, dayType) {
    const notes = [
      countMode === "inclusive"
        ? "El conteo inclusivo cuenta la fecha inicial."
        : "El conteo estándar no cuenta la fecha inicial.",
    ];

    if (dayType === "business") {
      notes.push("Los días hábiles excluyen sábados y domingos; no festivos.");
    }

    notes.push("Horas y minutos son aproximados porque no se usa hora.");

    return notes.join(" ");
  }

  function buildDateWarnings(result, dayType, countMode) {
    const warnings = [];

    if (result.startIsWeekend) {
      warnings.push(`La fecha inicial cae en ${result.startWeekday}.`);
    }

    if (result.endIsWeekend && result.nextBusinessDayAfterEnd) {
      warnings.push(
        `La fecha final cae en ${result.endWeekday}. El siguiente día hábil es ${formatFullPlainDate(
          result.nextBusinessDayAfterEnd,
        )}.`,
      );
    }

    if (dayType === "business") {
      warnings.push(
        "Los días hábiles de esta versión excluyen sábados y domingos, no festivos.",
      );
    }

    if (countMode === "inclusive") {
      warnings.push("El conteo inclusivo suma la fecha inicial al periodo.");
    }

    return warnings;
  }

  function buildOperationWarnings(result, unit) {
    const warnings = [];

    if (unit === "businessDays") {
      warnings.push(
        "Los días hábiles de esta versión excluyen sábados y domingos, no festivos.",
      );
    }

    if (result.isWeekend && result.nextBusinessDay) {
      warnings.push(
        `La fecha calculada cae en ${result.weekday}. El siguiente día hábil es ${formatFullPlainDate(
          result.nextBusinessDay,
        )}.`,
      );
    }

    return warnings;
  }

  function parseAmount() {
    const value = amountInput?.value.trim() ?? "";

    if (!value) {
      return { ok: false, error: "amount_required" };
    }

    if (!/^\d+$/.test(value)) {
      return { ok: false, error: "amount_invalid" };
    }

    const amount = Number(value);

    if (amount <= 0) {
      return { ok: false, error: "amount_invalid" };
    }

    if (amount > MAX_AMOUNT) {
      return { ok: false, error: "amount_too_large" };
    }

    return { ok: true, value: amount };
  }

  function renderDetails(rows) {
    detailList.innerHTML = "";

    rows.forEach(([label, value]) => {
      const item = document.createElement("div");
      item.className = "rounded-lg border border-gray-800 bg-gray-950/70 p-4";

      const labelElement = document.createElement("span");
      labelElement.className =
        "block text-xs font-semibold text-gray-500";
      labelElement.textContent = label;

      const valueElement = document.createElement("span");
      valueElement.className =
        "mt-2 block break-words text-lg font-semibold text-white";
      valueElement.textContent = value;

      item.append(labelElement, valueElement);
      detailList.append(item);
    });
  }

  function renderWarnings(warnings) {
    warningList.innerHTML = "";

    warnings.forEach((warning) => {
      const item = document.createElement("li");
      item.textContent = warning;
      warningList.append(item);
    });

    warningPanel.classList.toggle("hidden", warnings.length === 0);
  }

  function clearErrors() {
    Object.values(errors).forEach((element) => {
      element.textContent = "";
      element.classList.add("hidden");
    });
  }

  function showError(element, message) {
    element.textContent = message;
    element.classList.remove("hidden");
  }

  function setCopyVisible(isVisible) {
    copyButton.classList.toggle("hidden", !isVisible);
    copyButton.classList.toggle("inline-flex", isVisible);
  }

  function setMode(mode) {
    currentMode = mode;

    modeButtons.forEach((button) => {
      const isActive = button.dataset.modeButton === mode;
      button.dataset.active = isActive ? "true" : "false";
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
    });

    modePanels.forEach((panel) => {
      panel.classList.toggle("hidden", panel.dataset.modePanel !== mode);
    });

    updateCalculator();
  }

  function setDateGroupToToday(groupKey) {
    const today = getToday();
    setDateInputs(DATE_GROUPS[groupKey], today);

    if (groupKey === "difference-start") {
      differenceStartUsesToday = true;
    }

    if (groupKey === "operation-start") {
      operationStartUsesToday = true;
    }

    if (groupKey === "event-base") {
      eventBaseUsesToday = true;
    }

    updateCalculator();
  }

  function swapDifferenceDates() {
    const start = {
      day: DATE_GROUPS["difference-start"].day.value,
      month: DATE_GROUPS["difference-start"].month.value,
      year: DATE_GROUPS["difference-start"].year.value,
    };
    const end = {
      day: DATE_GROUPS["difference-end"].day.value,
      month: DATE_GROUPS["difference-end"].month.value,
      year: DATE_GROUPS["difference-end"].year.value,
    };

    DATE_GROUPS["difference-start"].day.value = end.day;
    DATE_GROUPS["difference-start"].month.value = end.month;
    DATE_GROUPS["difference-start"].year.value = end.year;
    DATE_GROUPS["difference-end"].day.value = start.day;
    DATE_GROUPS["difference-end"].month.value = start.month;
    DATE_GROUPS["difference-end"].year.value = start.year;
    differenceStartUsesToday = false;
    updateCalculator();
  }

  function fillExample() {
    if (currentMode === "difference") {
      setDateInputs(DATE_GROUPS["difference-start"], {
        year: 2026,
        month: 1,
        day: 15,
      });
      setDateInputs(DATE_GROUPS["difference-end"], {
        year: 2026,
        month: 9,
        day: 30,
      });
      setRadioValue("difference-count-mode", "standard");
      setRadioValue("difference-day-type", "calendar");
      differenceStartUsesToday = false;
    } else if (currentMode === "add") {
      setDateInputs(DATE_GROUPS["operation-start"], {
        year: 2026,
        month: 5,
        day: 1,
      });
      amountInput.value = "90";
      unitSelect.value = "days";
      setRadioValue("date-operation", "add");
      operationStartUsesToday = false;
    } else {
      setDateInputs(DATE_GROUPS["event-base"], {
        year: 2026,
        month: 4,
        day: 25,
      });
      setDateInputs(DATE_GROUPS.event, {
        year: 2026,
        month: 12,
        day: 31,
      });
      eventLabelInput.value = "Fin de año";
      setRadioValue("event-count-mode", "standard");
      setRadioValue("event-day-type", "calendar");
      eventBaseUsesToday = false;
    }

    updateCalculator();
  }

  function clearCalculator() {
    allDateInputs.forEach((input) => {
      input.value = "";
    });
    amountInput.value = "";
    eventLabelInput.value = "";
    setRadioValue("difference-count-mode", "standard");
    setRadioValue("difference-day-type", "calendar");
    setRadioValue("date-operation", "add");
    setRadioValue("event-count-mode", "standard");
    setRadioValue("event-day-type", "calendar");
    unitSelect.value = "days";
    setDefaultTodayInputs();
    clearErrors();
    setNeutralState();
  }

  function setDefaultTodayInputs() {
    const today = getToday();
    setDateInputs(DATE_GROUPS["difference-start"], today);
    setDateInputs(DATE_GROUPS["operation-start"], today);
    setDateInputs(DATE_GROUPS["event-base"], today);
    differenceStartUsesToday = true;
    operationStartUsesToday = true;
    eventBaseUsesToday = true;
  }

  function setRadioValue(name, value) {
    const input = document.querySelector(`input[name="${name}"][value="${value}"]`);

    if (input) {
      input.checked = true;
    }
  }

  async function copyResult() {
    if (!currentCopyText) {
      return;
    }

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(currentCopyText);
      } else {
        const textArea = document.createElement("textarea");
        textArea.value = currentCopyText;
        textArea.setAttribute("readonly", "");
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.append(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
      }

      window.clearTimeout(copiedTimeout);
      copyLabel.textContent = "Copiado";
      copyStatus.textContent = "Resultado copiado.";
      copiedTimeout = window.setTimeout(() => {
        copyLabel.textContent = "Copiar resultado";
        copyStatus.textContent = "";
      }, 2000);
    } catch {
      copyStatus.textContent = "No se pudo copiar el resultado.";
    }
  }

  function scheduleMidnightRefresh() {
    const now = new Date();
    const nextMidnight = new Date(now);
    nextMidnight.setHours(24, 0, 1, 0);

    window.setTimeout(() => {
      const today = getToday();

      if (differenceStartUsesToday) {
        setDateInputs(DATE_GROUPS["difference-start"], today);
      }

      if (operationStartUsesToday) {
        setDateInputs(DATE_GROUPS["operation-start"], today);
      }

      if (eventBaseUsesToday) {
        setDateInputs(DATE_GROUPS["event-base"], today);
      }

      updateCalculator();
      scheduleMidnightRefresh();
    }, nextMidnight.getTime() - now.getTime());
  }

  function formatUnit(value, singular, plural) {
    return `${formatNumber(value)} ${value === 1 ? singular : plural}`;
  }

  function formatAmountUnit(value, unit) {
    const labels = {
      days: ["día", "días"],
      businessDays: ["día hábil", "días hábiles"],
      weeks: ["semana", "semanas"],
      months: ["mes", "meses"],
      years: ["año", "años"],
    };
    const [singular, plural] = labels[unit] ?? labels.days;

    return formatUnit(value, singular, plural);
  }

  function capitalize(value) {
    return value ? value.charAt(0).toUpperCase() + value.slice(1) : value;
  }

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      setMode(button.dataset.modeButton);
    });
  });

  allDateInputs.forEach((input) => {
    input.addEventListener("input", () => {
      const key = input.dataset.dateInput ?? "";

      if (key.startsWith("difference-start")) {
        differenceStartUsesToday = false;
      }

      if (key.startsWith("operation-start")) {
        operationStartUsesToday = false;
      }

      if (key.startsWith("event-base")) {
        eventBaseUsesToday = false;
      }

      updateCalculator();
    });
    input.addEventListener("change", updateCalculator);
  });

  optionInputs.forEach((input) => {
    input.addEventListener("change", updateCalculator);
  });

  todayButtons.forEach((button) => {
    button.addEventListener("click", () => {
      setDateGroupToToday(button.dataset.useToday);
    });
  });

  amountInput?.addEventListener("input", updateCalculator);
  unitSelect?.addEventListener("change", updateCalculator);
  eventLabelInput?.addEventListener("input", updateCalculator);
  swapButton?.addEventListener("click", swapDifferenceDates);
  exampleButton?.addEventListener("click", fillExample);
  clearButton?.addEventListener("click", clearCalculator);
  copyButton?.addEventListener("click", copyResult);

  setDefaultTodayInputs();
  setNeutralState();
  scheduleMidnightRefresh();
</script>
