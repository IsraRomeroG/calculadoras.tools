
---
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import {
  ATTENDANCE_CANONICAL_PATH,
  ATTENDANCE_EXAMPLES,
} from "@lib/calculators/matematicas/calculadora-porcentaje-asistencia-escolar/attendance";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Calculadora de porcentaje de asistencia escolar";
const description =
  "Calcula tu porcentaje de asistencia, faltas disponibles y clases necesarias para cumplir un minimo requerido.";
const canonical = ATTENDANCE_CANONICAL_PATH;
const englishCanonical = "/en/math/attendance-percentage-calculator";
const alternates = buildAlternateLinks(
  { es: canonical, en: englishCanonical },
  Astro.site ?? Astro.url,
);

const faqs = [
  {
    question: "Como se calcula el porcentaje de asistencia?",
    answer:
      "Se divide el numero de clases asistidas entre el total de clases realizadas y se multiplica por 100.",
  },
  {
    question: "Cuantas faltas puedo tener?",
    answer:
      "Depende del minimo requerido, las faltas acumuladas y las clases restantes. La calculadora estima las faltas adicionales que puedes tener sin bajar del minimo final.",
  },
  {
    question: "Que pasa si estoy por debajo del minimo?",
    answer:
      "La calculadora revisa si todavia puedes recuperarte con las clases restantes y muestra cuantas tendrias que asistir.",
  },
  {
    question: "Puedo considerar clases restantes?",
    answer:
      "Si. Captura las clases que faltan del curso para estimar el escenario final, no solo el porcentaje actual.",
  },
  {
    question: "Que significa que ya no sea posible llegar al minimo?",
    answer:
      "Significa que, aunque asistas a todas las clases restantes capturadas, el porcentaje final quedaria por debajo del requisito.",
  },
  {
    question: "Las faltas justificadas cuentan para el porcentaje?",
    answer:
      "Depende de la regla de tu escuela. En este MVP todas las faltas capturadas cuentan igual para el porcentaje.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical} alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Calculadora de asistencia escolar"
      description="Calcula tu porcentaje actual, revisa si cumples el minimo y estima que margen tienes para las clases restantes."
      kicker="Matematicas"
      collapseBreadcrumbOnMobile
      containerClass="py-6 md:py-8"
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Matematicas", href: "/matematicas", optional: true },
        { label: "Asistencia escolar", truncate: true },
      ]}
    />

    <Container as="section" class="py-6 md:py-8">
      <div
        id="attendance-calculator"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
      >
        <div class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.78fr)]">
          <aside
            class="border-b border-gray-800 bg-gray-900/60 p-4 sm:p-6 lg:order-2 lg:border-b-0 lg:border-l"
            aria-live="polite"
          >
            <p class="text-sm font-semibold uppercase text-amber-400">
              Resultado
            </p>

            <div class="mt-4 rounded-lg border border-gray-700 bg-gray-950 p-5">
              <p class="text-xs font-semibold uppercase text-gray-400">
                Accion recomendada
              </p>
              <p
                class="mt-2 break-words text-2xl font-bold leading-tight text-white sm:text-3xl"
                data-result-action
              >
                Completa tus datos para calcular.
              </p>
              <p class="mt-3 text-sm leading-relaxed text-gray-400" data-result-note>
                Se mostrara tu porcentaje actual y el margen de faltas.
              </p>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-3">
              <div class="rounded-lg border border-gray-800 bg-gray-950 p-4">
                <p class="text-xs font-semibold uppercase text-gray-500">
                  Asistencia
                </p>
                <p
                  class="mt-2 break-words text-3xl font-semibold text-white"
                  data-result-percent
                >
                  -
                </p>
              </div>
              <div class="rounded-lg border border-gray-800 bg-gray-950 p-4">
                <p class="text-xs font-semibold uppercase text-gray-500">
                  Estado
                </p>
                <p class="mt-2 break-words text-2xl font-semibold text-white" data-result-status>
                  -
                </p>
              </div>
              <div class="rounded-lg border border-gray-800 bg-gray-950 p-4">
                <p class="text-xs font-semibold uppercase text-gray-500">
                  Faltas disponibles
                </p>
                <p class="mt-2 break-words text-2xl font-semibold text-white" data-result-available>
                  -
                </p>
              </div>
              <div class="rounded-lg border border-gray-800 bg-gray-950 p-4">
                <p class="text-xs font-semibold uppercase text-gray-500">
                  Clases necesarias
                </p>
                <p class="mt-2 break-words text-2xl font-semibold text-white" data-result-needed>
                  -
                </p>
              </div>
            </div>

            <div class="mt-3 rounded-lg border border-gray-800 bg-gray-950 p-4">
              <p class="text-xs font-semibold uppercase text-gray-500">
                Lectura rapida
              </p>
              <div class="mt-3 grid gap-2 text-sm leading-relaxed text-gray-300">
                <p data-result-margin>Margen: -</p>
                <p data-result-final-absences>Faltas maximas al final: -</p>
                <p data-result-recovery>Clases seguidas para recuperar: -</p>
                <p data-result-max-possible>Maximo posible: -</p>
              </div>
            </div>
          </aside>

          <section class="p-4 sm:p-6 lg:order-1" aria-labelledby="calculator-heading">
            <h2 id="calculator-heading" class="text-xl font-semibold">
              Datos de asistencia
            </h2>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div>
                <label for="attendance-total" class="block text-sm font-medium text-gray-200">
                  Total de clases realizadas
                </label>
                <input
                  id="attendance-total"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  placeholder="40"
                  data-field="totalClasses"
                />
                <p class="mt-2 hidden text-sm text-red-300" data-error-for="totalClasses"></p>
              </div>

              <div>
                <label for="attendance-required" class="block text-sm font-medium text-gray-200">
                  Minimo requerido (%)
                </label>
                <input
                  id="attendance-required"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  value="80"
                  data-field="requiredPercent"
                />
                <p class="mt-2 hidden text-sm text-red-300" data-error-for="requiredPercent"></p>
              </div>
            </div>

            <div class="mt-5">
              <span class="block text-sm font-medium text-gray-200">
                Capturar por
              </span>
              <div
                class="mt-2 inline-flex rounded-lg border border-gray-700 bg-gray-900 p-1"
                role="group"
                aria-label="Modo de captura"
              >
                <button
                  class="min-h-11 rounded-md px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  data-mode-button="attended"
                  aria-pressed="true"
                >
                  Asistidas
                </button>
                <button
                  class="min-h-11 rounded-md px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  data-mode-button="absences"
                  aria-pressed="false"
                >
                  Faltas
                </button>
              </div>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div data-attended-wrapper>
                <label
                  for="attendance-attended"
                  class="block text-sm font-medium text-gray-200"
                >
                  Clases asistidas
                </label>
                <input
                  id="attendance-attended"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  placeholder="34"
                  data-field="attendedClasses"
                />
                <p class="mt-2 hidden text-sm text-red-300" data-error-for="attendedClasses"></p>
              </div>

              <div class="hidden" data-absences-wrapper>
                <label
                  for="attendance-absences"
                  class="block text-sm font-medium text-gray-200"
                >
                  Faltas
                </label>
                <input
                  id="attendance-absences"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  placeholder="6"
                  data-field="absences"
                />
                <p class="mt-2 hidden text-sm text-red-300" data-error-for="absences"></p>
              </div>

              <div>
                <label
                  for="attendance-remaining"
                  class="block text-sm font-medium text-gray-200"
                >
                  Clases restantes
                </label>
                <input
                  id="attendance-remaining"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  value="0"
                  data-field="remainingClasses"
                />
                <p class="mt-2 hidden text-sm text-red-300" data-error-for="remainingClasses"></p>
              </div>
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
              <button
                class="inline-flex min-h-11 items-center justify-center rounded-lg bg-amber-400 px-4 py-2 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                data-copy-summary
                disabled
              >
                Copiar resumen
              </button>
              <button
                class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                data-clear
              >
                Limpiar
              </button>
            </div>
            <p class="mt-3 min-h-5 text-sm text-emerald-300" data-action-status></p>

            <div class="mt-5">
              <p class="text-sm font-medium text-gray-200">Ejemplos</p>
              <div class="mt-2 flex flex-wrap gap-2">
                {
                  ATTENDANCE_EXAMPLES.map((example) => (
                    <button
                      class="min-h-11 rounded-lg border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                      type="button"
                      data-example-id={example.id}
                    >
                      {example.label}
                    </button>
                  ))
                }
              </div>
            </div>
          </section>
        </div>
      </div>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-6 md:py-8">
      <SectionIntro
        title="Como leer el resultado"
        description="El valor mas util suele ser la accion siguiente: cuantas faltas quedan o cuantas clases conviene asistir."
      />

      <div class="grid gap-4 md:grid-cols-3">
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold text-white">Faltas acumuladas</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Son las clases que ya cuentan como ausencia dentro del total
            registrado.
          </p>
        </article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold text-white">Faltas disponibles</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Son faltas futuras posibles dentro de las clases restantes
            capturadas.
          </p>
        </article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold text-white">Clases necesarias</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Indica cuantas clases restantes necesitas asistir para cumplir el
            minimo al final.
          </p>
        </article>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<script>
  import {
    ATTENDANCE_EXAMPLES,
    buildAttendanceSummary,
    calculateAttendance,
    formatAttendanceCount,
    formatAttendancePercent,
    formatSignedAttendanceNumber,
    parseAttendanceInteger,
    parseAttendancePercent,
  } from "@lib/calculators/matematicas/calculadora-porcentaje-asistencia-escolar/attendance";

  const INTEGER_ERROR_MESSAGES = {
    required: "Campo obligatorio.",
    invalid: "Ingresa un numero entero valido.",
    negative: "Usa un numero igual o mayor a cero.",
    zero: "Debe ser mayor que cero.",
    too_large: "No puede superar el limite permitido.",
  };

  const PERCENT_ERROR_MESSAGES = {
    required: "Campo obligatorio.",
    invalid: "Ingresa un porcentaje valido.",
    negative: "Usa un porcentaje igual o mayor a cero.",
    too_large: "El porcentaje no puede superar 100.",
    too_many_decimals: "Usa maximo 4 decimales.",
  };

  const modeButtons = Array.from(document.querySelectorAll("[data-mode-button]"));
  const attendedWrapper = document.querySelector("[data-attended-wrapper]");
  const absencesWrapper = document.querySelector("[data-absences-wrapper]");
  const copyButton = document.querySelector("[data-copy-summary]");
  const clearButton = document.querySelector("[data-clear]");
  const actionStatus = document.querySelector("[data-action-status]");
  const resultAction = document.querySelector("[data-result-action]");
  const resultNote = document.querySelector("[data-result-note]");
  const resultPercent = document.querySelector("[data-result-percent]");
  const resultStatus = document.querySelector("[data-result-status]");
  const resultAvailable = document.querySelector("[data-result-available]");
  const resultNeeded = document.querySelector("[data-result-needed]");
  const resultMargin = document.querySelector("[data-result-margin]");
  const resultFinalAbsences = document.querySelector("[data-result-final-absences]");
  const resultRecovery = document.querySelector("[data-result-recovery]");
  const resultMaxPossible = document.querySelector("[data-result-max-possible]");
  const exampleButtons = Array.from(document.querySelectorAll("[data-example-id]"));

  let mode = "attended";
  let currentSummary = "";
  let statusTimeout = 0;

  function getField(field) {
    return document.querySelector(`[data-field="${field}"]`);
  }

  function getFieldValue(field) {
    return getField(field)?.value ?? "";
  }

  function setFieldValue(field, value) {
    const input = getField(field);

    if (input) {
      input.value = value;
    }
  }

  function readIntegerField(field, options = {}) {
    const input = getField(field);
    const parsed = parseAttendanceInteger(input?.value ?? "", {
      required: options.required ?? true,
      allowZero: options.allowZero ?? true,
      max: options.max ?? 1000,
    });

    if (!parsed.ok) {
      setFieldError(
        field,
        options.tooLargeMessage && parsed.error === "too_large"
          ? options.tooLargeMessage
          : INTEGER_ERROR_MESSAGES[parsed.error],
        shouldShowError(input),
      );
      return { ok: false, value: null };
    }

    return { ok: true, value: parsed.value };
  }

  function readPercentField(field) {
    const input = getField(field);
    const parsed = parseAttendancePercent(input?.value ?? "");

    if (!parsed.ok) {
      setFieldError(field, PERCENT_ERROR_MESSAGES[parsed.error], shouldShowError(input));
      return { ok: false, value: null };
    }

    return { ok: true, value: parsed.value };
  }

  function readCalculatorInput() {
    clearErrors();

    const total = readIntegerField("totalClasses", {
      allowZero: false,
      max: 1000,
    });

    if (!total.ok || total.value === null) {
      return { ok: false, reason: "Agrega el total de clases realizadas." };
    }

    const required = readPercentField("requiredPercent");

    if (!required.ok || required.value === null) {
      return { ok: false, reason: "Agrega el minimo requerido." };
    }

    const remaining = readIntegerField("remainingClasses", {
      required: false,
      allowZero: true,
      max: 1000,
    });

    if (!remaining.ok || remaining.value === null) {
      return { ok: false, reason: "Revisa las clases restantes." };
    }

    if (mode === "absences") {
      const absences = readIntegerField("absences", {
        allowZero: true,
        max: total.value,
        tooLargeMessage: "Las faltas no pueden superar el total.",
      });

      if (!absences.ok || absences.value === null) {
        return { ok: false, reason: "Agrega las faltas acumuladas." };
      }

      return {
        ok: true,
        value: {
          totalClasses: total.value,
          mode,
          absences: absences.value,
          requiredPercent: required.value,
          remainingClasses: remaining.value,
        },
      };
    }

    const attended = readIntegerField("attendedClasses", {
      allowZero: true,
      max: total.value,
      tooLargeMessage: "Las asistencias no pueden superar el total.",
    });

    if (!attended.ok || attended.value === null) {
      return { ok: false, reason: "Agrega las clases asistidas." };
    }

    return {
      ok: true,
      value: {
        totalClasses: total.value,
        mode,
        attendedClasses: attended.value,
        requiredPercent: required.value,
        remainingClasses: remaining.value,
      },
    };
  }

  function updateCalculator() {
    updateModeUi();

    const input = readCalculatorInput();

    if (!input.ok) {
      renderEmptyState(input.reason);
      return;
    }

    try {
      const result = calculateAttendance(input.value);
      currentSummary = buildAttendanceSummary(result);
      renderResult(result);
      syncAlternateField(result);
    } catch (error) {
      renderEmptyState(error instanceof Error ? error.message : "No se pudo calcular.");
    }
  }

  function renderResult(result) {
    setText(resultAction, result.actionMessage);
    setText(
      resultNote,
      result.viability === "imposible"
        ? "El objetivo final no se alcanza con las clases restantes capturadas."
        : "Resultado calculado con las clases realizadas y restantes.",
    );
    setText(resultPercent, formatAttendancePercent(result.currentPercent));
    setText(
      resultStatus,
      result.viability === "cumple"
        ? "Cumple"
        : result.viability === "recuperable"
          ? "Recuperable"
          : "Imposible",
    );
    setText(
      resultAvailable,
      result.availableAbsences < 0
        ? `Excedes ${formatAttendanceCount(result.exceededAbsences)}`
        : formatAttendanceCount(result.availableAbsences),
    );
    setText(
      resultNeeded,
      `${formatAttendanceCount(result.minimumRemainingAttendances)}/${formatAttendanceCount(
        result.remainingClasses,
      )}`,
    );
    setText(
      resultMargin,
      `Margen: ${formatSignedAttendanceNumber(result.marginPoints)} puntos`,
    );
    setText(
      resultFinalAbsences,
      `Faltas maximas al final: ${formatAttendanceCount(
        result.maximumFinalAbsences,
      )}`,
    );
    setText(resultRecovery, `Clases seguidas para recuperar: ${formatRecovery(result)}`);
    setText(
      resultMaxPossible,
      `Maximo posible: ${formatAttendancePercent(result.maxPossiblePercent)}`,
    );

    updateResultColors(result);
    setCopyEnabled(true);
  }

  function renderEmptyState(message) {
    currentSummary = "";
    setText(resultAction, "Completa tus datos para calcular.");
    setText(resultNote, message);
    setText(resultPercent, "-");
    setText(resultStatus, "-");
    setText(resultAvailable, "-");
    setText(resultNeeded, "-");
    setText(resultMargin, "Margen: -");
    setText(resultFinalAbsences, "Faltas maximas al final: -");
    setText(resultRecovery, "Clases seguidas para recuperar: -");
    setText(resultMaxPossible, "Maximo posible: -");
    updateResultColors(null);
    setCopyEnabled(false);
  }

  function updateResultColors(result) {
    const statusClasses = ["text-white", "text-emerald-300", "text-amber-300", "text-red-300"];

    [resultAction, resultPercent, resultStatus, resultAvailable].forEach((element) => {
      element?.classList.remove(...statusClasses);
      element?.classList.add("text-white");
    });

    if (!result) {
      return;
    }

    const color =
      result.viability === "cumple"
        ? "text-emerald-300"
        : result.viability === "recuperable"
          ? "text-amber-300"
          : "text-red-300";

    resultAction?.classList.remove("text-white");
    resultStatus?.classList.remove("text-white");
    resultAvailable?.classList.remove("text-white");
    resultAction?.classList.add(color);
    resultStatus?.classList.add(color);
    resultAvailable?.classList.add(
      result.availableAbsences < 0 ? "text-red-300" : color,
    );
  }

  function formatRecovery(result) {
    if (result.consecutiveClassesToRecover === 0) {
      return "0";
    }

    if (result.recoverySearchLimitExceeded) {
      return ">1000";
    }

    if (result.consecutiveClassesToRecover === null) {
      return "No posible";
    }

    return formatAttendanceCount(result.consecutiveClassesToRecover);
  }

  function setMode(nextMode) {
    const normalizedMode = nextMode === "absences" ? "absences" : "attended";

    if (mode === normalizedMode) {
      return;
    }

    inferAlternateField(normalizedMode);
    mode = normalizedMode;
    updateCalculator();
  }

  function updateModeUi() {
    modeButtons.forEach((button) => {
      const isActive = button.dataset.modeButton === mode;
      button.setAttribute("aria-pressed", String(isActive));
      button.classList.toggle("bg-amber-400", isActive);
      button.classList.toggle("text-gray-950", isActive);
      button.classList.toggle("text-gray-300", !isActive);
      button.classList.toggle("hover:bg-gray-800", !isActive);
    });

    attendedWrapper?.classList.toggle("hidden", mode !== "attended");
    absencesWrapper?.classList.toggle("hidden", mode !== "absences");
  }

  function inferAlternateField(nextMode) {
    const totalParsed = parseAttendanceInteger(getFieldValue("totalClasses"), {
      allowZero: false,
      max: 1000,
    });

    if (!totalParsed.ok) {
      return;
    }

    if (nextMode === "absences") {
      const attendedParsed = parseAttendanceInteger(getFieldValue("attendedClasses"), {
        allowZero: true,
        max: totalParsed.value,
      });

      if (attendedParsed.ok) {
        setFieldValue("absences", String(totalParsed.value - attendedParsed.value));
      }
      return;
    }

    const absencesParsed = parseAttendanceInteger(getFieldValue("absences"), {
      allowZero: true,
      max: totalParsed.value,
    });

    if (absencesParsed.ok) {
      setFieldValue("attendedClasses", String(totalParsed.value - absencesParsed.value));
    }
  }

  function syncAlternateField(result) {
    if (mode === "attended") {
      setFieldValue("absences", String(result.currentAbsences));
      return;
    }

    setFieldValue("attendedClasses", String(result.attendedClasses));
  }

  function loadExample(exampleId) {
    const example = ATTENDANCE_EXAMPLES.find((item) => item.id === exampleId);

    if (!example) {
      return;
    }

    mode = example.values.mode;
    setFieldValue("totalClasses", example.values.totalClasses);
    setFieldValue("attendedClasses", example.values.attendedClasses);
    setFieldValue("absences", example.values.absences);
    setFieldValue("requiredPercent", example.values.requiredPercent);
    setFieldValue("remainingClasses", example.values.remainingClasses);
    markFieldsTouched();
    updateCalculator();
  }

  function clearCalculator() {
    mode = "attended";
    setFieldValue("totalClasses", "");
    setFieldValue("attendedClasses", "");
    setFieldValue("absences", "");
    setFieldValue("requiredPercent", "80");
    setFieldValue("remainingClasses", "0");

    document.querySelectorAll("[data-field]").forEach((input) => {
      delete input.dataset.touched;
    });

    clearErrors();
    updateCalculator();
  }

  async function copySummary() {
    if (!currentSummary) {
      setStatus("No hay resumen para copiar.");
      return;
    }

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(currentSummary);
      } else {
        const textArea = document.createElement("textarea");
        textArea.value = currentSummary;
        textArea.setAttribute("readonly", "");
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.append(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
      }

      setStatus("Resumen copiado.");
    } catch {
      setStatus("No se pudo copiar.");
    }
  }

  function setCopyEnabled(isEnabled) {
    copyButton?.toggleAttribute("disabled", !isEnabled);
    copyButton?.classList.toggle("opacity-50", !isEnabled);
    copyButton?.classList.toggle("cursor-not-allowed", !isEnabled);
  }

  function markFieldsTouched() {
    document.querySelectorAll("[data-field]").forEach((input) => {
      input.dataset.touched = "true";
    });
  }

  function clearErrors() {
    document.querySelectorAll("[data-error-for]").forEach((errorElement) => {
      errorElement.textContent = "";
      errorElement.classList.add("hidden");
    });
  }

  function setFieldError(field, message, shouldShow = true) {
    const error = document.querySelector(`[data-error-for="${field}"]`);

    if (!error || !shouldShow) {
      return;
    }

    error.textContent = message;
    error.classList.remove("hidden");
  }

  function shouldShowError(input) {
    return input?.dataset.touched === "true";
  }

  function setText(element, value) {
    if (element) {
      element.textContent = value ?? "-";
    }
  }

  function setStatus(message) {
    setText(actionStatus, message);
    window.clearTimeout(statusTimeout);
    statusTimeout = window.setTimeout(() => setText(actionStatus, ""), 2500);
  }

  document.querySelectorAll("[data-field]").forEach((input) => {
    input.addEventListener("input", () => {
      input.dataset.touched = "true";
      updateCalculator();
    });
    input.addEventListener("change", () => {
      input.dataset.touched = "true";
      updateCalculator();
    });
    input.addEventListener("blur", () => {
      input.dataset.touched = "true";
      updateCalculator();
    });
  });

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => setMode(button.dataset.modeButton));
  });
  exampleButtons.forEach((button) => {
    button.addEventListener("click", () => loadExample(button.dataset.exampleId));
  });
  copyButton?.addEventListener("click", copySummary);
  clearButton?.addEventListener("click", clearCalculator);

  updateCalculator();
</script>
