---
import PercentageCalculatorPage from "@components/calculators/PercentageCalculatorPage.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";

const canonical = "/matematicas/calculadora-de-porcentajes";
const englishCanonical = "/en/math/percentage-calculator";
const alternates = buildAlternateLinks(
  { es: canonical, en: englishCanonical },
  Astro.site ?? Astro.url,
);
---

<PercentageCalculatorPage
  locale="es"
  canonical={canonical}
  alternates={alternates}
/>
