---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Calculadora de Porcentajes Online — Rápida y Gratis";
const description =
  "Calcula porcentajes al instante: descuentos, aumentos, IVA y más. Sin registro y con resultado en tiempo real.";
const canonical = "/matematicas/calculadora-de-porcentajes/";

const faqs = [
  {
    question: "¿Cómo se calcula el porcentaje de un número?",
    answer:
      "Multiplica el número base por el porcentaje dividido entre 100. Por ejemplo, el 20% de 350 se calcula como 350 × 0.20 = 70.",
    relatedHref: "/blog/como-calcular-porcentajes",
    relatedLabel: "Ver la guía para calcular porcentajes",
  },
  {
    question: "¿Cómo saber qué porcentaje representa una cantidad?",
    answer:
      "Divide la cantidad parcial entre el total y multiplica el resultado por 100. Por ejemplo, 45 de 200 es (45 / 200) × 100 = 22.5%.",
  },
  {
    question: "¿Cómo calcular el porcentaje de aumento entre dos valores?",
    answer:
      "Resta el valor original al valor nuevo, divide entre el valor original y multiplica por 100. Si el resultado es negativo, se trata de una disminución.",
    relatedHref: "/blog/aumento-porcentual",
    relatedLabel: "Entender el aumento porcentual",
  },
  {
    question: "¿Cómo calcular un descuento?",
    answer:
      "Multiplica el precio base por el porcentaje de descuento dividido entre 100. Después resta ese descuento al precio base.",
    relatedHref: "/blog/porcentaje-de-descuento",
    relatedLabel: "Ver cómo calcular descuentos",
  },
  {
    question: "¿Qué fórmula se usa para sacar el porcentaje?",
    answer:
      "La fórmula general es parte / total × 100. Para obtener un porcentaje de un número, usa porcentaje / 100 × número.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);

const examples = [
  {
    title: "Descuentos",
    text: "Calcula cuánto pagas después de aplicar una promoción.",
    href: "/blog/porcentaje-de-descuento",
    cta: "Aprender a calcular descuentos",
  },
  {
    title: "Aumentos",
    text: "Compara un valor inicial y final para saber cuánto creció.",
    href: "/blog/aumento-porcentual",
    cta: "Entender el aumento porcentual",
  },
  {
    title: "IVA",
    text: "Suma un porcentaje a una cantidad base para estimar totales.",
  },
  {
    title: "Calificaciones",
    text: "Encuentra qué porcentaje representa un resultado parcial.",
    href: "/blog/como-calcular-porcentajes",
    cta: "Ver ejemplos de porcentajes",
  },
];

const relatedGuides = [
  {
    href: "/blog/como-calcular-porcentajes",
    title: "Cómo calcular porcentajes sin complicarte",
    description:
      "Repasa la fórmula base para calcular porcentajes, partes de un total y variaciones.",
  },
  {
    href: "/blog/porcentaje-de-descuento",
    title: "Cómo calcular un descuento",
    description:
      "Aprende a pasar de porcentaje de descuento a ahorro real y precio final.",
  },
  {
    href: "/blog/aumento-porcentual",
    title: "Qué es el aumento porcentual",
    description:
      "Compara dos valores y entiende cuánto cambió una cantidad respecto a su punto de partida.",
  },
];

const commonPercentages = [
  { percent: "10%", of100: "$10", of500: "$50", of1200: "$120" },
  { percent: "15%", of100: "$15", of500: "$75", of1200: "$180" },
  { percent: "20%", of100: "$20", of500: "$100", of1200: "$240" },
  { percent: "25%", of100: "$25", of500: "$125", of1200: "$300" },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Calculadora de porcentajes"
      description="Calcula porcentajes, descuentos, aumentos y cambios entre valores con resultados claros al instante."
      kicker="Matemáticas"
      collapseBreadcrumbOnMobile
      containerClass="py-6 md:py-8"
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Matemáticas", href: "/matematicas", optional: true },
        { label: "Calculadora de porcentajes", truncate: true },
      ]}
    />

    <Container as="section" class="py-6 md:py-8">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <section
          id="percentage-calculator"
          class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
          aria-labelledby="calculator-heading"
        >
          <div class="border-b border-gray-700 p-2">
            <div
              class="flex gap-2 overflow-x-auto"
              role="tablist"
              aria-label="Tipos de cálculo de porcentaje"
            >
              <button
                id="tab-percentageOfNumber"
                class="min-h-11 shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls="panel-percentageOfNumber"
                data-tab="percentageOfNumber"
              >
                % de número
              </button>
              <button
                id="tab-whatPercentIs"
                class="min-h-11 shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="panel-whatPercentIs"
                data-tab="whatPercentIs"
                tabindex="-1"
              >
                X de Y
              </button>
              <button
                id="tab-percentChange"
                class="min-h-11 shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="panel-percentChange"
                data-tab="percentChange"
                tabindex="-1"
              >
                Cambio %
              </button>
              <button
                id="tab-addPercent"
                class="min-h-11 shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="panel-addPercent"
                data-tab="addPercent"
                tabindex="-1"
              >
                Sumar %
              </button>
              <button
                id="tab-subtractPercent"
                class="min-h-11 shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="panel-subtractPercent"
                data-tab="subtractPercent"
                tabindex="-1"
              >
                Restar %
              </button>
            </div>
          </div>

          <div
            class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_minmax(17rem,0.78fr)]"
          >
            <div class="p-4 sm:p-6">
              <h2 id="calculator-heading" class="sr-only">
                Calculadora interactiva de porcentajes
              </h2>

              <div
                id="panel-percentageOfNumber"
                role="tabpanel"
                aria-labelledby="tab-percentageOfNumber"
                data-panel="percentageOfNumber"
              >
                <div class="mb-5">
                  <h3 class="text-xl font-semibold">
                    ¿Cuánto es X% de un número?
                  </h3>
                  <p class="mt-2 text-sm text-gray-400">Ejemplo: 20% de 350.</p>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label
                      for="percentageOfNumber-percent"
                      class="block text-sm font-medium text-gray-200"
                    >
                      Porcentaje
                    </label>
                    <div
                      class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    >
                      <input
                        id="percentageOfNumber-percent"
                        class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="20"
                        aria-describedby="percentageOfNumber-percent-error"
                        data-input="percent"
                      />
                      <span class="flex items-center px-4 text-gray-500">%</span
                      >
                    </div>
                    <p
                      id="percentageOfNumber-percent-error"
                      class="mt-2 hidden text-sm text-red-300"
                      data-error-for="percent"
                    >
                    </p>
                  </div>

                  <div>
                    <label
                      for="percentageOfNumber-base"
                      class="block text-sm font-medium text-gray-200"
                    >
                      Número base
                    </label>
                    <input
                      id="percentageOfNumber-base"
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="350"
                      aria-describedby="percentageOfNumber-base-error"
                      data-input="base"
                    />
                    <p
                      id="percentageOfNumber-base-error"
                      class="mt-2 hidden text-sm text-red-300"
                      data-error-for="base"
                    >
                    </p>
                  </div>
                </div>
              </div>

              <div
                id="panel-whatPercentIs"
                role="tabpanel"
                aria-labelledby="tab-whatPercentIs"
                data-panel="whatPercentIs"
                hidden
              >
                <div class="mb-5">
                  <h3 class="text-xl font-semibold">
                    ¿Qué porcentaje es X de Y?
                  </h3>
                  <p class="mt-2 text-sm text-gray-400">Ejemplo: 45 de 200.</p>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label
                      for="whatPercentIs-partial"
                      class="block text-sm font-medium text-gray-200"
                    >
                      Valor parcial
                    </label>
                    <input
                      id="whatPercentIs-partial"
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="45"
                      aria-describedby="whatPercentIs-partial-error"
                      data-input="partial"
                    />
                    <p
                      id="whatPercentIs-partial-error"
                      class="mt-2 hidden text-sm text-red-300"
                      data-error-for="partial"
                    >
                    </p>
                  </div>

                  <div>
                    <label
                      for="whatPercentIs-total"
                      class="block text-sm font-medium text-gray-200"
                    >
                      Valor total
                    </label>
                    <input
                      id="whatPercentIs-total"
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="200"
                      aria-describedby="whatPercentIs-total-error"
                      data-input="total"
                    />
                    <p
                      id="whatPercentIs-total-error"
                      class="mt-2 hidden text-sm text-red-300"
                      data-error-for="total"
                    >
                    </p>
                  </div>
                </div>
              </div>

              <div
                id="panel-percentChange"
                role="tabpanel"
                aria-labelledby="tab-percentChange"
                data-panel="percentChange"
                hidden
              >
                <div
                  class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"
                >
                  <div>
                    <h3 class="text-xl font-semibold">
                      Cambio porcentual entre dos valores
                    </h3>
                    <p class="mt-2 text-sm text-gray-400">
                      Ejemplo: de 80 a 100.
                    </p>
                  </div>

                  <button
                    class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                    type="button"
                    data-swap
                  >
                    Intercambiar
                  </button>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label
                      for="percentChange-original"
                      class="block text-sm font-medium text-gray-200"
                    >
                      Valor original
                    </label>
                    <input
                      id="percentChange-original"
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="80"
                      aria-describedby="percentChange-original-error"
                      data-input="original"
                    />
                    <p
                      id="percentChange-original-error"
                      class="mt-2 hidden text-sm text-red-300"
                      data-error-for="original"
                    >
                    </p>
                  </div>

                  <div>
                    <label
                      for="percentChange-next"
                      class="block text-sm font-medium text-gray-200"
                    >
                      Valor nuevo
                    </label>
                    <input
                      id="percentChange-next"
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="100"
                      aria-describedby="percentChange-next-error"
                      data-input="next"
                    />
                    <p
                      id="percentChange-next-error"
                      class="mt-2 hidden text-sm text-red-300"
                      data-error-for="next"
                    >
                    </p>
                  </div>
                </div>
              </div>

              <div
                id="panel-addPercent"
                role="tabpanel"
                aria-labelledby="tab-addPercent"
                data-panel="addPercent"
                hidden
              >
                <div class="mb-5">
                  <h3 class="text-xl font-semibold">
                    Sumar un porcentaje a un número
                  </h3>
                  <p class="mt-2 text-sm text-gray-400">Ejemplo: 500 + 16%.</p>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label
                      for="addPercent-base"
                      class="block text-sm font-medium text-gray-200"
                    >
                      Número base
                    </label>
                    <input
                      id="addPercent-base"
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="500"
                      aria-describedby="addPercent-base-error"
                      data-input="base"
                    />
                    <p
                      id="addPercent-base-error"
                      class="mt-2 hidden text-sm text-red-300"
                      data-error-for="base"
                    >
                    </p>
                  </div>

                  <div>
                    <label
                      for="addPercent-percent"
                      class="block text-sm font-medium text-gray-200"
                    >
                      Porcentaje a sumar
                    </label>
                    <div
                      class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    >
                      <input
                        id="addPercent-percent"
                        class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="16"
                        aria-describedby="addPercent-percent-error"
                        data-input="percent"
                      />
                      <span class="flex items-center px-4 text-gray-500">%</span
                      >
                    </div>
                    <p
                      id="addPercent-percent-error"
                      class="mt-2 hidden text-sm text-red-300"
                      data-error-for="percent"
                    >
                    </p>
                  </div>
                </div>
              </div>

              <div
                id="panel-subtractPercent"
                role="tabpanel"
                aria-labelledby="tab-subtractPercent"
                data-panel="subtractPercent"
                hidden
              >
                <div class="mb-5">
                  <h3 class="text-xl font-semibold">
                    Restar un porcentaje a un número
                  </h3>
                  <p class="mt-2 text-sm text-gray-400">
                    Ejemplo: 1,200 con 30% de descuento.
                  </p>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label
                      for="subtractPercent-base"
                      class="block text-sm font-medium text-gray-200"
                    >
                      Número base
                    </label>
                    <input
                      id="subtractPercent-base"
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="1200"
                      aria-describedby="subtractPercent-base-error"
                      data-input="base"
                    />
                    <p
                      id="subtractPercent-base-error"
                      class="mt-2 hidden text-sm text-red-300"
                      data-error-for="base"
                    >
                    </p>
                  </div>

                  <div>
                    <label
                      for="subtractPercent-percent"
                      class="block text-sm font-medium text-gray-200"
                    >
                      Porcentaje a restar
                    </label>
                    <div
                      class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                    >
                      <input
                        id="subtractPercent-percent"
                        class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="30"
                        aria-describedby="subtractPercent-percent-error"
                        data-input="percent"
                      />
                      <span class="flex items-center px-4 text-gray-500">%</span
                      >
                    </div>
                    <p
                      id="subtractPercent-percent-error"
                      class="mt-2 hidden text-sm text-red-300"
                      data-error-for="percent"
                    >
                    </p>
                  </div>
                </div>
              </div>

              <div class="mt-6 flex flex-wrap gap-3">
                <button
                  class="inline-flex min-h-11 items-center justify-center rounded-lg bg-amber-400 px-5 py-2 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  data-clear-active
                >
                  Limpiar
                </button>
              </div>
            </div>

            <aside
              class="border-t border-gray-700 bg-gray-900/80 p-4 sm:p-6 lg:border-l lg:border-t-0"
            >
              <div
                class="min-h-[15rem]"
                aria-live="polite"
                aria-atomic="true"
                data-result-region
              >
                <p class="text-sm font-semibold text-gray-400">Resultado</p>
                <p
                  class="mt-4 break-words text-3xl font-bold leading-tight text-white"
                  data-main-result
                >
                  Ingresa los valores
                </p>
                <div
                  class="mt-4 space-y-2 text-sm text-gray-300"
                  data-secondary-result
                >
                </div>
                <p
                  class="mt-5 border-t border-gray-700 pt-4 text-sm leading-relaxed text-gray-400"
                  data-explanation
                >
                  El cálculo aparecerá aquí.
                </p>
                <button
                  class="mt-5 hidden min-h-11 w-full items-center justify-center gap-2 rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  aria-label="Copiar resultado"
                  data-copy-result
                >
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M8 8.5A2.5 2.5 0 0 1 10.5 6H18a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7.5A2.5 2.5 0 0 1 8 17.5v-9Z"
                      stroke="currentColor"
                      stroke-width="1.7"></path>
                    <path
                      d="M6 16H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"></path>
                  </svg>
                  <span data-copy-label>Copiar resultado</span>
                </button>
                <p class="sr-only" aria-live="polite" data-copy-status></p>
              </div>
            </aside>
          </div>
        </section>

        <aside class="rounded-lg border border-gray-700 bg-gray-950 p-4 sm:p-5">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg font-semibold">Historial</h2>
            <button
              class="min-h-11 rounded-lg border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-300 transition hover:border-red-300 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-red-400/30"
              type="button"
              data-clear-history
            >
              Limpiar
            </button>
          </div>

          <p class="mt-4 text-sm text-gray-500" data-history-empty>
            Los últimos cálculos aparecerán aquí.
          </p>

          <ol class="mt-4 space-y-3" data-history-list></ol>
        </aside>
      </div>
    </Container>

    <Container as="section" class="py-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          examples.map((example) => (
            <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
              <h2 class="text-lg font-semibold">{example.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-gray-400">
                {example.text}
              </p>
              {example.href && example.cta && (
                <a
                  href={example.href}
                  class="mt-4 inline-flex text-sm font-semibold text-amber-400 transition hover:text-amber-300 hover:underline"
                >
                  {example.cta}
                </a>
              )}
            </article>
          ))
        }
      </div>
    </Container>

    <Container as="section" class="py-8">
      <SectionIntro
        title="Guías relacionadas"
        description="Profundiza en los casos más comunes antes o después de usar la calculadora."
        class="mb-5"
      />

      <div class="grid gap-5 md:grid-cols-3">
        {
          relatedGuides.map((guide) => (
            <a
              href={guide.href}
              class="group rounded-lg border border-gray-700 bg-gray-950 p-5 transition hover:border-amber-400"
            >
              <h3 class="text-lg font-semibold group-hover:text-white">
                {guide.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-gray-400">
                {guide.description}
              </p>
              <span class="mt-4 inline-block text-sm font-semibold text-amber-400 group-hover:underline">
                Leer guía
              </span>
            </a>
          ))
        }
      </div>
    </Container>

    <Container as="section" class="py-8">
      <SectionIntro
        title="Porcentajes comunes"
        description="Referencias rápidas para cantidades habituales."
        class="mb-5"
      />

      <div class="overflow-x-auto rounded-lg border border-gray-700">
        <table
          class="min-w-full divide-y divide-gray-700 bg-gray-950 text-left text-sm"
        >
          <thead class="bg-gray-900 text-gray-300">
            <tr>
              <th class="px-4 py-3 font-semibold" scope="col">Porcentaje</th>
              <th class="px-4 py-3 font-semibold" scope="col">De $100</th>
              <th class="px-4 py-3 font-semibold" scope="col">De $500</th>
              <th class="px-4 py-3 font-semibold" scope="col">De $1,200</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800 text-gray-300">
            {
              commonPercentages.map((row) => (
                <tr>
                  <th class="px-4 py-3 font-semibold text-white" scope="row">
                    {row.percent}
                  </th>
                  <td class="px-4 py-3">{row.of100}</td>
                  <td class="px-4 py-3">{row.of500}</td>
                  <td class="px-4 py-3">{row.of1200}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<script>
  import {
    calculateAddPercent,
    calculatePercentChange,
    calculatePercentageOfNumber,
    calculateSubtractPercent,
    calculateWhatPercentIs,
    formatCurrency,
    formatNumber,
    formatPercent,
    parseNumericInput,
  } from "@lib/calculators/matematicas/calculadora-de-porcentajes/percentage";

  const MODES = [
    "percentageOfNumber",
    "whatPercentIs",
    "percentChange",
    "addPercent",
    "subtractPercent",
  ];

  const MODE_LABELS = {
    percentageOfNumber: "% de número",
    whatPercentIs: "X de Y",
    percentChange: "Cambio %",
    addPercent: "Sumar %",
    subtractPercent: "Restar %",
  };

  const REQUIRED_FIELDS = {
    percentageOfNumber: ["percent", "base"],
    whatPercentIs: ["partial", "total"],
    percentChange: ["original", "next"],
    addPercent: ["base", "percent"],
    subtractPercent: ["base", "percent"],
  };

  const ERROR_MESSAGES = {
    required: "Este campo es obligatorio.",
    invalid: "Ingresa un número válido.",
    negative: "Ingresa un número igual o mayor a cero.",
    too_many_decimals: "Usa máximo 2 decimales.",
  };

  const HISTORY_KEY = "percentage-calculator-history";
  const HISTORY_LIMIT = 10;
  const HISTORY_DEBOUNCE_MS = 800;

  const tabs = Array.from(document.querySelectorAll("[data-tab]"));
  const panels = Array.from(document.querySelectorAll("[data-panel]"));
  const resultRegion = document.querySelector("[data-result-region]");
  const mainResult = document.querySelector("[data-main-result]");
  const secondaryResult = document.querySelector("[data-secondary-result]");
  const explanation = document.querySelector("[data-explanation]");
  const copyButton = document.querySelector("[data-copy-result]");
  const copyLabel = document.querySelector("[data-copy-label]");
  const copyStatus = document.querySelector("[data-copy-status]");
  const historyList = document.querySelector("[data-history-list]");
  const historyEmpty = document.querySelector("[data-history-empty]");
  const clearHistoryButton = document.querySelector("[data-clear-history]");
  const clearActiveButton = document.querySelector("[data-clear-active]");
  const swapButton = document.querySelector("[data-swap]");

  let activeMode = "percentageOfNumber";
  let currentCopyText = "";
  let currentHistoryEntry = null;
  let historyDebounce = 0;
  let copiedTimeout = 0;

  const getActivePanel = () =>
    document.querySelector(`[data-panel="${activeMode}"]`);

  const getModeInputs = (mode = activeMode) =>
    Array.from(
      document.querySelectorAll(`[data-panel="${mode}"] [data-input]`),
    );

  const getFieldInput = (field, mode = activeMode) =>
    document.querySelector(`[data-panel="${mode}"] [data-input="${field}"]`);

  function setActiveMode(mode, shouldFocus = false) {
    activeMode = mode;

    tabs.forEach((tab) => {
      const isActive = tab.dataset.tab === mode;
      tab.setAttribute("aria-selected", String(isActive));
      tab.setAttribute("tabindex", isActive ? "0" : "-1");
      tab.classList.toggle("bg-amber-400", isActive);
      tab.classList.toggle("text-gray-950", isActive);
      tab.classList.toggle("text-gray-300", !isActive);
      tab.classList.toggle("hover:bg-gray-800", !isActive);

      if (isActive && shouldFocus) {
        tab.focus();
      }
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.panel !== mode;
    });

    updateCalculator();
  }

  function parseModeValues(mode) {
    const values = {};
    const errors = {};
    const inputs = getModeInputs(mode);

    inputs.forEach((input) => {
      const field = input.dataset.input;
      const parsed = parseNumericInput(input.value);

      if (parsed.ok) {
        values[field] = parsed.value;
        return;
      }

      errors[field] = parsed.error;
    });

    return { values, errors };
  }

  function clearErrors(mode = activeMode) {
    document
      .querySelectorAll(`[data-panel="${mode}"] [data-error-for]`)
      .forEach((errorElement) => {
        errorElement.textContent = "";
        errorElement.classList.add("hidden");
      });
  }

  function showErrors(errors, mode = activeMode) {
    clearErrors(mode);

    Object.entries(errors).forEach(([field, error]) => {
      const errorElement = document.querySelector(
        `[data-panel="${mode}"] [data-error-for="${field}"]`,
      );

      if (!errorElement) {
        return;
      }

      errorElement.textContent =
        ERROR_MESSAGES[error] ?? ERROR_MESSAGES.invalid;
      errorElement.classList.remove("hidden");
    });
  }

  function hasTouchedInputs(mode = activeMode) {
    return getModeInputs(mode).some(
      (input) => input.dataset.touched === "true",
    );
  }

  function hasAnyValue(mode = activeMode) {
    return getModeInputs(mode).some((input) => input.value.trim() !== "");
  }

  function getValidationErrors(mode, errors, values) {
    const modeErrors = { ...errors };

    if (mode === "whatPercentIs" && values.total === 0) {
      modeErrors.total = "zero_total";
    }

    if (mode === "percentChange" && values.original === 0) {
      modeErrors.original = "zero_original";
    }

    return modeErrors;
  }

  function getErrorMessage(error) {
    if (error === "zero_total") {
      return "El valor total no puede ser cero.";
    }

    if (error === "zero_original") {
      return "El valor original no puede ser cero.";
    }

    return ERROR_MESSAGES[error] ?? ERROR_MESSAGES.invalid;
  }

  function showSpecificErrors(errors, mode = activeMode) {
    clearErrors(mode);

    Object.entries(errors).forEach(([field, error]) => {
      const errorElement = document.querySelector(
        `[data-panel="${mode}"] [data-error-for="${field}"]`,
      );

      if (!errorElement) {
        return;
      }

      errorElement.textContent = getErrorMessage(error);
      errorElement.classList.remove("hidden");
    });
  }

  function computeResult(mode, values) {
    if (mode === "percentageOfNumber") {
      const result = calculatePercentageOfNumber(values.percent, values.base);

      return {
        main: `El ${formatPercent(values.percent)} de ${formatNumber(values.base)} es ${formatNumber(result)}`,
        copy: formatNumber(result),
        secondary: [],
        explanation: `${formatNumber(values.base)} * ${formatNumber(values.percent / 100)} = ${formatNumber(result)}`,
        tone: "neutral",
      };
    }

    if (mode === "whatPercentIs") {
      const result = calculateWhatPercentIs(values.partial, values.total);

      return {
        main: `${formatNumber(values.partial)} es el ${formatPercent(result)} de ${formatNumber(values.total)}`,
        copy: formatPercent(result),
        secondary: [],
        explanation: `(${formatNumber(values.partial)} / ${formatNumber(values.total)}) * 100 = ${formatPercent(result)}`,
        tone: "neutral",
      };
    }

    if (mode === "percentChange") {
      const result = calculatePercentChange(values.original, values.next);
      const absoluteChange = Math.abs(result.change);
      const formattedChange = formatPercent(absoluteChange);
      const directionText =
        result.direction === "increase"
          ? `Aumentó ${formattedChange}`
          : result.direction === "decrease"
            ? `Disminuyó ${formattedChange}`
            : "No hubo cambio: 0%";

      return {
        main: directionText,
        copy: directionText,
        secondary: [
          `Diferencia: ${formatNumber(values.next - values.original)}`,
        ],
        explanation: `((${formatNumber(values.next)} - ${formatNumber(values.original)}) / ${formatNumber(values.original)}) * 100 = ${formatPercent(result.change)}`,
        tone:
          result.direction === "increase"
            ? "positive"
            : result.direction === "decrease"
              ? "negative"
              : "neutral",
      };
    }

    if (mode === "addPercent") {
      const result = calculateAddPercent(values.base, values.percent);

      return {
        main: `Total con porcentaje: ${formatCurrency(result.total)}`,
        copy: formatCurrency(result.total),
        secondary: [`Incremento: ${formatCurrency(result.increment)}`],
        explanation: `${formatNumber(values.base)} * ${formatNumber(values.percent / 100)} = ${formatNumber(result.increment)}; ${formatNumber(values.base)} + ${formatNumber(result.increment)} = ${formatNumber(result.total)}`,
        tone: "positive",
      };
    }

    const result = calculateSubtractPercent(values.base, values.percent);

    return {
      main: `Precio final: ${formatCurrency(result.total)}`,
      copy: formatCurrency(result.total),
      secondary: [`Descuento: ${formatCurrency(result.discount)}`],
      explanation: `${formatNumber(values.base)} * ${formatNumber(values.percent / 100)} = ${formatNumber(result.discount)}; ${formatNumber(values.base)} - ${formatNumber(result.discount)} = ${formatNumber(result.total)}`,
      tone: result.total < 0 ? "negative" : "neutral",
    };
  }

  function setResultState(state, result = null) {
    if (!mainResult || !secondaryResult || !explanation || !copyButton) {
      return;
    }

    mainResult.classList.remove(
      "text-emerald-300",
      "text-red-300",
      "text-white",
    );
    resultRegion?.classList.remove("text-red-300");

    if (state === "initial") {
      mainResult.textContent = "Ingresa los valores";
      mainResult.classList.add("text-white");
      secondaryResult.innerHTML = "";
      explanation.textContent = "El cálculo aparecerá aquí.";
      copyButton.classList.add("hidden");
      copyButton.classList.remove("inline-flex");
      currentCopyText = "";
      currentHistoryEntry = null;
      return;
    }

    if (state === "invalid") {
      mainResult.textContent = "Revisa los campos";
      mainResult.classList.add("text-red-300");
      secondaryResult.innerHTML = "";
      explanation.textContent = "Corrige el valor marcado para continuar.";
      copyButton.classList.add("hidden");
      copyButton.classList.remove("inline-flex");
      currentCopyText = "";
      currentHistoryEntry = null;
      return;
    }

    if (!result) {
      return;
    }

    mainResult.textContent = result.main;
    mainResult.classList.add(
      result.tone === "positive"
        ? "text-emerald-300"
        : result.tone === "negative"
          ? "text-red-300"
          : "text-white",
    );

    secondaryResult.innerHTML = result.secondary
      .map((item) => `<p>${escapeHtml(item)}</p>`)
      .join("");
    explanation.textContent = result.explanation;
    copyButton.classList.remove("hidden");
    copyButton.classList.add("inline-flex");
    currentCopyText = result.copy;
  }

  function updateCalculator() {
    window.clearTimeout(historyDebounce);

    const { values, errors } = parseModeValues(activeMode);
    const requiredFields = REQUIRED_FIELDS[activeMode];
    const missingFields = requiredFields.filter(
      (field) => errors[field] === "required",
    );
    const hasOnlyMissingErrors =
      Object.keys(errors).length > 0 &&
      Object.keys(errors).every((field) => errors[field] === "required");

    if (!hasAnyValue(activeMode)) {
      clearErrors(activeMode);
      setResultState("initial");
      return;
    }

    if (missingFields.length > 0 && hasOnlyMissingErrors) {
      if (hasTouchedInputs(activeMode)) {
        showErrors(errors, activeMode);
      }
      setResultState("initial");
      return;
    }

    const validationErrors = getValidationErrors(activeMode, errors, values);

    if (Object.keys(validationErrors).length > 0) {
      showSpecificErrors(validationErrors, activeMode);
      setResultState("invalid");
      return;
    }

    clearErrors(activeMode);
    const result = computeResult(activeMode, values);
    setResultState("valid", result);

    currentHistoryEntry = {
      id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
      mode: activeMode,
      modeLabel: MODE_LABELS[activeMode],
      values,
      result: result.copy,
      summary: result.main,
      createdAt: new Date().toLocaleTimeString("es-MX", {
        hour: "2-digit",
        minute: "2-digit",
      }),
    };

    historyDebounce = window.setTimeout(() => {
      if (currentHistoryEntry) {
        saveHistoryEntry(currentHistoryEntry);
      }
    }, HISTORY_DEBOUNCE_MS);
  }

  function loadHistory() {
    try {
      const rawHistory = sessionStorage.getItem(HISTORY_KEY);
      return rawHistory ? JSON.parse(rawHistory) : [];
    } catch {
      return [];
    }
  }

  function writeHistory(history) {
    sessionStorage.setItem(HISTORY_KEY, JSON.stringify(history));
    renderHistory(history);
  }

  function saveHistoryEntry(entry) {
    const history = loadHistory();
    const previous = history[0];

    if (
      previous &&
      previous.mode === entry.mode &&
      JSON.stringify(previous.values) === JSON.stringify(entry.values)
    ) {
      return;
    }

    writeHistory([entry, ...history].slice(0, HISTORY_LIMIT));
  }

  function renderHistory(history = loadHistory()) {
    if (!historyList || !historyEmpty) {
      return;
    }

    historyEmpty.classList.toggle("hidden", history.length > 0);
    historyList.innerHTML = "";

    history.forEach((item) => {
      const listItem = document.createElement("li");
      const button = document.createElement("button");
      button.type = "button";
      button.className =
        "w-full rounded-lg border border-gray-800 bg-gray-900 p-3 text-left transition hover:border-amber-400 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/30";
      button.dataset.historyId = item.id;
      button.innerHTML = `
        <span class="block text-xs font-semibold uppercase tracking-wide text-amber-400">${escapeHtml(item.modeLabel)} · ${escapeHtml(item.createdAt)}</span>
        <span class="mt-2 block break-words text-sm font-semibold text-white">${escapeHtml(item.result)}</span>
        <span class="mt-1 block break-words text-xs leading-relaxed text-gray-500">${escapeHtml(item.summary)}</span>
      `;
      listItem.append(button);
      historyList.append(listItem);
    });
  }

  function restoreHistoryItem(id) {
    const item = loadHistory().find((historyItem) => historyItem.id === id);

    if (!item) {
      return;
    }

    setActiveMode(item.mode);

    Object.entries(item.values).forEach(([field, value]) => {
      const input = getFieldInput(field, item.mode);

      if (input) {
        input.value = String(value);
        input.dataset.touched = "true";
      }
    });

    updateCalculator();
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function clearActiveMode() {
    getModeInputs(activeMode).forEach((input) => {
      input.value = "";
      delete input.dataset.touched;
    });
    clearErrors(activeMode);
    setResultState("initial");
  }

  async function copyResult() {
    if (!currentCopyText || !copyLabel || !copyStatus) {
      return;
    }

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(currentCopyText);
      } else {
        const textArea = document.createElement("textarea");
        textArea.value = currentCopyText;
        textArea.setAttribute("readonly", "");
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.append(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
      }

      window.clearTimeout(copiedTimeout);
      copyLabel.textContent = "Copiado";
      copyStatus.textContent = "Resultado copiado.";
      copiedTimeout = window.setTimeout(() => {
        copyLabel.textContent = "Copiar resultado";
        copyStatus.textContent = "";
      }, 2000);
    } catch {
      copyStatus.textContent = "No se pudo copiar el resultado.";
    }
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      setActiveMode(tab.dataset.tab);
    });

    tab.addEventListener("keydown", (event) => {
      const key = event.key;
      let nextIndex = index;

      if (key === "ArrowRight" || key === "ArrowDown") {
        nextIndex = (index + 1) % tabs.length;
      } else if (key === "ArrowLeft" || key === "ArrowUp") {
        nextIndex = (index - 1 + tabs.length) % tabs.length;
      } else if (key === "Home") {
        nextIndex = 0;
      } else if (key === "End") {
        nextIndex = tabs.length - 1;
      } else {
        return;
      }

      event.preventDefault();
      setActiveMode(tabs[nextIndex].dataset.tab, true);
    });
  });

  document.querySelectorAll("[data-input]").forEach((input) => {
    input.addEventListener("input", () => {
      input.dataset.touched = "true";
      updateCalculator();
    });

    input.addEventListener("blur", () => {
      input.dataset.touched = "true";
      updateCalculator();
    });
  });

  swapButton?.addEventListener("click", () => {
    const original = getFieldInput("original", "percentChange");
    const next = getFieldInput("next", "percentChange");

    if (!original || !next) {
      return;
    }

    const previousOriginal = original.value;
    original.value = next.value;
    next.value = previousOriginal;
    original.dataset.touched = "true";
    next.dataset.touched = "true";
    updateCalculator();
  });

  clearActiveButton?.addEventListener("click", clearActiveMode);
  copyButton?.addEventListener("click", copyResult);

  clearHistoryButton?.addEventListener("click", () => {
    writeHistory([]);
  });

  historyList?.addEventListener("click", (event) => {
    const button = event.target.closest("[data-history-id]");

    if (button) {
      restoreHistoryItem(button.dataset.historyId);
    }
  });

  renderHistory();
  setActiveMode(activeMode);
</script>
