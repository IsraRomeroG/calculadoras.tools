---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import PageHero from "@components/shared/PageHero.astro";
import Panel from "@components/shared/Panel.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";

const description =
  "Conoce el propósito editorial de calculadoras.tools, cómo se mantiene el sitio, sus límites y las formas de contacto.";
const canonical = "/acerca-de";
const alternates = buildAlternateLinks(
  { es: canonical, en: "/en/about" },
  Astro.site ?? Astro.url,
);

const sections = [
  {
    title: "Qué es calculadoras.tools",
    content:
      "calculadoras.tools publica herramientas y guías para resolver cálculos cotidianos con explicaciones claras. El sitio prioriza calculadoras que ayuden a entender una fórmula, comparar escenarios o revisar un resultado sin crear una cuenta.",
  },
  {
    title: "Responsabilidad editorial",
    content:
      "El responsable editorial del sitio mantiene las calculadoras, revisa el contenido publicado y recibe reportes mediante el formulario de contacto. Cuando una pieza necesite revisión externa o especializada, esa revisión debe indicarse de forma visible.",
  },
  {
    title: "Experiencia y límites",
    content:
      "El proyecto se apoya en documentación de fórmulas, pruebas técnicas y revisión de fuentes públicas. No se presentan credenciales médicas, financieras, fiscales o legales que no estén verificadas, y el contenido no sustituye asesoría profesional.",
  },
  {
    title: "Financiamiento",
    content:
      "El sitio puede financiarse con publicidad cuando el inventario editorial y la configuración publicitaria estén listos. La publicidad no define resultados de calculadoras, recomendaciones editoriales ni fuentes citadas.",
  },
];
---

<BaseLayout
  title="Acerca de"
  description={description}
  canonical={canonical}
  alternates={alternates}
>
  <PageShell>
    <PageHero
      title="Acerca de"
      description="calculadoras.tools reúne calculadoras y guías prácticas con una idea sencilla: que el usuario entienda qué calcula, de dónde sale el resultado y cuándo debe confirmarlo con una fuente oficial o profesional."
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Acerca de" },
      ]}
      containerClass="px-6 py-10"
      breadcrumbClass="mb-8"
      titleClass="text-4xl font-bold tracking-tight md:text-6xl"
      descriptionClass="mt-6 text-lg leading-relaxed text-gray-400"
    />

    <Container as="section" class="px-6 py-14">
      <div class="grid gap-6">
        {
          sections.map((section) => (
            <Panel as="section" padding="lg">
              <h2 class="text-xl font-semibold">{section.title}</h2>
              <p class="mt-3 leading-relaxed text-gray-400">
                {section.content}
              </p>
            </Panel>
          ))
        }

        <Panel as="section" padding="lg">
          <h2 class="text-xl font-semibold">Contacto</h2>
          <p class="mt-3 leading-relaxed text-gray-400">
            Para reportar errores, proponer mejoras o pedir una corrección,
            utiliza el <a class="text-amber-400 hover:text-amber-300" href="/contacto">formulario de contacto</a>.
          </p>
        </Panel>
      </div>
    </Container>
  </PageShell>
</BaseLayout>
