---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import PageHero from "@components/shared/PageHero.astro";
import Panel from "@components/shared/Panel.astro";

const description =
  "Aviso financiero y fiscal de calculadoras.tools: las herramientas son educativas y estimativas, no asesoría financiera, fiscal, legal ni hipotecaria.";
const canonical = "/avisos/financiero-fiscal";

const sections = [
  {
    title: "Estimaciones educativas",
    content:
      "Las calculadoras financieras, fiscales e hipotecarias muestran escenarios aproximados con los datos que introduces. No predicen condiciones reales de crédito, impuestos, comisiones o costos finales.",
  },
  {
    title: "No es asesoría profesional",
    content:
      "El contenido no sustituye asesoría financiera, fiscal, legal, contable o hipotecaria. Antes de tomar decisiones, confirma los datos con una institución, autoridad oficial o profesional calificado.",
  },
  {
    title: "Datos que cambian",
    content:
      "Tasas, impuestos, comisiones, seguros, condiciones de crédito y reglas fiscales pueden cambiar según país, institución, producto, fecha y situación personal.",
  },
  {
    title: "Fuentes oficiales",
    content:
      "Cuando una tasa, impuesto o condición dependa de una norma vigente, la fuente oficial debe prevalecer sobre cualquier ejemplo del sitio.",
  },
];
---

<BaseLayout
  title="Aviso financiero y fiscal"
  description={description}
  canonical={canonical}
>
  <PageShell>
    <PageHero
      title="Aviso financiero y fiscal"
      description="Usa los resultados financieros, fiscales, legales o hipotecarios como punto de partida educativo. Confirma siempre tasas, reglas y condiciones con fuentes oficiales o profesionales."
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Metodología", href: "/metodologia", optional: true },
        { label: "Aviso financiero y fiscal" },
      ]}
      containerClass="px-6 py-10"
      breadcrumbClass="mb-8"
      titleClass="text-4xl font-bold tracking-tight md:text-6xl"
      descriptionClass="mt-6 text-lg leading-relaxed text-gray-400"
    />

    <Container as="section" class="px-6 py-14">
      <div class="grid gap-6">
        {
          sections.map((section) => (
            <Panel as="section" padding="lg">
              <h2 class="text-xl font-semibold">{section.title}</h2>
              <p class="mt-3 leading-relaxed text-gray-400">
                {section.content}
              </p>
            </Panel>
          ))
        }
      </div>
    </Container>
  </PageShell>
</BaseLayout>
