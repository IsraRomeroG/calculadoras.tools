---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/shared/Card.astro";
import Breadcrumb from "@components/shared/Breadcrumb.astro";

import "@styles/global.css";

const description =
  "Calculadoras online simples para resolver porcentajes y otros cálculos cotidianos de forma rápida, clara y gratuita.";
---

<BaseLayout title="Inicio" description={description}>
  <main class="bg-gray-900 text-gray-100">
    <!-- Hero -->
    <section class="border-b border-gray-700">
      <div class="mx-auto max-w-5xl px-6 pb-20 pt-15">
        <div class="max-w-3xl">
          <!-- Title -->
          <h1
            class="text-5xl font-bold leading-tight tracking-tight md:text-7xl"
          >
            Herramientas simples para
            <span class="text-amber-400"> cálculos rápidos </span>
          </h1>

          <!-- Subtitle -->
          <p class="mt-8 max-w-2xl text-xl leading-relaxed text-zinc-400">
            Calculadoras prácticas para resolver los problemas del día a día.
          </p>
        </div>
      </div>
    </section>

    <!-- CONTENIDO DINÁMICO -->
    <section id="calculadoras">
      <div class="max-w-5xl mx-auto px-6 py-12">
        <!-- Título de sección -->
        <div class="mb-8">
          <h2 class="text-2xl font-semibold">Calculadoras disponibles</h2>
          <p class="text-gray-400 text-sm mt-1">
            Selecciona una herramienta para comenzar
          </p>
        </div>

        <!-- GRID (HOME) -->
        <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
          <!-- CARD -->
          <Card
            href="/matematicas/calculadora-de-porcentajes"
            title="Calculadora de porcentajes"
            description="Calcula porcentajes y aumentos/disminuciones en valores."
            cta="Usar →"
          />

          <!-- Duplica este bloque dinámicamente -->
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
