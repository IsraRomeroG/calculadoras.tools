---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/ads/AdSlot.astro";
import Card from "@components/shared/Card.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import {
  getCalculatorCategories,
  getCalculatorCategoryUrl,
  getPublishedCalculators,
} from "@lib/calculator-directory";

const description =
  "Calculadoras online simples para resolver porcentajes y otros calculos cotidianos de forma rapida, clara y gratuita.";
const calculators = getPublishedCalculators();
const categories = getCalculatorCategories(calculators);
---

<BaseLayout
  title="Calculadoras disponibles"
  description={description}
  canonical="/"
>
  <PageShell>
    <section class="border-b border-gray-700">
      <Container class="py-8 md:py-12">
        <div
          class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(21rem,0.74fr)] lg:items-end"
        >
          <div>
            <h1
              class="mt-4 max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl md:text-6xl"
            >
              Encuentra la calculadora que necesitas
              <span class="text-amber-400"> en segundos</span>
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">
              Herramientas claras para porcentajes, finanzas, salud, fechas,
              conversiones y otros calculos cotidianos.
            </p>
          </div>

          <div
            class="rounded-lg border border-gray-700 bg-gray-950 p-4 shadow-xl shadow-gray-950/30"
          >
            <label
              for="calculator-search"
              class="block text-2xl font-semibold text-gray-200"
            >
              Buscar calculadora
            </label>
            <input
              id="calculator-search"
              class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none placeholder:text-gray-600 transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
              type="search"
              placeholder="IVA, IMC, hipoteca..."
              data-calculator-search
            />
            <div class="mt-4 grid grid-cols-3 gap-3">
              <div class="rounded-lg border border-gray-800 bg-gray-900 p-3">
                <p class="text-2xl font-bold text-white">
                  {calculators.length}
                </p>
                <p class="mt-1 text-xs text-gray-400">calculadoras</p>
              </div>
              <div class="rounded-lg border border-gray-800 bg-gray-900 p-3">
                <p class="text-2xl font-bold text-white">{categories.length}</p>
                <p class="mt-1 text-xs text-gray-400">categorias</p>
              </div>
              <a
                href="#calculadoras"
                class="rounded-lg border border-amber-400/60 bg-amber-400 px-3 py-3 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
              >
                Ver todo
              </a>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <AdSlot placement="home-after-intro" />

    <section class="border-b border-gray-800 bg-gray-950/45">
      <Container class="py-6">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            categories.map((category) => (
              <a
                href={getCalculatorCategoryUrl(category.slug)}
                class="rounded-lg border border-gray-700 p-4 transition hover:border-amber-400 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/30"
              >
                <span class="block text-sm font-semibold text-white">
                  {category.label}
                </span>
                <span class="mt-1 block text-xs text-gray-500">
                  {category.count} herramienta{category.count === 1 ? "" : "s"}
                </span>
              </a>
            ))
          }
        </div>
      </Container>
    </section>

    <section id="calculadoras">
      <Container class="py-8 md:py-12">
        <div class="mb-6">
          <h2 class="text-2xl font-semibold">Calculadoras disponibles</h2>
          <p class="mt-1 text-sm text-gray-400" data-search-summary>
            Selecciona una herramienta para comenzar.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
          {
            calculators.map((calculator) => (
              <Card
                href={calculator.href}
                title={calculator.title}
                description={calculator.description}
                cta="Usar →"
                data-calculator-card
                data-title={calculator.title.toLowerCase()}
                data-description={calculator.description.toLowerCase()}
              />
            ))
          }
        </div>
      </Container>
    </section>
  </PageShell>
</BaseLayout>

<script>
  const searchInput = document.querySelector("[data-calculator-search]");
  const cards = Array.from(document.querySelectorAll("[data-calculator-card]"));
  const summary = document.querySelector("[data-search-summary]");

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const haystack = `${card.dataset.title ?? ""} ${card.dataset.description ?? ""}`;
      const matches = !query || haystack.includes(query);
      card.classList.toggle("hidden", !matches);
      if (matches) visible += 1;
    });

    if (summary) {
      summary.textContent = query
        ? `${visible} resultado${visible === 1 ? "" : "s"} para "${query}".`
        : "Selecciona una herramienta para comenzar.";
    }
  });
</script>
