---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/shared/Card.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import {
  getCalculatorCategories,
  getPublishedCalculators,
} from "@lib/calculator-directory";

import "@styles/global.css";

const description =
  "Calculadoras online simples para resolver porcentajes y otros cálculos cotidianos de forma rápida, clara y gratuita.";
const calculators = getPublishedCalculators();
const categories = getCalculatorCategories(calculators);
---

<BaseLayout title="Inicio" description={description}>
  <PageShell>
    <!-- Hero -->
    <section class="border-b border-gray-700">
      <Container class="px-6 pb-20 pt-15">
        <div class="max-w-3xl">
          <!-- Title -->
          <h1
            class="text-5xl font-bold leading-tight tracking-tight md:text-7xl"
          >
            Herramientas simples para
            <span class="text-amber-400"> cálculos rápidos </span>
          </h1>

          <!-- Subtitle -->
          <p class="mt-8 max-w-2xl text-xl leading-relaxed text-zinc-400">
            Calculadoras prácticas para resolver los problemas del día a día.
          </p>
        </div>
      </Container>
    </section>

    <!-- CONTENIDO DINÁMICO -->
    <section id="calculadoras">
      <Container class="px-6 py-12">
        <!-- Título de sección -->
        <div class="mb-8">
          <h2 class="text-2xl font-semibold">Calculadoras disponibles</h2>
          <p class="text-gray-400 text-sm mt-1">
            Selecciona una herramienta para comenzar
          </p>
        </div>

        {
          categories.length > 0 && (
            <div class="mb-8 flex flex-wrap gap-3">
              {categories.map((category) => (
                <span class="inline-flex items-center gap-2 rounded-full border border-gray-700 px-4 py-2 text-sm text-gray-300">
                  <span>{category.label}</span>
                  <span class="text-xs text-gray-500">{category.count}</span>
                </span>
              ))}
            </div>
          )
        }

        <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
          {
            calculators.map((calculator) => (
              <Card
                href={calculator.href}
                title={calculator.title}
                description={calculator.description}
                cta="Usar →"
              />
            ))
          }
        </div>
      </Container>
    </section>
  </PageShell>
</BaseLayout>
