          </details>

          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <button
              type="button"
              class="inline-flex min-h-11 items-center justify-center rounded-lg bg-amber-400 px-4 py-2 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40 disabled:cursor-not-allowed disabled:opacity-50"
              data-copy-result
              disabled
            >
              Copiar resultado
            </button>
            <button
              type="button"
              class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
              data-copy-link
            >
              Copiar enlace
