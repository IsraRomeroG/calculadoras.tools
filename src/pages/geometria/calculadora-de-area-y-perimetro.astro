    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-8 md:py-10">
      <SectionIntro
        title="Fórmulas por figura"
        description="La calculadora usa estas fórmulas y conserva precisión completa durante el cálculo."
        class="mb-5"
      />

      <div class="overflow-x-auto rounded-lg border border-gray-700">
        <table class="min-w-full divide-y divide-gray-700 bg-gray-950 text-left text-sm">
          <thead class="bg-gray-900 text-gray-300">
            <tr>
              <th class="px-4 py-3 font-semibold" scope="col">Figura</th>
