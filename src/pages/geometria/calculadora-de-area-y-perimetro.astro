---
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/ads/AdSlot.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import { buildFaqJsonLd } from "@lib/seo";
import {
  AREA_PERIMETER_UNITS,
  MEASUREMENT_UNIT_METADATA,
} from "@lib/calculators/geometria/calculadora-de-area-y-perimetro/areaPerimeter";

const title = "Calculadora de Área y Perímetro — Fórmulas por Figura";
const description =
  "Calcula área y perímetro de cuadrados, rectángulos, triángulos, círculos y polígonos regulares con fórmula y procedimiento.";
const canonical = "/geometria/calculadora-de-area-y-perimetro";
const englishCanonical = "/en/geometry/area-perimeter-calculator";
const alternates = buildAlternateLinks(
  { es: canonical, en: englishCanonical },
  Astro.site ?? Astro.url,
);

const shapeOptions = [
  { value: "square", label: "Cuadrado" },
  { value: "rectangle", label: "Rectángulo" },
  { value: "triangle", label: "Triángulo" },
  { value: "circle", label: "Círculo" },
  { value: "regularPolygon", label: "Polígono regular" },
];

const decimalOptions = [
  { value: "auto", label: "Automático" },
  { value: "0", label: "0 decimales" },
  { value: "1", label: "1 decimal" },
  { value: "2", label: "2 decimales" },
  { value: "3", label: "3 decimales" },
  { value: "4", label: "4 decimales" },
  { value: "5", label: "5 decimales" },
  { value: "6", label: "6 decimales" },
];

const formulaRows = [
  {
    figure: "Cuadrado",
    area: "lado²",
    perimeter: "4 × lado",
  },
  {
    figure: "Rectángulo",
    area: "base × altura",
    perimeter: "2 × (base + altura)",
  },
  {
    figure: "Triángulo por lados",
    area: "√(s × (s - a) × (s - b) × (s - c))",
    perimeter: "a + b + c",
  },
  {
    figure: "Triángulo por base y altura",
    area: "(base × altura) ÷ 2",
    perimeter: "Se necesitan los tres lados",
  },
  {
    figure: "Círculo",
    area: "π × radio²",
    perimeter: "2 × π × radio",
  },
  {
    figure: "Polígono regular",
    area: "(perímetro × apotema) ÷ 2",
    perimeter: "número de lados × lado",
  },
];

const faqs = [
  {
    question: "¿Cuál es la diferencia entre área y perímetro?",
    answer:
      "El área mide la superficie que ocupa una figura. El perímetro mide la longitud de su contorno.",
  },
  {
    question: "¿Cuándo debo usar el área y cuándo el perímetro?",
    answer:
      "Usa el área para cubrir superficies, como piso, pintura o terreno. Usa el perímetro para bordear, cercar, enmarcar o medir contornos.",
  },
  {
    question: "¿Cómo calcular el área de un rectángulo?",
    answer:
      "Multiplica la base por la altura. Por ejemplo, un rectángulo de 5 m por 3 m tiene área de 15 m².",
  },
  {
    question: "¿Cómo calcular el perímetro de un rectángulo?",
    answer:
      "Suma base y altura, y multiplica por 2. Por ejemplo, con base 5 m y altura 3 m: 2 × (5 + 3) = 16 m.",
  },
  {
    question: "¿Cómo calcular el área de un triángulo?",
    answer:
      "Si conoces base y altura, multiplica base por altura y divide entre 2. Si conoces los tres lados, puedes usar la fórmula de Herón.",
  },
  {
    question: "¿Cómo calcular el área de un círculo?",
    answer:
      "Multiplica π por el radio al cuadrado. Si tienes el diámetro, primero divídelo entre 2 para obtener el radio.",
  },
  {
    question: "¿La circunferencia es el perímetro de un círculo?",
    answer:
      "Sí. En un círculo, la longitud del contorno se llama circunferencia y se calcula como 2 × π × radio.",
  },
  {
    question: "¿Qué unidad se usa para expresar un área?",
    answer:
      "El área se expresa en unidades cuadradas, como cm², m² o ft². El perímetro se expresa en unidades lineales, como cm, m o ft.",
  },
  {
    question: "¿Qué significa que un polígono sea regular?",
    answer:
      "Un polígono regular tiene todos sus lados con la misma longitud y todos sus ángulos iguales.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical} alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Calculadora de área y perímetro"
      description="Calcula el área y el perímetro de figuras comunes. Elige una figura, escribe sus medidas y consulta la fórmula paso a paso."
      kicker="Geometría"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      titleClass="mt-2 text-3xl font-bold leading-tight md:text-5xl"
      descriptionClass="mt-3 text-base leading-relaxed text-gray-400"
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Geometría", href: "/geometria", optional: true },
        { label: "Calculadora de área y perímetro", truncate: true },
      ]}
    />

    <Container as="section" class="py-5 md:py-8">
      <div
        id="area-perimeter-calculator"
        class="grid gap-4 lg:grid-cols-[minmax(0,1.05fr)_minmax(19rem,0.95fr)]"
      >
        <section
          class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
          aria-labelledby="calculator-heading"
        >
          <div class="border-b border-gray-800 p-4 sm:p-5">
            <h2 id="calculator-heading" class="text-xl font-semibold">
              Figura y medidas
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-gray-400">
              Usa una sola unidad para todas las medidas de la figura.
            </p>
          </div>

          <div class="p-4 sm:p-5">
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
              {
                shapeOptions.map((shape) => (
                  <button
                    type="button"
                    class="min-h-11 rounded-lg border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                    data-shape-option={shape.value}
                    aria-pressed="false"
                  >
                    {shape.label}
                  </button>
                ))
              }
            </div>

            <div
              class="mt-5 grid gap-4 md:grid-cols-[minmax(0,1fr)_13rem]"
            >
              <div>
                <div
                  class="mb-4 hidden rounded-lg border border-gray-800 bg-gray-900 p-3"
                  data-triangle-mode-wrapper
                >
                  <p class="text-sm font-semibold text-gray-200">
                    Datos del triángulo
                  </p>
                  <div class="mt-3 grid grid-cols-2 gap-2">
                    <button
                      type="button"
                      class="min-h-11 rounded-lg border border-gray-700 px-3 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                      data-triangle-mode-option="sides"
                      aria-pressed="true"
                    >
                      Tengo los 3 lados
                    </button>
                    <button
                      type="button"
                      class="min-h-11 rounded-lg border border-gray-700 px-3 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                      data-triangle-mode-option="baseHeight"
                      aria-pressed="false"
                    >
                      Tengo base y altura
                    </button>
                  </div>
                </div>

                <div
                  class="mb-4 hidden rounded-lg border border-gray-800 bg-gray-900 p-3"
                  data-circle-measure-wrapper
                >
                  <p class="text-sm font-semibold text-gray-200">
                    Medida conocida
                  </p>
                  <div class="mt-3 grid grid-cols-2 gap-2">
                    <button
                      type="button"
                      class="min-h-11 rounded-lg border border-gray-700 px-3 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                      data-circle-measure-option="radius"
                      aria-pressed="true"
                    >
                      Radio
                    </button>
                    <button
                      type="button"
                      class="min-h-11 rounded-lg border border-gray-700 px-3 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                      data-circle-measure-option="diameter"
                      aria-pressed="false"
                    >
                      Diámetro
                    </button>
                  </div>
                </div>

                <div class="space-y-4">
                  <div data-input-panel="square">
                    <div class="grid gap-4 sm:grid-cols-2">
                      <label class="block">
                        <span class="text-sm font-medium text-gray-200">
                          Lado
                        </span>
                        <input
                          id="square-side"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="decimal"
                          autocomplete="off"
                          placeholder="4"
                          data-input="side"
                          aria-describedby="square-side-error"
                        />
                      </label>
                      <p
                        id="square-side-error"
                        class="hidden self-end text-sm text-red-300"
                        data-error-for="side"
                      >
                      </p>
                    </div>
                  </div>

                  <div data-input-panel="rectangle" hidden>
                    <div class="grid gap-4 sm:grid-cols-2">
                      <label class="block">
                        <span class="text-sm font-medium text-gray-200">
                          Base
                        </span>
                        <input
                          id="rectangle-base"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="decimal"
                          autocomplete="off"
                          placeholder="5"
                          data-input="base"
                          aria-describedby="rectangle-base-error"
                        />
                        <span
                          id="rectangle-base-error"
                          class="mt-2 hidden text-sm text-red-300"
                          data-error-for="base"
                        >
                        </span>
                      </label>
                      <label class="block">
                        <span class="text-sm font-medium text-gray-200">
                          Altura
                        </span>
                        <input
                          id="rectangle-height"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="decimal"
                          autocomplete="off"
                          placeholder="3"
                          data-input="height"
                          aria-describedby="rectangle-height-error"
                        />
                        <span
                          id="rectangle-height-error"
                          class="mt-2 hidden text-sm text-red-300"
                          data-error-for="height"
                        >
                        </span>
                      </label>
                    </div>
                  </div>

                  <div data-input-panel="triangle-sides" hidden>
                    <div class="grid gap-4 sm:grid-cols-3">
                      {
                        ["a", "b", "c"].map((side) => (
                          <label class="block">
                            <span class="text-sm font-medium text-gray-200">
                              Lado {side}
                            </span>
                            <input
                              id={`triangle-side-${side}`}
                              class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                              type="text"
                              inputmode="decimal"
                              autocomplete="off"
                              placeholder={side === "a" ? "3" : side === "b" ? "4" : "5"}
                              data-input={side}
                              aria-describedby={`triangle-side-${side}-error`}
                            />
                            <span
                              id={`triangle-side-${side}-error`}
                              class="mt-2 hidden text-sm text-red-300"
                              data-error-for={side}
                            >
                            </span>
                          </label>
                        ))
                      }
                    </div>
                  </div>

                  <div data-input-panel="triangle-base-height" hidden>
                    <div class="grid gap-4 sm:grid-cols-2">
                      <label class="block">
                        <span class="text-sm font-medium text-gray-200">
                          Base
                        </span>
                        <input
                          id="triangle-base"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="decimal"
                          autocomplete="off"
                          placeholder="8"
                          data-input="base"
                          aria-describedby="triangle-base-error"
                        />
                        <span
                          id="triangle-base-error"
                          class="mt-2 hidden text-sm text-red-300"
                          data-error-for="base"
                        >
                        </span>
                      </label>
                      <label class="block">
                        <span class="text-sm font-medium text-gray-200">
                          Altura
                        </span>
                        <input
                          id="triangle-height"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="decimal"
                          autocomplete="off"
                          placeholder="3"
                          data-input="height"
                          aria-describedby="triangle-height-error"
                        />
                        <span
                          id="triangle-height-error"
                          class="mt-2 hidden text-sm text-red-300"
                          data-error-for="height"
                        >
                        </span>
                      </label>
                    </div>
                  </div>

                  <div data-input-panel="circle-radius" hidden>
                    <label class="block">
                      <span class="text-sm font-medium text-gray-200">
                        Radio
                      </span>
                      <input
                        id="circle-radius"
                        class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="2.5"
                        data-input="radius"
                        aria-describedby="circle-radius-error"
                      />
                      <span
                        id="circle-radius-error"
                        class="mt-2 hidden text-sm text-red-300"
                        data-error-for="radius"
                      >
                      </span>
                    </label>
                  </div>

                  <div data-input-panel="circle-diameter" hidden>
                    <label class="block">
                      <span class="text-sm font-medium text-gray-200">
                        Diámetro
                      </span>
                      <input
                        id="circle-diameter"
                        class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="10"
                        data-input="diameter"
                        aria-describedby="circle-diameter-error"
                      />
                      <span
                        id="circle-diameter-error"
                        class="mt-2 hidden text-sm text-red-300"
                        data-error-for="diameter"
                      >
                      </span>
                    </label>
                  </div>

                  <div data-input-panel="regular-polygon" hidden>
                    <div class="grid gap-4 sm:grid-cols-2">
                      <label class="block">
                        <span class="text-sm font-medium text-gray-200">
                          Número de lados
                        </span>
                        <input
                          id="polygon-sides"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="numeric"
                          autocomplete="off"
                          placeholder="6"
                          data-input="sideCount"
                          aria-describedby="polygon-sides-error"
                        />
                        <span
                          id="polygon-sides-error"
                          class="mt-2 hidden text-sm text-red-300"
                          data-error-for="sideCount"
                        >
                        </span>
                      </label>
                      <label class="block">
                        <span class="text-sm font-medium text-gray-200">
                          Longitud de cada lado
                        </span>
                        <input
                          id="polygon-side-length"
                          class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                          type="text"
                          inputmode="decimal"
                          autocomplete="off"
                          placeholder="4"
                          data-input="sideLength"
                          aria-describedby="polygon-side-length-error"
                        />
                        <span
                          id="polygon-side-length-error"
                          class="mt-2 hidden text-sm text-red-300"
                          data-error-for="sideLength"
                        >
                        </span>
                      </label>
                    </div>
                  </div>
                </div>

                <div class="mt-5 grid gap-4 sm:grid-cols-2">
                  <label class="block">
                    <span class="text-sm font-medium text-gray-200">
                      Unidad
                    </span>
                    <select
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      data-unit-select
                    >
                      {
                        AREA_PERIMETER_UNITS.map((unit) => (
                          <option value={unit}>
                            {MEASUREMENT_UNIT_METADATA[unit].label}
                          </option>
                        ))
                      }
                    </select>
                  </label>

                  <label class="block">
                    <span class="text-sm font-medium text-gray-200">
                      Decimales
                    </span>
                    <select
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                      data-decimals-select
                    >
                      {
                        decimalOptions.map((option) => (
                          <option value={option.value}>{option.label}</option>
                        ))
                      }
                    </select>
                  </label>
                </div>

                <div class="mt-5 flex flex-col gap-3 sm:flex-row">
                  <button
                    type="button"
                    class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                    data-clear-calculator
                  >
                    Limpiar
                  </button>
                </div>
              </div>

              <aside
                class="rounded-lg border border-gray-800 bg-gray-900 p-3 text-gray-300"
                aria-labelledby="diagram-title"
              >
                <h3
                  id="diagram-title"
                  class="text-sm font-semibold text-white"
                  data-diagram-title
                >
                  Cuadrado
                </h3>
                <p class="mt-1 text-xs leading-relaxed text-gray-500" data-diagram-note>
                  Cada lado mide lo mismo.
                </p>

                <div class="mt-3 aspect-square w-full text-amber-300">
                  <svg
                    class="h-full w-full"
                    viewBox="0 0 160 160"
                    role="img"
                    aria-label="Esquema de cuadrado con lado"
                    data-diagram="square"
                  >
                    <rect
                      x="38"
                      y="36"
                      width="84"
                      height="84"
                      rx="3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="5"
                    />
                    <text x="80" y="137" text-anchor="middle" class="fill-gray-200 text-[13px]">
                      lado
                    </text>
                  </svg>

                  <svg
                    class="hidden h-full w-full"
                    viewBox="0 0 160 160"
                    role="img"
                    aria-label="Esquema de rectángulo con base y altura"
                    data-diagram="rectangle"
                  >
                    <rect
                      x="28"
                      y="48"
                      width="104"
                      height="64"
                      rx="3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="5"
                    />
                    <text x="80" y="131" text-anchor="middle" class="fill-gray-200 text-[13px]">
                      base
                    </text>
                    <text x="142" y="83" text-anchor="middle" class="fill-gray-200 text-[13px]">
                      altura
                    </text>
                  </svg>

                  <svg
                    class="hidden h-full w-full"
                    viewBox="0 0 160 160"
                    role="img"
                    aria-label="Esquema de triángulo con lados a, b y c"
                    data-diagram="triangle-sides"
                  >
                    <path
                      d="M28 118 L80 32 L132 118 Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="5"
                      stroke-linejoin="round"
                    />
                    <text x="49" y="74" text-anchor="middle" class="fill-gray-200 text-[13px]">
                      a
                    </text>
                    <text x="111" y="74" text-anchor="middle" class="fill-gray-200 text-[13px]">
                      b
                    </text>
                    <text x="80" y="136" text-anchor="middle" class="fill-gray-200 text-[13px]">
                      c
                    </text>
                  </svg>

                  <svg
                    class="hidden h-full w-full"
                    viewBox="0 0 160 160"
                    role="img"
                    aria-label="Esquema de triángulo con base y altura"
                    data-diagram="triangle-base-height"
                  >
                    <path
                      d="M30 120 L122 120 L80 34 Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="5"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M80 34 L80 120"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-dasharray="6 5"
                    />
                    <text x="76" y="82" text-anchor="end" class="fill-gray-200 text-[13px]">
                      altura
                    </text>
                    <text x="76" y="139" text-anchor="middle" class="fill-gray-200 text-[13px]">
                      base
                    </text>
                  </svg>

                  <svg
                    class="hidden h-full w-full"
                    viewBox="0 0 160 160"
                    role="img"
                    aria-label="Esquema de círculo con radio"
                    data-diagram="circle-radius"
                  >
                    <circle
                      cx="80"
                      cy="80"
                      r="48"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="5"
                    />
                    <path d="M80 80 L128 80" stroke="currentColor" stroke-width="4" />
                    <circle cx="80" cy="80" r="4" fill="currentColor" />
                    <text x="104" y="72" text-anchor="middle" class="fill-gray-200 text-[13px]">
                      radio
                    </text>
                  </svg>

                  <svg
                    class="hidden h-full w-full"
                    viewBox="0 0 160 160"
                    role="img"
                    aria-label="Esquema de círculo con diámetro"
                    data-diagram="circle-diameter"
                  >
                    <circle
                      cx="80"
                      cy="80"
                      r="48"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="5"
                    />
