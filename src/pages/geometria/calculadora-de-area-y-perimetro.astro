                      stroke="currentColor"
                      stroke-width="5"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M80 80 L80 132"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-dasharray="6 5"
                    />
                    <text x="103" y="126" text-anchor="middle" class="fill-gray-200 text-[13px]">
