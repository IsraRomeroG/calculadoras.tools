---
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  COMBINATORICS_CANONICAL_PATH,
  COMBINATORICS_EXAMPLES,
} from "@lib/calculators/probabilidad-estadistica/calculadora-combinaciones-permutaciones/combinatorics";
import { buildFaqJsonLd } from "@lib/seo";
import { buildAlternateLinks } from "@lib/i18n/routing";

const title = "Calculadora de combinaciones y permutaciones";
const description =
  "Calcula combinaciones, arreglos y permutaciones con o sin repetición. Elige si importa el orden y obtén fórmula, explicación y resultado exacto.";

const faqs = [
  {
    question: "¿Cuál es la diferencia entre combinación y permutación?",
    answer:
      "En una combinación el orden no cambia el resultado. En una permutación o arreglo, cambiar el orden crea un resultado diferente. Elegir a Ana y Luis para un comité es la misma selección que Luis y Ana; asignarles primer y segundo lugar no lo es.",
  },
  {
    question: "¿Cómo sé si el orden importa?",
    answer:
      "Pregúntate si intercambiar dos elementos produce un resultado distinto. Si cambia un podio, una contraseña o una asignación de puestos, el orden importa. Si el grupo final sigue siendo el mismo, no importa.",
  },
  {
    question: "¿Qué significa que se puedan repetir elementos?",
    answer:
      "Significa que una misma opción puede usarse más de una vez. En un PIN pueden repetirse dígitos; en un podio una persona no puede ocupar dos lugares.",
  },
  {
    question: "¿Qué pasa si k es mayor que n?",
    answer:
      "Sin repetición no puedes elegir más elementos de los disponibles. Con repetición sí puede ser válido porque una opción puede utilizarse varias veces.",
  },
  {
    question: "¿Por qué algunos resultados tienen tantos dígitos?",
    answer:
      "El número de posibilidades crece muy rápido. La calculadora conserva el entero exacto con BigInt, muestra una vista resumida y permite copiar todos los dígitos.",
  },
  {
    question:
      "¿Qué diferencia hay entre n^k y una permutación de elementos repetidos?",
    answer:
      "n^k cuenta secuencias de k posiciones con n opciones disponibles en cada posición. Ordenar un conjunto que ya contiene elementos repetidos, como las letras de MAMA, requiere otra fórmula y no forma parte de este MVP.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout
  title={title}
  description={description}
  canonical={COMBINATORICS_CANONICAL_PATH}
 alternates={buildAlternateLinks({ es: "/probabilidad-estadistica/calculadora-combinaciones-permutaciones", en: "/en/probability-statistics/combinations-permutations-calculator" }, Astro.site ?? Astro.url)}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Calculadora de combinaciones y permutaciones"
      description="Responde dos preguntas sobre orden y repetición para elegir la fórmula correcta y obtener un resultado entero exacto."
      kicker="Probabilidad y estadística"
      kickerHref="/probabilidad-estadistica"
      collapseBreadcrumbOnMobile
      containerClass="py-6 md:py-8"
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        {
          label: "Probabilidad y estadística",
          href: "/probabilidad-estadistica",
          optional: true,
        },
        { label: "Combinaciones y permutaciones", truncate: true },
      ]}
    />

    <Container as="section" class="py-6 md:py-8">
      <div
        id="combinatorics-calculator"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
      >
        <div
          class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.78fr)]"
        >
          <section class="p-4 sm:p-6" aria-labelledby="calculator-heading">
            <h2 id="calculator-heading" class="text-xl font-semibold">
              Elige el tipo de problema
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-gray-400">
              No necesitas memorizar la fórmula. Indica qué cambia una solución
              y la calculadora identificará el caso.
            </p>

            <form class="mt-5" novalidate data-combinatorics-form>
              <fieldset>
                <legend class="text-sm font-semibold text-gray-100">
                  1. ¿Importa el orden?
                </legend>
                <p class="mt-1 text-sm text-gray-400">
                  Si intercambiar dos elementos crea otro resultado, responde
                  Sí.
                </p>
                <div class="mt-3 grid grid-cols-2 gap-2">
                  <label class="relative">
                    <input
                      class="peer sr-only"
                      type="radio"
                      name="order"
                      value="no"
                      checked
                    />
                    <span
                      class="flex min-h-11 cursor-pointer items-center justify-center rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400/70 peer-checked:border-amber-400 peer-checked:bg-amber-400 peer-checked:text-gray-950 peer-focus-visible:ring-3 peer-focus-visible:ring-amber-400/40"
                    >
                      No
                    </span>
                  </label>
                  <label class="relative">
                    <input
                      class="peer sr-only"
                      type="radio"
                      name="order"
                      value="yes"
                    />
                    <span
                      class="flex min-h-11 cursor-pointer items-center justify-center rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400/70 peer-checked:border-amber-400 peer-checked:bg-amber-400 peer-checked:text-gray-950 peer-focus-visible:ring-3 peer-focus-visible:ring-amber-400/40"
                    >
                      Sí
                    </span>
                  </label>
                </div>
              </fieldset>

              <fieldset class="mt-5">
                <legend class="text-sm font-semibold text-gray-100">
                  2. ¿Se pueden repetir elementos?
                </legend>
                <p class="mt-1 text-sm text-gray-400">
                  Responde Sí cuando una opción pueda usarse más de una vez.
                </p>
                <div class="mt-3 grid grid-cols-2 gap-2">
                  <label class="relative">
                    <input
                      class="peer sr-only"
                      type="radio"
                      name="repetition"
                      value="no"
                      checked
                    />
                    <span
                      class="flex min-h-11 cursor-pointer items-center justify-center rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400/70 peer-checked:border-amber-400 peer-checked:bg-amber-400 peer-checked:text-gray-950 peer-focus-visible:ring-3 peer-focus-visible:ring-amber-400/40"
                    >
                      No
                    </span>
                  </label>
                  <label class="relative">
                    <input
                      class="peer sr-only"
                      type="radio"
                      name="repetition"
                      value="yes"
                    />
                    <span
                      class="flex min-h-11 cursor-pointer items-center justify-center rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400/70 peer-checked:border-amber-400 peer-checked:bg-amber-400 peer-checked:text-gray-950 peer-focus-visible:ring-3 peer-focus-visible:ring-amber-400/40"
                    >
                      Sí
                    </span>
                  </label>
                </div>
              </fieldset>

              <div
                class="mt-5 rounded-lg border border-sky-400/25 bg-sky-400/10 px-4 py-3"
              >
                <p class="text-xs font-semibold uppercase text-sky-300">
                  Cálculo seleccionado
                </p>
                <p
                  class="mt-1 font-semibold text-white"
                  data-mode-preview
                >
                  Combinación sin repetición
                </p>
                <p
                  class="mt-1 text-sm leading-relaxed text-sky-100"
                  data-mode-explanation
                >
                  El orden no importa y cada elemento puede usarse una sola vez.
                </p>
              </div>

              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                <div>
                  <label
                    for="combinatorics-n"
                    class="block text-sm font-semibold text-gray-100"
                  >
                    Elementos disponibles (n)
                  </label>
                  <input
                    id="combinatorics-n"
                    class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    maxlength="5"
                    placeholder="Ejemplo: 10"
                    aria-describedby="combinatorics-n-help combinatorics-n-error"
                    data-input-n
                  />
                  <p
                    id="combinatorics-n-help"
                    class="mt-2 text-sm leading-relaxed text-gray-400"
                    data-help-n
                  >
                    El total de opciones o elementos disponibles.
                  </p>
                  <p
                    id="combinatorics-n-error"
                    class="mt-2 hidden rounded-lg border border-red-400/30 bg-red-400/10 px-3 py-2 text-sm text-red-200"
                    data-error-n
                  ></p>
                </div>

                <div>
                  <label
                    for="combinatorics-k"
                    class="block text-sm font-semibold text-gray-100"
                  >
                    Elementos o posiciones (k)
                  </label>
                  <input
                    id="combinatorics-k"
                    class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    maxlength="5"
                    placeholder="Ejemplo: 3"
                    aria-describedby="combinatorics-k-help combinatorics-k-error"
                    data-input-k
                  />
                  <p
                    id="combinatorics-k-help"
                    class="mt-2 text-sm leading-relaxed text-gray-400"
                    data-help-k
                  >
                    Cuántos elementos eliges.
                  </p>
                  <p
                    id="combinatorics-k-error"
                    class="mt-2 hidden rounded-lg border border-red-400/30 bg-red-400/10 px-3 py-2 text-sm text-red-200"
                    data-error-k
                  ></p>
                </div>
              </div>

              <div class="mt-5">
                <p class="text-sm font-semibold text-gray-100">
                  Ejemplos rápidos
                </p>
                <div
                  class="mt-2 flex gap-2 overflow-x-auto pb-2"
                  role="group"
                  aria-label="Cargar un ejemplo"
                >
                  {
                    COMBINATORICS_EXAMPLES.map((example) => (
                      <button
                        class="min-h-11 shrink-0 rounded-lg border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                        type="button"
                        data-example
                        data-order={String(example.orderMatters)}
                        data-repetition={String(example.repetitionAllowed)}
                        data-n={String(example.n)}
                        data-k={String(example.k)}
                        title={example.description}
                      >
                        {example.label}
                      </button>
                    ))
                  }
                </div>
              </div>

              <div class="mt-5 flex flex-col gap-3 sm:flex-row">
                <button
                  class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40 sm:w-auto sm:min-w-44"
                  type="submit"
                >
                  Calcular
                </button>
                <button
                  class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  data-clear
                >
                  Limpiar
                </button>
              </div>
            </form>
          </section>

          <aside
            class="border-t border-gray-800 bg-gray-900/60 p-4 sm:p-6 lg:border-l lg:border-t-0"
            aria-labelledby="result-heading"
          >
            <div class="rounded-lg border border-gray-700 bg-gray-950 p-5">
              <p class="text-xs font-semibold uppercase text-amber-400">
                Resultado
              </p>
              <h2
                id="result-heading"
                class="mt-2 text-lg font-semibold text-white"
                data-result-name
              >
                Completa los datos
              </h2>
              <p
                class="mt-4 break-all text-3xl font-bold leading-tight text-white sm:text-4xl"
                data-result-value
              >
                —
              </p>
              <p
                class="mt-2 hidden text-sm text-gray-500"
                data-result-digits
              ></p>

              <p
                class="mt-4 rounded-lg border border-gray-800 bg-gray-900 px-4 py-3 text-sm leading-relaxed text-gray-300"
                data-result-interpretation
              >
                Indica si importa el orden, si hay repetición y captura n y k.
              </p>

              <details
                class="mt-4 hidden rounded-lg border border-gray-800 bg-gray-900/70 p-4"
                data-exact-details
              >
                <summary class="cursor-pointer text-sm font-semibold text-white">
                  Ver resultado exacto
                </summary>
                <p
                  class="mt-3 break-all font-mono text-sm leading-relaxed text-gray-300"
                  dir="ltr"
                  data-result-exact
                ></p>
              </details>

              <div class="mt-5 hidden" data-result-actions>
                <button
                  class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  data-copy
                >
                  Copiar resultado exacto
                </button>
                <p
                  class="mt-2 min-h-5 text-sm text-emerald-300"
                  aria-live="polite"
                  data-copy-status
                ></p>
              </div>
            </div>

            <div
              class="mt-4 rounded-lg border border-gray-800 bg-gray-950 p-4"
            >
              <h3 class="text-sm font-semibold text-white">
                Por qué se usa esta fórmula
              </h3>
              <p
                class="mt-2 text-sm leading-relaxed text-gray-400"
                data-decision
              >
                La explicación aparecerá después de calcular.
              </p>
            </div>
          </aside>
        </div>

        <div class="border-t border-gray-800 p-4 sm:p-6">
          <div class="grid gap-4 lg:grid-cols-2">
            <details
              class="rounded-lg border border-gray-800 bg-gray-900/60 p-4"
              open
            >
              <summary class="cursor-pointer text-base font-semibold text-white">
                Fórmula y sustitución
              </summary>
              <p
                class="mt-4 rounded-lg border border-gray-800 bg-gray-950 px-3 py-2 font-mono text-sm leading-relaxed text-amber-200"
                data-formula
              >
                C(n, k) = n! / (k! × (n − k)!)
              </p>
              <p
                class="mt-3 break-words text-sm leading-relaxed text-gray-300"
                data-substitution
              >
                La sustitución aparecerá con un cálculo válido.
              </p>
            </details>

            <details
              class="rounded-lg border border-gray-800 bg-gray-900/60 p-4"
            >
              <summary class="cursor-pointer text-base font-semibold text-white">
                Procedimiento resumido
              </summary>
              <ol
                class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-gray-300"
                data-procedure
              >
                <li>Completa los datos para ver el procedimiento.</li>
              </ol>
            </details>
          </div>
        </div>

        <p class="sr-only" aria-live="polite" data-live-status></p>
      </div>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-6 md:py-8">
      <SectionIntro
        title="Cómo elegir la fórmula correcta"
        description="Las dos preguntas de la calculadora corresponden a estos cuatro casos."
      />

      <div class="grid gap-4 sm:grid-cols-2">
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
          <p class="text-xs font-semibold uppercase text-amber-400">
            Orden no · Repetición no
          </p>
          <h3 class="mt-2 text-lg font-semibold text-white">
            Combinación sin repetición
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Sirve para formar grupos donde cada elemento aparece como máximo una
            vez. Ejemplo: elegir un comité.
          </p>
        </article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
          <p class="text-xs font-semibold uppercase text-amber-400">
            Orden sí · Repetición no
          </p>
          <h3 class="mt-2 text-lg font-semibold text-white">
            Arreglo sin repetición
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Sirve cuando las posiciones son distintas y nadie puede repetirse.
            Ejemplo: oro, plata y bronce.
          </p>
        </article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
          <p class="text-xs font-semibold uppercase text-amber-400">
            Orden no · Repetición sí
          </p>
          <h3 class="mt-2 text-lg font-semibold text-white">
            Combinación con repetición
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Sirve para elegir cantidades donde una opción puede aparecer varias
            veces. Ejemplo: bolas de helado por sabor.
          </p>
        </article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
          <p class="text-xs font-semibold uppercase text-amber-400">
            Orden sí · Repetición sí
          </p>
          <h3 class="mt-2 text-lg font-semibold text-white">
            Arreglo con repetición
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Cada posición puede usar cualquiera de las opciones. Ejemplo: un
            PIN o una contraseña de longitud fija.
          </p>
        </article>
      </div>
    </Container>

    <Container as="section" class="py-6 md:py-8">
      <SectionIntro
        title="Ejemplos para probar"
        description="Cada ejemplo activa una combinación diferente de orden y repetición."
      />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          COMBINATORICS_EXAMPLES.map((example) => (
            <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
              <h3 class="text-base font-semibold text-white">{example.label}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-400">
                {example.description}
              </p>
              <p class="mt-4 text-sm font-semibold text-amber-300">
                n = {example.n}, k = {example.k}
              </p>
            </article>
          ))
        }
      </div>
    </Container>

    <Container as="section" class="py-6 md:py-8">
      <div class="rounded-lg border border-gray-700 bg-gray-950 p-5 sm:p-6">
        <h2 class="text-xl font-semibold text-white">
          Resultados grandes sin perder precisión
        </h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-gray-400">
          Muchas operaciones combinatorias superan rápidamente el rango seguro
          de los números habituales de JavaScript. Esta herramienta calcula con
          enteros BigInt. La notación científica solo resume la vista: el
          resultado exacto permanece disponible para consultarlo y copiarlo.
        </p>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<script>
  import {
    calculateCombinatoricsFromInput,
    getCombinatoricsMode,
    getCombinatoricsModeMetadata,
  } from "@lib/calculators/probabilidad-estadistica/calculadora-combinaciones-permutaciones/combinatorics";

  const form = document.querySelector("[data-combinatorics-form]");
  const inputN = document.querySelector("[data-input-n]");
  const inputK = document.querySelector("[data-input-k]");
  const errorN = document.querySelector("[data-error-n]");
  const errorK = document.querySelector("[data-error-k]");
  const helpN = document.querySelector("[data-help-n]");
  const helpK = document.querySelector("[data-help-k]");
  const modePreview = document.querySelector("[data-mode-preview]");
  const modeExplanation = document.querySelector("[data-mode-explanation]");
  const resultName = document.querySelector("[data-result-name]");
  const resultValue = document.querySelector("[data-result-value]");
  const resultDigits = document.querySelector("[data-result-digits]");
  const resultInterpretation = document.querySelector(
    "[data-result-interpretation]",
  );
  const exactDetails = document.querySelector("[data-exact-details]");
  const resultExact = document.querySelector("[data-result-exact]");
  const resultActions = document.querySelector("[data-result-actions]");
  const copyButton = document.querySelector("[data-copy]");
  const copyStatus = document.querySelector("[data-copy-status]");
  const decision = document.querySelector("[data-decision]");
  const formula = document.querySelector("[data-formula]");
  const substitution = document.querySelector("[data-substitution]");
  const procedure = document.querySelector("[data-procedure]");
  const liveStatus = document.querySelector("[data-live-status]");
  const clearButton = document.querySelector("[data-clear]");
  const exampleButtons = document.querySelectorAll("[data-example]");

  let currentCopyText = "";

  function readBooleanRadio(name) {
    const selected = document.querySelector(`input[name="${name}"]:checked`);

    return selected?.value === "yes";
  }

  function selectBooleanRadio(name, value) {
    const radio = document.querySelector(
      `input[name="${name}"][value="${value ? "yes" : "no"}"]`,
    );

    if (radio) radio.checked = true;
  }

  function getModeState() {
    const orderMatters = readBooleanRadio("order");
    const repetitionAllowed = readBooleanRadio("repetition");
    const mode = getCombinatoricsMode(orderMatters, repetitionAllowed);

    return {
      orderMatters,
      repetitionAllowed,
      mode,
      metadata: getCombinatoricsModeMetadata(mode),
    };
  }

  function getModeExplanation(mode) {
    switch (mode) {
      case "combination":
        return "El orden no importa y cada elemento puede usarse una sola vez.";
      case "arrangement":
        return "El orden sí importa y cada elemento puede usarse una sola vez.";
      case "combination-repetition":
        return "El orden no importa y los elementos pueden repetirse.";
      case "arrangement-repetition":
        return "El orden sí importa y cada posición puede repetir elementos.";
    }
  }

  function updateModeContext({ reset = false } = {}) {
    const state = getModeState();
    modePreview.textContent = state.metadata.label;
    modeExplanation.textContent = getModeExplanation(state.mode);
    formula.textContent = state.metadata.formula;

    if (state.mode === "arrangement-repetition") {
      helpN.textContent = "Las opciones disponibles para cada posición.";
      helpK.textContent = "Cuántas posiciones quieres llenar.";
    } else if (state.mode === "arrangement") {
      helpN.textContent = "El total de elementos que pueden ocupar posiciones.";
      helpK.textContent = "Cuántas posiciones distintas quieres asignar.";
    } else {
      helpN.textContent = "El total de opciones o elementos disponibles.";
      helpK.textContent = "Cuántos elementos quieres elegir.";
    }

    if (reset) resetResult();
  }

  function clearFieldError(field) {
    const input = field === "n" ? inputN : inputK;
    const error = field === "n" ? errorN : errorK;

    input.removeAttribute("aria-invalid");
    error.textContent = "";
    error.classList.add("hidden");
  }

  function setFieldError(field, message) {
    const input = field === "n" ? inputN : inputK;
    const error = field === "n" ? errorN : errorK;

    input.setAttribute("aria-invalid", "true");
    error.textContent = message;
    error.classList.remove("hidden");
  }

  function clearErrors() {
    clearFieldError("n");
    clearFieldError("k");
  }

  function resetResult() {
    currentCopyText = "";
    resultName.textContent = "Completa los datos";
    resultValue.textContent = "—";
    resultDigits.textContent = "";
    resultDigits.classList.add("hidden");
    resultInterpretation.textContent =
      "Indica si importa el orden, si hay repetición y captura n y k.";
    exactDetails.classList.add("hidden");
    exactDetails.open = false;
    resultExact.textContent = "";
    resultActions.classList.add("hidden");
    copyStatus.textContent = "";
    decision.textContent = "La explicación aparecerá después de calcular.";
    substitution.textContent =
      "La sustitución aparecerá con un cálculo válido.";
    procedure.replaceChildren();
    const item = document.createElement("li");
    item.textContent = "Completa los datos para ver el procedimiento.";
    procedure.append(item);
    liveStatus.textContent = "";
  }

  function renderCalculation(calculation) {
    currentCopyText = calculation.copyText;
    resultName.textContent = calculation.modeLabel;
    resultValue.textContent = calculation.isLongResult
      ? `≈ ${calculation.compact}`
      : calculation.formattedExact;
    resultInterpretation.textContent = calculation.interpretation;
    decision.textContent = calculation.decisionExplanation;
    formula.textContent = calculation.formula;
    substitution.textContent = calculation.substitution;
    resultExact.textContent = calculation.exact;
    resultActions.classList.remove("hidden");
    copyStatus.textContent = "";

    if (calculation.isLongResult) {
      resultDigits.textContent = `${calculation.digitCount.toLocaleString("es-MX")} dígitos · vista resumida`;
      resultDigits.classList.remove("hidden");
      exactDetails.classList.remove("hidden");
    } else {
      resultDigits.classList.add("hidden");
      exactDetails.classList.add("hidden");
      exactDetails.open = false;
    }

    procedure.replaceChildren();
    calculation.procedure.forEach((step) => {
      const item = document.createElement("li");
      item.textContent = step;
      procedure.append(item);
    });

    liveStatus.textContent = calculation.isLongResult
      ? `${calculation.modeLabel}: resultado exacto de ${calculation.digitCount} dígitos.`
      : `${calculation.modeLabel}: ${calculation.exact}.`;
  }

  function calculate() {
    clearErrors();
    const state = getModeState();
    const result = calculateCombinatoricsFromInput({
      orderMatters: state.orderMatters,
      repetitionAllowed: state.repetitionAllowed,
      n: inputN.value,
      k: inputK.value,
    });

    if (!result.ok) {
      result.errors.forEach((error) =>
        setFieldError(error.field, error.message),
      );
      const firstField = result.errors[0]?.field;
      (firstField === "n" ? inputN : inputK)?.focus();
      liveStatus.textContent =
        "No se pudo calcular. Revisa los campos marcados.";
      return;
    }

    renderCalculation(result.calculation);
  }

  async function copyText(text) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.append(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    calculate();
  });

  document.querySelectorAll('input[name="order"], input[name="repetition"]')
    .forEach((radio) => {
      radio.addEventListener("change", () => {
        clearErrors();
        updateModeContext({ reset: true });
      });
    });

  [inputN, inputK].forEach((input) => {
    input.addEventListener("input", () => {
      clearFieldError(input === inputN ? "n" : "k");
      resetResult();
    });
  });

  exampleButtons.forEach((button) => {
    button.addEventListener("click", () => {
      selectBooleanRadio("order", button.dataset.order === "true");
      selectBooleanRadio(
        "repetition",
        button.dataset.repetition === "true",
      );
      inputN.value = button.dataset.n ?? "";
      inputK.value = button.dataset.k ?? "";
      clearErrors();
      updateModeContext({ reset: true });
      calculate();
    });
  });

  clearButton.addEventListener("click", () => {
    form.reset();
    inputN.value = "";
    inputK.value = "";
    clearErrors();
    updateModeContext({ reset: true });
    inputN.focus();
  });

  copyButton.addEventListener("click", async () => {
    if (!currentCopyText) return;

    try {
      await copyText(currentCopyText);
      copyStatus.textContent = "Resultado exacto copiado.";
    } catch {
      copyStatus.textContent =
        "No fue posible copiar automáticamente. Selecciona el resultado exacto.";
    }
  });

  updateModeContext();
</script>
