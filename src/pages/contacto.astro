---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumb from "@components/shared/Breadcrumb.astro";

const description =
  "Envía sugerencias, reporta errores o propone nuevas calculadoras para calculadoras.tools mediante el formulario de contacto.";
---

<BaseLayout title="Contacto" description={description}>
  <main class="bg-gray-900 text-gray-100">
    <section class="border-b border-gray-700">
      <div class="mx-auto max-w-5xl px-6 py-10">
        <Breadcrumb
          class="mb-8"
          items={[
            { label: "Inicio", href: "/", ariaLabel: "Inicio" },
            { label: "Contacto" },
          ]}
        />

        <div class="max-w-3xl">
          <h1 class="text-4xl font-bold tracking-tight md:text-6xl">
            Contacto
          </h1>

          <p class="mt-6 text-lg leading-relaxed text-gray-400">
            Si tienes una sugerencia, encontraste un error o quieres proponer
            una nueva calculadora, escr&iacute;benos. Leemos cada mensaje con
            atenci&oacute;n.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 py-14">
      <div class="grid gap-8 md:grid-cols-[0.9fr_1.1fr]">
        <div class="space-y-6">
          <div class="py-4">
            <h2 class="text-2xl font-semibold">Hablemos</h2>
            <p class="mt-3 text-gray-400">
              Usa el formulario para enviarnos tu mensaje.
            </p>
          </div>

          <div class="rounded-lg border border-gray-700 bg-gray-950 p-5">
            <h2 class="text-lg font-semibold">Para responder mejor</h2>
            <ul class="mt-4 space-y-3 text-sm text-gray-400">
              <li>Incluye la calculadora o p&aacute;gina relacionada.</li>
              <li>Describe el resultado esperado y el resultado obtenido.</li>
              <li>
                Comparte ejemplos num&eacute;ricos si el mensaje trata de un
                c&aacute;lculo.
              </li>
            </ul>
          </div>
        </div>

        <form
          id="contact-form"
          class="rounded-lg border border-gray-700 bg-gray-950 p-6"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input
            type="hidden"
            name="access_key"
            value="4bae11ff-c274-4cac-9167-e10c62dab084"
          />
          <input
            type="hidden"
            name="subject"
            value="Nuevo mensaje desde calculadoras.tools"
          />
          <input type="hidden" name="from_name" value="calculadoras.tools" />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            tabindex="-1"
            autocomplete="off"
          />

          <div class="grid gap-5">
            <label class="block">
              <span class="text-sm font-medium text-gray-300">Nombre</span>
              <input
                class="mt-2 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-gray-100 outline-none transition placeholder:text-gray-500 focus:border-amber-400"
                type="text"
                name="nombre"
                autocomplete="name"
                placeholder="Tu nombre"
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium text-gray-300">Correo</span>
              <input
                class="mt-2 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-gray-100 outline-none transition placeholder:text-gray-500 focus:border-amber-400"
                type="email"
                name="correo"
                autocomplete="email"
                placeholder="tu@email.com"
                required
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium text-gray-300">Mensaje</span>
              <textarea
                class="mt-2 min-h-40 w-full resize-y rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-gray-100 outline-none transition placeholder:text-gray-500 focus:border-amber-400"
                name="mensaje"
                placeholder="Cuéntanos cómo podemos ayudarte"
                required></textarea>
            </label>

            <div class="overflow-x-auto">
              <div
                class="h-captcha"
                data-captcha="true"
                data-lang="es"
                data-theme="dark"
              >
              </div>
            </div>

            <button
              class="rounded-lg bg-amber-400 px-5 py-3 text-sm font-semibold text-gray-900 transition hover:bg-gray-700 hover:text-white"
              type="submit"
            >
              Enviar mensaje
            </button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <script src="https://web3forms.com/client/script.js" async defer></script>
  <script>
    const form = document.getElementById("contact-form");

    form?.addEventListener("submit", (event) => {
      const hCaptchaResponse = form.querySelector<HTMLTextAreaElement>(
        'textarea[name="h-captcha-response"]'
      );

      if (!hCaptchaResponse?.value) {
        event.preventDefault();
        alert("Por favor completa el captcha antes de enviar el mensaje.");
      }
    });
  </script>
</BaseLayout>
