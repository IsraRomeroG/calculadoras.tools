---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import PageHero from "@components/shared/PageHero.astro";
import Panel from "@components/shared/Panel.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";

const description =
  "Learn how calculadoras.tools selects calculators, reviews formulas, uses sources, and handles sensitive content.";
const canonical = "/en/methodology";
const alternates = buildAlternateLinks(
  { es: "/metodologia", en: canonical },
  Astro.site ?? Astro.url,
);

const sections = [
  {
    title: "Calculator selection",
    content:
      "A calculator deserves its own page when it solves a specific task, can be explained with clear inputs, and provides distinct value. We do not create URLs merely to change a number, unit, or country without verifiable editorial value.",
  },
  {
    title: "Formulas, units, and examples",
    content:
      "When a tool depends on a formula, we document its variables, units, and assumptions. Examples use reproducible numbers so readers can compare them with the calculator's result.",
  },
  {
    title: "Sources",
    content:
      "We prioritize primary sources, public agencies, technical documentation, and references with visible authorship or methodology. Sources should support specific claims, not serve as decorative links.",
  },
  {
    title: "Result testing",
    content:
      "Calculators are tested with known scenarios, edge cases, and input validation. When a result is an estimate, the page should state that clearly.",
  },
  {
    title: "Sensitive content",
    content:
      "Health, finance, real estate, and tax content uses clearer warnings, stricter sources, and explicit limitations. Educational content does not replace medical diagnosis or financial, tax, legal, or mortgage advice.",
  },
];

const representativeLinks = [
  {
    href: "/en/math/percentage-calculator",
    label: "Percentage calculator",
  },
];
---

<BaseLayout
  locale="en"
  title="Methodology"
  description={description}
  canonical={canonical}
  alternates={alternates}
>
  <PageShell>
    <PageHero
      locale="en"
      title="Methodology"
      description="This page summarizes how we decide what to publish, how formulas and sources are reviewed, and which limitations are disclosed when a calculation may affect an important decision."
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Methodology" },
      ]}
      containerClass="px-6 py-10"
      breadcrumbClass="mb-8"
      titleClass="text-4xl font-bold tracking-tight md:text-6xl"
      descriptionClass="mt-6 text-lg leading-relaxed text-gray-400"
    />

    <Container as="section" class="px-6 py-14">
      <div class="grid gap-6">
        {
          sections.map((section) => (
            <Panel as="section" padding="lg">
              <h2 class="text-xl font-semibold">{section.title}</h2>
              <p class="mt-3 leading-relaxed text-gray-400">
                {section.content}
              </p>
            </Panel>
          ))
        }

        <Panel as="section" padding="lg">
          <h2 class="text-xl font-semibold">Published English example</h2>
          <ul class="mt-4 grid gap-3 text-sm text-gray-400 sm:grid-cols-2">
            {
              representativeLinks.map((link) => (
                <li>
                  <a class="text-amber-400 hover:text-amber-300" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </Panel>

        <Panel as="section" padding="lg">
          <h2 class="text-xl font-semibold">General notices</h2>
          <p class="mt-3 leading-relaxed text-gray-400">
            Before using results for personal decisions, read the{" "}
            <a
              class="text-amber-400 hover:text-amber-300"
              href="/en/notices/health"
            >
              health notice
            </a>{" "}
            and the{" "}
            <a
              class="text-amber-400 hover:text-amber-300"
              href="/en/notices/financial-tax"
            >
              financial and tax notice
            </a>.
          </p>
        </Panel>
      </div>
    </Container>
  </PageShell>
</BaseLayout>
