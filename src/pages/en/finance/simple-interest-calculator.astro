---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Simple interest calculator";
const description =
  "Calculate simple interest using daily, monthly or annual rates. Get the interest, total amount and step-by-step formula.";
const canonical = "/en/finance/simple-interest-calculator";
const spanishCanonical = "/finanzas/calculadora-de-interes-simple";
const alternates = buildAlternateLinks({ es: spanishCanonical, en: canonical }, Astro.site ?? Astro.url);
const faqs = [
  {
    question: "What is the simple interest formula?",
    answer:
      "Simple interest is calculated by multiplying the initial principal by the rate per period and the number of periods. Interest is not added to principal to generate more interest.",
  },
  {
    question: "How do I convert a monthly rate to an annual rate?",
    answer:
      "For simple interest, multiply the monthly rate by 12. For example, a 2% monthly simple rate equals 24% annually.",
  },
  {
    question: "What is the difference between simple and compound interest?",
    answer:
      "With simple interest, only the initial principal earns interest. With compound interest, accumulated interest also earns interest.",
  },
  {
    question: "What is the difference between using 360 and 365 days?",
    answer:
      "The commercial convention uses 360-day years and the civil convention uses 365. This choice can change the result when the term is in days and the rate is monthly or annual.",
  },
  {
    question: "Can this calculator be used for loans?",
    answer:
      "It works for loans that calculate interest on the initial principal without partial payments. For installment loans with a declining balance, use a loan calculator.",
  },
  {
    question: "Does simple interest include partial payments?",
    answer:
      "No. This calculator assumes the initial principal remains constant throughout the term.",
  },
];
const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical} locale="en" alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Simple interest calculator"
      description="Calculate the interest generated and the total to pay or receive, even when the rate and term use different periods."
      kicker="Finance"
      collapseBreadcrumbOnMobile
      containerClass="py-6 md:py-8"
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Finance", href: "/en/finance", optional: true },
        { label: "Simple interest calculator", truncate: true },
      ]}
    />

    <Container as="section" class="py-6 md:py-8">
      <section
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <div class="grid lg:grid-cols-[minmax(0,1.08fr)_minmax(19rem,0.92fr)]">
          <div class="p-4 sm:p-6">
            <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">
              Main calculation
            </p>
            <h2 id="calculator-heading" class="mt-2 text-2xl font-semibold">
              How much interest is generated?
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-gray-400">
              Enter the rate as you know it. The calculator automatically
              converts the term to the same period.
            </p>

            <form class="mt-6" novalidate data-simple-interest-form>
              <div class="grid gap-4">
                <div>
                  <label class="field-label" for="simple-principal">Initial principal</label>
                  <div class="field-shell">
                    <span class="field-affix">$</span>
                    <input
                      id="simple-principal"
                      class="field-input"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="10000"
                      aria-describedby="simple-principal-error"
                      data-field="principal"
                    />
                  </div>
                  <p id="simple-principal-error" class="field-error" data-error-for="principal"></p>
                </div>

                <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_10rem]">
                  <div>
                    <label class="field-label" for="simple-rate">Interest rate</label>
                    <div class="field-shell">
                      <input
                        id="simple-rate"
                        class="field-input pl-3"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="12"
                        aria-describedby="simple-rate-error"
                        data-field="rate"
                      />
                      <span class="field-affix">%</span>
                    </div>
                    <p id="simple-rate-error" class="field-error" data-error-for="rate"></p>
                  </div>
                  <div>
                    <label class="field-label" for="simple-rate-period">Rate period</label>
                    <select id="simple-rate-period" class="field" data-rate-period>
                      <option value="years">Annual</option>
                      <option value="months">Monthly</option>
                      <option value="days">Diaria</option>
                    </select>
                  </div>
                </div>

                <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_10rem]">
                  <div>
                    <label class="field-label" for="simple-duration">Term</label>
                    <input
                      id="simple-duration"
                      class="field"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="18"
                      aria-describedby="simple-duration-error"
                      data-field="duration"
                    />
                    <p id="simple-duration-error" class="field-error" data-error-for="duration"></p>
                  </div>
                  <div>
                    <label class="field-label" for="simple-duration-unit">Term unit</label>
                    <select id="simple-duration-unit" class="field" data-duration-unit>
                      <option value="months">Months</option>
                      <option value="days">Days</option>
                      <option value="years">Years</option>
                    </select>
                  </div>
                </div>
              </div>

              <details class="mt-5 rounded-lg border border-gray-700 bg-gray-900/60 p-4">
                <summary class="cursor-pointer font-semibold text-white">
                  Advanced options
                </summary>
                <div class="mt-4">
                  <label class="field-label" for="simple-day-convention">Day-count convention</label>
                  <select id="simple-day-convention" class="field" data-day-convention>
                    <option value="365">Civil year: 365 days</option>
                    <option value="360">Commercial year: 360 days</option>
                  </select>
                  <p class="field-help">
                    This only changes the result when the rate and term use units
                    that require converting days.
                  </p>
                </div>
              </details>

              <div class="mt-6 flex flex-col gap-3 border-t border-gray-800 pt-5 sm:flex-row sm:flex-wrap">
                <button class="primary-button" type="submit">Calculate interest</button>
                <button class="secondary-button" type="button" data-example>Use example</button>
                <button class="secondary-button" type="button" data-clear>Clear</button>
                <button class="secondary-button hidden" type="button" data-copy>
                  <span data-copy-label>Copy result</span>
                </button>
                <p class="sr-only" aria-live="polite" data-copy-status></p>
              </div>
            </form>
          </div>

          <aside
            class="border-t border-gray-800 bg-gray-900/70 p-4 sm:p-6 lg:border-l lg:border-t-0"
            aria-live="polite"
            data-result-region
          >
            <p class="text-sm font-semibold uppercase tracking-wide text-amber-400" data-result-kicker>
              Result
            </p>
            <p class="mt-3 break-words text-4xl font-bold leading-tight text-white" data-main-result>
              Enter the values
            </p>
            <p class="mt-3 text-sm leading-relaxed text-gray-300" data-explanation>
              The generated interest and total will appear here.
            </p>

            <div class="mt-5 grid grid-cols-2 gap-3" data-summary-grid>
              <div class="col-span-2 rounded-lg border border-gray-800 bg-gray-950/70 p-4 text-sm text-gray-400">
                You can use a daily, monthly or annual rate.
              </div>
            </div>

            <div class="mt-4 hidden rounded-lg border border-amber-400/40 bg-amber-400/10 p-4" data-warning>
              <p class="text-xs font-semibold uppercase tracking-wide text-amber-300">Check the calculation</p>
              <div class="mt-2 space-y-1 text-sm leading-relaxed text-amber-100" data-warning-lines></div>
            </div>

            <details class="mt-4 hidden rounded-lg border border-gray-800 p-4" data-calculation-details>
              <summary class="cursor-pointer text-sm font-semibold text-white">How it was calculated</summary>
              <div class="mt-3 space-y-2 text-sm leading-relaxed text-gray-400" data-calculation-lines></div>
            </details>

            <details class="mt-4 rounded-lg border border-gray-800 p-4">
              <summary class="cursor-pointer text-sm font-semibold text-white">Calculation assumptions</summary>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-gray-400">
                <li>Interest is always calculated on the initial principal.</li>
                <li>It does not include partial payments, fees, taxes, or late charges.</li>
                <li>The rate remains constant throughout the term.</li>
              </ul>
            </details>
          </aside>
        </div>
      </section>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-8">
      <SectionIntro
        title="How to read the result"
        description="Simple interest keeps the principal that generates the return or cost fixed."
        class="mb-5"
      />
      <div class="grid gap-4 md:grid-cols-3">
        <article class="info-card">
          <h2 class="font-semibold text-white">Interest generated</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            This is the cost or return accumulated over the full term.
          </p>
        </article>
        <article class="info-card">
          <h2 class="font-semibold text-white">Total to pay or receive</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Adds the initial principal and all interest generated.
          </p>
        </article>
        <article class="info-card">
          <h2 class="font-semibold text-white">Total interest over the term</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Shows what percentage of principal the accumulated interest represents.
          </p>
        </article>
      </div>
    </Container>

    <Container as="section" class="py-8">
      <div class="grid gap-5 md:grid-cols-2">
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5 sm:p-6">
          <h2 class="text-xl font-semibold">Simple interest formula</h2>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Interest = principal × rate per period × number of periods. The final
            amount is the initial principal plus the interest earned.
          </p>
        </article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5 sm:p-6">
          <h2 class="text-xl font-semibold">Need another type of calculation?</h2>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            For installments that reduce the balance, use the
            <a class="text-amber-300 underline hover:text-amber-200" href="/en/finance/loan-calculator">loan calculator</a>.
            To reinvest interest, use the
            <a class="text-amber-300 underline hover:text-amber-200" href="/en/finance/compound-interest-calculator">compound interest calculator</a>.
          </p>
        </article>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<style is:global>
  .field-label { display: block; font-size: .875rem; font-weight: 500; color: rgb(229 231 235); }
  .field, .field-shell { margin-top: .5rem; min-height: 3rem; width: 100%; border-radius: .5rem; border: 1px solid rgb(55 65 81); background: rgb(17 24 39); color: white; outline: none; }
  .field { padding: 0 1rem; }
  .field-shell { display: flex; align-items: center; }
  .field-input { min-height: 2.875rem; min-width: 0; width: 100%; background: transparent; padding: 0 .25rem; color: white; outline: none; }
  .field-affix { padding: 0 .75rem; color: rgb(107 114 128); }
  .field:focus, .field-shell:focus-within { border-color: rgb(251 191 36); box-shadow: 0 0 0 3px rgb(251 191 36 / .15); }
  .field-help { margin-top: .4rem; font-size: .75rem; line-height: 1.4; color: rgb(107 114 128); }
  .field-error { display: none; margin-top: .4rem; font-size: .8rem; color: rgb(252 165 165); }
  .field-error:not(:empty) { display: block; }
  .primary-button, .secondary-button { display: inline-flex; min-height: 3rem; align-items: center; justify-content: center; border-radius: .5rem; padding: .5rem 1rem; font-size: .875rem; font-weight: 700; }
  .primary-button { background: rgb(251 191 36); color: rgb(3 7 18); }
  .secondary-button { border: 1px solid rgb(55 65 81); color: rgb(229 231 235); }
  .info-card { border-radius: .5rem; border: 1px solid rgb(55 65 81); background: rgb(3 7 18); padding: 1.25rem; }
</style>

<script>
  import {
    calculateSimpleInterest,
    formatCurrency,
    formatNumber,
    formatPercent,
    parseDurationInput,
    parseMoneyInput,
    parseRateInput,
  } from "@lib/calculators/finanzas/calculadora-de-interes-simple/simpleInterest.en";

  const form = document.querySelector("[data-simple-interest-form]");
  const fields = Object.fromEntries(
    [...document.querySelectorAll("[data-field]")].map((input) => [input.dataset.field, input]),
  );
  const ratePeriod = document.querySelector("[data-rate-period]");
  const durationUnit = document.querySelector("[data-duration-unit]");
  const dayConvention = document.querySelector("[data-day-convention]");
  const resultKicker = document.querySelector("[data-result-kicker]");
  const mainResult = document.querySelector("[data-main-result]");
  const explanation = document.querySelector("[data-explanation]");
  const summaryGrid = document.querySelector("[data-summary-grid]");
  const warning = document.querySelector("[data-warning]");
  const warningLines = document.querySelector("[data-warning-lines]");
  const calculationDetails = document.querySelector("[data-calculation-details]");
  const calculationLines = document.querySelector("[data-calculation-lines]");
  const copyButton = document.querySelector("[data-copy]");
  const copyLabel = document.querySelector("[data-copy-label]");
  const copyStatus = document.querySelector("[data-copy-status]");
  let copyText = "";

  const ERROR_MESSAGES = {
    required: "This field is required.",
    invalid: "Enter a valid number.",
    negative: "The value cannot be negative.",
    too_many_decimals: "Use fewer decimal places.",
    greater_than_zero: "The value must be greater than zero.",
    rate_high: "The rate cannot exceed 200% per period.",
  };
  const UNIT_LABELS = {
    days: { singular: "day", plural: "days", rate: "daily" },
    months: { singular: "month", plural: "months", rate: "monthly" },
    years: { singular: "year", plural: "years", rate: "annual" },
  };

  function calculate({ showRequired = false } = {}) {
    clearErrors();
    const principal = parseMoneyInput(fields.principal.value);
    const rate = parseRateInput(fields.rate.value);
    const duration = parseDurationInput(fields.duration.value);
    const parsed = { principal, rate, duration };
    const errors = {};

    Object.entries(parsed).forEach(([key, value]) => {
      if (!value.ok && (showRequired || value.error !== "required")) errors[key] = value.error;
    });
    if (principal.ok && principal.value <= 0) errors.principal = "greater_than_zero";
    if (rate.ok && rate.value > 200) errors.rate = "rate_high";
    if (duration.ok && duration.value <= 0) errors.duration = "greater_than_zero";
    showErrors(errors);

    const hasEmpty = Object.values(parsed).some((value) => !value.ok && value.error === "required");
    if (Object.keys(errors).length || hasEmpty || !principal.ok || !rate.ok || !duration.ok) {
      Object.keys(errors).length ? setInvalidState() : setInitialState();
      return;
    }

    const input = {
      principal: principal.value,
      rate: rate.value,
      ratePeriod: ratePeriod.value,
      duration: duration.value,
      durationUnit: durationUnit.value,
      dayConvention: Number(dayConvention.value),
    };
    renderResult(input, calculateSimpleInterest(input));
  }

  function renderResult(input, result) {
    const durationLabel = unitLabel(input.durationUnit, input.duration);
    const rateLabel = UNIT_LABELS[input.ratePeriod].rate;
    const interestUnitLabel = UNIT_LABELS[input.durationUnit].singular;
    resultKicker.textContent = "Interest generated";
    mainResult.textContent = formatCurrency(result.interest);
    explanation.textContent = `With ${formatCurrency(input.principal)}, a ${rateLabel} simple rate of ${formatPercent(input.rate)} and a term of ${formatNumber(input.duration)} ${durationLabel}, the total to pay or receive would be ${formatCurrency(result.finalAmount)}.`;
    summaryGrid.innerHTML = [
      ["Total to pay or receive", formatCurrency(result.finalAmount)],
      ["Total interest over the term", formatPercent(result.totalInterestPercent)],
      [`Interest per ${interestUnitLabel}`, formatCurrency(result.interestPerDurationUnit)],
      ["Equivalent annual simple rate", formatPercent(result.annualSimpleRate)],
    ].map(([label, value]) => summary(label, value)).join("");
    renderWarnings(result.warnings);
    calculationLines.innerHTML = [
      `Equivalent rate periods: ${formatNumber(result.durationInRatePeriods)}`,
      `Interest = ${formatCurrency(input.principal)} × ${formatPercent(input.rate)} × ${formatNumber(result.durationInRatePeriods)} = ${formatCurrency(result.interest)}`,
      `Total = ${formatCurrency(input.principal)} + ${formatCurrency(result.interest)} = ${formatCurrency(result.finalAmount)}`,
      `Convention used: ${input.dayConvention} days per year.`,
    ].map((line) => `<p>${escapeHtml(line)}</p>`).join("");
    calculationDetails.classList.remove("hidden");
    copyText = buildCopyText(input, result, durationLabel, rateLabel);
    copyButton.classList.remove("hidden");
  }

  function renderWarnings(warnings) {
    warning.classList.toggle("hidden", warnings.length === 0);
    warningLines.innerHTML = warnings.map((item) => `<p>${escapeHtml(item)}</p>`).join("");
  }

  function buildCopyText(input, result, durationLabel, rateLabel) {
    return [
      "Simple interest calculator - calculadoras.tools",
      `Initial principal: ${formatCurrency(input.principal)}`,
      `Simple ${rateLabel} rate: ${formatPercent(input.rate)}`,
      `Term: ${formatNumber(input.duration)} ${durationLabel}`,
      `Convention: ${input.dayConvention} days`,
      `Interest generated: ${formatCurrency(result.interest)}`,
      `Total to pay or receive: ${formatCurrency(result.finalAmount)}`,
      `Total interest over the term: ${formatPercent(result.totalInterestPercent)}`,
      "",
      "Assumption: principal remains constant and interest is not capitalized.",
    ].join("\n");
  }

  function unitLabel(unit, value) {
    return Math.abs(value - 1) < Number.EPSILON ? UNIT_LABELS[unit].singular : UNIT_LABELS[unit].plural;
  }

  function summary(label, value) {
    return `<div class="rounded-lg border border-gray-800 bg-gray-950/70 p-3"><span class="block text-xs font-semibold uppercase tracking-wide text-gray-500">${escapeHtml(label)}</span><span class="mt-2 block break-words text-base font-semibold text-white">${escapeHtml(value)}</span></div>`;
  }

  function fillExample() {
    fields.principal.value = "10000";
    fields.rate.value = "12";
    ratePeriod.value = "years";
    fields.duration.value = "18";
    durationUnit.value = "months";
    dayConvention.value = "365";
    calculate();
  }

  function clearAll() {
    Object.values(fields).forEach((input) => { input.value = ""; });
    ratePeriod.value = "years";
    durationUnit.value = "months";
    dayConvention.value = "365";
    clearErrors();
    setInitialState();
  }

  function clearErrors() {
    document.querySelectorAll("[data-error-for]").forEach((element) => { element.textContent = ""; });
    Object.values(fields).forEach((input) => input.removeAttribute("aria-invalid"));
  }

  function showErrors(errors) {
    Object.entries(errors).forEach(([field, error]) => {
      const element = document.querySelector(`[data-error-for="${field}"]`);
      if (element) element.textContent = ERROR_MESSAGES[error] ?? ERROR_MESSAGES.invalid;
      fields[field]?.setAttribute("aria-invalid", "true");
    });
  }

  function setInitialState() {
    resultKicker.textContent = "Result";
    mainResult.textContent = "Enter the values";
    explanation.textContent = "The generated interest and total will appear here.";
    summaryGrid.innerHTML = `<div class="col-span-2 rounded-lg border border-gray-800 bg-gray-950/70 p-4 text-sm text-gray-400">You can use a daily, monthly or annual rate.</div>`;
    warning.classList.add("hidden");
    calculationDetails.classList.add("hidden");
    copyButton.classList.add("hidden");
    copyText = "";
  }

  function setInvalidState() {
    resultKicker.textContent = "Check the fields";
    mainResult.textContent = "Cannot calculate";
    explanation.textContent = "Correct the highlighted values to continue.";
    summaryGrid.innerHTML = "";
    warning.classList.add("hidden");
    calculationDetails.classList.add("hidden");
    copyButton.classList.add("hidden");
    copyText = "";
  }

  async function copyResult() {
    if (!copyText) return;
    try {
      await navigator.clipboard.writeText(copyText);
      copyLabel.textContent = "Copied";
      copyStatus.textContent = "Result copied.";
      window.setTimeout(() => {
        copyLabel.textContent = "Copy result";
        copyStatus.textContent = "";
      }, 2000);
    } catch {
      copyStatus.textContent = "Could not copy the result.";
    }
  }

  function escapeHtml(value) {
    return String(value).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    calculate({ showRequired: true });
  });
  Object.values(fields).forEach((input) => input.addEventListener("input", () => calculate()));
  [ratePeriod, durationUnit, dayConvention].forEach((select) => select.addEventListener("change", () => calculate()));
  document.querySelector("[data-example]").addEventListener("click", fillExample);
  document.querySelector("[data-clear]").addEventListener("click", clearAll);
  copyButton.addEventListener("click", copyResult);
</script>

