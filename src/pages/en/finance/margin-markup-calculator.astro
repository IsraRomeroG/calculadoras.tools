---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Margin, markup and selling price calculator";
const description =
  "Calculate margin, markup, profit, minimum price and target selling price including costs and percentage fees.";
const canonical = "/en/finance/margin-markup-calculator";
const spanishCanonical = "/finanzas/calculadora-de-margen-y-markup";
const alternates = buildAlternateLinks({ es: spanishCanonical, en: canonical }, Astro.site ?? Astro.url);
const faqs = [
  {
    question: "What is the difference between margin and markup?",
    answer:
      "Margin divides profit by selling price. Markup divides profit by total effective cost. A 40% margin therefore equals a 66.67% markup, not 40%.",
  },
  {
    question: "How do I calculate a selling price from a target margin?",
    answer:
      "The calculator adds direct per-sale costs and the percentage fee, then finds the minimum price that reaches the specified margin.",
  },
  {
    question: "How do fees affect margin?",
    answer:
      "A percentage fee grows with the selling price. It must be included in the target-price formula rather than added as a fixed amount.",
  },
  {
    question: "Which costs should I include?",
    answer:
      "Include costs directly associated with a sale: product, materials, labor, business-paid shipping, packaging, fixed charges and other direct costs.",
  },
  {
    question: "What happens if I sell below cost?",
    answer:
      "The calculator will show the estimated loss and minimum chargeable price needed to cover entered costs.",
  },
  {
    question: "What is the largest discount I can offer without a loss?",
    answer:
      "It is the difference between the reference price and minimum chargeable price. It excludes overhead or taxes you did not enter.",
  },
  {
    question: "Does the result represent net profit?",
    answer:
      "No. It is estimated profit per sale before taxes and business overhead unless you manually allocate them to costs.",
  },
];
const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical} locale="en" alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Margin, markup and selling price calculator"
      description="Analyze profit per sale or calculate a price that reaches your target margin or markup."
      kicker="Finance"
      collapseBreadcrumbOnMobile
      containerClass="py-6 md:py-8"
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Finance", href: "/en/finance", optional: true },
        { label: "Margin and markup", truncate: true },
      ]}
    />

    <Container as="section" class="py-6 md:py-8">
      <section
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <div class="grid lg:grid-cols-[minmax(0,1.08fr)_minmax(19rem,0.92fr)]">
          <div class="p-4 sm:p-6">
            <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">
              Price and profitability per sale
            </p>
            <h2 id="calculator-heading" class="mt-2 text-2xl font-semibold">
              What do you want to calculate?
            </h2>

            <div
              class="mt-5 grid grid-cols-3 rounded-lg border border-gray-700 bg-gray-900 p-1"
              role="tablist"
              aria-label="Calculation mode"
            >
              <button class="mode-button is-active" type="button" role="tab" aria-selected="true" data-mode-button="analyze">
                Analizar
              </button>
              <button class="mode-button" type="button" role="tab" aria-selected="false" data-mode-button="margin">
                By margin
              </button>
              <button class="mode-button" type="button" role="tab" aria-selected="false" data-mode-button="markup">
                By markup
              </button>
            </div>

            <form class="mt-6" novalidate data-margin-form>
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="field-label" for="margin-base-cost">Base cost per sale</label>
                  <div class="field-shell">
                    <span class="field-affix">$</span>
                    <input id="margin-base-cost" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="300" data-field="baseCost" />
                  </div>
                  <p class="field-help">Product, materials or labor associated with one sale.</p>
                  <p class="field-error" data-error-for="baseCost"></p>
                </div>

                <div data-mode-field="analyze">
                  <label class="field-label" for="margin-price">Selling price</label>
                  <div class="field-shell">
                    <span class="field-affix">$</span>
                    <input id="margin-price" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="500" data-field="price" />
                  </div>
                  <p class="field-error" data-error-for="price"></p>
                </div>

                <div class="hidden" data-mode-field="margin">
                  <label class="field-label" for="margin-target">Target margin</label>
                  <div class="field-shell">
                    <input id="margin-target" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="40" data-field="targetMargin" />
                    <span class="field-affix">%</span>
                  </div>
                  <p class="field-help">Profit percentage of the final price.</p>
                  <p class="field-error" data-error-for="targetMargin"></p>
                </div>

                <div class="hidden" data-mode-field="markup">
                  <label class="field-label" for="markup-target">Target markup</label>
                  <div class="field-shell">
                    <input id="markup-target" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="50" data-field="targetMarkup" />
                    <span class="field-affix">%</span>
                  </div>
                  <p class="field-help">Profit percentage of total effective cost.</p>
                  <p class="field-error" data-error-for="targetMarkup"></p>
                </div>
              </div>

              <details class="mt-5 rounded-lg border border-gray-700 bg-gray-900/60 p-4" data-options>
                <summary class="cursor-pointer font-semibold text-white" data-options-summary>
                  Additional costs: $0.00
                </summary>
                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                  <div>
                    <label class="field-label" for="margin-shipping">Business-paid shipping</label>
                    <div class="field-shell">
                      <span class="field-affix">$</span>
                      <input id="margin-shipping" class="field-input" type="text" inputmode="decimal" value="0" data-field="shipping" />
                    </div>
                    <p class="field-error" data-error-for="shipping"></p>
                  </div>
                  <div>
                    <label class="field-label" for="margin-packaging">Empaque</label>
                    <div class="field-shell">
                      <span class="field-affix">$</span>
                      <input id="margin-packaging" class="field-input" type="text" inputmode="decimal" value="0" data-field="packaging" />
                    </div>
                    <p class="field-error" data-error-for="packaging"></p>
                  </div>
                  <div>
                    <label class="field-label" for="margin-fixed-fee">Fixed fee per sale</label>
                    <div class="field-shell">
                      <span class="field-affix">$</span>
                      <input id="margin-fixed-fee" class="field-input" type="text" inputmode="decimal" value="0" data-field="fixedFee" />
                    </div>
                    <p class="field-error" data-error-for="fixedFee"></p>
                  </div>
                  <div>
                    <label class="field-label" for="margin-other-costs">Other direct costs</label>
                    <div class="field-shell">
                      <span class="field-affix">$</span>
                      <input id="margin-other-costs" class="field-input" type="text" inputmode="decimal" value="0" data-field="otherCosts" />
                    </div>
                    <p class="field-error" data-error-for="otherCosts"></p>
                  </div>
                  <div>
                    <label class="field-label" for="margin-commission">Percentage fee</label>
                    <div class="field-shell">
                      <input id="margin-commission" class="field-input" type="text" inputmode="decimal" value="0" data-field="commissionRate" />
                      <span class="field-affix">%</span>
                    </div>
                    <p class="field-help">Applied to the final selling price.</p>
                    <p class="field-error" data-error-for="commissionRate"></p>
                  </div>
                  <div>
                    <label class="field-label" for="margin-rounding">Commercial rounding</label>
                    <select id="margin-rounding" class="field" data-rounding>
                      <option value="integer">Up to the next whole number</option>
                      <option value="cent">Up to the next cent</option>
                      <option value="multiple_5">Up to the next multiple of 5</option>
                      <option value="ending_99">.99 ending</option>
                    </select>
                    <p class="field-help">Only affects suggested prices; it never lowers them.</p>
                  </div>
                </div>
              </details>

              <div class="mt-6 flex flex-col gap-3 border-t border-gray-800 pt-5 sm:flex-row sm:flex-wrap">
                <button class="primary-button sm:min-w-40" type="submit">Calculate</button>
                <button class="secondary-button" type="button" data-example>Use example</button>
                <button class="secondary-button" type="button" data-clear>Clear</button>
                <button class="secondary-button hidden" type="button" data-copy>
                  <span data-copy-label>Copy summary</span>
                </button>
                <p class="sr-only" aria-live="polite" data-copy-status></p>
              </div>
            </form>
          </div>

          <aside
            class="border-t border-gray-800 bg-gray-900/70 p-4 sm:p-6 lg:border-l lg:border-t-0"
            aria-live="polite"
            data-result-region
          >
            <p class="text-sm font-semibold uppercase tracking-wide text-amber-400" data-result-kicker>
              Result
            </p>
            <p class="mt-3 break-words text-4xl font-bold leading-tight text-white" data-main-result>
              Enter the values
            </p>
            <p class="mt-3 text-sm leading-relaxed text-gray-300" data-interpretation>
              You will see profit per sale or the price you need to charge.
            </p>

            <div class="mt-5 grid grid-cols-2 gap-3" data-summary-grid>
              <div class="col-span-2 rounded-lg border border-gray-800 bg-gray-950/70 p-4 text-sm text-gray-400">
                Margin is calculated on price. Markup is calculated on total effective cost.
              </div>
            </div>

            <div class="mt-4 hidden rounded-lg border border-sky-400/40 bg-sky-400/10 p-4" data-conversion-card>
              <p class="text-xs font-semibold uppercase tracking-wide text-sky-300">Margin vs. markup</p>
              <p class="mt-2 text-sm leading-relaxed text-sky-100" data-conversion-text></p>
            </div>

            <details class="mt-4 hidden rounded-lg border border-gray-800 p-4" data-breakdown-details>
              <summary class="cursor-pointer text-sm font-semibold text-white">Price breakdown</summary>
              <div class="mt-3 space-y-3" data-breakdown-list></div>
            </details>

            <details class="mt-4 hidden rounded-lg border border-gray-800 p-4" data-calculation-details>
              <summary class="cursor-pointer text-sm font-semibold text-white">How it was calculated</summary>
              <div class="mt-3 space-y-2 text-sm leading-relaxed text-gray-400" data-calculation-lines></div>
            </details>

            <p class="mt-4 text-xs leading-relaxed text-gray-500">
              Estimated profit before taxes and business overhead.
            </p>
          </aside>
        </div>
      </section>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="hidden py-6 md:py-8" data-scenarios-section>
      <SectionIntro
        title="Quick margin scenarios"
        description="Compare suggested prices using the same costs, fee and rounding."
        class="mb-5"
      />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-scenarios-grid></div>
    </Container>

    <Container as="section" class="py-8">
      <SectionIntro
        title="Margin and markup are not the same"
        description="Both metrics show profitability but use different bases."
        class="mb-5"
      />
      <div class="grid gap-4 md:grid-cols-3">
        <article class="info-card">
          <h2 class="font-semibold text-white">Margin</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Divides estimated profit by selling price. It shows what share of revenue remains after direct costs.
          </p>
        </article>
        <article class="info-card">
          <h2 class="font-semibold text-white">Markup</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Divides estimated profit by total effective cost. It shows how much was added above cost.
          </p>
        </article>
        <article class="info-card">
          <h2 class="font-semibold text-white">Minimum price per sale</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Covers entered costs, but not necessarily rent, payroll, taxes or other business expenses.
          </p>
        </article>
      </div>
    </Container>

    <Container as="section" class="py-8">
      <div class="grid gap-5 md:grid-cols-2">
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5 sm:p-6">
          <h2 class="text-xl font-semibold">How fees affect pricing</h2>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            A percentage fee rises with price. This calculator includes it in the target price instead of adding it as a fixed cost.
          </p>
        </article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5 sm:p-6">
          <h2 class="text-xl font-semibold">Which costs to include</h2>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Include each cost directly related to a sale only once. To cover business overhead, allocate it per sale or complement the analysis with the <a class="font-semibold text-amber-400 underline underline-offset-4" href="/en/finance/break-even-calculator">break-even calculator</a>.
          </p>
        </article>
      </div>
      <p class="mt-5 text-sm text-gray-400">
        You can also use the <a class="text-amber-400 underline underline-offset-4" href="/en/finance/roi-calculator">ROI calculator</a> to analyze a project's full return.
      </p>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<style is:global>
  .field-label { display: block; font-size: .875rem; font-weight: 500; color: rgb(229 231 235); }
  .field, .field-shell { margin-top: .5rem; min-height: 3rem; width: 100%; border-radius: .5rem; border: 1px solid rgb(55 65 81); background: rgb(17 24 39); color: white; outline: none; }
  .field { padding: 0 1rem; }
  .field-shell { display: flex; align-items: center; }
  .field-input { min-height: 2.875rem; min-width: 0; width: 100%; background: transparent; padding: 0 .25rem; color: white; outline: none; }
  .field-affix { flex: none; padding: 0 .75rem; color: rgb(107 114 128); }
  .field:focus, .field-shell:focus-within { border-color: rgb(251 191 36); box-shadow: 0 0 0 3px rgb(251 191 36 / .15); }
  .field-help { margin-top: .4rem; font-size: .75rem; line-height: 1.4; color: rgb(107 114 128); }
  .field-error { display: none; margin-top: .4rem; font-size: .8rem; color: rgb(252 165 165); }
  .field-error:not(:empty) { display: block; }
  .mode-button { min-height: 2.75rem; border-radius: .4rem; padding: .5rem .25rem; font-size: .75rem; font-weight: 700; color: rgb(156 163 175); }
  .mode-button.is-active { background: rgb(251 191 36); color: rgb(3 7 18); }
  .primary-button { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; border-radius: .5rem; background: rgb(251 191 36); padding: .5rem 1rem; font-size: .875rem; font-weight: 700; color: rgb(3 7 18); }
  .secondary-button { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; border-radius: .5rem; border: 1px solid rgb(55 65 81); padding: .5rem 1rem; font-size: .875rem; font-weight: 600; color: rgb(229 231 235); }
  .info-card { border-radius: .5rem; border: 1px solid rgb(55 65 81); background: rgb(3 7 18); padding: 1.25rem; }
  @media (min-width: 360px) { .mode-button { padding-inline: .5rem; font-size: .8rem; } }
</style>

<script>
  import {
    analyzeSale,
    buildMarginScenarios,
    calculatePriceForMargin,
    calculatePriceForMarkup,
    formatCurrency,
    formatExactPrice,
    formatPercent,
    parseMoneyInput,
    parsePercentInput,
    sumFixedCosts,
  } from "@lib/calculators/finanzas/calculadora-de-margen-y-markup/marginMarkup.en";

  const form = document.querySelector("[data-margin-form]");
  const roundingSelect = document.querySelector("[data-rounding]");
  const resultKicker = document.querySelector("[data-result-kicker]");
  const mainResult = document.querySelector("[data-main-result]");
  const interpretation = document.querySelector("[data-interpretation]");
  const summaryGrid = document.querySelector("[data-summary-grid]");
  const conversionCard = document.querySelector("[data-conversion-card]");
  const conversionText = document.querySelector("[data-conversion-text]");
  const breakdownDetails = document.querySelector("[data-breakdown-details]");
  const breakdownList = document.querySelector("[data-breakdown-list]");
  const calculationDetails = document.querySelector("[data-calculation-details]");
  const calculationLines = document.querySelector("[data-calculation-lines]");
  const scenariosSection = document.querySelector("[data-scenarios-section]");
  const scenariosGrid = document.querySelector("[data-scenarios-grid]");
  const optionsSummary = document.querySelector("[data-options-summary]");
  const copyButton = document.querySelector("[data-copy]");
  const copyLabel = document.querySelector("[data-copy-label]");
  const copyStatus = document.querySelector("[data-copy-status]");
  const fields = Object.fromEntries(
    [...document.querySelectorAll("[data-field]")].map((input) => [input.dataset.field, input]),
  );

  let mode = "analyze";
  let copyText = "";

  const MONEY_FIELDS = ["baseCost", "shipping", "packaging", "fixedFee", "otherCosts"];
  const OPTIONAL_MONEY_FIELDS = ["shipping", "packaging", "fixedFee", "otherCosts"];
  const ERROR_MESSAGES = {
    required: "Enter a value to continue.",
    invalid: "Enter a valid number.",
    negative: "The value cannot be negative.",
    too_many_decimals: "Use fewer decimal places.",
    greater_than_zero: "Price must be greater than zero.",
    commission_limit: "The fee must be below 100%.",
    margin_limit: "Margin must be below 100%.",
    target_costs_zero: "Add at least one per-sale cost to calculate a target price.",
    margin_impossible: "The fee and margin total 100% or more; no price can reach that target.",
    markup_impossible: "With this fee, no price can reach the specified markup.",
  };

  function setMode(nextMode) {
    mode = nextMode;
    document.querySelectorAll("[data-mode-button]").forEach((button) => {
      const active = button.dataset.modeButton === mode;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-selected", String(active));
    });
    document.querySelectorAll("[data-mode-field]").forEach((element) => {
      element.classList.toggle("hidden", element.dataset.modeField !== mode);
    });
    clearErrors();
    setInitialState();
  }

  function calculate() {
    clearErrors();
    const errors = {};
    const costs = parseCosts(errors);
    const rounding = roundingSelect.value;
    let result;

    if (mode === "analyze") {
      const price = parseRequired("price", parseMoneyInput, errors);
      if (price !== undefined && price <= 0) errors.price = "greater_than_zero";
      if (!hasErrors(errors) && costs) result = { analysis: analyzeSale(costs, price), exactPrice: null, commercialPrice: price };
    }

    if (mode === "margin") {
      const targetMargin = parseRequired("targetMargin", parsePercentInput, errors);
      if (targetMargin !== undefined && targetMargin >= 100) errors.targetMargin = "margin_limit";
      if (costs && sumFixedCosts(costs) <= 0) errors.baseCost = "target_costs_zero";
      if (costs && targetMargin !== undefined) {
        const denominator = 1 - costs.commissionRate / 100 - targetMargin / 100;
        if (denominator <= Number.EPSILON * 10) errors.targetMargin = "margin_impossible";
      }
      if (!hasErrors(errors) && costs) result = calculatePriceForMargin(costs, targetMargin, rounding);
    }

    if (mode === "markup") {
      const targetMarkup = parseRequired("targetMarkup", parsePercentInput, errors);
      if (costs && sumFixedCosts(costs) <= 0) errors.baseCost = "target_costs_zero";
      if (costs && targetMarkup !== undefined) {
        const denominator = 1 - (costs.commissionRate / 100) * (1 + targetMarkup / 100);
        if (denominator <= Number.EPSILON * 10) errors.targetMarkup = "markup_impossible";
      }
      if (!hasErrors(errors) && costs) result = calculatePriceForMarkup(costs, targetMarkup, rounding);
    }

    showErrors(errors);
    if (!result || !costs || hasErrors(errors)) {
      setInvalidState(errors);
      return;
    }

    renderResult(costs, result);
  }

  function parseCosts(errors) {
    const values = {};
    MONEY_FIELDS.forEach((field) => {
      values[field] = OPTIONAL_MONEY_FIELDS.includes(field)
        ? parseOptional(field, parseMoneyInput, errors, 0)
        : parseRequired(field, parseMoneyInput, errors);
    });
    values.commissionRate = parseOptional("commissionRate", parsePercentInput, errors, 0);
    if (values.commissionRate !== undefined && values.commissionRate >= 100) errors.commissionRate = "commission_limit";
    if (hasErrors(errors)) return null;
    return values;
  }

  function parseRequired(field, parser, errors) {
    const parsed = parser(fields[field].value);
    if (!parsed.ok) {
      errors[field] = parsed.error;
      return undefined;
    }
    return parsed.value;
  }

  function parseOptional(field, parser, errors, fallback) {
    if (!fields[field].value.trim()) return fallback;
    return parseRequired(field, parser, errors);
  }

  function renderResult(costs, result) {
    const analysis = result.analysis;
    const targetMode = mode !== "analyze";
    resultKicker.textContent = targetMode
      ? "Suggested retail price"
      : analysis.status === "gain"
        ? "Profit"
        : analysis.status === "loss"
          ? "Loss"
          : "Break-even point";
    mainResult.textContent = targetMode ? formatCurrency(result.commercialPrice) : formatPercent(analysis.marginPercent);
    interpretation.textContent = buildInterpretation(result);

    const items = targetMode
      ? [
          ["Exact price", formatExactPrice(result.exactPrice)],
          [mode === "margin" ? "Actual margin" : "Actual markup", mode === "margin" ? formatPercent(analysis.marginPercent) : formatNullablePercent(analysis.markupPercent)],
          ["Profit per sale", formatSignedCurrency(analysis.profit)],
          [mode === "margin" ? "Resulting markup" : "Resulting margin", mode === "margin" ? formatNullablePercent(analysis.markupPercent) : formatPercent(analysis.marginPercent)],
        ]
      : [
          [analysis.profit >= 0 ? "Profit per sale" : "Loss per sale", formatCurrency(Math.abs(analysis.profit))],
          ["Markup", formatNullablePercent(analysis.markupPercent)],
          ["Total effective cost", formatCurrency(analysis.effectiveCost)],
          ["Costs as share of price", formatPercent(analysis.costPercent)],
        ];
    items.push(
      ["Minimum price per sale", formatCurrency(analysis.breakEvenPrice)],
      ["Maximum discount without a loss", `${formatCurrency(analysis.maxDiscountAmount)} · ${formatPercent(analysis.maxDiscountPercent)}`],
    );
    summaryGrid.innerHTML = items.map(([label, value]) => summary(label, value)).join("");

    conversionText.textContent = analysis.markupPercent === null
      ? `The margin is ${formatPercent(analysis.marginPercent)}. Markup is unavailable because total effective cost is zero.`
      : `A margin of ${formatPercent(analysis.marginPercent)} equals a markup of ${formatPercent(analysis.markupPercent)} with the entered costs.`;
    conversionCard.classList.remove("hidden");
    renderBreakdown(costs, analysis);
    renderCalculation(costs, result);
    renderScenarios(costs);
    copyText = buildCopyText(costs, result);
    copyButton.classList.remove("hidden");
  }

  function buildInterpretation(result) {
    const analysis = result.analysis;
    if (mode !== "analyze") {
      return `The exact price is ${formatExactPrice(result.exactPrice)}. The suggested price was rounded up and leaves approximately ${formatCurrency(analysis.profit)} per sale.`;
    }
    if (analysis.status === "break_even") return "This price exactly covers entered costs. It leaves no profit per sale.";
    if (analysis.status === "loss") return `You lose approximately ${formatCurrency(Math.abs(analysis.profit))} per sale. You need to charge at least ${formatCurrency(analysis.breakEvenPrice)} to cover entered costs.`;
    return `After entered costs, you earn approximately ${formatCurrency(analysis.profit)} per sale.`;
  }

  function renderBreakdown(costs, analysis) {
    const rows = [
      ["Base cost", costs.baseCost],
      ["Shipping", costs.shipping],
      ["Empaque", costs.packaging],
      ["Fixed fee", costs.fixedFee],
      ["Other costs", costs.otherCosts],
      [`Fee (${formatPercent(costs.commissionRate)})`, analysis.commissionAmount],
      [analysis.profit >= 0 ? "Estimated profit" : "Estimated loss", analysis.profit],
    ];
    breakdownList.innerHTML = rows
      .filter(([, value]) => value !== 0 || rows.length === 1)
      .map(([label, value]) => breakdownRow(label, value, analysis.price))
      .join("");
    breakdownDetails.classList.remove("hidden");
  }

  function renderCalculation(costs, result) {
    const analysis = result.analysis;
    const lines = [
      `Fixed costs per sale = ${formatCurrency(analysis.fixedCosts)}`,
      `Fee = ${formatCurrency(analysis.price)} × ${formatPercent(costs.commissionRate)} = ${formatCurrency(analysis.commissionAmount)}`,
      `Estimated profit = ${formatCurrency(analysis.price)} − ${formatCurrency(analysis.effectiveCost)} = ${formatSignedCurrency(analysis.profit)}`,
      `Margin = profit ÷ price = ${formatPercent(analysis.marginPercent)}`,
      `Markup = profit ÷ effective total cost = ${formatNullablePercent(analysis.markupPercent)}`,
    ];
    if (mode !== "analyze") lines.unshift(`Exact price before rounding = ${formatExactPrice(result.exactPrice)}`);
    calculationLines.innerHTML = lines.map((line) => `<p>${escapeHtml(line)}</p>`).join("");
    calculationDetails.classList.remove("hidden");
  }

  function renderScenarios(costs) {
    if (sumFixedCosts(costs) <= 0) {
      scenariosSection.classList.add("hidden");
      return;
    }
    const scenarios = buildMarginScenarios(costs, roundingSelect.value);
    scenariosGrid.innerHTML = scenarios.length
      ? scenarios.map((scenario) => `
          <article class="rounded-lg border border-gray-700 bg-gray-950 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-amber-400">Margin ${escapeHtml(formatPercent(scenario.targetMargin))}</p>
            <p class="mt-2 text-2xl font-bold text-white">${escapeHtml(formatCurrency(scenario.commercialPrice))}</p>
            <p class="mt-3 text-sm text-gray-400">Profit: <span class="font-semibold text-gray-200">${escapeHtml(formatCurrency(scenario.analysis.profit))}</span></p>
            <p class="mt-1 text-sm text-gray-400">Markup: <span class="font-semibold text-gray-200">${escapeHtml(formatNullablePercent(scenario.analysis.markupPercent))}</span></p>
          </article>`).join("")
      : `<p class="text-sm text-gray-400">No scenarios are possible with the entered fee.</p>`;
    scenariosSection.classList.remove("hidden");
  }

  function buildCopyText(costs, result) {
    const analysis = result.analysis;
    const lines = [
      "Margin and markup calculator - calculadoras.tools",
      `Modo: ${mode === "analyze" ? "Analyze price" : mode === "margin" ? "By target margin" : "By target markup"}`,
      `Fixed costs per sale: ${formatCurrency(analysis.fixedCosts)}`,
      `Fee: ${formatPercent(costs.commissionRate)} (${formatCurrency(analysis.commissionAmount)})`,
      `Price: ${formatCurrency(analysis.price)}`,
      `Estimated profit: ${formatSignedCurrency(analysis.profit)}`,
      `Margin: ${formatPercent(analysis.marginPercent)}`,
      `Markup: ${formatNullablePercent(analysis.markupPercent)}`,
      `Minimum price per sale: ${formatCurrency(analysis.breakEvenPrice)}`,
      "",
      "Estimate before taxes and business overhead.",
    ];
    return lines.join("\n");
  }

  function fillExample() {
    fields.baseCost.value = "300";
    fields.shipping.value = "30";
    fields.packaging.value = "15";
    fields.fixedFee.value = "5";
    fields.otherCosts.value = "0";
    fields.commissionRate.value = "10";
    if (mode === "analyze") fields.price.value = "600";
    if (mode === "margin") fields.targetMargin.value = "30";
    if (mode === "markup") fields.targetMarkup.value = "50";
    roundingSelect.value = "integer";
    updateOptionsSummary();
    calculate();
  }

  function clearAll() {
    const hasMeaningfulData = Object.values(fields).some((input) => input.value.trim() && input.value.trim() !== "0");
    if (hasMeaningfulData && !window.confirm("Clear the entered data?")) return;
    Object.entries(fields).forEach(([key, input]) => {
      input.value = OPTIONAL_MONEY_FIELDS.includes(key) || key === "commissionRate" ? "0" : "";
    });
    roundingSelect.value = "integer";
    clearErrors();
    updateOptionsSummary();
    setInitialState();
  }

  function updateOptionsSummary() {
    let total = 0;
    OPTIONAL_MONEY_FIELDS.forEach((field) => {
      const parsed = parseMoneyInput(fields[field].value);
      if (parsed.ok) total += parsed.value;
    });
    optionsSummary.textContent = `Additional costs: ${formatCurrency(total)}`;
  }

  function clearErrors() {
    document.querySelectorAll("[data-error-for]").forEach((element) => { element.textContent = ""; });
  }

  function showErrors(errors) {
    Object.entries(errors).forEach(([field, error]) => {
      const element = document.querySelector(`[data-error-for="${field}"]`);
      if (element) element.textContent = ERROR_MESSAGES[error] ?? ERROR_MESSAGES.invalid;
    });
  }

  function setInvalidState(errors) {
    resultKicker.textContent = "Check the fields";
    mainResult.textContent = "Cannot calculate";
    interpretation.textContent = "Correct the highlighted values to continue.";
    summaryGrid.innerHTML = "";
    conversionCard.classList.add("hidden");
    breakdownDetails.classList.add("hidden");
    calculationDetails.classList.add("hidden");
    scenariosSection.classList.add("hidden");
    copyButton.classList.add("hidden");
    copyText = "";
    const firstError = Object.keys(errors)[0];
    if (firstError && fields[firstError]) fields[firstError].focus();
  }

  function setInitialState() {
    resultKicker.textContent = "Result";
    mainResult.textContent = "Enter the values";
    interpretation.textContent = "You will see profit per sale or the price you need to charge.";
    summaryGrid.innerHTML = `<div class="col-span-2 rounded-lg border border-gray-800 bg-gray-950/70 p-4 text-sm text-gray-400">Margin is calculated on price. Markup is calculated on total effective cost.</div>`;
    conversionCard.classList.add("hidden");
    breakdownDetails.classList.add("hidden");
    calculationDetails.classList.add("hidden");
    scenariosSection.classList.add("hidden");
    copyButton.classList.add("hidden");
    copyText = "";
  }

  async function copyResult() {
    if (!copyText) return;
    try {
      await navigator.clipboard.writeText(copyText);
      copyLabel.textContent = "Copied";
      copyStatus.textContent = "Summary copied.";
      window.setTimeout(() => { copyLabel.textContent = "Copy summary"; copyStatus.textContent = ""; }, 2000);
    } catch {
      copyStatus.textContent = "Could not copy the summary.";
    }
  }

  function summary(label, value) {
    return `<div class="rounded-lg border border-gray-800 bg-gray-950/70 p-3"><span class="block text-xs font-semibold uppercase tracking-wide text-gray-500">${escapeHtml(label)}</span><span class="mt-2 block break-words text-base font-semibold text-white">${escapeHtml(value)}</span></div>`;
  }

  function breakdownRow(label, value, price) {
    const percent = price > 0 ? Math.abs(value / price) * 100 : 0;
    return `<div><div class="flex items-baseline justify-between gap-3 text-sm"><span class="text-gray-400">${escapeHtml(label)}</span><span class="font-semibold text-white">${escapeHtml(formatSignedCurrency(value))} · ${escapeHtml(formatPercent(percent))}</span></div><div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-gray-800"><span class="block h-full rounded-full bg-amber-400" style="width:${Math.min(percent, 100)}%"></span></div></div>`;
  }

  function formatNullablePercent(value) {
    return value === null ? "Not available" : formatPercent(value);
  }

  function formatSignedCurrency(value) {
    return value < 0 ? `−${formatCurrency(Math.abs(value))}` : formatCurrency(value);
  }

  function hasErrors(errors) {
    return Object.keys(errors).length > 0;
  }

  function escapeHtml(value) {
    return String(value).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
  }

  document.querySelectorAll("[data-mode-button]").forEach((button) => button.addEventListener("click", () => setMode(button.dataset.modeButton)));
  form.addEventListener("submit", (event) => { event.preventDefault(); calculate(); });
  document.querySelector("[data-example]").addEventListener("click", fillExample);
  document.querySelector("[data-clear]").addEventListener("click", clearAll);
  copyButton.addEventListener("click", copyResult);
  OPTIONAL_MONEY_FIELDS.forEach((field) => fields[field].addEventListener("input", updateOptionsSummary));
</script>
