---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import { VAT_COUNTRY_PRESETS, formatRate } from "@lib/calculators/legal-impuestos/calculadora-de-iva/vat.en";
import { buildFaqJsonLd } from "@lib/seo";

const title = "VAT calculator online — Add or extract VAT instantly";
const description =
  "Calculate VAT on any price in seconds. Add or extract VAT, choose a country, and get a complete breakdown.";
const canonical = "/en/legal-tax/vat-calculator";
const spanishCanonical = "/legal-impuestos/calculadora-de-iva";
const alternates = buildAlternateLinks({ es: spanishCanonical, en: canonical }, Astro.site ?? Astro.url);

const defaultCountry = VAT_COUNTRY_PRESETS[0];

const faqs = [
  {
    question: "How is VAT calculated on a price?",
    answer:
      "To add VAT, multiply the price before tax by the rate divided by 100, then add that tax to the base price.",
  },
  {
    question: "How do I find the VAT included in a price?",
    answer:
      "Divide the total price by one plus the VAT rate as a decimal. Then subtract the base price from the total to obtain the VAT amount.",
  },
  {
    question: "What is the VAT rate in Mexico, Spain, or Colombia?",
    answer:
      "The calculator includes reference presets by country. Mexico uses a 16% standard rate, Spain 21%, and Colombia 19%, but always verify current regulations.",
  },
  {
    question: "Is VAT calculated on the price before or after tax?",
    answer:
      "When adding VAT, it is calculated on the price before tax. When extracting VAT, the price before tax is first derived from the total.",
  },
  {
    question: "What is a reduced VAT rate?",
    answer:
      "It is a rate below the standard rate that some countries apply to certain goods or services. Its use depends on local regulations.",
  },
  {
    question: "Can I use the calculator for official invoices?",
    answer:
      "It is a calculation and reference tool. For invoicing, accounting, or official tax returns, verify the applicable tax rules.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);

const examples = [
  {
    title: "Quotes",
    text: "Start with a price before VAT and calculate the total to quote to a customer.",
  },
  {
    title: "Purchases",
    text: "Extract the tax from a receipt or final price to see how much is VAT.",
  },
  {
    title: "Comparison",
    text: "Change the country or rate manually to compare how the total changes.",
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} locale="en" alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="VAT calculator"
      description="Add VAT to a base price or extract the tax included in a total with a clear instant breakdown."
      kicker="Taxes"
      collapseBreadcrumbOnMobile
      containerClass="py-6 md:py-8"
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        {
          label: "Legal & Taxes",
          href: "/en/legal-tax",
          optional: true,
        },
        { label: "VAT calculator", truncate: true },
      ]}
    />

    <Container as="section" class="py-6 md:py-8">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <section
          id="vat-calculator"
          class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
          aria-labelledby="calculator-heading"
        >
          <div class="border-b border-gray-700 p-2">
            <div
              class="flex gap-2 overflow-x-auto"
              role="tablist"
              aria-label="VAT calculation types"
            >
              <button
                id="tab-addVat"
                class="min-h-11 shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls="panel-addVat"
                data-tab="addVat"
              >
                Add
              </button>
              <button
                id="tab-extractVat"
                class="min-h-11 shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="panel-extractVat"
                data-tab="extractVat"
                tabindex="-1"
              >
                Extract
              </button>
            </div>
          </div>

          <div
            class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_minmax(17rem,0.85fr)]"
          >
            <div class="p-4 sm:p-6">
              <h2 id="calculator-heading" class="sr-only">
                Interactive VAT calculator
              </h2>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label
                    for="vat-country"
                    class="block text-sm font-medium text-gray-200"
                  >
                    Country
                  </label>
                  <select
                    id="vat-country"
                    class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                    data-country
                  >
                    {
                      VAT_COUNTRY_PRESETS.map((country) => (
                        <option value={country.id}>{country.label}</option>
                      ))
                    }
                  </select>
                </div>

                <div>
                  <label
                    for="vat-rate-preset"
                    class="block text-sm font-medium text-gray-200"
                  >
                    Rate type
                  </label>
                  <select
                    id="vat-rate-preset"
                    class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15 disabled:cursor-not-allowed disabled:opacity-60"
                    data-rate-preset
                  >
                    {
                      defaultCountry.rates.map((rate) => (
                        <option value={String(rate.value)}>
                          {rate.label} ({formatRate(rate.value)})
                        </option>
                      ))
                    }
                    <option value="manual">Manual</option>
                  </select>
                </div>
              </div>

              <div class="mt-4">
                <label
                  for="vat-rate"
                  class="block text-sm font-medium text-gray-200"
                >
                  VAT rate
                </label>
                <div
                  class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15"
                >
                  <input
                    id="vat-rate"
                    class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    value={String(defaultCountry.defaultRate)}
                    aria-describedby="vat-rate-error vat-country-note"
                    data-input="rate"
                  />
                  <span class="flex items-center px-4 text-gray-500">%</span>
                </div>
                <p
                  id="vat-rate-error"
                  class="mt-2 hidden text-sm text-red-300"
                  data-error-for="rate"
                >
                </p>
                <p
                  id="vat-country-note"
                  class="mt-2 text-xs leading-relaxed text-gray-500"
                  data-country-note
                >
                  {defaultCountry.notes ??
                    "Rates are for reference and may change."}
                </p>
              </div>

              <div
                id="panel-addVat"
                class="mt-6"
                role="tabpanel"
                aria-labelledby="tab-addVat"
                data-panel="addVat"
              >
                <div class="mb-5">
                  <h3 class="text-xl font-semibold">
                    Add VAT to a price
                  </h3>
                  <p class="mt-2 text-sm text-gray-400">
                    Example: a $500 price before VAT at a 16% rate.
                  </p>
                </div>

                <label
                  for="addVat-amount"
                  class="block text-sm font-medium text-gray-200"
                >
                  Price before VAT
                </label>
                <input
                  id="addVat-amount"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  placeholder="500"
                  aria-describedby="addVat-amount-error"
                  data-input="amount"
                />
                <p
                  id="addVat-amount-error"
                  class="mt-2 hidden text-sm text-red-300"
                  data-error-for="amount"
                >
                </p>
              </div>

              <div
                id="panel-extractVat"
                class="mt-6"
                role="tabpanel"
                aria-labelledby="tab-extractVat"
                data-panel="extractVat"
                hidden
              >
                <div class="mb-5">
                  <h3 class="text-xl font-semibold">
                    Extract included VAT
                  </h3>
                  <p class="mt-2 text-sm text-gray-400">
                    Example: a $580 total with VAT included.
                  </p>
                </div>

                <label
                  for="extractVat-amount"
                  class="block text-sm font-medium text-gray-200"
                >
                  Price including VAT
                </label>
                <input
                  id="extractVat-amount"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition placeholder:text-gray-600 focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  placeholder="580"
                  aria-describedby="extractVat-amount-error"
                  data-input="amount"
                />
                <p
                  id="extractVat-amount-error"
                  class="mt-2 hidden text-sm text-red-300"
                  data-error-for="amount"
                >
                </p>
              </div>

              <div
                class="mt-6 flex flex-col gap-3 border-t border-gray-800 pt-5 sm:flex-row"
              >
                <button
                  class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  data-clear-active
                >
                  Clear
                </button>
                <button
                  class="hidden min-h-11 items-center justify-center gap-2 rounded-lg bg-amber-400 px-4 py-2 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
                  type="button"
                  data-copy-result
                >
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                    <path
                      d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                    ></path>
                  </svg>
                  <span data-copy-label>Copy breakdown</span>
                </button>
                <p class="sr-only" aria-live="polite" data-copy-status></p>
              </div>
            </div>

            <aside
              class="border-t border-gray-800 bg-gray-900/70 p-4 sm:p-6 lg:border-l lg:border-t-0"
              aria-live="polite"
              data-result-region
            >
              <p
                class="text-sm font-semibold uppercase tracking-wide text-amber-400"
                data-result-kicker
              >
                Result
              </p>
              <p
                class="mt-3 break-words text-3xl font-bold leading-tight text-white"
                data-main-result
              >
                Enter the values
              </p>

              <div class="mt-5 space-y-3" data-breakdown-list>
                <div
                  class="rounded-lg border border-gray-800 bg-gray-950/70 p-4 text-sm text-gray-400"
                >
                  The breakdown will appear here.
                </div>
              </div>

              <p
                class="mt-4 hidden rounded-lg border border-amber-400/40 bg-amber-400/10 p-3 text-sm leading-relaxed text-amber-200"
                data-warning
              >
              </p>

              <div class="mt-5 rounded-lg border border-gray-800 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                  Step by step
                </p>
                <p class="mt-2 text-sm leading-relaxed text-gray-300" data-explanation>
                  The calculation will appear here.
                </p>
              </div>

              <p class="mt-4 text-xs leading-relaxed text-gray-500">
                Rates are provided for guidance. Check the current rules before
                using the result for invoices or official tax filings.
              </p>
            </aside>
          </div>
        </section>

        <aside
          class="rounded-lg border border-gray-700 bg-gray-950 p-4 sm:p-5"
          aria-labelledby="history-heading"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 id="history-heading" class="text-lg font-semibold">
                History
              </h2>
              <p class="mt-1 text-sm text-gray-500">Last 10 calculations.</p>
            </div>
            <button
              class="rounded-lg border border-gray-800 px-3 py-2 text-xs font-semibold text-gray-300 transition hover:border-amber-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/30"
              type="button"
              data-clear-history
            >
              Delete
            </button>
          </div>

          <p class="mt-4 text-sm text-gray-500" data-history-empty>
            No calculations have been saved in this session yet.
          </p>
          <ol class="mt-4 space-y-3" data-history-list></ol>
        </aside>
      </div>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-8">
      <SectionIntro
        title="Common uses"
        description="Use the calculator to review prices, prepare simple quotes, and understand how much tax is included in a total."
      />

      <div class="grid gap-5 sm:grid-cols-3">
        {
          examples.map((example) => (
            <article class="rounded-lg border border-gray-700 p-5">
              <h3 class="text-base font-semibold text-white">
                {example.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-400">
                {example.text}
              </p>
            </article>
          ))
        }
      </div>
    </Container>

    <Container as="section" class="py-8">
      <SectionIntro
        title="Reference rates by country"
        description="These presets are editable reference values. Check the official source before using them in tax documents."
      />

      <div class="overflow-x-auto rounded-lg border border-gray-700">
        <table class="min-w-full divide-y divide-gray-800 bg-gray-950 text-sm">
          <thead class="bg-gray-900 text-left text-gray-300">
            <tr>
              <th class="px-4 py-3 font-semibold" scope="col">Country</th>
              <th class="px-4 py-3 font-semibold" scope="col">Rate</th>
              <th class="px-4 py-3 font-semibold" scope="col">Currency</th>
              <th class="px-4 py-3 font-semibold" scope="col">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800 text-gray-300">
            {
              VAT_COUNTRY_PRESETS.map((country) => (
                <tr>
                  <th class="px-4 py-3 font-semibold text-white" scope="row">
                    {country.country}
                  </th>
                  <td class="px-4 py-3">
                    {country.defaultRate === null
                      ? "Manual"
                      : formatRate(country.defaultRate, country.locale)}
                  </td>
                  <td class="px-4 py-3">{country.currency}</td>
                  <td class="px-4 py-3 text-gray-400">
                    {country.notes ?? country.sourceName ?? "Rate general."}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<script>
  import {
    VAT_COUNTRY_PRESETS,
    calculateVatFromBase,
    calculateVatFromTotal,
    formatMoney,
    formatNumber,
    formatRate,
    parseMoneyInput,
    parseRateInput,
  } from "@lib/calculators/legal-impuestos/calculadora-de-iva/vat.en";

  const MODES = ["addVat", "extractVat"];
  const MODE_LABELS = {
    addVat: "Add",
    extractVat: "Extract",
  };

  const ERROR_MESSAGES = {
    required: "This field is required.",
    invalid: "Enter a valid number.",
    negative: "Enter a number that is zero or greater.",
    too_many_decimals: "Use no more than four decimal places.",
  };

  const HISTORY_KEY = "vat-calculator-history";
  const HISTORY_LIMIT = 10;
  const HISTORY_DEBOUNCE_MS = 800;

  const tabs = Array.from(document.querySelectorAll("[data-tab]"));
  const panels = Array.from(document.querySelectorAll("[data-panel]"));
  const countrySelect = document.querySelector("[data-country]");
  const ratePresetSelect = document.querySelector("[data-rate-preset]");
  const rateInput = document.querySelector('[data-input="rate"]');
  const countryNote = document.querySelector("[data-country-note]");
  const resultKicker = document.querySelector("[data-result-kicker]");
  const mainResult = document.querySelector("[data-main-result]");
  const breakdownList = document.querySelector("[data-breakdown-list]");
  const warningElement = document.querySelector("[data-warning]");
  const explanation = document.querySelector("[data-explanation]");
  const copyButton = document.querySelector("[data-copy-result]");
  const copyLabel = document.querySelector("[data-copy-label]");
  const copyStatus = document.querySelector("[data-copy-status]");
  const clearActiveButton = document.querySelector("[data-clear-active]");
  const historyList = document.querySelector("[data-history-list]");
  const historyEmpty = document.querySelector("[data-history-empty]");
  const clearHistoryButton = document.querySelector("[data-clear-history]");

  let activeMode = "addVat";
  let currentCopyText = "";
  let currentHistoryEntry = null;
  let historyDebounce = 0;
  let copiedTimeout = 0;

  const getCountryPreset = () =>
    VAT_COUNTRY_PRESETS.find((country) => country.id === countrySelect?.value) ??
    VAT_COUNTRY_PRESETS[0];

  const getAmountInput = (mode = activeMode) =>
    document.querySelector(`[data-panel="${mode}"] [data-input="amount"]`);

  const getAmountError = (mode = activeMode) =>
    document.querySelector(`[data-panel="${mode}"] [data-error-for="amount"]`);

  const getRateError = () => document.querySelector('[data-error-for="rate"]');

  function setActiveMode(mode, shouldFocus = false) {
    activeMode = mode;

    tabs.forEach((tab) => {
      const isActive = tab.dataset.tab === mode;
      tab.setAttribute("aria-selected", String(isActive));
      tab.setAttribute("tabindex", isActive ? "0" : "-1");
      tab.classList.toggle("bg-amber-400", isActive);
      tab.classList.toggle("text-gray-950", isActive);
      tab.classList.toggle("text-gray-300", !isActive);
      tab.classList.toggle("hover:bg-gray-800", !isActive);

      if (isActive && shouldFocus) {
        tab.focus();
      }
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.panel !== mode;
    });

    updateCalculator();
  }

  function updateRatePresetOptions(shouldUseDefaultRate = true) {
    if (!ratePresetSelect || !rateInput) {
      return;
    }

    const country = getCountryPreset();
    ratePresetSelect.innerHTML = "";

    if (country.rates.length === 0) {
      const option = document.createElement("option");
      option.value = "manual";
      option.textContent = "Rate manual";
      ratePresetSelect.append(option);
      ratePresetSelect.disabled = true;

      if (shouldUseDefaultRate) {
        rateInput.value = "";
      }
    } else {
      country.rates.forEach((rate) => {
        const option = document.createElement("option");
        option.value = String(rate.value);
        option.textContent = `${rate.label} (${formatRate(rate.value, country.locale)})`;
        ratePresetSelect.append(option);
      });

      const manualOption = document.createElement("option");
      manualOption.value = "manual";
      manualOption.textContent = "Manual";
      ratePresetSelect.append(manualOption);
      ratePresetSelect.disabled = false;

      if (shouldUseDefaultRate && country.defaultRate !== null) {
        rateInput.value = String(country.defaultRate);
      }
    }

    if (countryNote) {
      countryNote.textContent =
        country.notes ?? "Rates are for reference and may change.";
    }

    syncRatePresetToInput();
  }

  function syncRatePresetToInput() {
    if (!ratePresetSelect || !rateInput) {
      return;
    }

    const country = getCountryPreset();
    const parsedRate = parseRateInput(rateInput.value);

    if (!parsedRate.ok) {
      ratePresetSelect.value = "manual";
      return;
    }

    const matchingRate = country.rates.find(
      (rate) => Math.abs(rate.value - parsedRate.value) < 0.000001,
    );

    ratePresetSelect.value = matchingRate ? String(matchingRate.value) : "manual";
  }

  function clearErrors() {
    document.querySelectorAll("[data-error-for]").forEach((errorElement) => {
      errorElement.textContent = "";
      errorElement.classList.add("hidden");
    });
  }

  function showError(field, error) {
    const errorElement = field === "rate" ? getRateError() : getAmountError();

    if (!errorElement) {
      return;
    }

    errorElement.textContent = ERROR_MESSAGES[error] ?? ERROR_MESSAGES.invalid;
    errorElement.classList.remove("hidden");
  }

  function setResultState(state, result = null, warning = "") {
    if (
      !resultKicker ||
      !mainResult ||
      !breakdownList ||
      !warningElement ||
      !explanation ||
      !copyButton
    ) {
      return;
    }

    mainResult.classList.remove("text-red-300", "text-white");

    if (state === "initial") {
      resultKicker.textContent = "Result";
      mainResult.textContent = "Enter the values";
      mainResult.classList.add("text-white");
      breakdownList.innerHTML = `
        <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-4 text-sm text-gray-400">
          The breakdown will appear here.
        </div>
      `;
      warningElement.textContent = "";
      warningElement.classList.add("hidden");
      explanation.textContent = "The calculation will appear here.";
      copyButton.classList.add("hidden");
      copyButton.classList.remove("inline-flex");
      currentCopyText = "";
      currentHistoryEntry = null;
      return;
    }

    if (state === "invalid") {
      resultKicker.textContent = "Check the fields";
      mainResult.textContent = "Cannot calculate yet";
      mainResult.classList.add("text-red-300");
      breakdownList.innerHTML = "";
      warningElement.textContent = "";
      warningElement.classList.add("hidden");
      explanation.textContent = "Correct the highlighted value to continue.";
      copyButton.classList.add("hidden");
      copyButton.classList.remove("inline-flex");
      currentCopyText = "";
      currentHistoryEntry = null;
      return;
    }

    if (!result) {
      return;
    }

    resultKicker.textContent = result.mainLabel;
    mainResult.textContent = result.main;
    mainResult.classList.add("text-white");
    breakdownList.innerHTML = result.rows
      .map(
        (row) => `
          <div class="flex items-start justify-between gap-4 rounded-lg border border-gray-800 bg-gray-950/70 p-4">
            <span class="min-w-0 text-sm text-gray-400">${escapeHtml(row.label)}</span>
            <span class="break-words text-right text-sm font-semibold text-white">${escapeHtml(row.value)}</span>
          </div>
        `,
      )
      .join("");

    warningElement.textContent = warning;
    warningElement.classList.toggle("hidden", !warning);
    explanation.textContent = result.explanation;
    copyButton.classList.remove("hidden");
    copyButton.classList.add("inline-flex");
    currentCopyText = result.copy;
  }

  function updateCalculator() {
    window.clearTimeout(historyDebounce);

    const amountInput = getAmountInput();

    if (!amountInput || !rateInput) {
      return;
    }

    clearErrors();
    syncRatePresetToInput();

    const amountValue = amountInput.value.trim();
    const amountTouched = amountInput.dataset.touched === "true";
    const rateTouched = rateInput.dataset.touched === "true";

    if (!amountValue) {
      if (amountTouched) {
        showError("amount", "required");
      }
      setResultState("initial");
      return;
    }

    const parsedAmount = parseMoneyInput(amountInput.value);
    const parsedRate = parseRateInput(rateInput.value);

    if (!parsedAmount.ok) {
      showError("amount", parsedAmount.error);
      setResultState("invalid");
      return;
    }

    if (!parsedRate.ok) {
      if (rateTouched || amountTouched) {
        showError("rate", parsedRate.error);
      }
      setResultState("invalid");
      return;
    }

    const result = computeResult(parsedAmount.value, parsedRate.value);
    const warning =
      parsedRate.value > 100
        ? "Unusually high rate. The calculation is shown for reference."
        : "";

    setResultState("valid", result, warning);

    currentHistoryEntry = {
      id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
      key: `${activeMode}-${countrySelect?.value}-${parsedAmount.normalized}-${parsedRate.normalized}`,
      mode: activeMode,
      modeLabel: MODE_LABELS[activeMode],
      countryId: countrySelect?.value ?? "mexico",
      countryLabel: getCountryPreset().label,
      amount: parsedAmount.normalized,
      rate: parsedRate.normalized,
      result: result.main,
      summary: result.summary,
      createdAt: new Date().toLocaleTimeString("en-US", {
        hour: "2-digit",
        minute: "2-digit",
      }),
    };

    historyDebounce = window.setTimeout(() => {
      if (currentHistoryEntry) {
        saveHistoryEntry(currentHistoryEntry);
      }
    }, HISTORY_DEBOUNCE_MS);
  }

  function computeResult(amount, rate) {
    const country = getCountryPreset();
    const locale = country.locale;
    const currency = country.currency;
    const breakdown =
      activeMode === "addVat"
        ? calculateVatFromBase(amount, rate)
        : calculateVatFromTotal(amount, rate);
    const base = formatMoney(breakdown.base, locale, currency);
    const tax = formatMoney(breakdown.tax, locale, currency);
    const total = formatMoney(breakdown.total, locale, currency);
    const rateLabel = formatRate(rate, locale);
    const multiplier = formatNumber(rate / 100, locale);
    const divisor = formatNumber(1 + rate / 100, locale);
    const mainLabel =
      activeMode === "addVat" ? "Price including VAT" : "VAT amount";
    const main = activeMode === "addVat" ? total : tax;
    const explanationText =
      activeMode === "addVat"
        ? `${base} * ${multiplier} = ${tax}; ${base} + ${tax} = ${total}`
        : `${total} / ${divisor} = ${base}; ${total} - ${base} = ${tax}`;

    return {
      mainLabel,
      main,
      rows: [
        { label: "Price before VAT", value: base },
        { label: `VAT (${rateLabel})`, value: tax },
        { label: "Price including VAT", value: total },
      ],
      explanation: explanationText,
      copy: [
        `Price before VAT: ${base}`,
        `VAT (${rateLabel}): ${tax}`,
        `Total including VAT: ${total}`,
        `Country: ${country.country}`,
      ].join("\n"),
      summary: `${country.label} · ${rateLabel} · ${mainLabel}: ${main}`,
    };
  }

  function loadHistory() {
    try {
      const rawHistory = sessionStorage.getItem(HISTORY_KEY);
      return rawHistory ? JSON.parse(rawHistory) : [];
    } catch {
      return [];
    }
  }

  function writeHistory(history) {
    sessionStorage.setItem(HISTORY_KEY, JSON.stringify(history));
    renderHistory(history);
  }

  function saveHistoryEntry(entry) {
    const history = loadHistory();
    const previous = history[0];

    if (previous?.key === entry.key) {
      return;
    }

    writeHistory([entry, ...history].slice(0, HISTORY_LIMIT));
  }

  function renderHistory(history = loadHistory()) {
    if (!historyList || !historyEmpty) {
      return;
    }

    historyEmpty.classList.toggle("hidden", history.length > 0);
    historyList.innerHTML = "";

    history.forEach((item) => {
      const listItem = document.createElement("li");
      const button = document.createElement("button");
      button.type = "button";
      button.className =
        "w-full rounded-lg border border-gray-800 bg-gray-900 p-3 text-left transition hover:border-amber-400 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/30";
      button.dataset.historyId = item.id;
      button.innerHTML = `
        <span class="block text-xs font-semibold uppercase tracking-wide text-amber-400">${escapeHtml(item.modeLabel)} · ${escapeHtml(item.countryLabel)} · ${escapeHtml(item.createdAt)}</span>
        <span class="mt-2 block break-words text-sm font-semibold text-white">${escapeHtml(item.result)}</span>
        <span class="mt-1 block break-words text-xs leading-relaxed text-gray-500">${escapeHtml(item.summary)}</span>
      `;
      listItem.append(button);
      historyList.append(listItem);
    });
  }

  function restoreHistoryItem(id) {
    const item = loadHistory().find((historyItem) => historyItem.id === id);

    if (!item || !countrySelect || !rateInput) {
      return;
    }

    setActiveMode(item.mode);
    countrySelect.value = item.countryId;
    updateRatePresetOptions(false);
    rateInput.value = String(item.rate);
    rateInput.dataset.touched = "true";

    const amountInput = getAmountInput(item.mode);

    if (amountInput) {
      amountInput.value = String(item.amount);
      amountInput.dataset.touched = "true";
    }

    syncRatePresetToInput();
    updateCalculator();
  }

  function clearActiveMode() {
    const amountInput = getAmountInput();

    if (amountInput) {
      amountInput.value = "";
      delete amountInput.dataset.touched;
    }

    clearErrors();
    setResultState("initial");
  }

  async function copyResult() {
    if (!currentCopyText || !copyLabel || !copyStatus) {
      return;
    }

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(currentCopyText);
      } else {
        const textArea = document.createElement("textarea");
        textArea.value = currentCopyText;
        textArea.setAttribute("readonly", "");
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.append(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
      }

      window.clearTimeout(copiedTimeout);
      copyLabel.textContent = "Copied";
      copyStatus.textContent = "Breakdown copied.";
      copiedTimeout = window.setTimeout(() => {
        copyLabel.textContent = "Copy breakdown";
        copyStatus.textContent = "";
      }, 2000);
    } catch {
      copyStatus.textContent = "The breakdown could not be copied.";
    }
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      setActiveMode(tab.dataset.tab);
    });

    tab.addEventListener("keydown", (event) => {
      const key = event.key;
      let nextIndex = index;

      if (key === "ArrowRight" || key === "ArrowDown") {
        nextIndex = (index + 1) % tabs.length;
      } else if (key === "ArrowLeft" || key === "ArrowUp") {
        nextIndex = (index - 1 + tabs.length) % tabs.length;
      } else if (key === "Home") {
        nextIndex = 0;
      } else if (key === "End") {
        nextIndex = tabs.length - 1;
      } else {
        return;
      }

      event.preventDefault();
      setActiveMode(tabs[nextIndex].dataset.tab, true);
    });
  });

  document.querySelectorAll('[data-input="amount"]').forEach((input) => {
    input.addEventListener("input", () => {
      input.dataset.touched = "true";
      updateCalculator();
    });

    input.addEventListener("blur", () => {
      input.dataset.touched = "true";
      updateCalculator();
    });
  });

  rateInput?.addEventListener("input", () => {
    rateInput.dataset.touched = "true";
    updateCalculator();
  });

  rateInput?.addEventListener("blur", () => {
    rateInput.dataset.touched = "true";
    updateCalculator();
  });

  countrySelect?.addEventListener("change", () => {
    updateRatePresetOptions(true);
    updateCalculator();
  });

  ratePresetSelect?.addEventListener("change", () => {
    if (!rateInput || ratePresetSelect.value === "manual") {
      return;
    }

    rateInput.value = ratePresetSelect.value;
    rateInput.dataset.touched = "true";
    updateCalculator();
  });

  clearActiveButton?.addEventListener("click", clearActiveMode);
  copyButton?.addEventListener("click", copyResult);

  clearHistoryButton?.addEventListener("click", () => {
    writeHistory([]);
  });

  historyList?.addEventListener("click", (event) => {
    const button = event.target.closest("[data-history-id]");

    if (button) {
      restoreHistoryItem(button.dataset.historyId);
    }
  });

  updateRatePresetOptions(false);
  renderHistory();
  setActiveMode(activeMode);
</script>
