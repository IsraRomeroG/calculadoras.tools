---
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import PageHero from "@components/shared/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const title = "VAT, GST and sales tax calculator by country";
const description = "Choose the country whose VAT, GST, GST/HST, sales tax or IVA rules apply before calculating tax.";
const canonical = "/en/legal-tax/indirect-tax-calculator";
const markets = [
  ["United States", "Sales tax", "State and locality required", "us"],
  ["United Kingdom", "VAT", "Domestic simple transactions", "gb"],
  ["Canada", "GST/HST", "Place of supply required", "ca"],
  ["Australia", "GST", "Domestic simple transactions", "au"],
  ["New Zealand", "GST", "Domestic simple transactions", "nz"],
  ["Ireland", "VAT", "Supported rate category required", "ie"],
  ["Mexico", "IVA", "Mexico rules in English", "mx-en"],
] as const;
---

<BaseLayout title={title} description={description} canonical={canonical} locale="en">
  <PageShell>
    <PageHero
      title="VAT, GST and sales tax calculator by country"
      description="Tax names and rates depend on jurisdiction. Choose the country first; English alone never selects a tax system."
      kicker="Legal & Tax"
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Legal & Taxes", href: "/en/legal-tax", optional: true },
        { label: "Indirect tax", truncate: true },
      ]}
    />
    <Container as="section" class="py-6 md:py-10">
      <div class="rounded-lg border border-amber-400/25 bg-amber-400/10 p-4 text-sm leading-relaxed text-amber-100" role="note">
        No country is selected by default. A calculator only becomes available when its jurisdiction dataset is published and current.
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {markets.map(([country, system, coverage, marketId]) => (
          <article class="rounded-lg border border-gray-700 bg-gray-950 p-5" data-market-id={marketId}>
            <p class="text-xs font-semibold uppercase tracking-wide text-amber-400">{system}</p>
            <h2 class="mt-2 text-xl font-semibold text-white">{country}</h2>
            <p class="mt-2 text-sm leading-relaxed text-gray-400">{coverage}</p>
            <p class="mt-4 text-xs font-semibold text-gray-500" data-market-status>Dataset pending publication gate</p>
          </article>
        ))}
      </div>
      <p class="mt-6 text-sm leading-relaxed text-gray-400">
        These tools estimate arithmetic only. They do not determine product classification, nexus, place of supply, registration, exemptions or filing obligations.
      </p>
    </Container>
  </PageShell>
</BaseLayout>
