---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import PageHero from "@components/shared/PageHero.astro";
import Panel from "@components/shared/Panel.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";

const description =
  "Learn about the editorial purpose of calculadoras.tools, how the site is maintained, its limits, and how to contact us.";
const canonical = "/en/about";
const alternates = buildAlternateLinks(
  { es: "/acerca-de", en: canonical },
  Astro.site ?? Astro.url,
);

const sections = [
  {
    title: "What calculadoras.tools is",
    content:
      "calculadoras.tools publishes tools and guides for everyday calculations with clear explanations. The site prioritizes calculators that help people understand a formula, compare scenarios, or check a result without creating an account.",
  },
  {
    title: "Editorial responsibility",
    content:
      "The site's editorial team maintains the calculators, reviews published content, and receives reports through the contact form. When a piece requires external or specialist review, that review should be clearly disclosed.",
  },
  {
    title: "Experience and limitations",
    content:
      "The project relies on formula documentation, technical testing, and reviews of public sources. We do not claim unverified medical, financial, tax, or legal credentials, and the content is not a substitute for professional advice.",
  },
  {
    title: "Funding",
    content:
      "The site may be funded by advertising when its editorial inventory and advertising configuration are ready. Advertising does not determine calculator results, editorial recommendations, or cited sources.",
  },
];
---

<BaseLayout
  locale="en"
  title="About"
  description={description}
  canonical={canonical}
  alternates={alternates}
>
  <PageShell>
    <PageHero
      locale="en"
      title="About"
      description="calculadoras.tools brings together calculators and practical guides around a simple idea: people should understand what is being calculated, where the result comes from, and when to confirm it with an official source or qualified professional."
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "About" },
      ]}
      containerClass="px-6 py-10"
      breadcrumbClass="mb-8"
      titleClass="text-4xl font-bold tracking-tight md:text-6xl"
      descriptionClass="mt-6 text-lg leading-relaxed text-gray-400"
    />

    <Container as="section" class="px-6 py-14">
      <div class="grid gap-6">
        {
          sections.map((section) => (
            <Panel as="section" padding="lg">
              <h2 class="text-xl font-semibold">{section.title}</h2>
              <p class="mt-3 leading-relaxed text-gray-400">
                {section.content}
              </p>
            </Panel>
          ))
        }

        <Panel as="section" padding="lg">
          <h2 class="text-xl font-semibold">Contact</h2>
          <p class="mt-3 leading-relaxed text-gray-400">
            To report an error, suggest an improvement, or request a
            correction, use the{" "}
            <a
              class="text-amber-400 hover:text-amber-300"
              href="/en/contact"
            >
              contact form
            </a>.
          </p>
        </Panel>
      </div>
    </Container>
  </PageShell>
</BaseLayout>
