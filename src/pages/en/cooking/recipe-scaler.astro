---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildFaqJsonLd } from "@lib/seo";
import { buildAlternateLinks } from "@lib/i18n/routing";

const title = "Recipe scaler";
const description =
  "Adjust recipe quantities for the number of servings you need and copy the updated ingredient list.";
const canonical = "/en/cooking/recipe-scaler";
const spanishCanonical = "/cocina/escalar-receta-por-porciones";
const alternates = buildAlternateLinks(
  { es: spanishCanonical, en: canonical },
  Astro.site ?? Astro.url,
);

const faqs = [
  {
    question: "How do you adjust a recipe for more people?",
    answer:
      "Divide the desired servings by the original servings and multiply each quantity by that factor. This calculator applies the calculation to every ingredient.",
  },
  {
    question: "How do you calculate a recipe scaling factor?",
    answer:
      "The factor is desired servings divided by original servings. For example, scaling from 4 to 10 servings gives a factor of 10 / 4 = 2.5.",
  },
  {
    question: "Should I round the number of eggs?",
    answer:
      "Not always. The calculator does not automatically round 1.5 eggs to 2. Decide based on the recipe, egg size and acceptable margin of error.",
  },
  {
    question: "Does cooking time change when a recipe is doubled?",
    answer:
      "It can. Ingredient quantities scale linearly, but the pan, batter thickness, oven and type of recipe can change the actual cooking time.",
  },
  {
    question: "Does the calculator convert cups to grams?",
    answer:
      "Not in this version. It preserves the units you enter. Use the cooking measurement converter for compatible unit conversions.",
    relatedHref: "/en/cooking/cooking-measurement-converter",
    relatedLabel: "Open the cooking measurement converter",
  },
  {
    question: "How do you scale a recipe by half?",
    answer:
      "Enter the original servings and half that number as the desired servings. For example, if a recipe makes 8 servings and you need 4, the factor is 0.5.",
  },
  {
    question: "Can I paste an ingredient list?",
    answer:
      "Yes. Paste simple lines such as '2 cups flour', '1/2 teaspoon salt' or 'salt to taste'. Each line remains editable before you copy the result.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);

const unitSuggestions = [
  "unit",
  "g",
  "kg",
  "ml",
  "l",
  "cup",
  "tablespoon",
  "teaspoon",
  "oz",
  "lb",
  "piece",
  "package",
  "pinch",
  "can",
  "sprig",
  "clove",
  "to taste",
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  locale="en"
  alternates={alternates}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title={title}
      description="Adjust recipe quantities for the servings you need. Double, halve or scale a recipe to any number of servings."
      kicker="Cooking"
      collapseBreadcrumbOnMobile
      containerClass="py-6 md:py-8"
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Cooking", href: "/en/cooking", optional: true },
        { label: "Recipe scaler", truncate: true },
      ]}
    />

    <Container as="section" class="py-5 md:py-8">
      <section
        id="recipe-scaler"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <div class="grid gap-0 xl:grid-cols-[minmax(0,1fr)_minmax(21rem,0.72fr)]">
          <div class="p-4 sm:p-6">
            <p class="text-sm font-semibold text-amber-300">Servings and factor</p>
            <h2 id="calculator-heading" class="mt-2 text-2xl font-semibold">
              Scale ingredients instantly
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-gray-400">
              Enter decimals or fractions such as <span class="text-gray-200">1/2</span>,
              <span class="text-gray-200">2.5</span> or
              <span class="text-gray-200">1 1/2</span>.
            </p>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div>
                <label for="original-servings" class="block text-sm font-semibold text-gray-200">
                  Original servings
                </label>
                <input
                  id="original-servings"
                  class="mt-2 min-h-14 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-xl text-white outline-none placeholder:text-gray-600 transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  value="4"
                  data-original-servings
                />
              </div>
              <div>
                <label for="desired-servings" class="block text-sm font-semibold text-gray-200">
                  Desired servings
                </label>
                <input
                  id="desired-servings"
                  class="mt-2 min-h-14 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-xl text-white outline-none placeholder:text-gray-600 transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  value="6"
                  data-desired-servings
                />
              </div>
            </div>

            <p class="mt-3 min-h-5 text-sm text-red-300" data-servings-error></p>

            <div class="mt-5">
              <label for="quantity-format" class="block text-sm font-semibold text-gray-200">
                Quantity format
              </label>
              <select
                id="quantity-format"
                class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                data-format-mode
              >
                <option value="fraction" selected>Practical fraction</option>
                <option value="decimal">Decimal</option>
                <option value="both">Decimal and fraction</option>
              </select>
            </div>

            <div class="mt-6 rounded-lg border border-gray-800 bg-gray-900/65 p-4">
              <label for="paste-ingredients" class="block text-sm font-semibold text-gray-200">
                Paste ingredients
              </label>
              <textarea
                id="paste-ingredients"
                class="mt-2 min-h-32 w-full resize-y rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-base text-white outline-none placeholder:text-gray-600 transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
                placeholder="2 cups flour&#10;1/2 teaspoon salt&#10;3 eggs&#10;salt to taste"
                data-paste-input
              ></textarea>
              <div class="mt-3 flex flex-wrap gap-3">
                <button
                  class="min-h-11 rounded-lg bg-amber-400 px-4 py-2 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-300/40"
                  type="button"
                  data-paste-button
                >
                  Paste ingredients
                </button>
                <button
                  class="min-h-11 rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-gray-500 hover:bg-gray-900 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-gray-400/30"
                  type="button"
                  data-example-button
                >
                  Load example
                </button>
              </div>
              <p class="mt-2 min-h-5 text-sm text-gray-400" data-paste-status></p>
            </div>

            <div class="mt-6">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-lg font-semibold">Ingredients</h3>
                <span class="text-sm text-gray-500" data-ingredient-count>0/50</span>
              </div>

              <datalist id="recipe-unit-options">
                {unitSuggestions.map((unit) => <option value={unit} />)}
              </datalist>

              <div class="mt-3 space-y-3" data-ingredients-list></div>

              <div class="mt-4 flex flex-wrap gap-3">
                <button
                  class="min-h-11 rounded-lg border border-amber-400/60 px-4 py-2 text-sm font-semibold text-amber-300 transition hover:bg-amber-400/10 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/30"
                  type="button"
                  data-add-row
                >
                  Add ingredient
                </button>
                <button
                  class="min-h-11 rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-gray-500 hover:bg-gray-900 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-gray-400/30"
                  type="button"
                  data-save-draft
                >
                  Save draft on this device
                </button>
                <button
                  class="hidden min-h-11 rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-gray-500 hover:bg-gray-900 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-gray-400/30"
                  type="button"
                  data-load-draft
                >
                  Load draft
                </button>
                <button
                  class="min-h-11 rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-gray-500 hover:bg-gray-900 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-gray-400/30"
                  type="button"
                  data-clear-button
                >
                  Clear recipe
                </button>
              </div>
            </div>
          </div>

          <aside class="border-t border-gray-800 bg-gray-900/65 p-4 sm:p-6 xl:border-l xl:border-t-0">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
              Result
            </p>
            <p class="mt-3 text-3xl font-semibold text-amber-100" data-factor-result>
              x 1.5
            </p>
            <p class="mt-2 min-h-5 text-sm leading-relaxed text-gray-400" data-factor-note>
              Scaling factor for 6 servings.
            </p>

            <div class="mt-5 rounded-lg border border-gray-800 bg-gray-950 p-4">
              <h3 class="text-base font-semibold">Scaled ingredients</h3>
              <div class="mt-3 min-h-32 space-y-2 text-sm leading-relaxed text-gray-300" data-result-list>
                <p>Add ingredients to see the scaled recipe.</p>
              </div>
            </div>

            <div class="mt-4 rounded-lg border border-amber-400/20 bg-amber-400/10 p-4">
              <p class="text-sm leading-relaxed text-amber-100" data-practical-note>
                Some ingredients and steps require practical judgment. Pay special attention to eggs, yeast, spices, pan size and cooking time.
              </p>
            </div>

            <div class="mt-4 flex flex-wrap gap-3">
              <button
                class="min-h-11 rounded-lg bg-amber-400 px-4 py-2 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-300/40"
                type="button"
                data-copy-button
              >
                Copy scaled recipe
              </button>
            </div>
            <p class="sr-only" role="status" aria-live="polite" data-live-status></p>
            <p class="mt-3 min-h-5 text-sm text-emerald-300" role="status" aria-live="polite" data-copy-status></p>
          </aside>
        </div>
      </section>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-6 md:py-8">
      <SectionIntro
        title="Practical cooking considerations"
        description="Quantity multiplication is linear, but real cooking is not always. The calculator preserves values so you can decide without hidden rounding."
      />
      <div class="grid gap-4 md:grid-cols-3">
        <article class="rounded-lg border border-gray-800 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold">Eggs and whole items</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            A result such as 1.5 eggs is shown as-is. You can beat and
            measure the egg, or round based on the recipe.
          </p>
        </article>
        <article class="rounded-lg border border-gray-800 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold">Leavening and spices</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Yeast, salt and spices may need adjustments for flavor,
            fermentation or texture.
          </p>
        </article>
        <article class="rounded-lg border border-gray-800 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold">Pan and oven</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            When the recipe size changes, thickness and cooking time do not
            always scale at the same rate.
          </p>
        </article>
      </div>
    </Container>

    <Container as="section" class="py-6 md:py-8">
      <SectionIntro
        title="Cooking measurements"
        description="This calculator preserves units. To convert compatible measurements, open the cooking measurement converter."
      />
      <div class="rounded-lg border border-gray-800 bg-gray-950 p-5">
        <a
          href="/en/cooking/cooking-measurement-converter"
          class="inline-flex min-h-11 items-center rounded-lg border border-amber-400/60 px-4 py-2 text-sm font-semibold text-amber-300 transition hover:bg-amber-400/10 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/30"
        >
          Open the cooking measurement converter
        </a>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<script>
  import {
    RECIPE_SCALING_MAX_INGREDIENTS,
    calculateRecipeScaleFactor,
    detectPracticalWarnings,
    formatRecipeQuantity,
    parsePastedIngredients,
    parseRecipeQuantity,
    scaleIngredientQuantity,
    validateRecipeIngredient,
  } from "@lib/calculators/cocina/escalar-receta-por-porciones/recipeScaling";

  const parsePastedIngredientsEn = (text, maxIngredients) =>
    parsePastedIngredients(text, maxIngredients, "en");
  const parseRecipeQuantityEn = (value) => parseRecipeQuantity(value, "en");
  const validateRecipeIngredientEn = (ingredient) =>
    validateRecipeIngredient(ingredient, "en");
  const detectPracticalWarningsEn = (ingredient) =>
    detectPracticalWarnings(ingredient, "en");

  const STORAGE_KEY = "calculadoras.tools.recipe-scaler.en.draft.v1";
  const defaultRows = [
    { quantity: "", unit: "", name: "" },
    { quantity: "", unit: "", name: "" },
    { quantity: "", unit: "", name: "" },
  ];
  const exampleRows = [
    { quantity: "2", unit: "cups", name: "flour" },
    { quantity: "1/2", unit: "teaspoon", name: "salt" },
    { quantity: "3", unit: "", name: "eggs" },
    { quantity: "", unit: "to taste", name: "pepper" },
  ];

  const originalInput = document.querySelector("[data-original-servings]");
  const desiredInput = document.querySelector("[data-desired-servings]");
  const formatSelect = document.querySelector("[data-format-mode]");
  const servingsError = document.querySelector("[data-servings-error]");
  const pasteInput = document.querySelector("[data-paste-input]");
  const pasteButton = document.querySelector("[data-paste-button]");
  const pasteStatus = document.querySelector("[data-paste-status]");
  const exampleButton = document.querySelector("[data-example-button]");
  const ingredientsList = document.querySelector("[data-ingredients-list]");
  const ingredientCount = document.querySelector("[data-ingredient-count]");
  const addRowButton = document.querySelector("[data-add-row]");
  const saveDraftButton = document.querySelector("[data-save-draft]");
  const loadDraftButton = document.querySelector("[data-load-draft]");
  const clearButton = document.querySelector("[data-clear-button]");
  const factorResult = document.querySelector("[data-factor-result]");
  const factorNote = document.querySelector("[data-factor-note]");
  const resultList = document.querySelector("[data-result-list]");
  const practicalNote = document.querySelector("[data-practical-note]");
  const copyButton = document.querySelector("[data-copy-button]");
  const copyStatus = document.querySelector("[data-copy-status]");
  const liveStatus = document.querySelector("[data-live-status]");

  let ingredients = structuredClone(defaultRows);
  let currentCopyText = "";
  let copyTimer = 0;
  let urlTimer = 0;

  function getFormatMode() {
    return ["fraction", "decimal", "both"].includes(formatSelect.value)
      ? formatSelect.value
      : "fraction";
  }

  function createInput({ label, value, field, index, inputMode = "text", list = "" }) {
    const wrapper = document.createElement("label");
    const labelText = document.createElement("span");
    const input = document.createElement("input");

    wrapper.className = "block";
    labelText.className = "block text-xs font-semibold uppercase tracking-wide text-gray-500";
    labelText.textContent = label;
    input.className =
      "mt-1 min-h-11 w-full rounded-lg border border-gray-700 bg-gray-950 px-3 text-base text-white outline-none placeholder:text-gray-600 transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15";
    input.value = value;
    input.dataset.field = field;
    input.dataset.index = String(index);
    input.autocomplete = "off";
    input.inputMode = inputMode;

    if (list) {
      input.setAttribute("list", list);
    }

    wrapper.append(labelText, input);

    return wrapper;
  }

  function renderRows() {
    ingredientsList.replaceChildren(
      ...ingredients.map((ingredient, index) => {
        const row = document.createElement("article");
        const header = document.createElement("div");
        const title = document.createElement("h4");
        const removeButton = document.createElement("button");
        const fields = document.createElement("div");
        const result = document.createElement("p");
        const warning = document.createElement("p");
        const error = document.createElement("p");

        row.className =
          "rounded-lg border border-gray-800 bg-gray-900/65 p-4 transition";
        row.dataset.row = String(index);
        header.className = "flex items-center justify-between gap-3";
        title.className = "text-sm font-semibold text-gray-200";
        title.textContent = `Ingredient ${index + 1}`;
        removeButton.className =
          "min-h-10 rounded-lg border border-gray-700 px-3 text-sm font-semibold text-gray-300 transition hover:border-red-300 hover:text-red-200 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-red-300/30";
        removeButton.type = "button";
        removeButton.textContent = "Remove";
        removeButton.dataset.removeIndex = String(index);
        removeButton.disabled = ingredients.length <= 1;
        fields.className = "mt-3 grid gap-3 sm:grid-cols-[8rem_9rem_minmax(0,1fr)]";
        result.className = "mt-3 min-h-5 text-sm leading-relaxed text-amber-100";
        result.dataset.rowResult = String(index);
        warning.className = "mt-2 min-h-5 text-sm leading-relaxed text-amber-200";
        warning.dataset.rowWarning = String(index);
        error.className = "mt-2 min-h-5 text-sm leading-relaxed text-red-300";
        error.dataset.rowError = String(index);

        fields.append(
          createInput({
            label: "Amount",
            value: ingredient.quantity,
            field: "quantity",
            index,
            inputMode: "decimal",
          }),
          createInput({
            label: "Unit",
            value: ingredient.unit,
            field: "unit",
            index,
            list: "recipe-unit-options",
          }),
          createInput({
            label: "Ingredient",
            value: ingredient.name,
            field: "name",
            index,
          }),
        );
        header.append(title, removeButton);
        row.append(header, fields, result, warning, error);

        return row;
      }),
    );

    ingredientCount.textContent = `${ingredients.length}/${RECIPE_SCALING_MAX_INGREDIENTS}`;
    addRowButton.disabled = ingredients.length >= RECIPE_SCALING_MAX_INGREDIENTS;
    addRowButton.classList.toggle("opacity-50", addRowButton.disabled);
    renderCalculations();
  }

  function parseServings() {
    const original = parseRecipeQuantityEn(originalInput.value);
    const desired = parseRecipeQuantityEn(desiredInput.value);

    if (!original.ok || !desired.ok) {
      return { ok: false, message: "Enter valid serving amounts." };
    }

    if (original.value <= 0 || desired.value <= 0) {
      return { ok: false, message: "Servings must be greater than zero." };
    }

    try {
      return {
        ok: true,
        original: original.value,
        desired: desired.value,
        factor: calculateRecipeScaleFactor(original.value, desired.value),
      };
    } catch {
      return { ok: false, message: "Servings must be positive numbers." };
    }
  }

  function formatIngredientLine(quantity, unit, name) {
    const cleanUnit = unit.trim();
    const cleanName = name.trim().replace(/^of\s+/i, "");

    if (!cleanUnit) {
      return `${quantity} ${cleanName}`.trim();
    }

    if (cleanUnit.toLowerCase() === "to taste") {
      if (/\bto taste\b/i.test(cleanName)) {
        return cleanName;
      }

      return `${cleanName} to taste`.trim();
    }

    return `${quantity} ${cleanUnit} of ${cleanName}`.trim();
  }

  function syncUrl(servings) {
    const url = new URL(window.location.href);

    if (servings.ok) {
      url.searchParams.set("original", String(servings.original));
      url.searchParams.set("desired", String(servings.desired));
    } else {
      url.searchParams.delete("original");
      url.searchParams.delete("desired");
    }

    window.clearTimeout(urlTimer);
    urlTimer = window.setTimeout(() => {
      window.history.replaceState({}, "", url);
    }, 250);
  }

  function renderCalculations(options = {}) {
    const { updateUrl = true } = options;
    const servings = parseServings();
    const resultLines = [];
    const warnings = new Map();
    const invalidRows = [];
    const mode = getFormatMode();

    servingsError.textContent = servings.ok ? "" : servings.message;

    if (!servings.ok) {
      factorResult.textContent = "No factor";
      factorNote.textContent = "Check the servings to calculate.";
      currentCopyText = "";
      resultList.replaceChildren(document.createElement("p"));
      resultList.firstElementChild.textContent = "No result is available.";
      if (updateUrl) {
        syncUrl(servings);
      }
      return;
    }

    factorResult.textContent = `x ${formatRecipeQuantity(servings.factor, "decimal")}`;
    factorNote.textContent = `Scaling factor for ${formatRecipeQuantity(servings.desired, "decimal")} servings.`;

    ingredients.forEach((ingredient, index) => {
      const row = document.querySelector(`[data-row="${index}"]`);
      const rowResult = document.querySelector(`[data-row-result="${index}"]`);
      const rowWarning = document.querySelector(`[data-row-warning="${index}"]`);
      const rowError = document.querySelector(`[data-row-error="${index}"]`);
      const isBlankRow =
        !ingredient.quantity.trim() &&
        !ingredient.unit.trim() &&
        !ingredient.name.trim();

      if (isBlankRow) {
        row?.classList.remove("border-red-300/70");
        rowResult.textContent = "Row ready for input.";
        rowWarning.textContent = "";
        rowError.textContent = "";
        return;
      }

      const validation = validateRecipeIngredientEn(ingredient);
      const warningMatches = detectPracticalWarningsEn(ingredient);

      row?.classList.toggle("border-red-300/70", !validation.valid);
      rowError.textContent = validation.errors.join(" ");
      rowWarning.textContent = warningMatches.map((warning) => warning.message).join(" ");
      warningMatches.forEach((warning) => warnings.set(warning.term, warning.message));

      if (validation.isTasteOnly && ingredient.name.trim()) {
        const line = formatIngredientLine("", "to taste", ingredient.name);

        rowResult.textContent = line;
        resultLines.push(line);
        return;
      }

      if (!validation.valid) {
        rowResult.textContent = "Review this row before including it in the result.";
        invalidRows.push(index + 1);
        return;
      }

      const scaled = scaleIngredientQuantity(ingredient.quantity, servings.factor);
      const scaledQuantity = formatRecipeQuantity(scaled, mode);
      const line = formatIngredientLine(scaledQuantity, ingredient.unit, ingredient.name);
      const originalLine = formatIngredientLine(
        ingredient.quantity,
        ingredient.unit,
        ingredient.name,
      );

      rowResult.textContent = `${originalLine} -> ${line}`;
      resultLines.push(line);
    });

    resultList.replaceChildren(
      ...(resultLines.length
        ? resultLines.map((line) => {
            const item = document.createElement("p");

            item.textContent = line;

            return item;
          })
        : [document.createElement("p")]),
    );

    if (!resultLines.length) {
      resultList.firstElementChild.textContent =
        "Add ingredients to see the scaled recipe.";
    }

    practicalNote.textContent = warnings.size
      ? `Review before rounding: ${[...warnings.values()].join(" ")}`
      : "Some ingredients and steps require practical judgment. Pay special attention to eggs, yeast, spices, pan size and cooking time.";

    currentCopyText = [
      `Recipe scaled from ${formatRecipeQuantity(servings.original, "decimal")} to ${formatRecipeQuantity(servings.desired, "decimal")} servings (x ${formatRecipeQuantity(servings.factor, "decimal")})`,
      "",
      "Ingredients:",
      ...(resultLines.length ? resultLines : ["No ingredients entered."]),
      "",
      "Note: review practical rounding for eggs, yeast, spices, pan size and cooking time.",
    ].join("\n");

    copyButton.dataset.invalidRows = invalidRows.join(", ");

    if (updateUrl) {
      syncUrl(servings);
    }

    liveStatus.textContent = servings.ok
      ? `Factor updated: ${factorResult.textContent}`
      : "";
  }

  function loadUrlParameters() {
    const parameters = new URLSearchParams(window.location.search);
    const original = parameters.get("original");
    const desired = parameters.get("desired");

    if (original && parseRecipeQuantityEn(original).ok) {
      originalInput.value = original;
    }

    if (desired && parseRecipeQuantityEn(desired).ok) {
      desiredInput.value = desired;
    }
  }

  function hasSavedDraft() {
    try {
      return Boolean(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return false;
    }
  }

  function syncDraftButton() {
    loadDraftButton.classList.toggle("hidden", !hasSavedDraft());
  }

  function saveDraft() {
    try {
      window.localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          original: originalInput.value,
          desired: desiredInput.value,
          formatMode: getFormatMode(),
          ingredients,
        }),
      );
      copyStatus.textContent = "Draft saved on this device.";
      syncDraftButton();
    } catch {
      copyStatus.textContent = "Unable to save the draft.";
    }
  }

  function loadDraft() {
    try {
      const rawDraft = window.localStorage.getItem(STORAGE_KEY);

      if (!rawDraft) {
        return;
      }

      const draft = JSON.parse(rawDraft);

      if (typeof draft.original === "string") {
        originalInput.value = draft.original;
      }

      if (typeof draft.desired === "string") {
        desiredInput.value = draft.desired;
      }

      if (["fraction", "decimal", "both"].includes(draft.formatMode)) {
        formatSelect.value = draft.formatMode;
      }

      if (Array.isArray(draft.ingredients)) {
        ingredients = draft.ingredients
          .slice(0, RECIPE_SCALING_MAX_INGREDIENTS)
          .map((ingredient) => ({
            quantity: String(ingredient.quantity ?? ""),
            unit: String(ingredient.unit ?? ""),
            name: String(ingredient.name ?? ""),
          }));
      }

      renderRows();
      copyStatus.textContent = "Draft loaded.";
    } catch {
      copyStatus.textContent = "Unable to load the draft.";
    }
  }

  async function copyRecipe() {
    const invalidRows = copyButton.dataset.invalidRows;

    if (invalidRows) {
      copyStatus.textContent = `Review rows ${invalidRows} before copying.`;
      return;
    }

    try {
      await navigator.clipboard.writeText(currentCopyText);
      copyStatus.textContent = "Scaled recipe copied.";
    } catch {
      copyStatus.textContent = "Unable to copy automatically.";
    }

    window.clearTimeout(copyTimer);
    copyTimer = window.setTimeout(() => {
      copyStatus.textContent = "";
    }, 2500);
  }

  function resetRecipe() {
    originalInput.value = "4";
    desiredInput.value = "6";
    formatSelect.value = "fraction";
    pasteInput.value = "";
    pasteStatus.textContent = "";
    ingredients = structuredClone(defaultRows);
    renderRows();
  }

  ingredientsList.addEventListener("input", (event) => {
    const input = event.target;
    const index = Number(input.dataset.index);
    const field = input.dataset.field;

    if (!Number.isInteger(index) || !["quantity", "unit", "name"].includes(field)) {
      return;
    }

    ingredients[index][field] = input.value;
    renderCalculations();
  });

  ingredientsList.addEventListener("click", (event) => {
    const button = event.target.closest("[data-remove-index]");

    if (!button) {
      return;
    }

    const index = Number(button.dataset.removeIndex);

    if (!Number.isInteger(index) || ingredients.length <= 1) {
      return;
    }

    ingredients.splice(index, 1);
    renderRows();
  });

  [originalInput, desiredInput, formatSelect].forEach((input) => {
    input.addEventListener("input", () => {
      renderCalculations();
    });
    input.addEventListener("change", () => {
      renderCalculations();
    });
  });

  pasteButton.addEventListener("click", () => {
    const remaining = RECIPE_SCALING_MAX_INGREDIENTS - ingredients.length;
    const existingBlankOnly = ingredients.every(
      (ingredient) =>
        !ingredient.quantity.trim() && !ingredient.unit.trim() && !ingredient.name.trim(),
    );
    const limit = existingBlankOnly ? RECIPE_SCALING_MAX_INGREDIENTS : remaining;
    const parsed = parsePastedIngredientsEn(pasteInput.value, limit);

    if (!parsed.ingredients.length) {
      pasteStatus.textContent = "Paste at least one ingredient line.";
      return;
    }

    ingredients = existingBlankOnly
      ? parsed.ingredients
      : [...ingredients, ...parsed.ingredients];

    pasteStatus.textContent =
      parsed.truncatedCount > 0
        ? `Loaded ${parsed.ingredients.length} ingredients. ${parsed.truncatedCount} were not added because of the 50-ingredient limit.`
        : `Loaded ${parsed.ingredients.length} ingredients.`;
    renderRows();
  });

  addRowButton.addEventListener("click", () => {
    if (ingredients.length >= RECIPE_SCALING_MAX_INGREDIENTS) {
      pasteStatus.textContent = "You reached the 50-ingredient limit.";
      return;
    }

    ingredients.push({ quantity: "", unit: "", name: "" });
    renderRows();
  });

  exampleButton.addEventListener("click", () => {
    originalInput.value = "4";
    desiredInput.value = "6";
    ingredients = structuredClone(exampleRows);
    pasteStatus.textContent = "Example loaded.";
    renderRows();
  });

  saveDraftButton.addEventListener("click", saveDraft);
  loadDraftButton.addEventListener("click", loadDraft);
  clearButton.addEventListener("click", resetRecipe);
  copyButton.addEventListener("click", copyRecipe);

  loadUrlParameters();
  syncDraftButton();
  renderRows();
</script>
