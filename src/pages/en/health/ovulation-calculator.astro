---
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Ovulation Calculator - Fertile Window and Menstrual Cycle";
const description =
  "Estimate your fertile window, probable ovulation day, and next period. Includes a cycle calendar, irregular-cycle mode, and pregnancy testing guidance.";
const canonical = "/en/health/ovulation-calculator";
const spanishCanonical = "/salud/calculadora-de-ovulacion";
const alternates = buildAlternateLinks({ es: spanishCanonical, en: canonical }, Astro.site ?? Astro.url);

const faqs = [
  {
    question: "How can I tell when I will ovulate?",
    answer:
      "Ovulation usually occurs about 12 to 14 days before your next period. This calculator estimates that date from the first day of your last menstrual period and your cycle length, but timing can vary from one cycle to another.",
  },
  {
    question: "How long does the fertile window last?",
    answer:
      "The main fertile window includes the five days before estimated ovulation and ovulation day itself. The following day is shown only as a margin for uncertainty.",
  },
  {
    question: "Can I use the calculator if my cycles are irregular?",
    answer:
      "Yes, but the estimate will cover a wider range and have a lower confidence level. Enter previous cycle dates or your shortest and longest cycle lengths to obtain a range.",
  },
  {
    question: "Can this be used as birth control?",
    answer:
      "No. This tool must not be used to prevent pregnancy. If you want to avoid pregnancy, use a reliable contraceptive method and consult a healthcare professional.",
  },
  {
    question: "When is the best time to take a pregnancy test?",
    answer:
      "Testing is generally most reliable from the first day of a missed period. An early test can be negative even if you are pregnant, so consider testing again if your period does not start.",
  },
  {
    question: "When should I seek advice if I am trying to conceive?",
    answer:
      "Consider seeking advice after 12 months of trying without becoming pregnant, or after 6 months if you are age 35 or older. Seek advice sooner if you are over 40, have highly irregular cycles, or have significant symptoms.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical} locale="en" alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Ovulation calculator"
      description="Estimate your fertile window, probable ovulation day, and next period with a confidence level and cycle calendar."
      kicker="Health"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Health", href: "/en/health", optional: true },
        { label: "Ovulation", truncate: true },
      ]}
    />

    <Container as="section" class="py-6 md:py-8">
      <section
        id="ovulation-calculator"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <div class="grid gap-0 xl:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.82fr)]">
          <div class="p-4 sm:p-6">
            <div>
              <p class="text-sm font-semibold text-emerald-300">
                Main calculation
              </p>
              <h2 id="calculator-heading" class="mt-2 text-2xl font-semibold">
                When might your fertile window occur?
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-gray-400">
                Choose the type of information you have. The result is an estimate,
                not a guarantee or a method of contraception.
              </p>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-3">
              <div class="sm:col-span-2">
                <label for="ovulation-mode" class="block text-sm font-semibold text-gray-200">
                  Calculation method
                </label>
                <select
                  id="ovulation-mode"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-emerald-300 focus:ring-3 focus:ring-emerald-300/15"
                  data-mode-select
                >
                  <option value="standard">Regular cycle</option>
                  <option value="history">Variable cycle using history</option>
                  <option value="range">Variable cycle using a range</option>
                  <option value="detected">Detected ovulation</option>
                </select>
              </div>

              <div>
                <label for="cycle-intent" class="block text-sm font-semibold text-gray-200">
                  Goal
                </label>
                <select
                  id="cycle-intent"
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none transition focus:border-emerald-300 focus:ring-3 focus:ring-emerald-300/15"
                  data-intent
                >
                  <option value="conceive">Trying to conceive</option>
                  <option value="track">Track my cycle</option>
                  <option value="avoid">Avoid pregnancy</option>
                </select>
              </div>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div>
                <label for="period-length" class="block text-sm font-medium text-gray-200">
                  Period length
                </label>
                <div
                  class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-300 focus-within:ring-3 focus-within:ring-emerald-300/15"
                >
                  <input
                    id="period-length"
                    class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                    type="number"
                    min="2"
                    max="10"
                    step="1"
                    inputmode="numeric"
                    value="5"
                    data-period-length
                  />
                  <span class="flex items-center px-4 text-gray-500">days</span>
                </div>
              </div>

              <div>
                <label for="luteal-phase" class="block text-sm font-medium text-gray-200">
                  Optional luteal phase
                </label>
                <div
                  class="mt-2 flex rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-300 focus-within:ring-3 focus:ring-emerald-300/15"
                >
                  <input
                    id="luteal-phase"
                    class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none placeholder:text-gray-600"
                    type="number"
                    min="10"
                    max="16"
                    step="1"
                    inputmode="numeric"
                    placeholder="14"
                    data-luteal-phase
                  />
                  <span class="flex items-center px-4 text-gray-500">days</span>
                </div>
              </div>
            </div>

            <div class="mt-6 space-y-5">
              <div data-mode-panel="standard">
                <fieldset class="rounded-lg border border-gray-800 bg-gray-900/60 p-4">
                  <legend class="text-sm font-semibold text-gray-200">
                    Regular cycle
                  </legend>
                  <div class="mt-3 grid gap-4 sm:grid-cols-2">
                    <div>
                      <label for="standard-lmp-date" class="block text-sm text-gray-300">
                        First day of your last period
                      </label>
                      <input
                        id="standard-lmp-date"
                        class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-emerald-300 focus:ring-3 focus:ring-emerald-300/15"
                        type="date"
                        data-standard-lmp
                      />
                    </div>

                    <div>
                      <label for="cycle-length-number" class="block text-sm text-gray-300">
                        Cycle length
                      </label>
                      <div
                        class="mt-2 flex rounded-lg border border-gray-700 bg-gray-950 focus-within:border-emerald-300 focus-within:ring-3 focus-within:ring-emerald-300/15"
                      >
                        <input
                          id="cycle-length-number"
                          class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                          type="number"
                          min="21"
                          max="45"
                          step="1"
                          inputmode="numeric"
                          value="28"
                          data-cycle-length
                        />
                        <span class="flex items-center px-4 text-gray-500">days</span>
                      </div>
                    </div>

                    <div class="sm:col-span-2">
                      <label for="cycle-length-range" class="block text-sm text-gray-300">
                        Quick cycle-length adjustment
                      </label>
                      <input
                        id="cycle-length-range"
                        class="mt-3 h-2 w-full accent-emerald-300"
                        type="range"
                        min="21"
                        max="45"
                        step="1"
                        value="28"
                        data-cycle-length-range
                      />
                      <div class="mt-2 flex justify-between text-xs text-gray-500">
                        <span>21 days</span>
                        <span>28 days</span>
                        <span>45 days</span>
                      </div>
                    </div>
                  </div>
                </fieldset>
              </div>

              <div class="hidden" data-mode-panel="history">
                <fieldset class="rounded-lg border border-gray-800 bg-gray-900/60 p-4">
                  <legend class="text-sm font-semibold text-gray-200">
                    Variable cycle using history
                  </legend>
                  <div class="mt-3">
                    <label for="history-lmp-date" class="block text-sm text-gray-300">
                      First day of your last period
                    </label>
                    <input
                      id="history-lmp-date"
                      class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-emerald-300 focus:ring-3 focus:ring-emerald-300/15"
                      type="date"
                      data-history-lmp
                    />
                  </div>
                  <div class="mt-4 grid gap-4 sm:grid-cols-2">
                    {
                      [1, 2, 3, 4].map((index) => (
                        <div>
                          <label
                            for={`history-date-${index}`}
                            class="block text-sm text-gray-300"
                          >
                            Previous period {index}
                          </label>
                          <input
                            id={`history-date-${index}`}
                            class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-emerald-300 focus:ring-3 focus:ring-emerald-300/15"
                            type="date"
                            data-history-date
                          />
                        </div>
                      ))
                    }
                  </div>
                  <p class="mt-3 text-sm leading-relaxed text-gray-500">
                    Enter at least two previous dates. Three or more recent cycles
                    can improve the confidence level.
                  </p>
                </fieldset>
              </div>

              <div class="hidden" data-mode-panel="range">
                <fieldset class="rounded-lg border border-gray-800 bg-gray-900/60 p-4">
                  <legend class="text-sm font-semibold text-gray-200">
                    Variable cycle using a range
                  </legend>
                  <div class="mt-3 grid gap-4 sm:grid-cols-3">
                    <div class="sm:col-span-3">
                      <label for="range-lmp-date" class="block text-sm text-gray-300">
                        First day of your last period
                      </label>
                      <input
                        id="range-lmp-date"
                        class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-emerald-300 focus:ring-3 focus:ring-emerald-300/15"
                        type="date"
                        data-range-lmp
                      />
                    </div>
                    <div>
                      <label for="shortest-cycle" class="block text-sm text-gray-300">
                        Shortest cycle
                      </label>
                      <div class="mt-2 flex rounded-lg border border-gray-700 bg-gray-950">
                        <input
                          id="shortest-cycle"
                          class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                          type="number"
                          min="21"
                          max="45"
                          step="1"
                          inputmode="numeric"
                          placeholder="25"
                          data-shortest-cycle
                        />
                        <span class="flex items-center px-4 text-gray-500">days</span>
                      </div>
                    </div>
                    <div>
                      <label for="longest-cycle" class="block text-sm text-gray-300">
                        Longest cycle
                      </label>
                      <div class="mt-2 flex rounded-lg border border-gray-700 bg-gray-950">
                        <input
                          id="longest-cycle"
                          class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none"
                          type="number"
                          min="21"
                          max="45"
                          step="1"
                          inputmode="numeric"
                          placeholder="32"
                          data-longest-cycle
                        />
                        <span class="flex items-center px-4 text-gray-500">days</span>
                      </div>
                    </div>
                  </div>
                </fieldset>
              </div>

              <div class="hidden" data-mode-panel="detected">
                <fieldset class="rounded-lg border border-gray-800 bg-gray-900/60 p-4">
                  <legend class="text-sm font-semibold text-gray-200">
                    Detected ovulation
                  </legend>
                  <div class="mt-3 grid gap-4 sm:grid-cols-2">
                    <div>
                      <label for="detected-ovulation-date" class="block text-sm text-gray-300">
                        Detected ovulation date
                      </label>
                      <input
                        id="detected-ovulation-date"
                        class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-emerald-300 focus:ring-3 focus:ring-emerald-300/15"
                        type="date"
                        data-detected-ovulation
                      />
                    </div>
                    <div>
                      <label for="ovulation-source" class="block text-sm text-gray-300">
                        Source
                      </label>
                      <select
                        id="ovulation-source"
                        class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-950 px-4 text-base text-white outline-none transition focus:border-emerald-300 focus:ring-3 focus:ring-emerald-300/15"
                        data-ovulation-source
                      >
                        <option value="lh">LH test</option>
                        <option value="bbt">Basal body temperature</option>
                        <option value="mucus">Cervical mucus</option>
                        <option value="ultrasound">Ultrasound</option>
                        <option value="clinical">Clinical monitoring</option>
                        <option value="other">Other sign</option>
                      </select>
                    </div>
                  </div>
                </fieldset>
              </div>

              <p class="hidden text-sm text-red-300" data-form-error></p>

              <div class="flex flex-col gap-3 border-t border-gray-800 pt-5 sm:flex-row sm:flex-wrap">
                <button
                  class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-emerald-300 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-300/40"
                  type="button"
                  data-fill-example
                >
                  Use example
                </button>
                <button
                  class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-emerald-300 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-300/40"
                  type="button"
                  data-clear-calculator
                >
                  Clear
                </button>
                <button
                  class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-emerald-300 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-300/40"
                  type="button"
                  data-save-cycle
                >
                  Save on this device
                </button>
                <button
                  class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-red-300 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-red-300/40"
                  type="button"
                  data-delete-cycle
                >
                  Delete saved data
                </button>
              </div>
              <p class="text-xs leading-relaxed text-gray-500" data-storage-note>
                Your data is stored only in this browser using local storage. No
                account is created, and nothing is sent to a server.
              </p>
            </div>
          </div>

          <aside
            class="border-t border-gray-800 bg-gray-900/70 p-4 sm:p-6 xl:border-l xl:border-t-0"
            aria-live="polite"
          >
            <p class="text-sm font-semibold text-emerald-300" data-result-kicker>
              Result
            </p>
            <p
              class="mt-3 break-words text-3xl font-bold leading-tight text-white md:text-4xl"
              data-main-result
            >
              Complete your information
            </p>
            <p class="mt-3 text-sm leading-relaxed text-gray-400" data-result-note>
              Your result will appear here with a confidence level, calendar, and
              suggested next steps.
            </p>

            <div class="mt-5 grid gap-3">
              <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-4">
                <span class="block text-xs font-semibold text-gray-500">
                  Estimated ovulation
                </span>
                <span class="mt-2 block text-lg font-semibold text-white" data-summary-ovulation>-</span>
              </div>
              <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-4">
                <span class="block text-xs font-semibold text-gray-500">
                  Next period
                </span>
                <span class="mt-2 block text-lg font-semibold text-white" data-summary-period>-</span>
              </div>
              <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-4">
                <span class="block text-xs font-semibold text-gray-500">Confidence</span>
                <span class="mt-2 block text-lg font-semibold text-white" data-summary-confidence>-</span>
                <span class="mt-2 block text-sm leading-relaxed text-gray-400" data-confidence-note></span>
              </div>
              <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-4">
                <span class="block text-xs font-semibold text-gray-500">Today</span>
                <span class="mt-2 block text-sm leading-relaxed text-gray-300" data-today-status>-</span>
              </div>
            </div>

            <div class="mt-5 hidden rounded-lg border border-amber-400/40 bg-amber-400/10 p-4" data-warning-panel>
              <p class="text-sm font-semibold text-amber-200">Review this information</p>
              <ul class="mt-2 space-y-2 text-sm leading-relaxed text-amber-100" data-warning-list></ul>
            </div>

            <div class="mt-5 flex flex-col gap-3 sm:flex-row xl:flex-col">
              <button
                class="inline-flex min-h-11 items-center justify-center rounded-lg bg-emerald-300 px-4 py-2 text-sm font-semibold text-gray-950 transition hover:bg-emerald-200 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-300/40"
                type="button"
                data-copy-result
              >
                Copy summary
              </button>
              <a
                class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-emerald-300 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-300/40"
                href="/en/health/pregnancy-due-date-calculator"
              >
                Go to the pregnancy due date calculator
              </a>
            </div>
            <p class="mt-2 min-h-5 text-xs text-gray-500" data-action-feedback></p>

            <div class="mt-5 rounded-lg border border-gray-700 bg-gray-950 p-4">
              <p class="text-sm font-semibold text-gray-100">Health notice</p>
              <p class="mt-2 text-sm leading-relaxed text-gray-400">
                This calculator provides an estimate based on averages. Ovulation
                can vary from one cycle to another and this tool must not be used
                as a method of contraception.
              </p>
            </div>
          </aside>
        </div>
      </section>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-6 md:py-8">
      <SectionIntro
        title="Cycle calendar"
        description="The legend combines color and text so it does not rely on color alone. Select a day to view its details."
      />
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.4fr)]">
        <div class="rounded-lg border border-gray-700 bg-gray-950 p-4 sm:p-5">
          <div class="flex flex-wrap gap-3 text-xs text-gray-300" aria-label="Calendar legend">
            <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-rose-300"></span> Period</span>
            <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-emerald-300"></span> Fertile window</span>
            <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-amber-300"></span> Ovulation</span>
            <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-sm border border-dashed border-emerald-200"></span> Uncertainty margin</span>
          </div>
          <div class="mt-5 grid gap-5 xl:grid-cols-2" data-calendar-months>
            <p class="text-sm text-gray-400">Complete the calculator to view the calendar.</p>
          </div>
        </div>

        <div class="rounded-lg border border-gray-700 bg-gray-950 p-4 sm:p-5">
          <h2 class="text-xl font-semibold">Day details</h2>
          <p class="mt-3 text-sm leading-relaxed text-gray-400" data-day-detail>
            Select a day on the calendar to view its estimated cycle phase and fertility.
          </p>
        </div>
      </div>
    </Container>

    <Container as="section" class="py-6 md:py-8">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-lg border border-gray-700 bg-gray-950 p-4 sm:p-5">
          <h2 class="text-xl font-semibold">Days in the fertile window</h2>
          <div class="mt-4 grid gap-3" data-fertility-rows>
            <p class="text-sm text-gray-400">Complete the calculator to view the breakdown.</p>
          </div>
        </div>

        <div class="rounded-lg border border-gray-700 bg-gray-950 p-4 sm:p-5">
          <h2 class="text-xl font-semibold">When to take a pregnancy test</h2>
          <div class="mt-4 grid gap-3 text-sm leading-relaxed text-gray-300">
            <p>Most reliable time: <strong class="text-white" data-test-reliable>-</strong></p>
            <p>Early-detection test: <strong class="text-white" data-test-sensitive>-</strong></p>
            <p class="text-gray-400" data-test-note>
              If you test before your missed period and get a negative result, it may simply be too early.
            </p>
          </div>
        </div>
      </div>
    </Container>

    <Container as="section" class="py-6 md:py-8">
      <div class="grid gap-6 md:grid-cols-3">
        <div>
          <h2 class="text-2xl font-semibold">How to interpret confidence</h2>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Confidence improves when several recent cycles are available and their lengths vary little. It decreases when cycles are long, highly variable, or the date is less certain.
          </p>
        </div>
        <div>
          <h2 class="text-2xl font-semibold">Signs that may help</h2>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            LH tests, cervical mucus, and basal body temperature can complement the estimate. No single sign guarantees the exact timing of ovulation.
          </p>
        </div>
        <div>
          <h2 class="text-2xl font-semibold">When to seek advice</h2>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Consider consulting a specialist after 12 months of trying to conceive, or after 6 months if you are age 35 or older.
          </p>
        </div>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<script>
  import {
    addCalendarDays,
    buildOvulationCopyText,
    calculateFromCycleHistory,
    calculateFromCycleRange,
    calculateFromDetectedOvulation,
    calculateStandardCycle,
    comparePlainDates,
    diffTotalDays,
    formatFullOvulationDate,
    formatIsoDate,
    formatOvulationDate,
    formatOvulationDateRange,
    parseIsoDate,
    todayInLocalTimeZone,
  } from "@lib/calculators/salud/calculadora-de-ovulacion/ovulation.en";

  const storageKey = "calculadoras.tools.ovulation.v1";
  const modeSelect = document.querySelector("[data-mode-select]");
  const modePanels = document.querySelectorAll("[data-mode-panel]");
  const formError = document.querySelector("[data-form-error]");
  const resultKicker = document.querySelector("[data-result-kicker]");
  const mainResult = document.querySelector("[data-main-result]");
  const resultNote = document.querySelector("[data-result-note]");
  const summaryOvulation = document.querySelector("[data-summary-ovulation]");
  const summaryPeriod = document.querySelector("[data-summary-period]");
  const summaryConfidence = document.querySelector("[data-summary-confidence]");
  const confidenceNote = document.querySelector("[data-confidence-note]");
  const todayStatus = document.querySelector("[data-today-status]");
  const warningPanel = document.querySelector("[data-warning-panel]");
  const warningList = document.querySelector("[data-warning-list]");
  const calendarMonths = document.querySelector("[data-calendar-months]");
  const dayDetail = document.querySelector("[data-day-detail]");
  const fertilityRows = document.querySelector("[data-fertility-rows]");
  const testReliable = document.querySelector("[data-test-reliable]");
  const testSensitive = document.querySelector("[data-test-sensitive]");
  const testNote = document.querySelector("[data-test-note]");
  const actionFeedback = document.querySelector("[data-action-feedback]");

  const fields = {
    intent: document.querySelector("[data-intent]"),
    periodLength: document.querySelector("[data-period-length]"),
    lutealPhase: document.querySelector("[data-luteal-phase]"),
    standardLmp: document.querySelector("[data-standard-lmp]"),
    cycleLength: document.querySelector("[data-cycle-length]"),
    cycleLengthRange: document.querySelector("[data-cycle-length-range]"),
    historyLmp: document.querySelector("[data-history-lmp]"),
    historyDates: [...document.querySelectorAll("[data-history-date]")],
    rangeLmp: document.querySelector("[data-range-lmp]"),
    shortestCycle: document.querySelector("[data-shortest-cycle]"),
    longestCycle: document.querySelector("[data-longest-cycle]"),
    detectedOvulation: document.querySelector("[data-detected-ovulation]"),
    ovulationSource: document.querySelector("[data-ovulation-source]"),
  };

  const allInputs = [
    modeSelect, fields.intent, fields.periodLength, fields.lutealPhase,
    fields.standardLmp, fields.cycleLength, fields.cycleLengthRange,
    fields.historyLmp, ...fields.historyDates, fields.rangeLmp,
    fields.shortestCycle, fields.longestCycle, fields.detectedOvulation,
    fields.ovulationSource,
  ];

  let lastResult = null;

  function setMode(mode) {
    modePanels.forEach((panel) => {
      panel.classList.toggle("hidden", panel.dataset.modePanel !== mode);
    });
    updateCalculator();
  }

  function updateCalculator() {
    clearError();
    const result = getResultForMode(modeSelect.value, true);

    if (!result.ok) {
      lastResult = null;
      if (result.reason === "empty") {
        renderNeutralState();
        return;
      }
      renderInvalidState(result.message);
      return;
    }

    lastResult = result.result;
    renderResult(result.result);
  }

  function getResultForMode(mode, strict) {
    try {
      const shared = {
        periodLength: readInteger(fields.periodLength, 2, 10, "Your period length must be between 2 and 10 days."),
        lutealPhase: readOptionalInteger(fields.lutealPhase, 10, 16, "The luteal phase must be between 10 and 16 days."),
        today: todayInLocalTimeZone(),
        intent: fields.intent.value,
      };

      if (mode === "standard") {
        const lmpDate = readDate(fields.standardLmp, "Enter the first day of your last period.", strict);
        if (!lmpDate) return emptyResult();

        return okResult(
          calculateStandardCycle({
            lmpDate,
            cycleLength: readInteger(fields.cycleLength, 21, 45, "Cycle length must be between 21 and 45 days."),
            ...shared,
          }),
        );
      }

      if (mode === "history") {
        const lmpDate = readDate(fields.historyLmp, "Enter the first day of your last period.", strict);
        if (!lmpDate) return emptyResult();
        const previousPeriodStartDates = fields.historyDates
          .map((input) => readDate(input, "", false))
          .filter(Boolean);

        if (previousPeriodStartDates.length < 2) {
          if (strict) {
            throw new Error("Add at least two previous period dates to estimate variable cycles.");
          }
          return emptyResult();
        }

        return okResult(
          calculateFromCycleHistory({
            lmpDate,
            previousPeriodStartDates,
            ...shared,
          }),
        );
      }

      if (mode === "range") {
        const lmpDate = readDate(fields.rangeLmp, "Enter the first day of your last period.", strict);
        if (!lmpDate) return emptyResult();

        return okResult(
          calculateFromCycleRange({
            lmpDate,
            shortestCycle: readInteger(fields.shortestCycle, 21, 45, "The shortest cycle must be between 21 and 45 days."),
            longestCycle: readInteger(fields.longestCycle, 21, 45, "The longest cycle must be between 21 and 45 days."),
            ...shared,
          }),
        );
      }

      if (mode === "detected") {
        const ovulationDate = readDate(fields.detectedOvulation, "Enter the detected ovulation date.", strict);
        if (!ovulationDate) return emptyResult();

        return okResult(
          calculateFromDetectedOvulation({
            ovulationDate,
            source: fields.ovulationSource.value,
            ...shared,
          }),
        );
      }
    } catch (error) {
      return invalidResult(error instanceof Error ? error.message : "Review the information you entered.");
    }

    return emptyResult();
  }

  function readDate(input, message, strict) {
    const value = input.value.trim();

    if (!value) {
      if (strict && message) {
        throw new Error(message);
      }

      return null;
    }

    const date = parseIsoDate(value);

    if (!date) {
      throw new Error("Enter a valid date.");
    }

    return date;
  }

  function readInteger(input, min, max, message) {
    const value = input.value.trim();

    if (!/^\d+$/.test(value)) {
      throw new Error(message);
    }

    const number = Number(value);

    if (number < min || number > max) {
      throw new Error(message);
    }

    return number;
  }

  function readOptionalInteger(input, min, max, message) {
    const value = input.value.trim();

    if (!value) {
      return undefined;
    }

    return readInteger(input, min, max, message);
  }

  function renderNeutralState() {
    resultKicker.textContent = "Result";
    mainResult.textContent = "Complete your information";
    resultNote.textContent =
      "Your result will appear here with a confidence level, calendar, and suggested next steps.";
    summaryOvulation.textContent = "-";
    summaryPeriod.textContent = "-";
    summaryConfidence.textContent = "-";
    confidenceNote.textContent = "";
    todayStatus.textContent = "-";
    renderWarnings([]);
    renderCalendar(null);
    renderFertilityRows(null);
    renderPregnancyTest(null);
  }

  function renderInvalidState(message) {
    showError(message);
    resultKicker.textContent = "Review your information";
    mainResult.textContent = "Unable to calculate yet";
    resultNote.textContent = message;
    summaryOvulation.textContent = "-";
    summaryPeriod.textContent = "-";
    summaryConfidence.textContent = "-";
    confidenceNote.textContent = "";
    todayStatus.textContent = "-";
    renderWarnings([]);
    renderCalendar(null);
    renderFertilityRows(null);
    renderPregnancyTest(null);
  }

  function renderResult(result) {
    const ovulationRange = formatOvulationDateRange(
      result.ovulationStart,
      result.ovulationEnd,
    );
    const periodRange = formatOvulationDateRange(
      result.nextPeriodRange?.start ?? result.nextPeriodDate,
      result.nextPeriodRange?.end ?? result.nextPeriodDate,
    );

    resultKicker.textContent = "Estimated fertile window";
    mainResult.textContent = formatOvulationDateRange(
      result.fertileStart,
      result.fertileEnd,
    );
    resultNote.textContent = `Days with the highest relative probability: ${formatOvulationDateRange(
      result.peakStart,
      result.peakEnd,
    )}. Observation margin: ${formatOvulationDate(result.observationEnd)}.`;
    summaryOvulation.textContent = ovulationRange;
    summaryPeriod.textContent = periodRange;
    summaryConfidence.textContent = `${result.modeLabel} · ${result.confidence.toLowerCase()} confidence`;
    confidenceNote.textContent = result.confidenceMessage;
    todayStatus.textContent = result.todayStatus.message;
    renderWarnings(result.warnings);
    renderCalendar(result);
    renderFertilityRows(result);
    renderPregnancyTest(result);
  }

  function renderWarnings(warnings) {
    warningList.innerHTML = "";

    warnings.forEach((warning) => {
      const item = document.createElement("li");
      item.textContent = warning;
      warningList.append(item);
    });

    warningPanel.classList.toggle("hidden", warnings.length === 0);
  }

  function renderCalendar(result) {
    calendarMonths.innerHTML = "";

    if (!result) {
      calendarMonths.innerHTML =
        '<p class="text-sm text-gray-400">Complete the calculator to view the calendar.</p>';
      dayDetail.textContent =
        "Select a day on the calendar to view its estimated cycle phase and fertility.";
      return;
    }

    const firstMonth = startOfMonth(result.lmpDate);
    const lastMonth = startOfMonth(result.nextPeriodRange?.end ?? result.observationEnd);
    const months = getMonthsBetween(firstMonth, lastMonth).slice(0, 3);

    months.forEach((month) => {
      calendarMonths.append(buildMonthElement(month, result));
    });

    renderDayDetail(result.ovulationStart, result);
  }

  function buildMonthElement(month, result) {
    const wrapper = document.createElement("section");
    wrapper.className = "rounded-lg border border-gray-800 bg-gray-900/60 p-3";

    const title = document.createElement("h3");
    title.className = "text-sm font-semibold text-gray-100";
    title.textContent = formatMonthTitle(month);

    const grid = document.createElement("div");
    grid.className = "mt-3 grid grid-cols-7 gap-1";
    grid.setAttribute("role", "grid");

    ["M", "T", "W", "T", "F", "S", "S"].forEach((day) => {
      const item = document.createElement("div");
      item.className = "flex h-7 items-center justify-center text-xs font-semibold text-gray-500";
      item.textContent = day;
      grid.append(item);
    });

    const leadingBlanks = getMondayWeekdayIndex(month);

    for (let index = 0; index < leadingBlanks; index += 1) {
      const blank = document.createElement("div");
      blank.className = "h-9";
      grid.append(blank);
    }

    const totalDays = daysInMonth(month.year, month.month);

    for (let day = 1; day <= totalDays; day += 1) {
      const date = { year: month.year, month: month.month, day };
      const meta = getDayMeta(date, result);
      const button = document.createElement("button");
      button.type = "button";
      button.className = `flex h-9 w-full items-center justify-center rounded-md border text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 ${meta.className}`;
      button.textContent = String(day);
      button.setAttribute(
        "aria-label",
        `${formatFullOvulationDate(date)}. ${meta.label}. ${meta.fertility}.`,
      );
      button.addEventListener("click", () => renderDayDetail(date, result));
      grid.append(button);
    }

    wrapper.append(title, grid);
    return wrapper;
  }

  function getDayMeta(date, result) {
    const today = todayInLocalTimeZone();
    const isToday = comparePlainDates(date, today) === 0;
    const todayClass = isToday ? " ring-2 ring-sky-300" : "";
    const inPeriod = isBetween(date, result.lmpDate, result.periodEndDate);
    const inFertile = isBetween(date, result.fertileStart, result.fertileEnd);
    const inOvulation = isBetween(date, result.ovulationStart, result.ovulationEnd);
    const inMargin = comparePlainDates(date, result.observationEnd) === 0;

    if (inOvulation) {
      return {
        label: "Estimated ovulation",
        fertility: "Very high estimated fertility",
        className: `border-amber-300 bg-amber-300 text-gray-950${todayClass}`,
      };
    }

    if (inFertile && inPeriod) {
      return {
        label: "Estimated period and fertile window",
        fertility: "Increasing estimated fertility",
        className: `border-emerald-300 bg-emerald-300/80 text-gray-950${todayClass}`,
      };
    }

    if (inFertile) {
      return {
        label: "Estimated fertile window",
        fertility: "High estimated fertility",
        className: `border-emerald-300 bg-emerald-300 text-gray-950${todayClass}`,
      };
    }

    if (inMargin) {
      return {
        label: "Uncertainty margin",
        fertility: "Low estimated fertility",
        className: `border-dashed border-emerald-200 bg-emerald-300/10 text-emerald-100${todayClass}`,
      };
    }

    if (inPeriod) {
      return {
        label: "Estimated period",
        fertility: "Low estimated fertility",
        className: `border-rose-300 bg-rose-300/80 text-gray-950${todayClass}`,
      };
    }

    return {
      label: "Low estimated fertility",
      fertility: "Low estimated fertility",
      className: `border-gray-800 bg-gray-950 text-gray-300 hover:border-gray-600${todayClass}`,
    };
  }

  function renderDayDetail(date, result) {
    const meta = getDayMeta(date, result);
    const cycleDay = diffTotalDays(result.lmpDate, date) + 1;

    dayDetail.textContent = `${formatFullOvulationDate(date)}. Day ${cycleDay} of the estimated cycle. ${meta.label}. ${meta.fertility}.`;
  }

  function renderFertilityRows(result) {
    fertilityRows.innerHTML = "";

    if (!result) {
      fertilityRows.innerHTML =
        '<p class="text-sm text-gray-400">Complete the calculator to view the breakdown.</p>';
      return;
    }

    result.fertilityRows.forEach((row) => {
      const item = document.createElement("div");
      item.className = "grid gap-2 rounded-lg border border-gray-800 bg-gray-900/60 p-4 sm:grid-cols-[5rem_1fr]";

      const date = document.createElement("div");
      date.className = "text-sm font-semibold text-white";
      date.textContent = formatOvulationDate(row.date);

      const details = document.createElement("div");
      details.innerHTML = `
        <p class="text-sm font-semibold text-gray-100">${row.relation} · ${row.level}</p>
        <p class="mt-1 text-sm leading-relaxed text-gray-400">Day ${row.cycleDay} of the cycle. ${row.description}</p>
      `;

      item.append(date, details);
      fertilityRows.append(item);
    });
  }

  function renderPregnancyTest(result) {
    if (!result) {
      testReliable.textContent = "-";
      testSensitive.textContent = "-";
      testNote.textContent =
        "If you test before your missed period and get a negative result, it may simply be too early.";
      return;
    }

    const reliableStart = result.nextPeriodRange?.start ?? result.nextPeriodDate;
    const reliableEnd = result.nextPeriodRange?.end ?? result.nextPeriodDate;
    const sensitiveStart = addCalendarDays(result.ovulationStart, 10);
    const sensitiveEnd = addCalendarDays(result.ovulationEnd, 12);

    testReliable.textContent = `from ${formatOvulationDateRange(reliableStart, reliableEnd)}`;
    testSensitive.textContent = `${formatOvulationDateRange(sensitiveStart, sensitiveEnd)}`;
    testNote.textContent =
      "An early negative result does not rule out pregnancy. Test again in a few days if your period does not start.";
  }

  function fillExample() {
    const mode = modeSelect.value;
    fields.periodLength.value = "5";
    fields.lutealPhase.value = "";
    fields.intent.value = "conceive";

    if (mode === "standard") {
      fields.standardLmp.value = "2026-04-01";
      setCycleLength("28");
    } else if (mode === "history") {
      fields.historyLmp.value = "2026-04-01";
      ["2026-01-05", "2026-02-02", "2026-03-03", ""].forEach((value, index) => {
        fields.historyDates[index].value = value;
      });
    } else if (mode === "range") {
      fields.rangeLmp.value = "2026-04-01";
      fields.shortestCycle.value = "25";
      fields.longestCycle.value = "32";
    } else if (mode === "detected") {
      fields.detectedOvulation.value = "2026-04-15";
      fields.ovulationSource.value = "lh";
    }

    updateCalculator();
  }

  function clearCalculator() {
    fields.periodLength.value = "5";
    fields.lutealPhase.value = "";
    fields.intent.value = "conceive";
    fields.standardLmp.value = "";
    setCycleLength("28");
    fields.historyLmp.value = "";
    fields.historyDates.forEach((input) => {
      input.value = "";
    });
    fields.rangeLmp.value = "";
    fields.shortestCycle.value = "";
    fields.longestCycle.value = "";
    fields.detectedOvulation.value = "";
    fields.ovulationSource.value = "lh";
    clearFeedback();
    renderNeutralState();
  }

  function saveCycle() {
    const payload = {
      mode: modeSelect.value,
      intent: fields.intent.value,
      periodLength: fields.periodLength.value,
      lutealPhase: fields.lutealPhase.value,
      standardLmp: fields.standardLmp.value,
      cycleLength: fields.cycleLength.value,
      historyLmp: fields.historyLmp.value,
      historyDates: fields.historyDates.map((input) => input.value),
      rangeLmp: fields.rangeLmp.value,
      shortestCycle: fields.shortestCycle.value,
      longestCycle: fields.longestCycle.value,
      detectedOvulation: fields.detectedOvulation.value,
      ovulationSource: fields.ovulationSource.value,
    };

    localStorage.setItem(storageKey, JSON.stringify(payload));
    showFeedback("Data saved on this device.");
  }

  function loadSavedCycle() {
    try {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return;

      const payload = JSON.parse(raw);
      modeSelect.value = payload.mode ?? "standard";
      fields.intent.value = payload.intent ?? "conceive";
      fields.periodLength.value = payload.periodLength ?? "5";
      fields.lutealPhase.value = payload.lutealPhase ?? "";
      fields.standardLmp.value = payload.standardLmp ?? "";
      setCycleLength(payload.cycleLength ?? "28");
      fields.historyLmp.value = payload.historyLmp ?? "";
      fields.historyDates.forEach((input, index) => {
        input.value = payload.historyDates?.[index] ?? "";
      });
      fields.rangeLmp.value = payload.rangeLmp ?? "";
      fields.shortestCycle.value = payload.shortestCycle ?? "";
      fields.longestCycle.value = payload.longestCycle ?? "";
      fields.detectedOvulation.value = payload.detectedOvulation ?? "";
      fields.ovulationSource.value = payload.ovulationSource ?? "lh";
      setMode(modeSelect.value);
      showFeedback("Saved data loaded from this browser.");
    } catch {
      localStorage.removeItem(storageKey);
    }
  }

  function deleteSavedCycle() {
    localStorage.removeItem(storageKey);
    showFeedback("Saved data deleted.");
  }

  async function copyResult() {
    if (!lastResult) {
      showFeedback("Complete the calculator before copying the summary.");
      return;
    }

    const text = buildOvulationCopyText(lastResult);

    try {
      await navigator.clipboard.writeText(text);
      showFeedback("Summary copied.");
    } catch {
      showFeedback("The summary could not be copied automatically.");
    }
  }

  function setCycleLength(value) {
    fields.cycleLength.value = value;
    fields.cycleLengthRange.value = value;
  }

  function showError(message) {
    formError.textContent = message;
    formError.classList.remove("hidden");
  }

  function clearError() {
    formError.textContent = "";
    formError.classList.add("hidden");
  }

  function showFeedback(message) {
    actionFeedback.textContent = message;
  }

  function clearFeedback() {
    actionFeedback.textContent = "";
  }

  function okResult(result) {
    return { ok: true, result };
  }

  function emptyResult() {
    return { ok: false, reason: "empty" };
  }

  function invalidResult(message) {
    return { ok: false, reason: "invalid", message };
  }

  function isBetween(date, start, end) {
    return comparePlainDates(date, start) >= 0 && comparePlainDates(date, end) <= 0;
  }

  function startOfMonth(date) {
    return { year: date.year, month: date.month, day: 1 };
  }

  function addMonths(date, months) {
    const totalMonths = date.year * 12 + date.month - 1 + months;
    return {
      year: Math.floor(totalMonths / 12),
      month: positiveModulo(totalMonths, 12) + 1,
      day: 1,
    };
  }

  function getMonthsBetween(start, end) {
    const months = [];
    let current = start;

    while (comparePlainDates(current, end) <= 0) {
      months.push(current);
      current = addMonths(current, 1);
    }

    return months;
  }

  function daysInMonth(year, month) {
    return new Date(Date.UTC(year, month, 0)).getUTCDate();
  }

  function getMondayWeekdayIndex(date) {
    const day = new Date(Date.UTC(date.year, date.month - 1, date.day)).getUTCDay();
    return (day + 6) % 7;
  }

  function formatMonthTitle(date) {
    return new Intl.DateTimeFormat("en-US", {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }).format(new Date(Date.UTC(date.year, date.month - 1, date.day)));
  }

  function positiveModulo(value, divisor) {
    return ((value % divisor) + divisor) % divisor;
  }

  allInputs.forEach((input) => {
    input?.addEventListener("input", updateCalculator);
    input?.addEventListener("change", updateCalculator);
  });

  fields.cycleLength?.addEventListener("input", () => {
    fields.cycleLengthRange.value = fields.cycleLength.value;
  });
  fields.cycleLengthRange?.addEventListener("input", () => {
    fields.cycleLength.value = fields.cycleLengthRange.value;
  });
  modeSelect?.addEventListener("change", () => setMode(modeSelect.value));
  document.querySelector("[data-fill-example]")?.addEventListener("click", fillExample);
  document.querySelector("[data-clear-calculator]")?.addEventListener("click", clearCalculator);
  document.querySelector("[data-save-cycle]")?.addEventListener("click", saveCycle);
  document.querySelector("[data-delete-cycle]")?.addEventListener("click", deleteSavedCycle);
  document.querySelector("[data-copy-result]")?.addEventListener("click", copyResult);

  renderNeutralState();
  loadSavedCycle();
  setMode(modeSelect.value);
</script>
