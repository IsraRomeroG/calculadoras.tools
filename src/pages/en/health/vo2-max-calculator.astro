---
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildFaqJsonLd } from "@lib/seo";

const title = "VO2 Max Calculator: Cooper and Rockport Tests";
const description =
  "Estimate your VO2 max with the 12-minute Cooper test or the Rockport walk. Includes protocols, data-quality checks, and comparisons.";
const canonical = "/en/health/vo2-max-calculator";
const spanishCanonical = "/salud/calculadora-vo2-max";
const alternates = buildAlternateLinks({ es: spanishCanonical, en: canonical }, Astro.site ?? Astro.url);
const faqs = [
  {
    question: "What is VO2 max?",
    answer:
      "It measures the maximum amount of oxygen your body can use during intense exercise. This calculator provides a field estimate in ml/kg/min.",
  },
  {
    question: "What is the difference between Cooper and Rockport?",
    answer:
      "Cooper uses the distance covered during 12 minutes of hard effort. Rockport uses a fast one-mile walk together with age, weight, time, and finishing heart rate.",
  },
  {
    question: "Can I run during the Rockport test?",
    answer:
      "No. The Rockport equation used here requires walking the entire mile. Running makes the result invalid for that protocol.",
  },
  {
    question: "Why did my result change?",
    answer:
      "Weather, altitude, surface, effort, heart-rate measurement, and daily conditions can affect the estimate. Compare results from the same method under similar conditions.",
  },
  {
    question: "Can I compare Cooper with Rockport?",
    answer:
      "Not directly. They use different protocols and equations. To track a trend, repeat the same method each time.",
  },
  {
    question: "Do I need a heart-rate monitor?",
    answer:
      "Only the Rockport test requires your finishing heart rate. You can use a monitor or count your beats immediately after the walk.",
  },
];
const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical} locale="en" alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Estimated VO2 max calculator"
      description="Choose a field test, follow the protocol, and get an estimate you can use to compare future measurements."
      kicker="Health"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      breadcrumbs={[
        { label: "Salud", href: "/salud" },
        { label: "VO2 max calculator", truncate: true },
      ]}
    />

    <Container as="section" class="py-6 md:py-10">
      <section
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="vo2-calculator-heading"
      >
        <div class="grid gap-0 xl:grid-cols-[minmax(0,0.98fr)_minmax(22rem,0.82fr)]">
          <form class="p-4 sm:p-6" data-calculator-form novalidate>
            <div>
              <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">Choose your test</p>
              <h2 id="vo2-calculator-heading" class="mt-2 text-2xl font-semibold text-white">
                What data do you have?
              </h2>
              <div class="mt-4 grid grid-cols-2 gap-2" role="group" aria-label="Estimation method">
                <button class="min-h-12 rounded-lg border border-amber-400 bg-amber-400/10 px-3 py-3 text-sm font-semibold text-amber-200" type="button" data-method="cooper" aria-pressed="true">
                  Cooper
                </button>
                <button class="min-h-12 rounded-lg border border-gray-700 px-3 py-3 text-sm font-semibold text-gray-300" type="button" data-method="rockport" aria-pressed="false">
                  Rockport
                </button>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-gray-400" data-method-help>
                Cooper is suitable if you can run or sustain a hard effort for 12 minutes.
              </p>
            </div>

            <div class="mt-5 rounded-lg border border-red-400/40 bg-red-950/25 p-4">
              <p class="font-semibold text-red-200">Before taking the test</p>
              <p class="mt-2 text-sm leading-relaxed text-red-100/80">
                Do not take the test if you have chest pain, dizziness, unusual shortness of breath, an injury that limits exertion, or medical advice to avoid exercise. Stop if symptoms appear.
              </p>
              <p class="mt-2 text-sm leading-relaxed text-red-100/80" data-cooper-safety>
                Cooper requires a hard effort. If you are not used to running or have health concerns, consider Rockport or consult a healthcare professional.
              </p>
            </div>

            <div class="mt-5 rounded-lg border border-gray-800 bg-gray-900/55 p-4" data-protocol="cooper">
              <p class="font-semibold text-white">How to perform the Cooper test</p>
              <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-gray-400">
                <li>Use a flat, measured route, preferably a track.</li>
                <li>After warming up, cover as much distance as possible in exactly 12:00.</li>
                <li>Record the total distance, including any additional meters.</li>
              </ol>
            </div>

            <div class="mt-5 hidden rounded-lg border border-gray-800 bg-gray-900/55 p-4" data-protocol="rockport">
              <p class="font-semibold text-white">How to perform the Rockport test</p>
              <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-gray-400">
                <li>Use a flat, measured route of exactly 1 mile or 1.609 km.</li>
                <li>Walk the entire distance as fast as possible without running.</li>
                <li>Record your time and measure your heart rate immediately after finishing.</li>
              </ol>
            </div>

            <div class="mt-6" data-fields="cooper">
              <fieldset>
                <legend class="text-sm font-semibold text-gray-200">How to record the distance</legend>
                <div class="mt-2 grid grid-cols-2 gap-2">
                  <button class="min-h-12 rounded-lg border border-amber-400 bg-amber-400/10 px-3 py-3 text-sm font-semibold text-amber-200" type="button" data-distance-mode="total" aria-pressed="true">Total distance</button>
                  <button class="min-h-12 rounded-lg border border-gray-700 px-3 py-3 text-sm font-semibold text-gray-300" type="button" data-distance-mode="laps" aria-pressed="false">400 m laps</button>
                </div>
              </fieldset>

              <div class="mt-5" data-distance-fields="total" data-field-block="distance">
                <label class="text-sm font-semibold text-gray-200" for="cooper-distance">Distance covered</label>
                <div class="mt-2 grid grid-cols-[minmax(0,1fr)_6.5rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15" data-wrapper="distance">
                  <input id="cooper-distance" class="min-w-0 bg-transparent px-4 py-3 text-base text-white outline-none" inputmode="decimal" autocomplete="off" data-input="distance" aria-describedby="distance-error" />
                  <select class="border-l border-gray-700 bg-gray-900 px-3 text-sm text-white outline-none" data-input="distanceUnit" aria-label="Distance unit">
                    <option value="m">m</option><option value="km">km</option><option value="mi">mi</option>
                  </select>
                </div>
                <p id="distance-error" class="mt-2 hidden text-sm text-red-300" data-error="distance"></p>
              </div>

              <div class="mt-5 hidden grid gap-4 sm:grid-cols-2" data-distance-fields="laps">
                <div>
                  <label class="text-sm font-semibold text-gray-200" for="cooper-laps">Vueltas completas</label>
                  <input id="cooper-laps" class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-base text-white outline-none focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15" inputmode="numeric" data-input="laps" aria-describedby="laps-error" />
                </div>
                <div>
                  <label class="text-sm font-semibold text-gray-200" for="cooper-extra">Metros adicionales</label>
                  <input id="cooper-extra" class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-base text-white outline-none focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15" inputmode="numeric" data-input="extraMeters" aria-describedby="laps-error" />
                </div>
                <p id="laps-error" class="hidden text-sm text-red-300 sm:col-span-2" data-error="laps"></p>
              </div>
            </div>

            <div class="mt-6 hidden space-y-5" data-fields="rockport">
              <div class="grid gap-4 sm:grid-cols-2">
                <div data-field-block="age">
                  <label class="text-sm font-semibold text-gray-200" for="rockport-age">Age</label>
                  <input id="rockport-age" class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-base text-white outline-none focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15" inputmode="numeric" data-input="age" aria-describedby="age-error" />
                  <p id="age-error" class="mt-2 hidden text-sm text-red-300" data-error="age"></p>
                </div>
                <div data-field-block="formulaSex">
                  <label class="text-sm font-semibold text-gray-200" for="rockport-sex">Sex used by the formula</label>
                  <select id="rockport-sex" class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-base text-white outline-none focus:border-amber-400" data-input="formulaSex" aria-describedby="sex-help formulaSex-error">
                    <option value="">Select</option><option value="male">Male</option><option value="female">Female</option>
                  </select>
                  <p id="sex-help" class="mt-2 text-xs leading-relaxed text-gray-500">This variable is required by the original equation.</p>
                  <p id="formulaSex-error" class="mt-2 hidden text-sm text-red-300" data-error="formulaSex"></p>
                </div>
              </div>

              <div data-field-block="weight">
                <label class="text-sm font-semibold text-gray-200" for="rockport-weight">Weight</label>
                <div class="mt-2 grid grid-cols-[minmax(0,1fr)_6.5rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15" data-wrapper="weight">
                  <input id="rockport-weight" class="min-w-0 bg-transparent px-4 py-3 text-base text-white outline-none" inputmode="decimal" data-input="weight" aria-describedby="weight-error" />
                  <select class="border-l border-gray-700 bg-gray-900 px-3 text-sm text-white outline-none" data-input="weightUnit" aria-label="Weight unit">
                    <option value="kg">kg</option><option value="lb">lb</option>
                  </select>
                </div>
                <p id="weight-error" class="mt-2 hidden text-sm text-red-300" data-error="weight"></p>
              </div>

              <fieldset>
                <legend class="text-sm font-semibold text-gray-200">Mile time</legend>
                <div class="mt-2 grid grid-cols-2 gap-4">
                  <div><label class="text-xs text-gray-400" for="rockport-minutes">Minutes</label><input id="rockport-minutes" class="mt-1 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-base text-white outline-none focus:border-amber-400" inputmode="numeric" data-input="minutes" aria-describedby="minutes-error" /></div>
                  <div><label class="text-xs text-gray-400" for="rockport-seconds">Seconds</label><input id="rockport-seconds" class="mt-1 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-base text-white outline-none focus:border-amber-400" inputmode="numeric" data-input="seconds" aria-describedby="minutes-error" /></div>
                </div>
                <p id="minutes-error" class="mt-2 hidden text-sm text-red-300" data-error="minutes"></p>
              </fieldset>

              <div data-field-block="finalPulse">
                <label class="text-sm font-semibold text-gray-200" for="rockport-pulse">Finishing heart rate</label>
                <div class="mt-2 grid grid-cols-[minmax(0,1fr)_5rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15" data-wrapper="finalPulse">
                  <input id="rockport-pulse" class="min-w-0 bg-transparent px-4 py-3 text-base text-white outline-none" inputmode="numeric" data-input="finalPulse" aria-describedby="pulse-help finalPulse-error" />
                  <span class="border-l border-gray-700 px-3 py-3 text-sm text-gray-400">bpm</span>
                </div>
                <p id="pulse-help" class="mt-2 text-xs leading-relaxed text-gray-500">Use a monitor or count your beats immediately after finishing.</p>
                <p id="finalPulse-error" class="mt-2 hidden text-sm text-red-300" data-error="finalPulse"></p>
              </div>

              <label class="flex min-h-12 items-start gap-3 rounded-lg border border-gray-700 bg-gray-900 p-3 text-sm text-gray-200" data-walk-confirmation>
                <input class="mt-1 size-4 accent-amber-400" type="checkbox" data-input="walkedEntireMile" aria-describedby="walkedEntireMile-error" />
                <span>I walked the entire mile without running.</span>
              </label>
              <p id="walkedEntireMile-error" class="hidden text-sm text-red-300" data-error="walkedEntireMile"></p>
            </div>

            <fieldset class="mt-6">
              <legend class="text-sm font-semibold text-gray-200">Review how you performed the test</legend>
              <div class="mt-3 space-y-2">
                <label class="flex min-h-12 items-start gap-3 rounded-lg border border-gray-800 bg-gray-900/55 p-3 text-sm text-gray-300"><input class="mt-1 size-4 accent-amber-400" type="checkbox" data-check="measuredRoute" /><span>The route was flat and the distance was measured.</span></label>
                <label class="flex min-h-12 items-start gap-3 rounded-lg border border-gray-800 bg-gray-900/55 p-3 text-sm text-gray-300"><input class="mt-1 size-4 accent-amber-400" type="checkbox" data-check="timing" /><span data-timing-check>The test lasted exactly 12 minutes.</span></label>
                <label class="flex min-h-12 items-start gap-3 rounded-lg border border-gray-800 bg-gray-900/55 p-3 text-sm text-gray-300"><input class="mt-1 size-4 accent-amber-400" type="checkbox" data-check="noSymptoms" /><span>I did not have to stop because of pain, dizziness, or another symptom.</span></label>
              </div>
            </fieldset>

            <div class="mt-6 hidden rounded-lg border border-red-400/40 bg-red-950/25 p-4" tabindex="-1" data-error-summary>
              <p class="font-semibold text-red-200">Review the highlighted fields before calculating.</p>
            </div>

            <div class="mt-6 grid gap-3 sm:grid-cols-3">
              <button class="min-h-12 rounded-lg bg-amber-400 px-5 py-3 text-sm font-bold text-gray-950 transition hover:bg-amber-300 sm:col-span-3" type="submit">Calculate VO2 max</button>
              <button class="min-h-12 rounded-lg border border-gray-700 px-4 py-3 text-sm font-semibold text-gray-200 transition hover:bg-gray-900 sm:col-span-2" type="button" data-example>Probar ejemplo</button>
              <button class="min-h-12 rounded-lg border border-gray-700 px-4 py-3 text-sm font-semibold text-gray-300 transition hover:bg-gray-900" type="reset">Limpiar</button>
            </div>
          </form>

          <aside class="border-t border-gray-800 bg-gray-900/45 p-4 sm:p-6 xl:border-l xl:border-t-0">
            <div data-empty-result>
              <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">Result</p>
              <h2 class="mt-2 text-2xl font-semibold text-white">Your estimate will appear here</h2>
              <p class="mt-3 text-sm leading-relaxed text-gray-400">
                You will see your estimated VO2 max, data quality, average pace, and a comparison if you repeat the same method in this tab.
              </p>
            </div>

            <div class="hidden" aria-live="polite" data-result>
              <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">Your estimated VO2 max</p>
              <h2 class="mt-2 text-4xl font-bold tracking-tight text-white outline-none sm:text-5xl" tabindex="-1" data-result-heading></h2>
              <p class="mt-2 text-sm text-gray-400" data-result-method></p>
              <div class="mt-4 flex flex-wrap gap-2"><span class="rounded-full border px-3 py-1 text-sm font-semibold" data-quality></span></div>
              <p class="mt-3 text-sm leading-relaxed text-gray-400" data-quality-help></p>

              <dl class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-1 2xl:grid-cols-2">
                <div class="rounded-lg border border-gray-700 bg-gray-950/70 p-4"><dt class="text-xs uppercase tracking-wide text-gray-500">Average pace</dt><dd class="mt-1 font-semibold text-white" data-result-pace></dd></div>
                <div class="rounded-lg border border-gray-700 bg-gray-950/70 p-4"><dt class="text-xs uppercase tracking-wide text-gray-500">Comparison</dt><dd class="mt-1 font-semibold text-white" data-comparison>No previous result</dd></div>
              </dl>

              <div class="mt-5 rounded-lg border border-gray-800 bg-gray-950/55 p-4">
                <p class="text-sm font-semibold text-gray-200">Data used</p>
                <ul class="mt-2 space-y-1 text-sm text-gray-400" data-summary></ul>
              </div>
              <div class="mt-4 hidden rounded-lg border border-amber-400/40 bg-amber-950/20 p-4" data-warnings>
                <p class="font-semibold text-amber-200">Review before interpreting</p>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-amber-100/80" data-warning-list></ul>
              </div>
              <p class="mt-4 text-xs leading-relaxed text-gray-500">Illustrative field estimate; it does not replace laboratory testing or professional evaluation.</p>
              <div class="mt-6 grid gap-2 sm:grid-cols-2">
                <button class="min-h-12 rounded-lg border border-amber-400/50 px-4 py-3 text-sm font-semibold text-amber-200 hover:bg-amber-400/10" type="button" data-copy>Copy result</button>
                <button class="hidden min-h-12 rounded-lg border border-gray-700 px-4 py-3 text-sm font-semibold text-gray-300 hover:bg-gray-800" type="button" data-delete-previous>Clear comparison</button>
              </div>
              <p class="sr-only" aria-live="polite" data-copy-status></p>
            </div>
          </aside>
        </div>
      </section>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-8 md:py-12">
      <SectionIntro title="How to interpret the result" description="Use it to follow a trend with the same method, not as a diagnosis or an exact figure." />
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <article class="rounded-lg border border-gray-800 bg-gray-950/60 p-5"><h3 class="font-semibold text-white">Compare like with like</h3><p class="mt-2 text-sm leading-relaxed text-gray-400">Repeat Cooper with Cooper or Rockport with Rockport, ideally under similar weather, surface, and preparation conditions.</p></article>
        <article class="rounded-lg border border-gray-800 bg-gray-950/60 p-5"><h3 class="font-semibold text-white">Quality provides context</h3><p class="mt-2 text-sm leading-relaxed text-gray-400">The checklist helps identify when a figure may be influenced more by the protocol than by your aerobic capacity.</p></article>
        <article class="rounded-lg border border-gray-800 bg-gray-950/60 p-5"><h3 class="font-semibold text-white">Avoid false precision</h3><p class="mt-2 text-sm leading-relaxed text-gray-400">A small difference may be due to measurement, effort, or daily conditions. Look at several tests, not just one.</p></article>
      </div>
    </Container>

    <Container as="section" class="py-8 md:py-12">
      <SectionIntro title="Formulas and limitations" description="Both methods convert a field test into a population-based estimate." />
      <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <article class="rounded-lg border border-gray-800 bg-gray-950/60 p-5"><h3 class="font-semibold text-white">12-minute Cooper test</h3><p class="mt-3 text-sm leading-relaxed text-gray-400">VO2 max = (distance in meters - 504.9) ÷ 44.73. The result depends on completing exactly 12 minutes at a hard effort over a well-measured distance.</p></article>
        <article class="rounded-lg border border-gray-800 bg-gray-950/60 p-5"><h3 class="font-semibold text-white">Rockport walking test</h3><p class="mt-3 text-sm leading-relaxed text-gray-400">It combines age, sex used by the formula, weight, time, and finishing heart rate. A warning appears outside ages 30–69 because the equation may be less representative.</p></article>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<script>
  import {
    QUALITY_LABELS,
    Vo2CalculationError,
    buildVo2CopyText,
    calculateVo2Result,
    distanceFromLaps,
    formatPace,
    formatSignedVo2,
    formatVo2,
    parseVo2Number,
    type CooperInput,
    type DataQuality,
    type DistanceUnit,
    type FormulaSex,
    type RockportInput,
    type Vo2Method,
    type Vo2Result,
    type Vo2Warning,
    type WeightUnit,
  } from "@lib/calculators/salud/calculadora-vo2-max/vo2Max.en";

  const STORAGE_PREFIX = "vo2-max-last:";
  const form = document.querySelector<HTMLFormElement>("[data-calculator-form]")!;
  const query = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
  const input = (name: string) => query<HTMLInputElement>(`[data-input="${name}"]`);
  let method: Vo2Method = "cooper";
  let distanceMode: "total" | "laps" = "total";
  let currentResult: Vo2Result | undefined;
  let currentComparison: number | undefined;

  const errorMessages: Record<string, string> = {
    distance: "Enter a distance equivalent to 600–5,000 m.",
    laps: "Enter laps and additional meters totaling between 600 and 5,000 m.",
    age: "Enter a whole-number age between 18 and 100.",
    formulaSex: "Select the sex used by the formula.",
    weight: "Enter a weight equivalent to 20–250 kg.",
    minutes: "Enter a time from 8:00 to 30:00, with seconds from 0 to 59.",
    finalPulse: "Enter a whole-number finishing heart rate from 60 to 220 bpm.",
    walkedEntireMile: "Confirm that you walked the entire mile without running.",
  };
  const warningMessages: Record<Vo2Warning, string> = {
    unusual_result: "The result is unusual; review the data and how you performed the test.",
    rockport_fast: "This is a very fast walking time. Confirm that you did not run and that the distance was exactly one mile.",
    rockport_age_extrapolated: "The equation may be less representative outside its primary age range of 30–69.",
    protocol_incomplete: "One or more optional protocol items have not been confirmed.",
  };
  const qualityHelp: Record<DataQuality, string> = {
    good: "The reported data and protocol items are consistent.",
    acceptable: "The calculation is valid, but optional protocol details are missing.",
    review: "The calculation is valid, but it includes a condition worth reviewing.",
  };

  function selectMethod(next: Vo2Method) {
    method = next;
    document.querySelectorAll<HTMLButtonElement>("[data-method]").forEach((button) => {
      const selected = button.dataset.method === next;
      button.setAttribute("aria-pressed", String(selected));
      button.classList.toggle("border-amber-400", selected);
      button.classList.toggle("bg-amber-400/10", selected);
      button.classList.toggle("text-amber-200", selected);
      button.classList.toggle("border-gray-700", !selected);
      button.classList.toggle("text-gray-300", !selected);
    });
    document.querySelectorAll<HTMLElement>("[data-fields], [data-protocol]").forEach((element) => element.classList.toggle("hidden", element.dataset.fields !== next && element.dataset.protocol !== next));
    query<HTMLElement>("[data-cooper-safety]").classList.toggle("hidden", next !== "cooper");
    query<HTMLElement>("[data-method-help]").textContent = next === "cooper"
      ? "Cooper is suitable if you can run or sustain a hard effort for 12 minutes."
      : "Rockport is suitable if you prefer a fast one-mile walk and can measure your finishing heart rate.";
    query<HTMLElement>("[data-timing-check]").textContent = next === "cooper"
      ? "The test lasted exactly 12 minutes."
      : "I measured my heart rate immediately after finishing.";
    clearErrors();
    hideResult();
  }

  function selectDistanceMode(next: "total" | "laps") {
    distanceMode = next;
    document.querySelectorAll<HTMLButtonElement>("[data-distance-mode]").forEach((button) => {
      const selected = button.dataset.distanceMode === next;
      button.setAttribute("aria-pressed", String(selected));
      button.classList.toggle("border-amber-400", selected);
      button.classList.toggle("bg-amber-400/10", selected);
      button.classList.toggle("text-amber-200", selected);
      button.classList.toggle("border-gray-700", !selected);
      button.classList.toggle("text-gray-300", !selected);
    });
    document.querySelectorAll<HTMLElement>("[data-distance-fields]").forEach((element) => element.classList.toggle("hidden", element.dataset.distanceFields !== next));
    clearErrors();
    hideResult();
  }

  function readProtocol() {
    return {
      measuredRoute: query<HTMLInputElement>('[data-check="measuredRoute"]').checked,
      exactDurationOrImmediatePulse: query<HTMLInputElement>('[data-check="timing"]').checked,
      noSymptoms: query<HTMLInputElement>('[data-check="noSymptoms"]').checked,
    };
  }

  function requiredNumber(name: string, integer = false): number {
    return parseVo2Number(input(name).value, { integer }) ?? Number.NaN;
  }

  function readInput(): CooperInput | RockportInput {
    if (method === "cooper") {
      let distance = requiredNumber("distance");
      if (distanceMode === "laps") {
        const laps = input("laps").value.trim() ? requiredNumber("laps", true) : 0;
        const extraMeters = input("extraMeters").value.trim() ? requiredNumber("extraMeters", true) : 0;
        if (
          !Number.isInteger(laps) ||
          laps < 0 ||
          laps > 12 ||
          !Number.isInteger(extraMeters) ||
          extraMeters < 0 ||
          extraMeters > 399
        ) {
          throw new RangeError("Review the laps and additional meters.");
        }
        distance = distanceFromLaps(laps, extraMeters);
      }
      return {
        method,
        distance,
        distanceUnit: distanceMode === "total" ? query<HTMLSelectElement>('[data-input="distanceUnit"]').value as DistanceUnit : "m",
        protocol: readProtocol(),
      };
    }
    return {
      method,
      age: requiredNumber("age", true),
      formulaSex: query<HTMLSelectElement>('[data-input="formulaSex"]').value as FormulaSex,
      weight: requiredNumber("weight"),
      weightUnit: query<HTMLSelectElement>('[data-input="weightUnit"]').value as WeightUnit,
      minutes: requiredNumber("minutes", true),
      seconds: requiredNumber("seconds", true),
      finalPulse: requiredNumber("finalPulse", true),
      walkedEntireMile: input("walkedEntireMile").checked,
      protocol: readProtocol(),
    };
  }

  function clearErrors() {
    document.querySelectorAll<HTMLElement>("[data-error]").forEach((element) => {
      element.textContent = "";
      element.classList.add("hidden");
    });
    query<HTMLElement>("[data-error-summary]").classList.add("hidden");
  }

  function showError(field: string) {
    const target =
      field === "seconds"
        ? "minutes"
        : field === "distance" && distanceMode === "laps"
          ? "laps"
          : field;
    const element = document.querySelector<HTMLElement>(`[data-error="${target}"]`);
    if (!element) return;
    element.textContent = errorMessages[target] ?? "Review this field.";
    element.classList.remove("hidden");
  }

  function calculate(focusResult = true) {
    clearErrors();
    let result: Vo2Result;
    try {
      result = calculateVo2Result(readInput());
    } catch (error) {
      if (error instanceof Vo2CalculationError) {
        Object.keys(error.validation.errors).forEach(showError);
      } else if (method === "cooper" && distanceMode === "laps") {
        showError("laps");
      } else {
        showError(method === "cooper" ? "distance" : "minutes");
      }
      const summary = query<HTMLElement>("[data-error-summary]");
      summary.classList.remove("hidden");
      summary.focus();
      return;
    }

    const previous = readPrevious(result.method);
    currentComparison = previous ? result.vo2Max - previous.vo2Max : undefined;
    currentResult = result;
    storeResult(result);
    renderResult(result, focusResult);
  }

  function renderResult(result: Vo2Result, focusResult: boolean) {
    query<HTMLElement>("[data-empty-result]").classList.add("hidden");
    query<HTMLElement>("[data-result]").classList.remove("hidden");
    query<HTMLElement>("[data-result-heading]").textContent = formatVo2(result.vo2Max);
    query<HTMLElement>("[data-result-method]").textContent = `Method: ${result.method === "cooper" ? "12-minute Cooper" : "Rockport walk"}`;
    query<HTMLElement>("[data-result-pace]").textContent = formatPace(result.paceMinutesPerKm);
    query<HTMLElement>("[data-comparison]").textContent = currentComparison === undefined ? "No previous result" : formatSignedVo2(currentComparison);
    query<HTMLButtonElement>("[data-delete-previous]").classList.toggle("hidden", currentComparison === undefined);
    const quality = query<HTMLElement>("[data-quality]");
    quality.textContent = `Quality: ${QUALITY_LABELS[result.quality]}`;
    quality.className = `rounded-full border px-3 py-1 text-sm font-semibold ${result.quality === "good" ? "border-emerald-400/50 text-emerald-300" : result.quality === "acceptable" ? "border-amber-400/50 text-amber-300" : "border-red-400/50 text-red-300"}`;
    query<HTMLElement>("[data-quality-help]").textContent = qualityHelp[result.quality];
    query<HTMLElement>("[data-summary]").innerHTML = result.summary.map((line) => `<li>${line}</li>`).join("");
    const warnings = query<HTMLElement>("[data-warnings]");
    warnings.classList.toggle("hidden", result.warnings.length === 0);
    query<HTMLElement>("[data-warning-list]").innerHTML = result.warnings.map((warning) => `<li>${warningMessages[warning]}</li>`).join("");
    if (focusResult) {
      const heading = query<HTMLElement>("[data-result-heading]");
      heading.focus({ preventScroll: true });
      heading.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
    }
  }

  function hideResult() {
    currentResult = undefined;
    currentComparison = undefined;
    query<HTMLElement>("[data-result]").classList.add("hidden");
    query<HTMLElement>("[data-empty-result]").classList.remove("hidden");
    query<HTMLButtonElement>("[data-delete-previous]").classList.add("hidden");
  }

  function storageKey(targetMethod: Vo2Method) {
    return `${STORAGE_PREFIX}${targetMethod}`;
  }

  function readPrevious(targetMethod: Vo2Method): { vo2Max: number } | undefined {
    try {
      const stored = sessionStorage.getItem(storageKey(targetMethod));
      return stored ? JSON.parse(stored) : undefined;
    } catch {
      return undefined;
    }
  }

  function storeResult(result: Vo2Result) {
    try {
      sessionStorage.setItem(storageKey(result.method), JSON.stringify({ vo2Max: result.vo2Max, savedAt: new Date().toISOString() }));
    } catch {}
  }

  function clearCalculator() {
    form.querySelectorAll<HTMLInputElement>("input").forEach((element) => {
      if (element.type === "checkbox") element.checked = false;
      else element.value = "";
    });
    form.querySelectorAll<HTMLSelectElement>("select").forEach((element) => element.selectedIndex = 0);
    selectDistanceMode("total");
    clearErrors();
    hideResult();
    if (method === "cooper") input("distance").focus();
    else input("age").focus();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-method]").forEach((button) => button.addEventListener("click", () => selectMethod(button.dataset.method as Vo2Method)));
  document.querySelectorAll<HTMLButtonElement>("[data-distance-mode]").forEach((button) => button.addEventListener("click", () => selectDistanceMode(button.dataset.distanceMode as "total" | "laps")));
  form.addEventListener("submit", (event) => { event.preventDefault(); calculate(); });
  form.addEventListener("reset", (event) => { event.preventDefault(); clearCalculator(); });
  query<HTMLButtonElement>("[data-example]").addEventListener("click", () => {
    clearCalculator();
    if (method === "cooper") {
      input("distance").value = "2400";
      query<HTMLSelectElement>('[data-input="distanceUnit"]').value = "m";
    } else {
      input("age").value = "30";
      query<HTMLSelectElement>('[data-input="formulaSex"]').value = "male";
      input("weight").value = "70";
      input("minutes").value = "15";
      input("seconds").value = "0";
      input("finalPulse").value = "140";
      input("walkedEntireMile").checked = true;
    }
    form.querySelectorAll<HTMLInputElement>("[data-check]").forEach((check) => check.checked = true);
    calculate();
  });
  query<HTMLButtonElement>("[data-copy]").addEventListener("click", async () => {
    if (!currentResult) return;
    const status = query<HTMLElement>("[data-copy-status]");
    try {
      await navigator.clipboard.writeText(buildVo2CopyText(currentResult, currentComparison));
      status.textContent = "Result copied.";
    } catch {
      status.textContent = "Could not copy the result.";
    }
  });
  query<HTMLButtonElement>("[data-delete-previous]").addEventListener("click", () => {
    sessionStorage.removeItem(storageKey(method));
    currentComparison = undefined;
    query<HTMLElement>("[data-comparison]").textContent = "No previous result";
    query<HTMLButtonElement>("[data-delete-previous]").classList.add("hidden");
  });
</script>
