---
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { POPULAR_DISTANCES } from "@lib/calculators/salud/calculadora-de-pace-ritmo-de-carrera/runningPace.en";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Running Pace Calculator";
const description =
  "Calculate pace per kilometer or mile, time, speed, and splits for a 5K, 10K, half marathon, or marathon.";
const canonical = "/en/health/running-pace-calculator";
const spanishCanonical = "/salud/calculadora-de-pace-ritmo-de-carrera";
const alternates = buildAlternateLinks({ es: spanishCanonical, en: canonical }, Astro.site ?? Astro.url);

const faqs = [
  {
    question: "What does pace mean in running?",
    answer:
      "Pace indicates how long you need to cover one unit of distance, usually expressed in minutes per kilometer or minutes per mile.",
  },
  {
    question: "How do I convert min/km to km/h?",
    answer:
      "Divide 60 by the minutes per kilometer expressed as a decimal number. For example, 5:00 min/km equals 12 km/h.",
  },
  {
    question: "What pace do I need to run a 10K in 50 minutes?",
    answer:
      "You need to maintain an average pace of 5:00 min/km. The calculator also shows cumulative splits so you can check your progress.",
  },
  {
    question: "How do I calculate splits for a race?",
    answer:
      "Enter the distance and target time. The tool calculates the cumulative time you should reach at every kilometer, every 5 kilometers, or every mile.",
  },
  {
    question: "Do the equivalents predict my time at another distance?",
    answer:
      "No. They only show how long you would take at exactly the same pace. Fatigue, training, weather, and terrain can change your actual performance.",
  },
  {
    question: "Does the calculator work with miles?",
    answer:
      "Yes. You can enter distance in miles, use pace in min/mi, and view mile splits.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical} locale="en" alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Running pace calculator"
      description="Analyze a run, calculate the pace needed for a goal, and get a cumulative split plan."
      kicker="Health"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Health", href: "/en/health", optional: true },
        { label: "Pace calculator", truncate: true },
      ]}
    />

    <Container as="section" class="py-4 md:py-8">
      <section
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="pace-calculator-heading"
      >
        <div class="grid xl:grid-cols-[minmax(0,0.92fr)_minmax(25rem,1.08fr)]">
          <form class="p-4 sm:p-6" data-calculator-form novalidate>
            <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">
              Your calculation
            </p>
            <h2 id="pace-calculator-heading" class="mt-2 text-2xl font-semibold text-white">
              What do you want to calculate?
            </h2>

            <div
              class="mt-5 grid grid-cols-3 gap-1 rounded-lg border border-gray-700 bg-gray-900 p-1"
              role="group"
              aria-label="Calculation mode"
            >
              <button class="min-h-12 rounded-md bg-amber-400 px-2 py-2 text-xs font-bold text-gray-950 sm:text-sm" type="button" aria-pressed="true" data-mode="analyze">Analyze run</button>
              <button class="min-h-12 rounded-md px-2 py-2 text-xs font-semibold text-gray-300 sm:text-sm" type="button" aria-pressed="false" data-mode="plan">Plan a target</button>
              <button class="min-h-12 rounded-md px-2 py-2 text-xs font-semibold text-gray-300 sm:text-sm" type="button" aria-pressed="false" data-mode="distance">Calculate distance</button>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-gray-400" data-mode-help>
              Enter how far you ran and how long it took.
            </p>

            <section class="mt-6" data-distance-section>
              <div class="flex items-end justify-between gap-3">
                <label for="pace-distance" class="text-sm font-semibold text-gray-200">Distance</label>
                <span class="text-xs text-gray-500">Atajos</span>
              </div>
              <div class="mt-2 flex flex-wrap gap-2">
                {POPULAR_DISTANCES.map((distance) => (
                  <button
                    class="min-h-11 rounded-full border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-300 transition hover:border-amber-400/60 hover:text-amber-200"
                    type="button"
                    data-preset={distance.distanceKm}
                  >
                    {distance.label}
                  </button>
                ))}
              </div>
              <div class="mt-3 grid grid-cols-[minmax(0,1fr)_7rem] gap-2">
                <div class="rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400 focus-within:ring-3 focus-within:ring-amber-400/15" data-wrapper="distance">
                  <input id="pace-distance" class="min-h-12 w-full bg-transparent px-4 text-base text-white outline-none" type="text" inputmode="decimal" autocomplete="off" placeholder="10" aria-describedby="pace-distance-error" data-input="distance" />
                </div>
                <select class="min-h-12 rounded-lg border border-gray-700 bg-gray-900 px-3 text-base text-white outline-none focus:border-amber-400" aria-label="Distance unit" data-input="distance-unit">
                  <option value="km">km</option>
                  <option value="mi">millas</option>
                </select>
              </div>
              <p id="pace-distance-error" class="mt-2 hidden text-sm font-medium text-red-300" data-error="distance"></p>
            </section>

            <section class="mt-5">
              <label class="text-sm font-semibold text-gray-200" data-time-label>Total time</label>
              <div class="mt-2 grid grid-cols-3 gap-2">
                <label class="rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400" data-wrapper="time">
                  <span class="sr-only">Horas</span>
                  <input class="min-h-12 w-full bg-transparent px-3 text-center text-base text-white outline-none" type="text" inputmode="numeric" placeholder="0" aria-label="Horas" data-time-part="hours" />
                  <span class="block pb-2 text-center text-xs text-gray-500">horas</span>
                </label>
                <label class="rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400" data-wrapper="time">
                  <span class="sr-only">Minutes</span>
                  <input class="min-h-12 w-full bg-transparent px-3 text-center text-base text-white outline-none" type="text" inputmode="numeric" placeholder="50" aria-label="Minutes" data-time-part="minutes" />
                  <span class="block pb-2 text-center text-xs text-gray-500">min</span>
                </label>
                <label class="rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400" data-wrapper="time">
                  <span class="sr-only">Seconds</span>
                  <input class="min-h-12 w-full bg-transparent px-3 text-center text-base text-white outline-none" type="text" inputmode="numeric" placeholder="00" aria-label="Seconds" data-time-part="seconds" />
                  <span class="block pb-2 text-center text-xs text-gray-500">sec</span>
                </label>
              </div>
              <p class="mt-2 hidden text-sm font-medium text-red-300" data-error="time"></p>
            </section>

            <section class="mt-5 hidden" data-pace-section>
              <label class="text-sm font-semibold text-gray-200">Pace</label>
              <div class="mt-2 grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_7rem] gap-2">
                <label class="rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400" data-wrapper="pace">
                  <span class="sr-only">Pace minutes</span>
                  <input class="min-h-12 w-full bg-transparent px-3 text-center text-base text-white outline-none" type="text" inputmode="numeric" placeholder="5" aria-label="Pace minutes" data-pace-part="minutes" />
                  <span class="block pb-2 text-center text-xs text-gray-500">min</span>
                </label>
                <label class="rounded-lg border border-gray-700 bg-gray-900 focus-within:border-amber-400" data-wrapper="pace">
                  <span class="sr-only">Pace seconds</span>
                  <input class="min-h-12 w-full bg-transparent px-3 text-center text-base text-white outline-none" type="text" inputmode="numeric" placeholder="00" aria-label="Pace seconds" data-pace-part="seconds" />
                  <span class="block pb-2 text-center text-xs text-gray-500">seg</span>
                </label>
                <select class="min-h-12 rounded-lg border border-gray-700 bg-gray-900 px-2 text-sm text-white outline-none focus:border-amber-400" aria-label="Pace unit" data-input="pace-unit">
                  <option value="min/km">min/km</option>
                  <option value="min/mi">min/mi</option>
                </select>
              </div>
              <p class="mt-2 hidden text-sm font-medium text-red-300" data-error="pace"></p>
            </section>

            <div class="mt-5">
              <label for="pace-split-interval" class="block text-sm font-semibold text-gray-200">
                Show splits every
              </label>
              <select id="pace-split-interval" class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none focus:border-amber-400" data-input="split-interval">
                <option value="1km">1 km</option>
                <option value="5km">5 km</option>
                <option value="1mi">1 milla</option>
              </select>
            </div>

            <p class="mt-4 hidden rounded-lg border border-red-400/30 bg-red-400/10 p-3 text-sm font-medium text-red-200" role="alert" data-general-error></p>

            <div class="mt-6 grid gap-3 sm:grid-cols-3">
              <button class="min-h-12 rounded-lg bg-amber-400 px-5 py-3 text-sm font-bold text-gray-950 transition hover:bg-amber-300 sm:col-span-3" type="submit" data-submit>
                Calculate my pace
              </button>
              <button class="min-h-12 rounded-lg border border-gray-700 px-4 py-3 text-sm font-semibold text-gray-200 transition hover:bg-gray-900 sm:col-span-2" type="button" data-example>
                Probar ejemplo 10K
              </button>
              <button class="min-h-12 rounded-lg border border-gray-700 px-4 py-3 text-sm font-semibold text-gray-300 transition hover:bg-gray-900" type="reset">
                Limpiar
              </button>
            </div>
          </form>

          <aside class="border-t border-gray-800 bg-gray-900/45 p-4 sm:p-6 xl:border-l xl:border-t-0">
            <div data-empty-result>
              <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">Result</p>
              <h2 class="mt-2 text-2xl font-semibold text-white">Your pace and splits will appear here</h2>
              <p class="mt-3 text-sm leading-relaxed text-gray-400">
                You will see pace per kilometer and mile, speed, equivalents,
                and cumulative time for each segment.
              </p>
            </div>

            <div class="hidden" aria-live="polite" data-result>
              <p class="text-sm font-semibold uppercase tracking-wide text-amber-400" data-result-kicker></p>
              <h2 class="mt-2 text-5xl font-bold tracking-tight text-white outline-none" tabindex="-1" data-result-heading></h2>
              <p class="mt-2 text-sm leading-relaxed text-gray-400" data-result-summary></p>

              <div class="mt-5 grid gap-3 sm:grid-cols-2">
                <div class="rounded-lg border border-gray-700 bg-gray-950/70 p-4">
                  <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Equivalent pace</p>
                  <p class="mt-2 text-xl font-semibold text-white" data-other-pace></p>
                </div>
                <div class="rounded-lg border border-gray-700 bg-gray-950/70 p-4">
                  <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Velocidad</p>
                  <p class="mt-2 text-xl font-semibold text-white" data-speed></p>
                  <p class="mt-1 text-xs text-gray-500" data-other-speed></p>
                </div>
              </div>

              <p class="mt-4 hidden rounded-lg border border-amber-400/25 bg-amber-400/10 p-3 text-sm leading-relaxed text-amber-100/85" data-warning></p>

              <section class="mt-6 border-t border-gray-800 pt-6" aria-labelledby="equivalences-heading">
                <h3 id="equivalences-heading" class="text-lg font-semibold text-white">
                  If you maintained this pace
                </h3>
                <div class="mt-3 divide-y divide-gray-800 overflow-hidden rounded-lg border border-gray-700" data-equivalences>
                  {POPULAR_DISTANCES.map((distance) => (
                    <div class="flex min-h-12 items-center justify-between gap-3 bg-gray-950/60 px-4 py-3" data-equivalent={distance.id}>
                      <span class="text-sm text-gray-300">{distance.label}</span>
                      <strong class="text-sm text-white" data-equivalent-time></strong>
                    </div>
                  ))}
                </div>
                <p class="mt-3 text-xs leading-relaxed text-gray-500">
                  These are constant-pace mathematical equivalents, not
                  performance predictions.
                </p>
              </section>

              <section class="mt-6 border-t border-gray-800 pt-6" aria-labelledby="splits-heading">
                <div class="flex items-center justify-between gap-3">
                  <h3 id="splits-heading" class="text-lg font-semibold text-white">Split plan</h3>
                  <span class="text-xs text-gray-500" data-splits-label></span>
                </div>
                <div class="mt-3 divide-y divide-gray-800 overflow-hidden rounded-lg border border-gray-700" data-splits></div>
                <button class="mt-3 hidden min-h-11 w-full rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-300 transition hover:bg-gray-800" type="button" data-toggle-splits>
                  Ver todos
                </button>
              </section>

              <div class="mt-6 grid gap-2 sm:grid-cols-2">
                <button class="min-h-12 rounded-lg border border-amber-400/50 px-4 py-3 text-sm font-semibold text-amber-200 transition hover:bg-amber-400/10" type="button" data-copy>
                  Copy result
                </button>
                <button class="min-h-12 rounded-lg border border-gray-700 px-4 py-3 text-sm font-semibold text-gray-300 transition hover:bg-gray-800" type="button" data-result-clear>
                  New calculation
                </button>
              </div>
              <p class="sr-only" aria-live="polite" data-copy-status></p>
            </div>
          </aside>
        </div>
      </section>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-8 md:py-12">
      <SectionIntro
        title="How to use your result"
        description="Average pace helps analyze a session or plan a goal, but it does not describe the entire effort on its own."
      />
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <article class="rounded-lg border border-gray-800 bg-gray-950/60 p-5">
          <h3 class="font-semibold text-white">Pace and speed</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">Pace expresses time per distance. Speed expresses distance per hour. They are two ways of describing the same average.</p>
        </article>
        <article class="rounded-lg border border-gray-800 bg-gray-950/60 p-5">
          <h3 class="font-semibold text-white">Splits acumulados</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">Check your watch at each point to see whether you are ahead of or behind your goal.</p>
        </article>
        <article class="rounded-lg border border-gray-800 bg-gray-950/60 p-5">
          <h3 class="font-semibold text-white">Constant pace is not a prediction</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">The equivalents do not adjust for fatigue, elevation, weather, stops, or preparation for another distance.</p>
        </article>
      </div>
    </Container>

    <Container as="section" class="py-8 md:py-12">
      <SectionIntro
        title="Formula used"
        description="The calculator relates distance, time, and pace through direct conversion while retaining internal precision."
      />
      <div class="mt-6 rounded-lg border border-gray-800 bg-gray-950/60 p-5">
        <p class="text-sm leading-relaxed text-gray-400">
          <strong class="text-gray-200">Pace = time ÷ distance.</strong>
          Speed is calculated by dividing distance by time in hours. Miles are
          converted using exactly <code>1 mi = 1.609344 km</code>, and values
          are rounded only for display.
        </p>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<script>
  import {
    buildRunningPaceCopyText,
    calculateRunningPace,
    combinePaceParts,
    combineTimeParts,
    convertDistance,
    convertPace,
    formatDistance,
    formatDuration,
    formatPace,
    formatSpeed,
    parseLocalizedNumber,
    type DistanceUnit,
    type PaceUnit,
    type RunningPaceMode,
    type RunningPaceResult,
    type SplitInterval,
  } from "@lib/calculators/salud/calculadora-de-pace-ritmo-de-carrera/runningPace.en";

  const form = document.querySelector<HTMLFormElement>("[data-calculator-form]");

  if (form) {
    const query = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
    const distanceInput = form.querySelector<HTMLInputElement>('[data-input="distance"]')!;
    const distanceUnitInput = form.querySelector<HTMLSelectElement>('[data-input="distance-unit"]')!;
    const paceUnitInput = form.querySelector<HTMLSelectElement>('[data-input="pace-unit"]')!;
    const splitIntervalInput = form.querySelector<HTMLSelectElement>('[data-input="split-interval"]')!;
    const timeHours = form.querySelector<HTMLInputElement>('[data-time-part="hours"]')!;
    const timeMinutes = form.querySelector<HTMLInputElement>('[data-time-part="minutes"]')!;
    const timeSeconds = form.querySelector<HTMLInputElement>('[data-time-part="seconds"]')!;
    const paceMinutes = form.querySelector<HTMLInputElement>('[data-pace-part="minutes"]')!;
    const paceSeconds = form.querySelector<HTMLInputElement>('[data-pace-part="seconds"]')!;
    const resultPanel = query<HTMLElement>("[data-result]");
    const emptyResult = query<HTMLElement>("[data-empty-result]");
    let mode: RunningPaceMode = "analyze";
    let currentResult: RunningPaceResult | undefined;
    let showAllSplits = false;

    const modeContent = {
      analyze: {
        help: "Enter how far you ran and how long it took.",
        submit: "Calculate my pace",
        time: "Total time",
      },
      plan: {
        help: "Enter the distance and the time in which you want to finish.",
        submit: "Calculate target pace",
        time: "Target time",
      },
      distance: {
        help: "Enter how long you will maintain a given pace.",
        submit: "Calculate distance",
        time: "Available time",
      },
    };

    function numberPart(input: HTMLInputElement) {
      if (!input.value.trim()) return 0;
      return /^\d+$/.test(input.value.trim()) ? Number(input.value) : Number.NaN;
    }

    function clearErrors() {
      document.querySelectorAll<HTMLElement>("[data-error]").forEach((element) => {
        element.textContent = "";
        element.classList.add("hidden");
      });
      document.querySelectorAll<HTMLElement>("[data-wrapper]").forEach((element) => {
        element.classList.remove("border-red-400");
      });
      query<HTMLElement>("[data-general-error]").classList.add("hidden");
    }

    function showError(field: "distance" | "time" | "pace", message: string) {
      const error = query<HTMLElement>(`[data-error="${field}"]`);
      error.textContent = message;
      error.classList.remove("hidden");
      document.querySelectorAll<HTMLElement>(`[data-wrapper="${field}"]`).forEach((wrapper) => {
        wrapper.classList.add("border-red-400");
      });
    }

    function calculate(focusResult = true) {
      clearErrors();
      const time = combineTimeParts(
        numberPart(timeHours),
        numberPart(timeMinutes),
        numberPart(timeSeconds),
      );
      const pace = combinePaceParts(numberPart(paceMinutes), numberPart(paceSeconds));
      const distance = parseLocalizedNumber(distanceInput.value);
      let valid = true;

      if (mode !== "distance" && (distance === undefined || distance <= 0)) {
        showError("distance", "Enter a valid distance greater than zero.");
        valid = false;
      }
      if (time === undefined || time <= 0) {
        showError("time", "Enter a valid time; minutes and seconds must be between 0 and 59.");
        valid = false;
      }
      if (mode === "distance" && (pace === undefined || pace <= 0)) {
        showError("pace", "Enter a valid pace; seconds must be between 0 and 59.");
        valid = false;
      }

      if (!valid) {
        resultPanel.classList.add("hidden");
        emptyResult.classList.remove("hidden");
        return;
      }

      try {
        currentResult = calculateRunningPace({
          mode,
          distance,
          distanceUnit: distanceUnitInput.value as DistanceUnit,
          timeSeconds: time!,
          paceSeconds: pace,
          paceUnit: paceUnitInput.value as PaceUnit,
          splitInterval: splitIntervalInput.value as SplitInterval,
        });
        showAllSplits = false;
        renderResult(currentResult, focusResult);
      } catch {
        query<HTMLElement>("[data-general-error]").textContent =
          "The calculation is outside the allowed limits. Review the distance, time, and units.";
        query<HTMLElement>("[data-general-error]").classList.remove("hidden");
        resultPanel.classList.add("hidden");
        emptyResult.classList.remove("hidden");
      }
    }

    function renderResult(result: RunningPaceResult, focusResult: boolean) {
      emptyResult.classList.add("hidden");
      resultPanel.classList.remove("hidden");
      const distanceUnit = distanceUnitInput.value as DistanceUnit;
      const primaryIsDistance = mode === "distance";
      const primaryPaceUnit: PaceUnit =
        mode === "distance"
          ? result.input.paceUnit
          : distanceUnit === "mi"
            ? "min/mi"
            : "min/km";
      const primaryPace =
        primaryPaceUnit === "min/km"
          ? result.paceSecondsPerKm
          : result.paceSecondsPerMi;
      const otherPace =
        primaryPaceUnit === "min/km"
          ? `${formatPace(result.paceSecondsPerMi)} min/mi`
          : `${formatPace(result.paceSecondsPerKm)} min/km`;
      query<HTMLElement>("[data-result-kicker]").textContent =
        mode === "analyze" ? "Your pace was" : mode === "plan" ? "Required pace" : "Estimated distance";
      query<HTMLElement>("[data-result-heading]").textContent = primaryIsDistance
        ? formatDistance(result.distanceKm, distanceUnit, 2)
        : `${formatPace(primaryPace)} ${primaryPaceUnit}`;
      query<HTMLElement>("[data-result-summary]").textContent =
        `${formatDistance(result.distanceKm, distanceUnit)} en ${formatDuration(result.timeSeconds)}.`;
      query<HTMLElement>("[data-other-pace]").textContent =
        primaryIsDistance
          ? `${formatPace(result.paceSecondsPerKm)} min/km · ${formatPace(result.paceSecondsPerMi)} min/mi`
          : otherPace;
      query<HTMLElement>("[data-speed]").textContent = formatSpeed(result.speedKmh, "km/h");
      query<HTMLElement>("[data-other-speed]").textContent = formatSpeed(result.speedMph, "mph");

      const warning = query<HTMLElement>("[data-warning]");
      warning.classList.toggle("hidden", result.warnings.length === 0);
      warning.textContent = result.warnings.length
        ? "The distance is unusually long. Check that the selected unit is correct."
        : "";

      result.equivalents.forEach((equivalent) => {
        query<HTMLElement>(`[data-equivalent="${equivalent.id}"] [data-equivalent-time]`).textContent =
          formatDuration(equivalent.timeSeconds);
      });
      renderSplits(result);

      if (focusResult) {
        const heading = query<HTMLElement>("[data-result-heading]");
        heading.focus({ preventScroll: true });
        heading.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
          block: "start",
        });
      }
    }

    function renderSplits(result: RunningPaceResult) {
      const list = query<HTMLElement>("[data-splits]");
      const visible = showAllSplits ? result.splits : result.splits.slice(0, 5);
      list.innerHTML = "";
      visible.forEach((split) => {
        const row = document.createElement("div");
        row.className = "flex min-h-12 items-center justify-between gap-3 bg-gray-950/60 px-4 py-3";
        const distance = document.createElement("span");
        distance.className = "text-sm text-gray-300";
        const splitUnit = result.input.splitInterval === "1mi" ? "mi" : "km";
        distance.textContent = `${formatDistance(split.distanceKm, splitUnit)}${split.isPartial ? " · final" : ""}`;
        const time = document.createElement("strong");
        time.className = "text-sm text-white";
        time.textContent = formatDuration(split.timeSeconds);
        row.append(distance, time);
        list.append(row);
      });
      query<HTMLElement>("[data-splits-label]").textContent =
        `${result.splits.length} ${result.splits.length === 1 ? "paso" : "pasos"}`;
      const toggle = query<HTMLButtonElement>("[data-toggle-splits]");
      toggle.classList.toggle("hidden", result.splits.length <= 5);
      toggle.textContent = showAllSplits ? "Show fewer" : `Show all (${result.splits.length})`;
    }

    function setMode(nextMode: RunningPaceMode) {
      mode = nextMode;
      form.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((button) => {
        const selected = button.dataset.mode === mode;
        button.setAttribute("aria-pressed", String(selected));
        button.classList.toggle("bg-amber-400", selected);
        button.classList.toggle("text-gray-950", selected);
        button.classList.toggle("font-bold", selected);
        button.classList.toggle("text-gray-300", !selected);
      });
      query<HTMLElement>("[data-distance-section]").classList.toggle("hidden", mode === "distance");
      query<HTMLElement>("[data-pace-section]").classList.toggle("hidden", mode !== "distance");
      query<HTMLElement>("[data-mode-help]").textContent = modeContent[mode].help;
      query<HTMLElement>("[data-time-label]").textContent = modeContent[mode].time;
      query<HTMLElement>("[data-submit]").textContent = modeContent[mode].submit;
      clearErrors();
      if (currentResult) calculate(false);
    }

    function clearCalculator() {
      currentResult = undefined;
      showAllSplits = false;
      distanceInput.value = "";
      distanceUnitInput.value = "km";
      paceUnitInput.value = "min/km";
      splitIntervalInput.value = "1km";
      [timeHours, timeMinutes, timeSeconds, paceMinutes, paceSeconds].forEach((input) => input.value = "");
      clearErrors();
      setMode("analyze");
      resultPanel.classList.add("hidden");
      emptyResult.classList.remove("hidden");
      distanceInput.focus();
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      calculate();
    });
    form.addEventListener("reset", (event) => {
      event.preventDefault();
      clearCalculator();
    });
    form.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((button) => {
      button.addEventListener("click", () => setMode(button.dataset.mode as RunningPaceMode));
    });
    form.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((button) => {
      button.addEventListener("click", () => {
        distanceInput.value = button.dataset.preset!;
        distanceUnitInput.value = "km";
      });
    });
    form.querySelector<HTMLButtonElement>("[data-example]")!.addEventListener("click", () => {
      setMode("analyze");
      distanceInput.value = "10";
      distanceUnitInput.value = "km";
      timeHours.value = "0";
      timeMinutes.value = "50";
      timeSeconds.value = "0";
      splitIntervalInput.value = "1km";
      calculate();
    });
    distanceUnitInput.addEventListener("change", () => {
      const value = parseLocalizedNumber(distanceInput.value);
      if (value !== undefined) {
        const previous = distanceUnitInput.value === "km" ? "mi" : "km";
        distanceInput.value = Number(
          convertDistance(value, previous, distanceUnitInput.value as DistanceUnit).toFixed(5),
        ).toString();
      }
      if (currentResult) calculate(false);
    });
    paceUnitInput.addEventListener("change", () => {
      const pace = combinePaceParts(numberPart(paceMinutes), numberPart(paceSeconds));
      if (pace !== undefined && pace > 0) {
        const previous = paceUnitInput.value === "min/km" ? "min/mi" : "min/km";
        const converted = Math.round(convertPace(pace, previous, paceUnitInput.value as PaceUnit));
        paceMinutes.value = Math.floor(converted / 60).toString();
        paceSeconds.value = (converted % 60).toString();
      }
      if (currentResult) calculate(false);
    });
    splitIntervalInput.addEventListener("change", () => currentResult && calculate(false));
    query<HTMLButtonElement>("[data-toggle-splits]").addEventListener("click", () => {
      if (!currentResult) return;
      showAllSplits = !showAllSplits;
      renderSplits(currentResult);
    });
    query<HTMLButtonElement>("[data-result-clear]").addEventListener("click", clearCalculator);
    query<HTMLButtonElement>("[data-copy]").addEventListener("click", async () => {
      if (!currentResult) return;
      const status = query<HTMLElement>("[data-copy-status]");
      try {
        await navigator.clipboard.writeText(buildRunningPaceCopyText(currentResult));
        status.textContent = "Result copied.";
      } catch {
        status.textContent = "Could not copy the result.";
      }
    });
  }
</script>
