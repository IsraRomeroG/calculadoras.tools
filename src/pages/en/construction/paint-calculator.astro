---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Paint calculator";
const description =
  "Calculate wall or ceiling area and estimate the paint needed from coats, coverage and margin.";
const canonical = "/en/construction/paint-calculator";
const spanishCanonical = "/construccion/metros-cuadrados-de-pintura";
const alternates = buildAlternateLinks({ es: spanishCanonical, en: canonical }, Astro.site ?? Astro.url);

const faqs = [
  {
    question: "How do you calculate the square meters of a wall?",
    answer:
      "Multiply width by height. For several walls, add each area or multiply the perimeter of a rectangular room by its height.",
  },
  {
    question: "How do you calculate paint for a room?",
    answer:
      "Calculate net area, multiply by the number of coats and divide by the paint coverage, then add a margin.",
  },
  {
    question: "Should you subtract doors and windows?",
    answer:
      "Yes for walls. The calculator subtracts doors and windows from walls, not the ceiling.",
  },
  {
    question: "How much paint do you need per square meter?",
    answer:
      "It depends on manufacturer coverage. A common starting value is 10 m²/L, but check the product label.",
  },
  {
    question: "Why must you enter paint coverage?",
    answer:
      "Porque cambia por tipo de pintura, superficie, color previo y forma de aplicacion. Usar el rendimiento de la etiqueta mejora la estimacion.",
  },
  {
    question: "How do you account for two coats?",
    answer:
      "Multiplica la superficie neta por 2 antes de dividir entre el rendimiento. La calculadora lo hace automaticamente desde el campo de manos.",
  },
  {
    question: "How much extra paint should you buy?",
    answer:
      "El margen es una decision editable. Puede servir si la pared esta porosa, hay manchas o el color anterior es muy oscuro, pero no es una regla universal.",
  },
  {
    question: "How do you calculate doors and windows measured in centimeters?",
    answer:
      "Puedes capturar ancho y alto en cm dentro del detalle de aberturas. La calculadora convierte a metros antes de sumar el area.",
  },
  {
    question: "How do you choose container size?",
    answer:
      "Usa el tamano real disponible para la pintura que vas a comprar. La calculadora redondea hacia arriba y muestra el sobrante estimado.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical} locale="en" alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title={title}
      description="Calculate wall or ceiling area and estimate the paint needed from coats, coverage and margin."
      kicker="Construction"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Construction", href: "/en/construction", optional: true },
        { label: "Paint calculator", truncate: true },
      ]}
    />

    <Container as="section" class="py-4 pb-24 md:py-7 md:pb-7">
      <section
        id="paint-calculator"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <div class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_minmax(21rem,0.82fr)]">
          <div class="p-4 sm:p-6">
            <h2 id="calculator-heading" class="sr-only">
              Paint area calculator
            </h2>

            <div
              class="grid rounded-lg border border-gray-700 bg-gray-900 p-1 sm:grid-cols-2"
              role="tablist"
              aria-label="Calculation mode"
            >
              <button
                class="min-h-12 rounded-md px-3 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/35"
                type="button"
                role="tab"
                aria-selected="true"
                data-mode-button="habitacion"
              >
                Room
              </button>
              <button
                class="min-h-12 rounded-md px-3 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/35"
                type="button"
                role="tab"
                aria-selected="false"
                data-mode-button="manual"
              >
                Manual area
              </button>
            </div>

            <div class="mt-5 grid gap-6">
              <section data-room-panel>
                <span class="block text-sm font-semibold text-gray-200">
                  Que quieres pintar?
                </span>
                <div class="mt-2 grid grid-cols-3 gap-2" aria-label="Surface to paint">
                  <button
                    class="min-h-11 rounded-lg border border-gray-700 px-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30"
                    type="button"
                    data-surface-button="paredes"
                    aria-pressed="true"
                  >
                    Walls
                  </button>
                  <button
                    class="min-h-11 rounded-lg border border-gray-700 px-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30"
                    type="button"
                    data-surface-button="techo"
                    aria-pressed="false"
                  >
                    Ceiling
                  </button>
                  <button
                    class="min-h-11 rounded-lg border border-gray-700 px-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30"
                    type="button"
                    data-surface-button="ambos"
                    aria-pressed="false"
                  >
                    Ambos
                  </button>
                </div>

                <div class="mt-5 grid gap-4 sm:grid-cols-3">
                  <div>
                    <label for="room-length" class="block text-sm font-semibold text-gray-200">
                      Length
                    </label>
                    <div class="mt-2 grid grid-cols-[minmax(0,1fr)_3.75rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-400 focus-within:ring-3 focus-within:ring-emerald-400/15">
                      <input
                        id="room-length"
                        class="min-h-14 w-full bg-transparent px-4 text-2xl font-semibold text-white outline-none placeholder:text-gray-600"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="5"
                        aria-describedby="room-length-error"
                        data-input="length"
                      />
                      <span class="grid place-items-center border-l border-gray-700 bg-gray-950 text-sm font-semibold text-gray-300">
                        m
                      </span>
                    </div>
                    <p id="room-length-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="length"></p>
                  </div>

                  <div>
                    <label for="room-width" class="block text-sm font-semibold text-gray-200">
                      Width
                    </label>
                    <div class="mt-2 grid grid-cols-[minmax(0,1fr)_3.75rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-400 focus-within:ring-3 focus-within:ring-emerald-400/15">
                      <input
                        id="room-width"
                        class="min-h-14 w-full bg-transparent px-4 text-2xl font-semibold text-white outline-none placeholder:text-gray-600"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="4"
                        aria-describedby="room-width-error"
                        data-input="width"
                      />
                      <span class="grid place-items-center border-l border-gray-700 bg-gray-950 text-sm font-semibold text-gray-300">
                        m
                      </span>
                    </div>
                    <p id="room-width-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="width"></p>
                  </div>

                  <div data-height-field>
                    <label for="room-height" class="block text-sm font-semibold text-gray-200">
                      Height
                    </label>
                    <div class="mt-2 grid grid-cols-[minmax(0,1fr)_3.75rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-400 focus-within:ring-3 focus-within:ring-emerald-400/15">
                      <input
                        id="room-height"
                        class="min-h-14 w-full bg-transparent px-4 text-2xl font-semibold text-white outline-none placeholder:text-gray-600"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="2.6"
                        aria-describedby="room-height-error"
                        data-input="height"
                      />
                      <span class="grid place-items-center border-l border-gray-700 bg-gray-950 text-sm font-semibold text-gray-300">
                        m
                      </span>
                    </div>
                    <p id="room-height-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="height"></p>
                  </div>
                </div>
              </section>

              <section class="hidden" data-manual-panel>
                <label for="manual-area" class="block text-sm font-semibold text-gray-200">
                  Total area a pintar
                </label>
                <div class="mt-2 grid grid-cols-[minmax(0,1fr)_4.5rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-400 focus-within:ring-3 focus-within:ring-emerald-400/15">
                  <input
                    id="manual-area"
                    class="min-h-14 w-full bg-transparent px-4 text-2xl font-semibold text-white outline-none placeholder:text-gray-600"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder="48"
                    aria-describedby="manual-area-error"
                    data-input="manualArea"
                  />
                  <span class="grid place-items-center border-l border-gray-700 bg-gray-950 text-sm font-semibold text-gray-300">
                    m²
                  </span>
                </div>
                <p id="manual-area-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="manualArea"></p>

                <label for="manual-openings" class="mt-4 block text-sm font-semibold text-gray-200">
                  Openings a descontar
                </label>
                <div class="mt-2 grid grid-cols-[minmax(0,1fr)_4.5rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-400 focus-within:ring-3 focus-within:ring-emerald-400/15">
                  <input
                    id="manual-openings"
                    class="min-h-14 w-full bg-transparent px-4 text-2xl font-semibold text-white outline-none placeholder:text-gray-600"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder="0"
                    aria-describedby="manual-openings-error"
                    data-input="manualOpenings"
                  />
                  <span class="grid place-items-center border-l border-gray-700 bg-gray-950 text-sm font-semibold text-gray-300">
                    m²
                  </span>
                </div>
                <p id="manual-openings-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="manualOpenings"></p>
              </section>

              <section data-openings-section>
                <details class="rounded-lg border border-gray-800 bg-gray-900/70 p-4" data-openings-details>
                  <summary class="cursor-pointer list-none text-sm font-semibold text-white">
                    Doors and windows
                  </summary>

                  <div class="mt-4 grid rounded-lg border border-gray-700 bg-gray-950 p-1 sm:grid-cols-2">
                    <button
                      class="min-h-11 rounded-md px-3 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30"
                      type="button"
                      data-opening-mode="total"
                      aria-pressed="true"
                    >
                      Total area
                    </button>
                    <button
                      class="min-h-11 rounded-md px-3 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30"
                      type="button"
                      data-opening-mode="detalle"
                      aria-pressed="false"
                    >
                      Width y alto
                    </button>
                  </div>

                  <div class="mt-4 grid gap-4 sm:grid-cols-2" data-opening-total-panel>
                    <div>
                      <label for="door-area" class="block text-sm font-semibold text-gray-200">
                        Doors
                      </label>
                      <div class="mt-2 grid grid-cols-[minmax(0,1fr)_4.5rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-400 focus-within:ring-3 focus-within:ring-emerald-400/15">
                        <input
                          id="door-area"
                          class="min-h-14 w-full bg-transparent px-4 text-xl font-semibold text-white outline-none placeholder:text-gray-600"
                          type="text"
                          inputmode="decimal"
                          autocomplete="off"
                          placeholder="0"
                          aria-describedby="door-area-error"
                          data-input="doorArea"
                        />
                        <span class="grid place-items-center border-l border-gray-700 bg-gray-950 text-sm font-semibold text-gray-300">
                          m²
                        </span>
                      </div>
                      <p id="door-area-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="doorArea"></p>
                    </div>

                    <div>
                      <label for="window-area" class="block text-sm font-semibold text-gray-200">
                        Windows
                      </label>
                      <div class="mt-2 grid grid-cols-[minmax(0,1fr)_4.5rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-400 focus-within:ring-3 focus-within:ring-emerald-400/15">
                        <input
                          id="window-area"
                          class="min-h-14 w-full bg-transparent px-4 text-xl font-semibold text-white outline-none placeholder:text-gray-600"
                          type="text"
                          inputmode="decimal"
                          autocomplete="off"
                          placeholder="0"
                          aria-describedby="window-area-error"
                          data-input="windowArea"
                        />
                        <span class="grid place-items-center border-l border-gray-700 bg-gray-950 text-sm font-semibold text-gray-300">
                          m²
                        </span>
                      </div>
                      <p id="window-area-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="windowArea"></p>
                    </div>
                  </div>

                  <div class="mt-4 hidden" data-opening-detail-panel>
                    <div class="grid gap-3" data-opening-groups></div>
                    <button
                      class="mt-3 min-h-11 rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-emerald-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30"
                      type="button"
                      data-add-opening
                    >
                      Add opening
                    </button>
                    <p class="mt-3 text-sm text-gray-400" data-opening-detail-summary>
                      Doors: 0 m² · Windows: 0 m²
                    </p>
                  </div>
                </details>
              </section>

              <section class="grid gap-4 sm:grid-cols-3">
                <div>
                  <label for="paint-coats" class="block text-sm font-semibold text-gray-200">
                    Coats
                  </label>
                  <input
                    id="paint-coats"
                    class="mt-2 min-h-14 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-xl font-semibold text-white outline-none placeholder:text-gray-600 focus:border-emerald-400 focus:ring-3 focus:ring-emerald-400/15"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    value="2"
                    aria-describedby="paint-coats-error"
                    data-input="coats"
                  />
                  <p id="paint-coats-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="coats"></p>
                </div>

                <div class="sm:col-span-2">
                  <label for="paint-coverage" class="block text-sm font-semibold text-gray-200">
                    Coverage
                  </label>
                  <div class="mt-2 grid grid-cols-[minmax(0,1fr)_5.5rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-400 focus-within:ring-3 focus-within:ring-emerald-400/15">
                    <input
                      id="paint-coverage"
                      class="min-h-14 w-full bg-transparent px-4 text-xl font-semibold text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      value="10"
                      aria-describedby="paint-coverage-error"
                      data-input="coverage"
                    />
                    <span class="grid place-items-center border-l border-gray-700 bg-gray-950 text-sm font-semibold text-gray-300">
                      m²/l
                    </span>
                  </div>
                  <div class="mt-2 grid grid-cols-3 gap-2" aria-label="Coverage presets">
                    <button class="min-h-10 rounded-lg border border-gray-700 px-2 text-sm font-semibold text-gray-300 transition hover:border-emerald-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30" type="button" data-coverage-preset="8">
                      8
                    </button>
                    <button class="min-h-10 rounded-lg border border-emerald-400 bg-emerald-300 px-2 text-sm font-semibold text-gray-950 transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30" type="button" data-coverage-preset="10">
                      10
                    </button>
                    <button class="min-h-10 rounded-lg border border-gray-700 px-2 text-sm font-semibold text-gray-300 transition hover:border-emerald-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30" type="button" data-coverage-preset="12">
                      12
                    </button>
                  </div>
                  <p id="paint-coverage-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="coverage"></p>
                </div>
              </section>

              <section class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="paint-margin" class="block text-sm font-semibold text-gray-200">
                    Margin
                  </label>
                  <div class="mt-2 grid grid-cols-[minmax(0,1fr)_3.75rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-400 focus-within:ring-3 focus-within:ring-emerald-400/15">
                    <input
                      id="paint-margin"
                      class="min-h-14 w-full bg-transparent px-4 text-xl font-semibold text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      value="10"
                      aria-describedby="paint-margin-error"
                      data-input="margin"
                    />
                    <span class="grid place-items-center border-l border-gray-700 bg-gray-950 text-sm font-semibold text-gray-300">
                      %
                    </span>
                  </div>
                  <p id="paint-margin-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="margin"></p>
                </div>

                <div>
                  <label for="container-size" class="block text-sm font-semibold text-gray-200">
                    Envase
                  </label>
                  <div class="mt-2 grid grid-cols-[minmax(0,1fr)_3.75rem] overflow-hidden rounded-lg border border-gray-700 bg-gray-900 focus-within:border-emerald-400 focus-within:ring-3 focus-within:ring-emerald-400/15">
                    <input
                      id="container-size"
                      class="min-h-14 w-full bg-transparent px-4 text-xl font-semibold text-white outline-none placeholder:text-gray-600"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="4"
                      aria-describedby="container-size-error"
                      data-input="container"
                    />
                    <span class="grid place-items-center border-l border-gray-700 bg-gray-950 text-sm font-semibold text-gray-300">
                      l
                    </span>
                  </div>
                  <div class="mt-2 grid grid-cols-5 gap-2" aria-label="Container presets">
                    {[1, 4, 10, 19].map((size) => (
                      <button
                        class="min-h-10 rounded-lg border border-gray-700 px-2 text-sm font-semibold text-gray-300 transition hover:border-emerald-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30"
                        type="button"
                        data-container-preset={size}
                      >
                        {size} l
                      </button>
                    ))}
                    <button
                      class="min-h-10 rounded-lg border border-gray-700 px-2 text-sm font-semibold text-gray-300 transition hover:border-emerald-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30"
                      type="button"
                      data-container-clear
                    >
                      Otro
                    </button>
                  </div>
                  <p id="container-size-error" class="mt-2 min-h-5 text-sm text-red-300" data-error="container"></p>
                </div>
              </section>

              <div class="flex flex-col gap-3 sm:flex-row">
                <button
                  class="min-h-11 justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-emerald-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30"
                  type="button"
                  data-clear-calculator
                >
                  Clear
                </button>
              </div>
            </div>
          </div>

          <aside
            class="border-t border-gray-800 bg-gray-900/70 p-4 sm:p-6 lg:border-l lg:border-t-0"
            aria-live="polite"
            data-result-region
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-emerald-300">
              Result
            </p>
            <p class="mt-3 break-words text-3xl font-bold leading-tight text-white" data-main-result>
              Enter your measurements
            </p>
            <p class="mt-2 min-h-5 text-sm leading-relaxed text-gray-400" data-result-note>
              El resultado aparecera aqui junto con la compra estimada.
            </p>

            <div class="mt-5 grid gap-3" data-shopping-list></div>
            <div class="mt-5 space-y-3" data-breakdown-list></div>
            <div class="mt-5 rounded-lg border border-amber-400/30 bg-amber-400/10 p-4 text-sm leading-relaxed text-amber-100" data-estimate-copy>
              This is an estimate. Check manufacturer coverage and surface condition before buying.
            </div>

            <div class="mt-5 flex flex-col gap-3 sm:flex-row">
              <button
                class="hidden min-h-11 items-center justify-center rounded-lg bg-emerald-300 px-4 py-2 text-sm font-semibold text-gray-950 transition hover:bg-emerald-200 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-300/40"
                type="button"
                data-copy-result
              >
                Copy result
              </button>
              <button
                class="hidden min-h-11 items-center justify-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-emerald-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/40"
                type="button"
                data-copy-url
              >
                Compartir enlace
              </button>
            </div>
            <p class="mt-3 min-h-5 text-sm text-emerald-200" role="status" aria-live="polite" data-copy-status></p>
          </aside>
        </div>
      </section>

      <div
        class="fixed inset-x-0 bottom-0 z-30 hidden border-t border-gray-800 bg-gray-950/95 px-4 py-3 shadow-2xl shadow-black/50 backdrop-blur md:hidden"
        data-mobile-total
      >
        <div class="mx-auto flex max-w-xl items-center justify-between gap-3">
          <span class="text-xs font-semibold uppercase tracking-wide text-gray-500" data-mobile-total-label>
            Result
          </span>
          <span class="break-words text-right text-lg font-bold text-emerald-100" data-mobile-total-text></span>
        </div>
      </div>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-6 md:py-8">
      <SectionIntro
        title="How to measure a room"
        description="For a rectangular room, measure length, width and wall height. The calculator uses perimeter for walls and length by width for ceiling."
      />
      <div class="grid gap-4 md:grid-cols-3">
        <article class="rounded-lg border border-gray-800 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold">Walls</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Se calcula como 2 x (largo + ancho) x altura.
          </p>
        </article>
        <article class="rounded-lg border border-gray-800 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold">Ceiling</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Se calcula como largo x ancho y no descuenta puertas ni ventanas.
          </p>
        </article>
        <article class="rounded-lg border border-gray-800 bg-gray-950 p-5">
          <h3 class="text-lg font-semibold">Openings</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">
            Suma puertas y ventanas para descontarlas de la superficie de paredes.
          </p>
        </article>
      </div>
    </Container>

    <Container as="section" class="py-6 md:py-8">
      <div class="rounded-lg border border-gray-800 bg-gray-950 p-5">
        <SectionIntro
          title="Nonrectangular surfaces"
          description="Si necesitas medir una pared por partes o una forma irregular, calcula primero el area y pega el total en el modo Manual area."
          class="mb-4"
        />
        <a
          class="inline-flex min-h-11 items-center rounded-lg border border-gray-700 px-4 py-2 text-sm font-semibold text-gray-200 transition hover:border-emerald-400 hover:text-white focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-emerald-400/30"
          href="/geometria/calculadora-de-area-y-perimetro"
        >
          Abrir calculadora de area y perimetro
        </a>
      </div>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<script>
  import {
    PAINT_AREA_CANONICAL_PATH,
    buildPaintShareText,
    buildPaintShareUrl,
    calculateManualPaintArea,
    calculateOpeningArea,
    calculatePaintContainers,
    calculatePaintLiters,
    calculateRoomPaintArea,
    formatPaintCompactNumber,
    formatPaintNumber,
    parseMeasurementInput,
    parseOpeningMeasurementInput,
  } from "@lib/calculators/construccion/metros-cuadrados-de-pintura/paintArea.en";

  const modeButtons = Array.from(document.querySelectorAll("[data-mode-button]"));
  const surfaceButtons = Array.from(document.querySelectorAll("[data-surface-button]"));
  const openingModeButtons = Array.from(document.querySelectorAll("[data-opening-mode]"));
  const coveragePresetButtons = Array.from(document.querySelectorAll("[data-coverage-preset]"));
  const containerPresetButtons = Array.from(document.querySelectorAll("[data-container-preset]"));
  const roomPanel = document.querySelector("[data-room-panel]");
  const manualPanel = document.querySelector("[data-manual-panel]");
  const heightField = document.querySelector("[data-height-field]");
  const openingsSection = document.querySelector("[data-openings-section]");
  const openingTotalPanel = document.querySelector("[data-opening-total-panel]");
  const openingDetailPanel = document.querySelector("[data-opening-detail-panel]");
  const openingGroups = document.querySelector("[data-opening-groups]");
  const openingDetailSummary = document.querySelector("[data-opening-detail-summary]");
  const addOpeningButton = document.querySelector("[data-add-opening]");
  const containerClearButton = document.querySelector("[data-container-clear]");
  const clearButton = document.querySelector("[data-clear-calculator]");
  const mainResult = document.querySelector("[data-main-result]");
  const resultNote = document.querySelector("[data-result-note]");
  const shoppingList = document.querySelector("[data-shopping-list]");
  const breakdownList = document.querySelector("[data-breakdown-list]");
  const copyButton = document.querySelector("[data-copy-result]");
  const copyUrlButton = document.querySelector("[data-copy-url]");
  const copyStatus = document.querySelector("[data-copy-status]");
  const mobileTotal = document.querySelector("[data-mobile-total]");
  const mobileTotalLabel = document.querySelector("[data-mobile-total-label]");
  const mobileTotalText = document.querySelector("[data-mobile-total-text]");

  const inputs = {
    length: document.querySelector("[data-input='length']"),
    width: document.querySelector("[data-input='width']"),
    height: document.querySelector("[data-input='height']"),
    manualArea: document.querySelector("[data-input='manualArea']"),
    manualOpenings: document.querySelector("[data-input='manualOpenings']"),
    doorArea: document.querySelector("[data-input='doorArea']"),
    windowArea: document.querySelector("[data-input='windowArea']"),
    coats: document.querySelector("[data-input='coats']"),
    coverage: document.querySelector("[data-input='coverage']"),
    margin: document.querySelector("[data-input='margin']"),
    container: document.querySelector("[data-input='container']"),
  };

  const FIELD_MESSAGES = {
    required: "Completa este campo para calcular.",
    invalid: "Escribe un numero valido.",
    negative: "Usa un numero mayor o igual a cero.",
    zero: "Usa un numero mayor a cero.",
    integer: "Usa un numero entero.",
    tooHigh: "Check this value before continuing.",
  };

  const DEFAULT_OPENINGS = [
    { type: "door", quantity: "1", width: "0.90", height: "2.10", unit: "m" },
    { type: "window", quantity: "2", width: "1.20", height: "1.00", unit: "m" },
  ];

  let currentMode = "habitacion";
  let currentSurface = "paredes";
  let currentOpeningMode = "total";
  let currentShareText = "";
  let currentShareUrl = window.location.href;
  let copyTimer = 0;

  function setMode(mode, { syncUrl = true } = {}) {
    currentMode = mode === "manual" ? "manual" : "habitacion";

    modeButtons.forEach((button) => {
      const active = button.dataset.modeButton === currentMode;
      button.setAttribute("aria-selected", String(active));
      setActiveButton(button, active);
    });

    roomPanel.classList.toggle("hidden", currentMode !== "habitacion");
    manualPanel.classList.toggle("hidden", currentMode !== "manual");
    openingsSection.classList.toggle(
      "hidden",
      currentMode !== "habitacion" || currentSurface === "techo",
    );
    heightField.classList.toggle("hidden", currentSurface === "techo");

    if (currentSurface === "techo") {
      setFieldError("height", "");
    }

    updateCalculator({ syncUrl });
  }

  function setSurface(surface, { syncUrl = true } = {}) {
    currentSurface = ["paredes", "techo", "ambos"].includes(surface)
      ? surface
      : "paredes";

    surfaceButtons.forEach((button) => {
      const active = button.dataset.surfaceButton === currentSurface;
      button.setAttribute("aria-pressed", String(active));
      setActiveButton(button, active);
    });

    openingsSection.classList.toggle(
      "hidden",
      currentMode !== "habitacion" || currentSurface === "techo",
    );

    updateCalculator({ syncUrl });
  }

  function setOpeningMode(mode) {
    currentOpeningMode = mode === "detalle" ? "detalle" : "total";

    openingModeButtons.forEach((button) => {
      const active = button.dataset.openingMode === currentOpeningMode;
      button.setAttribute("aria-pressed", String(active));
      setActiveButton(button, active);
    });

    openingTotalPanel.classList.toggle("hidden", currentOpeningMode !== "total");
    openingDetailPanel.classList.toggle("hidden", currentOpeningMode !== "detalle");
    updateCalculator();
  }

  function setActiveButton(button, active) {
    button.classList.toggle("border-emerald-400", active);
    button.classList.toggle("bg-emerald-300", active);
    button.classList.toggle("text-gray-950", active);
    button.classList.toggle("border-gray-700", !active);
    button.classList.toggle("text-gray-300", !active);
  }

  function readRequired(name) {
    const input = inputs[name];
    const parsed = parseMeasurementInput(input.value);

    if (!parsed.ok) {
      setFieldError(name, FIELD_MESSAGES[parsed.error]);
      return undefined;
    }

    if (parsed.value <= 0) {
      setFieldError(name, FIELD_MESSAGES.zero);
      return undefined;
    }

    setFieldError(name, "");
    return parsed.value;
  }

  function readOptionalArea(name) {
    const input = inputs[name];

    if (!input.value.trim()) {
      setFieldError(name, "");
      return 0;
    }

    const parsed = parseMeasurementInput(input.value);

    if (!parsed.ok) {
      setFieldError(name, FIELD_MESSAGES[parsed.error]);
      return undefined;
    }

    setFieldError(name, "");
    return parsed.value;
  }

  function readCoats() {
    const value = readRequired("coats");

    if (typeof value !== "number") {
      return undefined;
    }

    if (!Number.isInteger(value)) {
      setFieldError("coats", FIELD_MESSAGES.integer);
      return undefined;
    }

    if (value > 10) {
      setFieldError("coats", FIELD_MESSAGES.tooHigh);
      return undefined;
    }

    return value;
  }

  function readMargin() {
    const value = readOptionalArea("margin");

    if (typeof value !== "number") {
      return undefined;
    }

    if (value > 100) {
      setFieldError("margin", FIELD_MESSAGES.tooHigh);
      return undefined;
    }

    return value;
  }

  function readContainerSize() {
    const input = inputs.container;

    if (!input.value.trim()) {
      setFieldError("container", "");
      return 0;
    }

    const parsed = parseMeasurementInput(input.value);

    if (!parsed.ok) {
      setFieldError("container", FIELD_MESSAGES[parsed.error]);
      return undefined;
    }

    if (parsed.value <= 0) {
      setFieldError("container", FIELD_MESSAGES.zero);
      return undefined;
    }

    setFieldError("container", "");
    return parsed.value;
  }

  function readOpenings() {
    if (currentMode !== "habitacion" || currentSurface === "techo") {
      setFieldError("doorArea", "");
      setFieldError("windowArea", "");
      return { doorArea: 0, windowArea: 0, ok: true };
    }

    if (currentOpeningMode === "total") {
      const doorArea = readOptionalArea("doorArea");
      const windowArea = readOptionalArea("windowArea");

      return {
        doorArea: typeof doorArea === "number" ? doorArea : 0,
        windowArea: typeof windowArea === "number" ? windowArea : 0,
        ok: typeof doorArea === "number" && typeof windowArea === "number",
      };
    }

    const result = readOpeningGroups();
    updateOpeningDetailSummary(result.doorArea, result.windowArea);
    return result;
  }

  function readOpeningGroups() {
    const rows = Array.from(document.querySelectorAll("[data-opening-row]"));
    let ok = true;
    let doorArea = 0;
    let windowArea = 0;

    rows.forEach((row) => {
      const type = row.querySelector("[data-opening-type]").value;
      const quantityInput = row.querySelector("[data-opening-quantity]");
      const widthInput = row.querySelector("[data-opening-width]");
      const heightInput = row.querySelector("[data-opening-height]");
      const unitSelect = row.querySelector("[data-opening-unit]");

      const quantity = parseMeasurementInput(quantityInput.value);
      const width = parseOpeningMeasurementInput(widthInput.value);
      const height = parseOpeningMeasurementInput(heightInput.value);

      row.querySelector("[data-row-error]").textContent = "";

      if (!quantity.ok || !width.ok || !height.ok) {
        row.querySelector("[data-row-error]").textContent =
          "Completa cantidad, ancho y alto con numeros validos.";
        ok = false;
        return;
      }

      if (!Number.isInteger(quantity.value) || quantity.value < 0) {
        row.querySelector("[data-row-error]").textContent =
          "La cantidad debe ser un entero mayor o igual a cero.";
        ok = false;
        return;
      }

      if (quantity.value === 0) {
        return;
      }

      if (width.unit && height.unit && width.unit !== height.unit) {
        row.querySelector("[data-row-error]").textContent =
          "Usa la misma unidad para ancho y alto.";
        ok = false;
        return;
      }

      const unit = width.unit ?? height.unit ?? unitSelect.value;
      let area = 0;

      try {
        area = calculateOpeningArea([
          {
            quantity: quantity.value,
            width: width.value,
            height: height.value,
            unit,
          },
        ]);
      } catch (error) {
        row.querySelector("[data-row-error]").textContent =
          error instanceof Error
            ? error.message
            : "Check this opening's measurements.";
        ok = false;
        return;
      }

      if (type === "window") {
        windowArea += area;
        return;
      }

      doorArea += area;
    });

    return { doorArea, windowArea, ok };
  }

  function updateCalculator({ syncUrl = true } = {}) {
    clearCopyStatus();
    clearResultVisibility();

    const common = readCommonInputs();

    if (!common.ok) {
      setNeutralResult("Check the marked fields to continue.");
      return;
    }

    if (currentMode === "manual") {
      updateManualResult(common, { syncUrl });
      return;
    }

    updateRoomResult(common, { syncUrl });
  }

  function readCommonInputs() {
    const coats = readCoats();
    const coverage = readRequired("coverage");
    const marginPercentage = readMargin();
    const containerSize = readContainerSize();

    return {
      ok:
        typeof coats === "number" &&
        typeof coverage === "number" &&
        typeof marginPercentage === "number" &&
        typeof containerSize === "number",
      coats,
      coverage,
      marginPercentage,
      containerSize,
    };
  }

  function updateRoomResult(common, { syncUrl }) {
    const length = readRequired("length");
    const width = readRequired("width");
    const paintWalls = currentSurface !== "techo";
    const paintCeiling = currentSurface !== "paredes";
    const height = paintWalls ? readRequired("height") : 1;
    const openings = readOpenings();

    if (
      typeof length !== "number" ||
      typeof width !== "number" ||
      typeof height !== "number" ||
      !openings.ok
    ) {
      setNeutralResult("Completa las medidas de la habitacion.");
      return;
    }

    try {
      const area = calculateRoomPaintArea({
        length,
        width,
        height,
        paintWalls,
        paintCeiling,
        doorArea: openings.doorArea,
        windowArea: openings.windowArea,
      });
      const liters = calculatePaintLiters(
        area.netArea,
        common.coats,
        common.coverage,
        common.marginPercentage,
      );
      const containers =
        common.containerSize > 0
          ? calculatePaintContainers(liters.litersWithMargin, common.containerSize)
          : undefined;

      renderResult({
        area,
        liters,
        containers,
        length,
        width,
        height,
        paintWalls,
        paintCeiling,
        mode: "habitacion",
      });

      currentShareText = buildPaintShareText({
        netArea: liters.netArea,
        coats: liters.coats,
        accumulatedArea: liters.accumulatedArea,
        coverage: liters.coverage,
        litersBase: liters.litersBase,
        marginPercentage: liters.marginPercentage,
        litersWithMargin: liters.litersWithMargin,
        wallArea: paintWalls ? area.wallArea : undefined,
        ceilingArea: paintCeiling ? area.ceilingArea : undefined,
        openingArea: area.openingArea,
        containers,
      });

      updateShareUrl(
        {
          mode: "habitacion",
          length,
          width,
          height: paintWalls ? height : undefined,
          paintWalls,
          paintCeiling,
          doorArea: openings.doorArea,
          windowArea: openings.windowArea,
          coats: common.coats,
          coverage: common.coverage,
          marginPercentage: common.marginPercentage,
          containerSize: common.containerSize > 0 ? common.containerSize : undefined,
        },
        syncUrl,
      );
    } catch (error) {
      setNeutralResult(error instanceof Error ? error.message : "No fue posible calcular.");
    }
  }

  function updateManualResult(common, { syncUrl }) {
    const totalArea = readRequired("manualArea");
    const manualOpenings = readOptionalArea("manualOpenings");

    if (typeof totalArea !== "number" || typeof manualOpenings !== "number") {
      setNeutralResult("Completa la superficie total para calcular.");
      return;
    }

    try {
      const netArea = calculateManualPaintArea(totalArea, manualOpenings);
      const liters = calculatePaintLiters(
        netArea,
        common.coats,
        common.coverage,
        common.marginPercentage,
      );
      const containers =
        common.containerSize > 0
          ? calculatePaintContainers(liters.litersWithMargin, common.containerSize)
          : undefined;

      renderResult({
        area: {
          wallArea: totalArea,
          ceilingArea: 0,
          openingArea: manualOpenings,
          netArea,
          netWallArea: netArea,
          netCeilingArea: 0,
        },
        liters,
        containers,
        mode: "manual",
      });

      currentShareText = buildPaintShareText({
        netArea: liters.netArea,
        coats: liters.coats,
        accumulatedArea: liters.accumulatedArea,
        coverage: liters.coverage,
        litersBase: liters.litersBase,
        marginPercentage: liters.marginPercentage,
        litersWithMargin: liters.litersWithMargin,
        openingArea: manualOpenings,
        containers,
      });

      updateShareUrl(
        {
          mode: "manual",
          manualArea: totalArea,
          manualOpenings,
          coats: common.coats,
          coverage: common.coverage,
          marginPercentage: common.marginPercentage,
          containerSize: common.containerSize > 0 ? common.containerSize : undefined,
        },
        syncUrl,
      );
    } catch (error) {
      setNeutralResult(error instanceof Error ? error.message : "No fue posible calcular.");
    }
  }

  function renderResult({
    area,
    liters,
    containers,
    length,
    width,
    height,
    paintWalls,
    paintCeiling,
    mode,
  }) {
    const primaryText = containers
      ? `${containers.containers} container${containers.containers === 1 ? "" : "s"} de ${formatPaintCompactNumber(
          containers.containerSize,
        )} l`
      : `${formatPaintNumber(liters.litersWithMargin)} l`;

    mainResult.textContent = primaryText;
    resultNote.textContent = containers
      ? `${formatPaintNumber(liters.litersWithMargin)} l needed; estimated purchase rounded by container.`
      : "Litros estimados con margen incluido.";

    const shoppingItems = [
      ["Net area", `${formatPaintNumber(area.netArea)} m²`],
      ["Coats", String(liters.coats)],
      ["Paint needed", `${formatPaintNumber(liters.litersWithMargin)} l`],
    ];

    if (containers) {
      shoppingItems.push(
        [
          "Estimated purchase",
          `${containers.containers} container${
            containers.containers === 1 ? "" : "s"
          } de ${formatPaintCompactNumber(containers.containerSize)} l`,
        ],
        ["Total purchased", `${formatPaintNumber(containers.litersBought)} l`],
        ["Surplus", `${formatPaintNumber(containers.litersSurplus)} l`],
      );
    }

    renderKeyValueList(shoppingList, shoppingItems);

    const breakdownItems = [
      ["Net area", `${formatPaintNumber(area.netArea)} m²`],
      [
        `${liters.coats} mano${liters.coats === 1 ? "" : "s"}`,
        `${formatPaintNumber(liters.accumulatedArea)} m² accumulated`,
      ],
      ["Base paint", `${formatPaintNumber(liters.litersBase)} l`],
      [
        `With a margin of ${formatPaintCompactNumber(liters.marginPercentage)}%`,
        `${formatPaintNumber(liters.litersWithMargin)} l`,
      ],
    ];

    if (mode === "habitacion" && paintWalls) {
      breakdownItems.unshift(
        ["Walls", `${formatPaintNumber(area.wallArea)} m²`],
        ["Doors and windows", `-${formatPaintNumber(area.openingArea)} m²`],
      );
    }

    if (mode === "habitacion" && paintCeiling) {
      breakdownItems.unshift(["Ceiling", `${formatPaintNumber(area.ceilingArea)} m²`]);
    }

    renderKeyValueList(breakdownList, breakdownItems);
    renderFormulaSteps({
      area,
      liters,
      length,
      width,
      height,
      paintWalls,
      paintCeiling,
      mode,
    });

    showActions();
    updateMobileResult(containers, liters);
  }

  function renderFormulaSteps({
    area,
    liters,
    length,
    width,
    height,
    paintWalls,
    paintCeiling,
    mode,
  }) {
    const steps = [];

    if (mode === "habitacion" && paintWalls) {
      steps.push(
        `Walls: 2 x (${formatPaintCompactNumber(length)} + ${formatPaintCompactNumber(
          width,
        )}) x ${formatPaintCompactNumber(height)} = ${formatPaintNumber(area.wallArea)} m²`,
      );
      steps.push(
        `Openings: ${formatPaintNumber(area.wallArea)} - ${formatPaintNumber(
          area.openingArea,
        )} = ${formatPaintNumber(area.netWallArea)} m²`,
      );
    }

    if (mode === "habitacion" && paintCeiling) {
      steps.push(
        `Ceiling: ${formatPaintCompactNumber(length)} x ${formatPaintCompactNumber(
          width,
        )} = ${formatPaintNumber(area.ceilingArea)} m²`,
      );
    }

    steps.push(
      `Coats: ${formatPaintNumber(area.netArea)} x ${liters.coats} = ${formatPaintNumber(
        liters.accumulatedArea,
      )} m² accumulated`,
      `Litros: ${formatPaintNumber(liters.accumulatedArea)} ÷ ${formatPaintNumber(
        liters.coverage,
      )} = ${formatPaintNumber(liters.litersBase)} l`,
      `Margin: ${formatPaintNumber(liters.litersBase)} x ${formatPaintCompactNumber(
        1 + liters.marginPercentage / 100,
      )} = ${formatPaintNumber(liters.litersWithMargin)} l`,
    );

    const stepWrapper = document.createElement("div");
    stepWrapper.className =
      "rounded-lg border border-gray-800 bg-gray-950 p-4 text-sm leading-relaxed text-gray-300";
    stepWrapper.innerHTML = `<p class="font-semibold text-white">Step by step</p><div class="mt-3 grid gap-2"></div>`;
    const stepList = stepWrapper.querySelector("div");

    steps.forEach((step) => {
      const item = document.createElement("p");
      item.textContent = step;
      stepList.appendChild(item);
    });

    breakdownList.appendChild(stepWrapper);
  }

  function renderKeyValueList(container, items) {
    container.textContent = "";

    items.forEach(([label, value]) => {
      const row = document.createElement("div");
      row.className =
        "flex items-start justify-between gap-4 rounded-lg border border-gray-800 bg-gray-950 p-3 text-sm";
      row.innerHTML = `<span class="text-gray-400"></span><strong class="break-words text-right font-semibold text-white"></strong>`;
      row.querySelector("span").textContent = label;
      row.querySelector("strong").textContent = value;
      container.appendChild(row);
    });
  }

  function showActions() {
    copyButton.classList.remove("hidden");
    copyButton.classList.add("inline-flex");
    copyUrlButton.classList.remove("hidden");
    copyUrlButton.classList.add("inline-flex");
  }

  function clearResultVisibility() {
    copyButton.classList.add("hidden");
    copyButton.classList.remove("inline-flex");
    copyUrlButton.classList.add("hidden");
    copyUrlButton.classList.remove("inline-flex");
    mobileTotal.classList.add("hidden");
  }

  function setNeutralResult(message) {
    mainResult.textContent = "Enter your measurements";
    resultNote.textContent = message;
    shoppingList.textContent = "";
    breakdownList.textContent = "";
    currentShareText = "";
    currentShareUrl = new URL(PAINT_AREA_CANONICAL_PATH, window.location.origin).href;
  }

  function updateMobileResult(containers, liters) {
    if (containers) {
      mobileTotalLabel.textContent = "Purchase";
      mobileTotalText.textContent = `${containers.containers} container${
        containers.containers === 1 ? "" : "s"
      } de ${formatPaintCompactNumber(containers.containerSize)} l`;
    } else {
      mobileTotalLabel.textContent = "Necesitas";
      mobileTotalText.textContent = `${formatPaintNumber(liters.litersWithMargin)} l`;
    }

    mobileTotal.classList.remove("hidden");
  }

  function updateShareUrl(input, syncUrl) {
    const path = buildPaintShareUrl(input);
    currentShareUrl = new URL(path, window.location.origin).href;

    if (syncUrl) {
      window.history.replaceState({}, "", path);
    }
  }

  function setFieldError(name, message) {
    const error = document.querySelector(`[data-error='${name}']`);

    if (error) {
      error.textContent = message;
    }
  }

  function clearCopyStatus() {
    window.clearTimeout(copyTimer);
    copyStatus.textContent = "";
  }

  function updateOpeningDetailSummary(doorArea, windowArea) {
    openingDetailSummary.textContent = `Doors: ${formatPaintNumber(
      doorArea,
    )} m² · Windows: ${formatPaintNumber(windowArea)} m²`;
  }

  function addOpeningRow(opening = {}) {
    const rows = document.querySelectorAll("[data-opening-row]");

    if (rows.length >= 10) {
      return;
    }

    const row = document.createElement("div");
    row.className = "rounded-lg border border-gray-800 bg-gray-950 p-3";
    row.dataset.openingRow = "";
    row.innerHTML = `
      <div class="grid gap-3 sm:grid-cols-[7rem_5rem_1fr_1fr_5rem]">
        <select class="min-h-11 rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm font-semibold text-gray-100 outline-none focus:border-emerald-400 focus:ring-3 focus:ring-emerald-400/15" data-opening-type aria-label="Opening type">
          <option value="door">Door</option>
          <option value="window">Window</option>
        </select>
        <input class="min-h-11 rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm font-semibold text-white outline-none placeholder:text-gray-600 focus:border-emerald-400 focus:ring-3 focus:ring-emerald-400/15" type="text" inputmode="numeric" placeholder="1" data-opening-quantity aria-label="Quantity" />
        <input class="min-h-11 rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm font-semibold text-white outline-none placeholder:text-gray-600 focus:border-emerald-400 focus:ring-3 focus:ring-emerald-400/15" type="text" inputmode="decimal" placeholder="0.90" data-opening-width aria-label="Width" />
        <input class="min-h-11 rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm font-semibold text-white outline-none placeholder:text-gray-600 focus:border-emerald-400 focus:ring-3 focus:ring-emerald-400/15" type="text" inputmode="decimal" placeholder="2.10" data-opening-height aria-label="Height" />
        <select class="min-h-11 rounded-lg border border-gray-700 bg-gray-900 px-3 text-sm font-semibold text-gray-100 outline-none focus:border-emerald-400 focus:ring-3 focus:ring-emerald-400/15" data-opening-unit aria-label="Unit">
          <option value="m">m</option>
          <option value="cm">cm</option>
        </select>
      </div>
      <p class="mt-2 min-h-5 text-sm text-red-300" data-row-error></p>
    `;

    row.querySelector("[data-opening-type]").value = opening.type ?? "door";
    row.querySelector("[data-opening-quantity]").value = opening.quantity ?? "";
    row.querySelector("[data-opening-width]").value = opening.width ?? "";
    row.querySelector("[data-opening-height]").value = opening.height ?? "";
    row.querySelector("[data-opening-unit]").value = opening.unit ?? "m";
    row.addEventListener("input", () => updateCalculator());
    row.addEventListener("change", () => updateCalculator());
    openingGroups.appendChild(row);
  }

  function copyText(text, successMessage) {
    clearCopyStatus();

    if (!text) {
      copyStatus.textContent = "There is no result to copy.";
      return;
    }

    if (navigator.clipboard?.writeText) {
      navigator.clipboard
        .writeText(text)
        .then(() => {
          copyStatus.textContent = successMessage;
        })
        .catch(() => {
          copyStatus.textContent = "Could not copy automatically.";
        });
    } else {
      copyStatus.textContent = "Could not copy automatically.";
    }

    copyTimer = window.setTimeout(() => {
      copyStatus.textContent = "";
    }, 3000);
  }

  function hydrateFromQuery() {
    const params = new URLSearchParams(window.location.search);

    setInputFromParam("length", params.get("largo"));
    setInputFromParam("width", params.get("ancho"));
    setInputFromParam("height", params.get("altura"));
    setInputFromParam("manualArea", params.get("area"));
    setInputFromParam("manualOpenings", params.get("aberturas"));
    setInputFromParam("doorArea", params.get("puertas"));
    setInputFromParam("windowArea", params.get("ventanas"));
    setInputFromParam("coats", params.get("manos"));
    setInputFromParam("coverage", params.get("rendimiento"));
    setInputFromParam("margin", params.get("margen"));
    setInputFromParam("container", params.get("envase"));

    const paintWalls = params.get("paredes") !== "0";
    const paintCeiling = params.get("techo") === "1";
    const surface = paintWalls && paintCeiling ? "ambos" : paintCeiling ? "techo" : "paredes";

    setSurface(surface, { syncUrl: false });
    setMode(params.get("modo") === "manual" ? "manual" : "habitacion", {
      syncUrl: false,
    });
    updateCalculator({ syncUrl: false });
  }

  function setInputFromParam(name, value) {
    if (value !== null && inputs[name]) {
      inputs[name].value = value;
    }
  }

  Object.values(inputs).forEach((input) => {
    input.addEventListener("input", () => updateCalculator());
  });

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => setMode(button.dataset.modeButton));
  });

  surfaceButtons.forEach((button) => {
    button.addEventListener("click", () => setSurface(button.dataset.surfaceButton));
  });

  openingModeButtons.forEach((button) => {
    button.addEventListener("click", () => setOpeningMode(button.dataset.openingMode));
  });

  coveragePresetButtons.forEach((button) => {
    button.addEventListener("click", () => {
      inputs.coverage.value = button.dataset.coveragePreset;
      coveragePresetButtons.forEach((preset) =>
        setActiveButton(preset, preset === button),
      );
      updateCalculator();
    });
  });

  containerPresetButtons.forEach((button) => {
    button.addEventListener("click", () => {
      inputs.container.value = button.dataset.containerPreset;
      containerPresetButtons.forEach((preset) =>
        setActiveButton(preset, preset === button),
      );
      setActiveButton(containerClearButton, false);
      updateCalculator();
    });
  });

  containerClearButton.addEventListener("click", () => {
    inputs.container.value = "";
    containerPresetButtons.forEach((preset) => setActiveButton(preset, false));
    setActiveButton(containerClearButton, true);
    inputs.container.focus();
    updateCalculator();
  });

  addOpeningButton.addEventListener("click", () => {
    addOpeningRow();
    updateCalculator();
  });

  clearButton.addEventListener("click", () => {
    Object.entries(inputs).forEach(([name, input]) => {
      input.value = name === "coats" ? "2" : name === "coverage" ? "10" : name === "margin" ? "10" : "";
    });
    setMode("habitacion");
    setSurface("paredes");
    setOpeningMode("total");
    window.history.replaceState({}, "", PAINT_AREA_CANONICAL_PATH);
    updateCalculator({ syncUrl: false });
  });

  copyButton.addEventListener("click", () => {
    copyText(currentShareText, "Result copiado.");
  });

  copyUrlButton.addEventListener("click", () => {
    copyText(currentShareUrl, "Link copied.");
  });

  DEFAULT_OPENINGS.forEach((opening) => addOpeningRow(opening));
  setMode("habitacion", { syncUrl: false });
  setSurface("paredes", { syncUrl: false });
  setOpeningMode("total");
  hydrateFromQuery();
</script>
