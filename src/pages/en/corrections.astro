---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import PageHero from "@components/shared/PageHero.astro";
import Panel from "@components/shared/Panel.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";

const description =
  "Learn how to report errors, what information to include, and how calculadoras.tools evaluates editorial or calculation corrections.";
const canonical = "/en/corrections";
const alternates = buildAlternateLinks(
  { es: "/correcciones", en: canonical },
  Astro.site ?? Astro.url,
);

const steps = [
  {
    title: "How to report an error",
    content:
      "Use the contact form and include the affected URL, the result you observed, the result you expected, and the input values you used if the issue involves a calculator.",
  },
  {
    title: "What we review",
    content:
      "We check whether the problem involves the formula, assumptions, wording, a source, a current rate, a link, or an interpretation that could confuse readers.",
  },
  {
    title: "When a date changes",
    content:
      "The update or review date changes only after a substantial correction, source verification, or meaningful editorial revision. Minor corrections may be resolved without changing those dates.",
  },
  {
    title: "Significant corrections",
    content:
      "If a correction changes the meaning of an explanation, formula, warning, or important source, it should be documented in the page or in the internal editorial record.",
  },
];
---

<BaseLayout
  locale="en"
  title="Corrections"
  description={description}
  canonical={canonical}
  alternates={alternates}
>
  <PageShell>
    <PageHero
      locale="en"
      title="Corrections"
      description="If you find a calculation error, an outdated source, or a confusing explanation, you can report it so the content can be reviewed."
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Corrections" },
      ]}
      containerClass="px-6 py-10"
      breadcrumbClass="mb-8"
      titleClass="text-4xl font-bold tracking-tight md:text-6xl"
      descriptionClass="mt-6 text-lg leading-relaxed text-gray-400"
    />

    <Container as="section" class="px-6 py-14">
      <div class="grid gap-6">
        {
          steps.map((step) => (
            <Panel as="section" padding="lg">
              <h2 class="text-xl font-semibold">{step.title}</h2>
              <p class="mt-3 leading-relaxed text-gray-400">{step.content}</p>
            </Panel>
          ))
        }

        <Panel as="section" padding="lg">
          <h2 class="text-xl font-semibold">Send a report</h2>
          <p class="mt-3 leading-relaxed text-gray-400">
            You can send your report through the{" "}
            <a
              class="text-amber-400 hover:text-amber-300"
              href="/en/contact"
            >
              contact page
            </a>.
          </p>
        </Panel>
      </div>
    </Container>
  </PageShell>
</BaseLayout>
