
---
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Pomodoro timer";
const description =
  "Plan Pomodoro sessions with focus blocks, short and long breaks, total duration, finish time, and the number of pomodoros that fit your available time.";
const canonical = "/en/date-time/pomodoro-timer";
const spanishCanonical = "/fecha-tiempo/calculadora-pomodoro";
const alternates = buildAlternateLinks({ es: spanishCanonical, en: canonical }, Astro.site ?? Astro.url);

const faqs = [
  {
    question: "How long is a Pomodoro?",
    answer:
      "The classic technique uses 25 minutes of focus and a 5-minute short break. After several pomodoros, a 15- to 30-minute long break is commonly added.",
  },
  {
    question: "Does the calculator include long breaks?",
    answer:
      "Yes. You can configure how often a long break appears and how long it lasts. The calculator never adds a break after the final focus block.",
  },
  {
    question: "Can I change the focus duration?",
    answer:
      "Yes. You can use 25-, 50-, or 90-minute presets or enter custom focus, short-break, and long-break values.",
  },
  {
    question: "How many pomodoros fit into two hours?",
    answer:
      "With the classic preset—25 minutes of focus, a 5-minute short break, and a 20-minute long break every four pomodoros—four complete pomodoros fit into two hours with five minutes remaining.",
  },
  {
    question: "What if I need to finish by a specific time?",
    answer:
      "Add a start time and deadline. If the deadline is earlier than the start time, it is treated as the next day.",
  },
  {
    question: "Are 25-, 50-, or 90-minute pomodoros better?",
    answer:
      "It depends on the work and your energy. Twenty-five-minute blocks help you start quickly, while 50 or 90 minutes may work better for deep work with fewer context switches.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical} locale="en" alternates={alternates}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title="Pomodoro timer"
      description="Build a focus plan with breaks, a finish time, and a block-by-block schedule."
      kicker="Date and time"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Date and time", href: "/en/date-time", optional: true },
        { label: "Pomodoro", truncate: true },
      ]}
    />

    <Container as="section" class="py-4 md:py-8">
      <section
        id="pomodoro-calculator"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <div class="grid gap-0 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.9fr)]">
          <form class="p-4 sm:p-6" novalidate data-pomodoro-form>
            <div>
              <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">
                Pomodoro planner
              </p>
              <h2 id="calculator-heading" class="mt-2 text-2xl font-semibold">
                Configure your session
              </h2>
            </div>

            <fieldset class="mt-5">
              <legend class="field-label">Modo</legend>
              <div class="mt-2 grid grid-cols-2 gap-2 rounded-lg border border-gray-800 bg-gray-900/70 p-1">
                <label class="segmented-option" data-mode-label="pomodoros" data-active="true">
                  <input class="sr-only" type="radio" name="pomodoro-mode" value="pomodoros" checked />
                  Number of pomodoros
                </label>
                <label class="segmented-option" data-mode-label="time">
                  <input class="sr-only" type="radio" name="pomodoro-mode" value="time" />
                  Available time
                </label>
              </div>
            </fieldset>

            <fieldset class="mt-5">
              <legend class="field-label">Preset</legend>
              <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
                <button class="preset-button" type="button" data-preset="classic" aria-pressed="true">
                  25 / 5 / 20
                </button>
                <button class="preset-button" type="button" data-preset="long" aria-pressed="false">
                  50 / 10 / 30
                </button>
                <button class="preset-button" type="button" data-preset="deep" aria-pressed="false">
                  90 / 15 / 30
                </button>
                <button class="preset-button" type="button" data-preset="custom" aria-pressed="false">
                  Custom
                </button>
              </div>
            </fieldset>

            <div class="mt-5 grid gap-4 sm:grid-cols-2" data-pomodoro-count-field>
              <div>
                <label class="field-label" for="pomodoro-count">Pomodoros</label>
                <div class="field-shell">
                  <input
                    id="pomodoro-count"
                    class="field-input field-input-leading"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    value="4"
                    data-field="pomodoros"
                  />
                  <span class="field-affix">blocks</span>
                </div>
              </div>
            </div>

            <div class="mt-5 hidden grid gap-4 sm:grid-cols-2" data-available-time-field>
              <div>
                <label class="field-label" for="available-hours">Available hours</label>
                <div class="field-shell">
                  <input
                    id="available-hours"
                    class="field-input field-input-leading"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    value="2"
                    data-field="availableHours"
                  />

                  <span class="field-affix">h</span>
                </div>
              </div>
              <div>
                <label class="field-label" for="available-minutes">Minutes</label>
                <div class="field-shell">
                  <input
                    id="available-minutes"
                    class="field-input field-input-leading"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    value="0"
                    data-field="availableMinutes"
                  />
                  <span class="field-affix">min</span>
                </div>
              </div>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div>
                <label class="field-label" for="focus-minutes">Focus</label>
                <div class="field-shell">
                  <input
                    id="focus-minutes"
                    class="field-input field-input-leading"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    value="25"
                    data-field="focusMinutes"
                  />
                  <span class="field-affix">min</span>
                </div>
              </div>
              <div>
                <label class="field-label" for="short-break">Short break</label>
                <div class="field-shell">
                  <input
                    id="short-break"
                    class="field-input field-input-leading"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    value="5"
                    data-field="shortBreakMinutes"
                  />
                  <span class="field-affix">min</span>
                </div>
              </div>
              <div>
                <label class="field-label" for="long-break">Long break</label>
                <div class="field-shell">
                  <input
                    id="long-break"
                    class="field-input field-input-leading"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    value="20"
                    data-field="longBreakMinutes"
                  />
                  <span class="field-affix">min</span>
                </div>
              </div>
              <div>
                <label class="field-label" for="long-break-every">Long break every</label>
                <div class="field-shell">
                  <input
                    id="long-break-every"
                    class="field-input field-input-leading"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    value="4"
                    data-field="longBreakEvery"
                  />
                  <span class="field-affix">pomodoros</span>
                </div>
              </div>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div>
                <label class="field-label" for="start-time">Start time</label>
                <input id="start-time" class="field" type="time" data-field="startTime" />
              </div>
              <div>
                <label class="field-label" for="deadline-time">
                  Deadline <span class="font-normal text-gray-500">(optional)</span>
                </label>
                <input id="deadline-time" class="field" type="time" data-field="deadlineTime" />
              </div>
            </div>

            <div
              class="mt-5 hidden rounded-lg border border-red-400/40 bg-red-400/10 p-3 text-sm leading-relaxed text-red-100"
              role="alert"
              tabindex="-1"
              data-errors
            ></div>

            <div class="mt-6 flex flex-col gap-3 border-t border-gray-800 pt-5 sm:flex-row sm:flex-wrap">
              <button class="primary-button w-full sm:w-auto sm:min-w-44" type="submit">
                Calculate plan
              </button>
              <button class="secondary-button" type="button" data-copy-result>
                <span data-copy-label>Copy summary</span>
              </button>
              <button class="secondary-button" type="button" data-clear>
                Clear
              </button>
              <p class="sr-only" aria-live="polite" data-copy-status></p>
            </div>
          </form>

          <aside
            class="order-first border-b border-gray-800 bg-gray-900/70 p-4 sm:p-6 lg:order-last lg:border-b-0 lg:border-l"
            aria-live="polite"
            tabindex="-1"
            data-result-region
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-amber-400" data-result-kicker>
              Estimated plan
            </p>
            <p class="mt-3 min-h-[3rem] break-words text-4xl font-bold leading-tight text-white" data-main-result>
              Your plan
            </p>
            <p class="mt-2 text-sm font-semibold text-amber-100" data-result-subtitle>
              Configure a session to calculate it.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-gray-400" data-result-note>
              You will see duration, finish time, breaks, and schedule.
            </p>

            <div class="mt-5 grid grid-cols-2 gap-3" data-summary-grid></div>

            <div
              class="mt-4 hidden rounded-lg border border-amber-400/40 bg-amber-400/10 p-4 text-sm leading-relaxed text-amber-100"
              data-warning-panel
            ></div>

            <details class="mt-5 rounded-lg border border-gray-800 bg-gray-950/70 p-4" data-agenda-details>
              <summary class="cursor-pointer text-sm font-semibold text-white">
                Block schedule
              </summary>
              <ol class="mt-4 space-y-2" data-agenda-list></ol>
            </details>
          </aside>

        </div>
      </section>

      <div class="sticky bottom-3 z-20 mt-4 lg:hidden">
        <button class="primary-button w-full shadow-lg shadow-gray-950/50" type="button" data-mobile-calculate>
          Calculate plan
        </button>
      </div>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-6 md:py-8">
      <SectionIntro
        title="Three ways to plan"
        description="Choose a number of blocks, start from free time, or use a deadline when your schedule has a clear endpoint."
        class="mb-5"
      />
      <div class="grid gap-4 md:grid-cols-3">
        <article class="info-card">
          <h2 class="font-semibold text-white">Exact blocks</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Calculate how long a defined session takes and check its estimated
            end time before you begin.
          </p>
        </article>
        <article class="info-card">
          <h2 class="font-semibold text-white">Available time</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Turn a 30-minute gap, two free hours, or an entire morning into
            complete Pomodoros.
          </p>
        </article>
        <article class="info-card">
          <h2 class="font-semibold text-white">Copyable schedule</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            The summary includes duration, start time, end time, and breaks so
            you can paste it into a note or share it with your team.
          </p>
        </article>
      </div>
    </Container>

    <Container as="section" class="py-6 md:py-8">
      <section class="rounded-lg border border-gray-700 bg-gray-950 p-5 sm:p-6">
        <h2 class="text-2xl font-semibold">Breaks included in the plan</h2>
        <div class="mt-4 grid gap-4 text-sm leading-relaxed text-gray-400 md:grid-cols-2">
          <p>
            The schedule only adds breaks between focus blocks. If another
            Pomodoro does not fit after a break, that final break is not added.
          </p>
          <p>
            When a plan spans several hours, the calculator displays warnings
            so you can split it into more sustainable sessions.
          </p>
        </div>
      </section>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>

<style is:global>
  .field-label { display: block; font-size: .875rem; font-weight: 600; color: rgb(229 231 235); }
  .field, .field-shell { margin-top: .5rem; min-height: 3rem; min-width: 0; width: 100%; border-radius: .5rem; border: 1px solid rgb(55 65 81); background: rgb(17 24 39); color: white; outline: none; }
  .field { padding: 0 1rem; }
  .field-shell { display: flex; align-items: center; }
  .field-input { min-height: 2.875rem; min-width: 0; width: 100%; background: transparent; padding: 0 .25rem; color: white; outline: none; }
  .field-input-leading { padding-left: .75rem; }
  .field-affix { flex: none; padding: 0 .75rem; font-size: .875rem; color: rgb(156 163 175); }
  .field:focus, .field-shell:focus-within { border-color: rgb(251 191 36); box-shadow: 0 0 0 3px rgb(251 191 36 / .15); }
  .field[aria-invalid="true"], .field-shell:has(.field-input[aria-invalid="true"]) { border-color: rgb(248 113 113); }
  .segmented-option, .preset-button, .primary-button, .secondary-button { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; border-radius: .5rem; padding: .5rem .75rem; text-align: center; font-size: .875rem; font-weight: 700; transition: border-color .15s, background-color .15s, color .15s; }
  .segmented-option { cursor: pointer; color: rgb(209 213 219); }
  .segmented-option[data-active="true"] { background: rgb(251 191 36); color: rgb(3 7 18); }
  .preset-button, .secondary-button { border: 1px solid rgb(55 65 81); color: rgb(229 231 235); }
  .preset-button:hover, .secondary-button:hover { border-color: rgb(251 191 36 / .7); color: white; }
  .preset-button[aria-pressed="true"] { border-color: rgb(251 191 36); background: rgb(251 191 36 / .15); color: rgb(253 230 138); }
  .primary-button { background: rgb(251 191 36); color: rgb(3 7 18); }
  .primary-button:hover { background: rgb(252 211 77); }
  .primary-button:disabled, .secondary-button:disabled { cursor: not-allowed; opacity: .5; }
  .info-card { border-radius: .5rem; border: 1px solid rgb(55 65 81); background: rgb(3 7 18); padding: 1.25rem; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>

<script>
  import {
    POMODORO_PRESETS,
    PomodoroValidationError,
    buildPomodoroSummary,
    calculatePomodoroPlan,
    formatPomodoroDuration,
    parsePomodoroNumber,
  } from "@lib/calculators/fecha-tiempo/calculadora-pomodoro/pomodoro.en";

  const form = document.querySelector("[data-pomodoro-form]");
  const resultRegion = document.querySelector("[data-result-region]");
  const modeLabels = Array.from(document.querySelectorAll("[data-mode-label]"));
  const modeInputs = Array.from(document.querySelectorAll('input[name="pomodoro-mode"]'));
  const countField = document.querySelector("[data-pomodoro-count-field]");
  const availableField = document.querySelector("[data-available-time-field]");
  const errorBox = document.querySelector("[data-errors]");
  const warningPanel = document.querySelector("[data-warning-panel]");
  const agendaDetails = document.querySelector("[data-agenda-details]");
  const copyButton = document.querySelector("[data-copy-result]");
  const copyLabel = document.querySelector("[data-copy-label]");
  const copyStatus = document.querySelector("[data-copy-status]");
  const mobileCalculate = document.querySelector("[data-mobile-calculate]");
  const presetButtons = Array.from(document.querySelectorAll("[data-preset]"));

  const warningMessages = {
    long_session: "The plan exceeds four hours. Consider splitting it into sessions with a real pause between them.",
    very_long_session: "The plan exceeds eight hours. This is a long single focus session.",
    unrealistic_session: "The plan exceeds 12 hours. Consider splitting it across several days or adjusting breaks.",
    no_complete_pomodoro: "A complete focus block does not fit with these settings.",
  };
  const blockStyles = {
    focus: "border-amber-400/35 bg-amber-400/10 text-amber-50",
    "short-break": "border-sky-400/30 bg-sky-400/10 text-sky-50",
    "long-break": "border-emerald-400/30 bg-emerald-400/10 text-emerald-50",
  };
  let currentResult = null;
  let copyText = "";

  function getField(name) {
    return document.querySelector(`[data-field="${name}"]`);
  }

  function getMode() {
    return modeInputs.find((input) => input.checked)?.value ?? "pomodoros";
  }

  function updateModeUi() {
    const mode = getMode();

    modeLabels.forEach((label) => {
      label.dataset.active = String(label.dataset.modeLabel === mode);
    });
    countField.classList.toggle("hidden", mode !== "pomodoros");
    availableField.classList.toggle("hidden", mode !== "time");
  }

  function setMode(mode) {
    modeInputs.forEach((input) => {
      input.checked = input.value === mode;
    });
    updateModeUi();

  }

  function readIntegerField(name, label, min, max, errors) {
    const input = getField(name);
    const parsed = parsePomodoroNumber(input.value);

    if (!parsed.ok || parsed.value < min || parsed.value > max) {
      input.setAttribute("aria-invalid", "true");
      errors.push(`${label} must be between ${min} and ${max}.`);
      return 0;
    }

    input.removeAttribute("aria-invalid");
    return parsed.value;
  }

  function readInput() {
    const errors = [];
    const mode = getMode();
    const deadlineTime = getField("deadlineTime").value || undefined;
    const startTime = getField("startTime").value || undefined;
    const focusMinutes = readIntegerField("focusMinutes", "Focus", 1, 120, errors);
    const shortBreakMinutes = readIntegerField("shortBreakMinutes", "Short break", 0, 60, errors);
    const longBreakMinutes = readIntegerField("longBreakMinutes", "Long break", 0, 120, errors);
    const longBreakEvery = readIntegerField("longBreakEvery", "Long break every", 1, 20, errors);
    const input = {
      mode,
      focusMinutes,
      shortBreakMinutes,
      longBreakMinutes,
      longBreakEvery,
      startTime,
      deadlineTime,
    };

    getField("pomodoros").removeAttribute("aria-invalid");
    getField("availableHours").removeAttribute("aria-invalid");
    getField("availableMinutes").removeAttribute("aria-invalid");

    if (mode === "pomodoros") {
      input.pomodoros = readIntegerField("pomodoros", "Pomodoros", 1, 50, errors);
    } else if (!deadlineTime) {
      const hours = readIntegerField("availableHours", "Available hours", 0, 12, errors);
      const minutes = readIntegerField("availableMinutes", "Available minutes", 0, 59, errors);
      const availableMinutes = hours * 60 + minutes;

      if (availableMinutes < 1 || availableMinutes > 720) {
        errors.push("Available time must be between one minute and 12 hours.");
        getField("availableHours").setAttribute("aria-invalid", "true");
        getField("availableMinutes").setAttribute("aria-invalid", "true");
      }

      input.availableMinutes = availableMinutes;
    }

    return { input, errors };
  }

  function calculate({ scroll = false } = {}) {
    const parsed = readInput();

    if (parsed.errors.length) {
      showErrors(parsed.errors);
      setCopyEnabled(false);
      return;
    }

    try {
      currentResult = calculatePomodoroPlan(parsed.input);
      copyText = buildPomodoroSummary(currentResult);
      showErrors([]);
      renderResult(currentResult);
      setCopyEnabled(true);

      if (scroll) {
        resultRegion.focus({ preventScroll: true });
        resultRegion.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
          block: "start",
        });
      }
    } catch (error) {
      const message =
        error instanceof PomodoroValidationError
          ? error.message
          : "The plan could not be calculated. Review the entered data.";

      showErrors([message]);
      setCopyEnabled(false);
    }
  }

  function renderResult(result) {
    const hasPomodoros = result.pomodoros > 0;

    document.querySelector("[data-result-kicker]").textContent =
      result.mode === "time" ? "Possible pomodoros" : "Estimated plan";
    document.querySelector("[data-main-result]").textContent = hasPomodoros
      ? formatPomodoroDuration(result.totalMinutes)
      : "No complete block";
    document.querySelector("[data-result-subtitle]").textContent = subtitleFor(result);
    document.querySelector("[data-result-note]").textContent = noteFor(result);
    document.querySelector("[data-summary-grid]").innerHTML = [
      ["Pomodoros", String(result.pomodoros)],
      ["Total focus", formatPomodoroDuration(result.focusTotalMinutes)],
      ["Breaks", formatPomodoroDuration(result.breakTotalMinutes)],
      [
        result.mode === "time" ? "Unused time" : "Deadline",
        result.mode === "time"
          ? formatPomodoroDuration(result.unusedMinutes ?? 0)
          : deadlineLabel(result),
      ],
    ].map(([label, value]) => summaryCard(label, value)).join("");

    const warnings = result.warnings.map((warning) => warningMessages[warning.code]);
    warningPanel.innerHTML = warnings.map((message) => `<p>${escapeHtml(message)}</p>`).join("");
    warningPanel.classList.toggle("hidden", warnings.length === 0);

    renderAgenda(result);
  }

  function subtitleFor(result) {
    if (result.pomodoros === 0) {
      return `The configured focus block is ${result.focusMinutes} min.`;
    }

    if (result.deadline) {
      return deadlineLabel(result);
    }

    if (result.endTime) {
      return `Finishes at ${result.endTime}.`;
    }

    return `${result.pomodoros} ${result.pomodoros === 1 ? "complete pomodoro" : "complete pomodoros"}.`;
  }

  function noteFor(result) {
    const parts = [
      `${formatPomodoroDuration(result.focusTotalMinutes)} of focus`,
      `${result.shortBreaks} short breaks`,
      `${result.longBreaks} long breaks`,
    ];

    if (result.mode === "time" && result.availableMinutes !== undefined) {
      parts.push(`${formatPomodoroDuration(result.availableMinutes)} available`);
    }

    return parts.join(" · ");
  }


  function deadlineLabel(result) {
    if (!result.deadline) return "No deadline";

    if (result.deadline.status === "on_time") {
      return `Finishes on time · ${formatPomodoroDuration(result.deadline.differenceMinutes)}`;
    }

    return `Runs over by ${formatPomodoroDuration(Math.abs(result.deadline.differenceMinutes))}`;
  }

  function renderAgenda(result) {
    const list = document.querySelector("[data-agenda-list]");

    agendaDetails.open = result.blocks.length <= 10;
    list.innerHTML = result.blocks.length
      ? result.blocks.map((block) => `
          <li class="rounded-lg border p-3 ${blockStyles[block.type]}">
            <div class="flex items-start justify-between gap-3">
              <span class="font-semibold">${escapeHtml(block.label)}</span>
              <span class="shrink-0 text-sm">${escapeHtml(formatPomodoroDuration(block.durationMinutes))}</span>
            </div>
            <p class="mt-1 text-xs opacity-80">
              ${block.startTime && block.endTime
                ? `${escapeHtml(block.startTime)}-${escapeHtml(block.endTime)}`
                : `${escapeHtml(formatPomodoroDuration(block.elapsedStartMinutes))}-${escapeHtml(formatPomodoroDuration(block.elapsedEndMinutes))}`}
            </p>
          </li>
        `).join("")
      : '<li class="rounded-lg border border-gray-800 bg-gray-950 p-3 text-sm text-gray-400">Adjust the available time or shorten the focus duration.</li>';
  }

  function showErrors(messages) {
    errorBox.innerHTML = messages.map((message) => `<p>${escapeHtml(message)}</p>`).join("");
    errorBox.classList.toggle("hidden", messages.length === 0);

    if (messages.length) {
      errorBox.focus();
    }
  }

  function setCopyEnabled(enabled) {
    copyButton.disabled = !enabled;
  }

  async function copyResult() {
    if (!copyText) return;

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(copyText);
      } else {
        const textArea = document.createElement("textarea");
        textArea.value = copyText;
        textArea.setAttribute("readonly", "");
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.append(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
      }

      copyLabel.textContent = "Copied";
      copyStatus.textContent = "Summary copied.";
      window.setTimeout(() => {
        copyLabel.textContent = "Copy summary";
        copyStatus.textContent = "";
      }, 2000);
    } catch {
      copyStatus.textContent = "The summary could not be copied.";
    }
  }

  function setPreset(name) {
    if (name !== "custom") {
      const preset = POMODORO_PRESETS[name];

      getField("focusMinutes").value = String(preset.focusMinutes);
      getField("shortBreakMinutes").value = String(preset.shortBreakMinutes);
      getField("longBreakMinutes").value = String(preset.longBreakMinutes);
      getField("longBreakEvery").value = String(preset.longBreakEvery);
    }

    presetButtons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.preset === name));
    });
    calculate();
  }

  function markCustomPreset() {
    presetButtons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.preset === "custom"));
    });
  }

  function setCurrentStartTime() {
    const now = new Date();
    getField("startTime").value = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
  }

  function clearForm() {
    setMode("pomodoros");
    getField("pomodoros").value = "4";
    getField("availableHours").value = "2";
    getField("availableMinutes").value = "0";
    getField("deadlineTime").value = "";
    setCurrentStartTime();
    setPreset("classic");
    showErrors([]);
  }

  function summaryCard(label, value) {
    return `<div class="rounded-lg border border-gray-800 bg-gray-950/70 p-3"><span class="block text-xs font-semibold uppercase tracking-wide text-gray-500">${escapeHtml(label)}</span><span class="mt-2 block break-words text-base font-semibold text-white">${escapeHtml(value)}</span></div>`;
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  modeInputs.forEach((input) => {
    input.addEventListener("change", () => {
      updateModeUi();
      calculate();
    });
  });
  presetButtons.forEach((button) => {
    button.addEventListener("click", () => setPreset(button.dataset.preset));
  });
  ["focusMinutes", "shortBreakMinutes", "longBreakMinutes", "longBreakEvery"].forEach((field) => {
    getField(field).addEventListener("input", () => {
      markCustomPreset();
      calculate();
    });
  });
  form.addEventListener("input", (event) => {
    if (event.target.matches("[data-field]")) calculate();
  });
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    calculate({ scroll: true });
  });
  copyButton.addEventListener("click", copyResult);
  mobileCalculate.addEventListener("click", () => calculate({ scroll: true }));
  document.querySelector("[data-clear]").addEventListener("click", clearForm);


  updateModeUi();
  setCurrentStartTime();
  calculate();
</script>
