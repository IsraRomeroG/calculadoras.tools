---
import AdSlot from "@components/ads/AdSlot.astro";
import AttendanceCalculator from "@components/calculators/AttendanceCalculator.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { ATTENDANCE_CANONICAL_PATH } from "@lib/calculators/matematicas/calculadora-porcentaje-asistencia-escolar/attendance.en";
import { buildAlternateLinks } from "@lib/i18n/routing";
import { buildFaqJsonLd } from "@lib/seo";

const title = "School attendance percentage calculator";
const description = "Calculate your school attendance percentage and, if you know the remaining classes or the course total, estimate available absences and required attendances.";
const canonical = ATTENDANCE_CANONICAL_PATH;
const spanishCanonical = "/matematicas/calculadora-porcentaje-asistencia-escolar";
const alternates = buildAlternateLinks({ es: spanishCanonical, en: canonical }, Astro.site ?? Astro.url);
const faqs = [
  { question: "How is attendance percentage calculated?", answer: "Divide attended classes by classes held so far and multiply by 100. Future classes are not part of the current percentage." },
  { question: "How many absences can I have?", answer: "Enter how many classes remain to estimate future absences. The margin assumes you attend the other classes and is calculated for the end of the course." },
  { question: "What happens if I am below the minimum?", answer: "The theoretical recovery shows how many consecutive classes would reach the current minimum. The final projection separately checks whether they fit within the entered schedule." },
  { question: "Can I enter remaining classes or the course total?", answer: "Yes. You only need one of those quantities, in addition to the classes held so far. Leave it blank if you do not know it; enter 0 for remaining classes only when the course is finished." },
  { question: "What does it mean when the minimum can no longer be reached?", answer: "It means that attending every remaining class would still leave the final percentage below the requirement." },
  { question: "Do excused absences count toward the percentage?", answer: "All entered absences count equally in this base calculation. Check your school's rules for excused absences and late arrivals." },
  { question: "Why does the displayed percentage match the minimum but say I am below it?", answer: "The display rounds percentages for readability, while the decision uses the exact fraction and the full minimum you entered." },
  { question: "Does meeting the minimum now guarantee meeting it at the end?", answer: "Not always. Current attendance and the final projection are separate states. A guarantee appears only after you already have the minimum attendances for the entered final total." },
];
const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical} locale="en" alternates={alternates}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} /></Fragment>
  <PageShell>
    <PageHero
      title="School attendance calculator"
      description="Calculate current attendance from classes held so far and either attendances or absences. For a final-course projection, enter remaining classes or the course total."
      kicker="Math"
      collapseBreadcrumbOnMobile
      containerClass="py-6 md:py-8"
      breadcrumbs={[{ label: "Home", href: "/en", ariaLabel: "Home" }, { label: "Math", href: "/en/math", optional: true }, { label: "School attendance", truncate: true }]}
    />
    <AttendanceCalculator locale="en" />
    <AdSlot placement="calculator-after-tool" />
    <Container as="section" class="py-6 md:py-8">
      <SectionIntro title="How attendance is calculated" description="Current attendance and the final projection answer different questions. Every class has equal weight." />
      <div class="grid gap-4 lg:grid-cols-2">
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
          <h2 class="text-lg font-semibold text-white">Formulas</h2>
          <ol class="mt-3 list-decimal space-y-3 pl-5 text-sm leading-relaxed text-gray-300">
            <li>Current attendance = attended ÷ classes held so far × 100.</li>
            <li>Course total = held so far + remaining; if you know the total, remaining = course total − held so far.</li>
            <li>Minimum final attendances = ceiling(course total × minimum ÷ 100), rounding that fraction up.</li>
            <li>Subtract current attendances to find how many are still needed. If that exceeds the remaining classes, the requirement cannot be met within that schedule.</li>
            <li>Maximum total absences = course total − minimum final attendances. Future absences available start with that maximum minus accumulated absences, capped by the remaining classes.</li>
            <li>Recovering the minimum today counts consecutive classes against the classes held so far; meeting it at the end uses the course total and the remaining-class schedule.</li>
          </ol>
        </article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5">
          <h2 class="text-lg font-semibold text-white">Worked example</h2>
          <p class="mt-3 text-sm leading-relaxed text-gray-300">With 40 classes held so far, 34 attendances, an 80% minimum and 10 remaining classes—or a course total of 50—current attendance is 85%. At least 40 attendances are required at the end. You need 6 more attendances, so you may miss 4 of the 10 remaining classes if you attend the other 6. This margin is calculated for the end: the minimum is not guaranteed at every intermediate point and the percentage may fall temporarily. The display may round percentages for readability; that formatting is not your school's rounding rule.</p>
        </article>
      </div>
      <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5"><h3 class="font-semibold text-white">Accumulated absences</h3><p class="mt-2 text-sm text-gray-400">Absences already recorded among classes held so far.</p></article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5"><h3 class="font-semibold text-white">Maximum total absences</h3><p class="mt-2 text-sm text-gray-400">The maximum number of absences allowed in the final total while still reaching the minimum.</p></article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5"><h3 class="font-semibold text-white">Future absences available</h3><p class="mt-2 text-sm text-gray-400">Possible absences among remaining classes, provided you attend the others.</p></article>
        <article class="rounded-lg border border-gray-700 bg-gray-950 p-5"><h3 class="font-semibold text-white">Theoretical recovery</h3><p class="mt-2 text-sm text-gray-400">Adds attended classes to the current total to reach today's minimum; it is not the need within a fixed final schedule.</p></article>
      </div>
    </Container>
    <FaqSection faqs={faqs} />
  </PageShell>
</BaseLayout>
