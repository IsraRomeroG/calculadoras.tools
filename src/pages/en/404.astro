---
import BaseLayout from "@layouts/BaseLayout.astro";
import robot404Url from "../../svg/404 robot-cuate.svg?url";
import Breadcrumb from "@components/shared/Breadcrumb.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import Button from "@components/shared/Button.astro";
---

<BaseLayout
  locale="en"
  title="Page not found"
  description="We could not find the page you were looking for on calculadoras.tools."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <PageShell>
    <section>
      <Container class="px-6 py-10">
        <Breadcrumb
          locale="en"
          class="mb-8"
          items={[
            { label: "Home", href: "/en", ariaLabel: "Home" },
            { label: "404 error" },
          ]}
        />
        <div class="order-2 text-center md:order-1 md:text-left">
          <div class="order-1 md:order-2">
            <img
              src={robot404Url}
              alt="Robot next to the number 404"
              class="mx-auto w-full max-w-160"
              loading="eager"
              decoding="async"
            />
          </div>
          <h1
            class="mt-4 text-4xl font-bold leading-tight text-center tracking-tight text-white sm:text-5xl md:text-6xl"
          >
            This page does not exist
          </h1>

          <p
            class="mx-auto mt-5 text-base text-center leading-relaxed text-gray-400 md:mx-0"
          >
            The address may have changed, the link may be incomplete, or the
            page may no longer be available.
          </p>

          <div class="mt-8 flex flex-col gap-3 md:flex-row justify-center">
            <Button href="/en" size="lg">
              Back to home
            </Button>
            <Button
              href="/en#calculadoras"
              variant="secondary"
              size="lg"
              class="hover:border-gray-500 hover:bg-gray-800"
            >
              View calculators
            </Button>
          </div>
        </div>
      </Container>
    </section>
  </PageShell>
</BaseLayout>
