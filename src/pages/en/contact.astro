---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import Button from "@components/shared/Button.astro";
import PageHero from "@components/shared/PageHero.astro";
import Panel from "@components/shared/Panel.astro";
import { buildAlternateLinks } from "@lib/i18n/routing";

const description =
  "Send suggestions, report errors, or propose new calculators to calculadoras.tools through the contact form.";
const canonical = "/en/contact";
const alternates = buildAlternateLinks(
  { es: "/contacto", en: canonical },
  Astro.site ?? Astro.url,
);
---

<BaseLayout
  locale="en"
  title="Contact form"
  description={description}
  canonical={canonical}
  alternates={alternates}
>
  <PageShell>
    <PageHero
      locale="en"
      title="Contact"
      description="If you have a suggestion, found an error, or want to propose a new calculator, send us a message. We read every submission carefully."
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Contact" },
      ]}
      containerClass="px-6 py-10"
      breadcrumbClass="mb-8"
      titleClass="text-4xl font-bold tracking-tight md:text-6xl"
      descriptionClass="mt-6 text-lg leading-relaxed text-gray-400"
    />

    <Container as="section" class="px-6 py-14">
      <div class="grid gap-8 md:grid-cols-[0.9fr_1.1fr]">
        <div class="space-y-6">
          <div class="py-4">
            <h2 class="text-2xl font-semibold">Let's talk</h2>
            <p class="mt-3 text-gray-400">
              Use the form to send us your message.
            </p>
          </div>

          <Panel>
            <h2 class="text-lg font-semibold">Help us respond effectively</h2>
            <ul class="mt-4 space-y-3 text-sm text-gray-400">
              <li>Include the related calculator or page.</li>
              <li>Describe the expected result and the result you received.</li>
              <li>
                Share numerical examples if your message is about a
                calculation.
              </li>
            </ul>
          </Panel>
        </div>

        <Panel
          as="form"
          id="contact-form"
          padding="lg"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input
            type="hidden"
            name="access_key"
            value="4bae11ff-c274-4cac-9167-e10c62dab084"
          />
          <input
            type="hidden"
            name="subject"
            value="New message from calculadoras.tools"
          />
          <input type="hidden" name="from_name" value="calculadoras.tools" />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            tabindex="-1"
            autocomplete="off"
          />

          <div class="grid gap-5">
            <label class="block">
              <span class="text-sm font-medium text-gray-300">Name</span>
              <input
                class="mt-2 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-gray-100 outline-none transition placeholder:text-gray-500 focus:border-amber-400"
                type="text"
                name="name"
                autocomplete="name"
                placeholder="Your name"
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium text-gray-300">Email</span>
              <input
                class="mt-2 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-gray-100 outline-none transition placeholder:text-gray-500 focus:border-amber-400"
                type="email"
                name="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium text-gray-300">Message</span>
              <textarea
                class="mt-2 min-h-40 w-full resize-y rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-gray-100 outline-none transition placeholder:text-gray-500 focus:border-amber-400"
                name="message"
                placeholder="Tell us how we can help"
                required></textarea>
            </label>

            <div class="overflow-x-auto">
              <div
                class="h-captcha"
                data-captcha="true"
                data-lang="en"
                data-theme="dark"
              >
              </div>
            </div>

            <Button
              type="submit"
              class="text-gray-900 hover:bg-gray-700 hover:text-white"
            >
              Send message
            </Button>
          </div>
        </Panel>
      </div>
    </Container>
  </PageShell>

  <script src="https://web3forms.com/client/script.js" async defer></script>
  <script>
    const form = document.getElementById("contact-form");

    form?.addEventListener("submit", (event) => {
      const hCaptchaResponse = form.querySelector<HTMLTextAreaElement>(
        'textarea[name="h-captcha-response"]',
      );

      if (!hCaptchaResponse?.value) {
        event.preventDefault();
        alert("Please complete the captcha before sending your message.");
      }
    });
  </script>
</BaseLayout>
