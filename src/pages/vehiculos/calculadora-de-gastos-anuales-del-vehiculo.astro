---
import AdSlot from "@components/ads/AdSlot.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import FaqSection from "@components/shared/FaqSection.astro";
import PageHero from "@components/shared/PageHero.astro";
import SectionIntro from "@components/shared/SectionIntro.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  VEHICLE_ANNUAL_COSTS_CANONICAL_PATH,
} from "@lib/calculators/vehiculos/calculadora-de-gastos-anuales-del-vehiculo/vehicleAnnualCosts";
import { buildFaqJsonLd } from "@lib/seo";

const title = "Calculadora de gastos anuales del vehiculo";
const description =
  "Estima cuanto cuesta mantener y usar un vehiculo al ano, al mes y por kilometro con gastos editables y reserva mensual sugerida.";
const canonical = VEHICLE_ANNUAL_COSTS_CANONICAL_PATH;

const faqs = [
  {
    question: "Que gastos conviene incluir?",
    answer:
      "Incluye servicios, llantas, seguro, impuestos, verificacion, reparaciones, estacionamiento, peajes, lavado y cualquier otro gasto recurrente o periodico del vehiculo.",
  },
  {
    question: "Que diferencia hay entre costo promedio y reserva practica?",
    answer:
      "El costo promedio reparte eventos parciales durante el ano. La reserva practica redondea eventos por meses o kilometraje hacia arriba para planear con un margen conservador.",
  },
  {
    question: "Por que pide kilometros anuales?",
    answer:
      "Los kilometros permiten convertir servicios o llantas cada cierto kilometraje a eventos estimados por ano y calcular costo por kilometro.",
  },
  {
    question: "La calculadora incluye combustible?",
    answer:
      "No lo calcula automaticamente en el MVP. Puedes agregar combustible manualmente como partida o usar la calculadora de consumo y costo por kilometro relacionada.",
  },
  {
    question: "La calculadora estima depreciacion?",
    answer:
      "No. La depreciacion depende de valor de compra, edad, mercado y estado del vehiculo. Puedes agregarla manualmente como partida si quieres aproximar costo total.",
  },
  {
    question: "Se guardan mis datos?",
    answer:
      "El autoguardado usa localStorage en tu navegador. No se envian datos a un servidor ni se sincronizan entre dispositivos.",
  },
];

const faqJsonLd = buildFaqJsonLd(faqs);
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <PageShell>
    <PageHero
      title={title}
      description="Convierte servicios, seguro, llantas, impuestos y otros gastos irregulares en una reserva mensual clara."
      kicker="Vehiculos"
      collapseBreadcrumbOnMobile
      containerClass="py-5 md:py-7"
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Vehiculos", href: "/vehiculos", optional: true },
        { label: "Gastos anuales", truncate: true },
      ]}
    />

    <Container as="section" class="py-4 md:py-8">
      <section
        id="vehicle-annual-costs-calculator"
        class="overflow-hidden rounded-lg border border-gray-700 bg-gray-950 shadow-xl shadow-gray-950/30"
        aria-labelledby="calculator-heading"
      >
        <form
          class="grid lg:grid-cols-[minmax(0,1.08fr)_minmax(21rem,0.92fr)]"
          novalidate
          data-vehicle-cost-form
        >
          <aside
            class="order-first border-b border-gray-800 bg-gray-900/70 p-4 sm:p-6 lg:order-last lg:sticky lg:top-4 lg:min-h-screen lg:border-b-0 lg:border-l"
            aria-live="polite"
            data-result-region
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-emerald-300" data-result-kicker>
              Reserva mensual
            </p>
            <p class="mt-3 min-h-[3.25rem] break-words text-4xl font-bold leading-tight text-white" data-main-result>
              Agrega gastos
            </p>
            <p class="mt-2 text-sm font-semibold text-emerald-100" data-result-subtitle>
              Captura importes para estimar.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-gray-400" data-result-note>
              Los importes vacios cuentan como cero y quedan marcados como incompletos.
            </p>
            <p class="sr-only" role="status" aria-live="polite" data-live-summary></p>

            <div class="mt-5 grid grid-cols-2 gap-3" data-summary-grid></div>

            <details class="mt-5 rounded-lg border border-gray-800 bg-gray-950/70 p-4" open data-group-section>
              <summary class="cursor-pointer list-none text-sm font-semibold text-white">
                Mantenimiento, propiedad y uso
              </summary>
              <div class="mt-3 grid gap-2" data-group-breakdown></div>
            </details>

            <details class="mt-3 rounded-lg border border-gray-800 bg-gray-950/70 p-4" data-category-section>
              <summary class="cursor-pointer list-none text-sm font-semibold text-white">
                Categorias y partidas altas
              </summary>
              <div class="mt-3 grid gap-2" data-category-breakdown></div>
              <h3 class="mt-5 text-sm font-semibold text-white">Partidas mas altas</h3>
              <div class="mt-3 grid gap-2" data-top-items></div>
            </details>

            <section
              class="mt-5 hidden rounded-lg border border-amber-300/25 bg-amber-300/10 p-4 text-sm leading-relaxed text-amber-100"
              data-practical-section
            >
              <h3 class="font-semibold text-amber-50">Reserva conservadora</h3>
              <div class="mt-2 grid gap-2" data-practical-list></div>
            </section>

            <div
              class="mt-5 hidden rounded-lg border border-red-300/30 bg-red-300/10 p-3 text-sm leading-relaxed text-red-100"
              role="alert"
              data-errors
            ></div>

            <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
              <button class="vehicle-primary-button" type="button" disabled data-copy-result>
                <span data-copy-label>Copiar resumen</span>
              </button>
              <button class="vehicle-secondary-button" type="button" disabled data-export-csv>
                Exportar CSV
              </button>
              <button class="vehicle-secondary-button" type="button" data-example>
                Probar ejemplo
              </button>
              <button class="vehicle-quiet-button" type="button" data-clear>
                Limpiar formulario
              </button>
            </div>
            <p class="mt-3 min-h-5 text-sm text-emerald-100" role="status" aria-live="polite" data-action-status></p>
          </aside>

          <section class="p-4 sm:p-6 lg:col-start-1 lg:row-start-1">
            <p class="text-sm font-semibold uppercase tracking-wide text-emerald-300">
              Datos del vehiculo
            </p>
            <h2 id="calculator-heading" class="mt-2 text-2xl font-semibold text-white">
              Presupuesto anual editable
            </h2>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div>
                <label class="vehicle-field-label" for="vehicle-name">
                  Nombre del vehiculo
                </label>
                <input
                  id="vehicle-name"
                  class="vehicle-field mt-2"
                  type="text"
                  maxlength="80"
                  autocomplete="off"
                  placeholder="Auto familiar"
                  data-project-field="vehicleName"
                />
              </div>

              <div>
                <label class="vehicle-field-label" for="vehicle-currency">
                  Moneda
                </label>
                <select id="vehicle-currency" class="vehicle-field mt-2" data-project-field="currency">
                  <option value="MXN">MXN</option>
                  <option value="USD">USD</option>
                  <option value="EUR">EUR</option>
                  <option value="COP">COP</option>
                  <option value="CLP">CLP</option>
                  <option value="ARS">ARS</option>
                  <option value="PEN">PEN</option>
                </select>
              </div>

              <div class="sm:col-span-2">
                <label class="vehicle-field-label" for="annual-kilometers">
                  Kilometros anuales
                </label>
                <div class="vehicle-field-shell">
                  <input
                    id="annual-kilometers"
                    class="vehicle-field-input text-xl font-semibold"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder="15000"
                    data-project-field="annualKilometers"
                    data-field-error-target="annualKilometers"
                  />
                  <span class="vehicle-field-affix">km/ano</span>
                </div>
                <p class="vehicle-field-error" data-field-error="annualKilometers"></p>
              </div>
            </div>

            <section class="vehicle-item-section mt-7">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <h3 class="text-lg font-semibold text-white">Gastos</h3>
                  <p class="mt-1 text-sm text-gray-400">
                    Servicios, llantas, seguro, impuestos, reparaciones y uso diario.
                  </p>
                </div>
                <div class="grid gap-2 sm:grid-cols-2">
                  <button class="vehicle-secondary-button" type="button" data-add-item>
                    Agregar gasto
                  </button>
                  <button class="vehicle-secondary-button" type="button" data-add-suggested>
                    Agregar conceptos
                  </button>
                </div>
              </div>

              <div class="mt-4 grid gap-3" data-item-list></div>
              <p class="mt-3 text-sm text-gray-500">
                Autoguardado local en este navegador. No se envian datos a servidores.
              </p>
            </section>
          </section>
        </form>
      </section>
    </Container>

    <AdSlot placement="calculator-after-tool" />

    <Container as="section" class="py-6 md:py-8">
      <SectionIntro
        title="Que significa la reserva mensual"
        description="El promedio anual reparte los gastos como estimacion. La reserva mensual sugerida usa eventos redondeados para planear servicios o cambios que podrian caer completos en el ano."
        class="mb-5"
      />
      <div class="grid gap-4 md:grid-cols-3">
        <article class="vehicle-info-card">
          <h2 class="font-semibold text-white">Mantenimiento</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Servicios, llantas, bateria, reparaciones y refacciones que dependen del uso o del paso del tiempo.
          </p>
        </article>
        <article class="vehicle-info-card">
          <h2 class="font-semibold text-white">Propiedad</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Seguro, impuestos, refrendo, verificacion o cargos que pagas por tener el vehiculo.
          </p>
        </article>
        <article class="vehicle-info-card">
          <h2 class="font-semibold text-white">Uso</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Estacionamiento, peajes, lavado, accesorios y otros gastos cotidianos capturados manualmente.
          </p>
        </article>
      </div>
    </Container>

    <Container as="section" class="py-6 md:py-8">
      <section class="rounded-lg border border-gray-700 bg-gray-950 p-5 sm:p-6">
        <h2 class="text-2xl font-semibold text-white">Calculadoras relacionadas</h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-gray-400">
          Este MVP no calcula combustible ni depreciacion automaticamente para no mezclar supuestos. Puedes estimarlos aparte y agregarlos como partidas si buscas una vista mas completa.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a class="vehicle-secondary-button" href="/vehiculos/calculadora-de-consumo-de-gasolina">
            Consumo de gasolina
          </a>
          <a class="vehicle-secondary-button" href="/vehiculos/calculadora-de-costo-por-kilometro">
            Costo por kilometro
          </a>
          <a class="vehicle-secondary-button" href="/vehiculos/calculadora-de-depreciacion-del-vehiculo">
            Depreciacion
          </a>
        </div>
      </section>
    </Container>

    <FaqSection faqs={faqs} />
  </PageShell>

  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-gray-700 bg-gray-950/95 px-3 py-3 shadow-2xl shadow-gray-950/60 backdrop-blur lg:hidden" data-mobile-summary>
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500" data-mobile-kicker>Reserva mensual</p>
        <p class="truncate text-lg font-bold text-white" data-mobile-total>Agrega gastos</p>
      </div>
      <p class="max-w-[48%] text-right text-xs font-semibold leading-snug text-gray-300" data-mobile-status>
        Completa importes.
      </p>
    </div>
  </div>
  <div class="h-20 lg:hidden"></div>
</BaseLayout>

<style is:global>
  .vehicle-field-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    color: rgb(229 231 235);
  }

  .vehicle-field,
  .vehicle-field-shell {
    min-height: 3rem;
    width: 100%;
    min-width: 0;
    border-radius: 0.5rem;
    border: 1px solid rgb(55 65 81);
    background: rgb(17 24 39);
    color: white;
    outline: none;
  }

  .vehicle-field {
    padding: 0 0.875rem;
  }

  .vehicle-field-shell {
    display: flex;
    align-items: center;
    margin-top: 0.5rem;
  }

  .vehicle-field-input {
    min-height: 2.875rem;
    min-width: 0;
    width: 100%;
    background: transparent;
    padding: 0 0.25rem 0 0.875rem;
    color: white;
    outline: none;
  }

  .vehicle-field-affix {
    flex: none;
    padding: 0 0.75rem;
    color: rgb(156 163 175);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .vehicle-field:focus,
  .vehicle-field-shell:focus-within {
    border-color: rgb(110 231 183);
    box-shadow: 0 0 0 3px rgb(110 231 183 / 0.14);
  }

  .vehicle-field[aria-invalid="true"],
  .vehicle-field-input[aria-invalid="true"] {
    border-color: rgb(252 165 165);
  }

  .vehicle-field-error {
    min-height: 1.125rem;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: rgb(252 165 165);
  }

  .vehicle-primary-button,
  .vehicle-secondary-button,
  .vehicle-quiet-button,
  .vehicle-item-action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    padding: 0.55rem 0.9rem;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 700;
    transition: border-color 150ms, background-color 150ms, color 150ms, opacity 150ms;
  }

  .vehicle-primary-button {
    background: rgb(110 231 183);
    color: rgb(3 7 18);
  }

  .vehicle-primary-button:hover {
    background: rgb(167 243 208);
  }

  .vehicle-secondary-button,
  .vehicle-item-action {
    border: 1px solid rgb(75 85 99);
    color: rgb(229 231 235);
  }

  .vehicle-secondary-button:hover,
  .vehicle-item-action:hover {
    border-color: rgb(110 231 183 / 0.8);
    color: white;
  }

  .vehicle-quiet-button {
    color: rgb(156 163 175);
  }

  .vehicle-quiet-button:hover {
    color: rgb(254 202 202);
  }

  .vehicle-primary-button:disabled,
  .vehicle-secondary-button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .vehicle-item-action-danger {
    border-color: rgb(248 113 113 / 0.45);
    color: rgb(254 202 202);
  }

  .vehicle-item-section,
  .vehicle-info-card {
    border-radius: 0.5rem;
    border: 1px solid rgb(55 65 81);
    background: rgb(3 7 18);
    padding: 1rem;
  }

  @media (min-width: 640px) {
    .vehicle-item-section,
    .vehicle-info-card {
      padding: 1.25rem;
    }
  }
</style>

<script>
  import {
    DEFAULT_CATEGORY_GROUP,
    VEHICLE_ANNUAL_COST_CATEGORIES,
    VEHICLE_ANNUAL_COST_CATEGORY_LABELS,
    VEHICLE_ANNUAL_COST_FREQUENCIES,
    VEHICLE_ANNUAL_COST_FREQUENCY_LABELS,
    VEHICLE_ANNUAL_COST_GROUPS,
    VEHICLE_ANNUAL_COST_GROUP_LABELS,
    buildVehicleAnnualCostsCsv,
    buildVehicleAnnualCostsShareText,
    calculateVehicleAnnualCosts,
    formatVehicleAnnualCostCurrency,
    formatVehicleAnnualCostNumber,
    parseVehicleAnnualCostNumberInput,
  } from "@lib/calculators/vehiculos/calculadora-de-gastos-anuales-del-vehiculo/vehicleAnnualCosts";

  const MAX_ITEMS = 100;
  const STORAGE_KEY = "calculadoras.tools.vehicleAnnualCosts.v1";
  const CURRENCIES = ["MXN", "USD", "EUR", "COP", "CLP", "ARS", "PEN"];
  const defaultProject = {
    vehicleName: "",
    annualKilometers: "",
    currency: "MXN",
  };

  const form = document.querySelector("[data-vehicle-cost-form]");
  const projectFields = {
    vehicleName: document.querySelector('[data-project-field="vehicleName"]'),
    annualKilometers: document.querySelector('[data-project-field="annualKilometers"]'),
    currency: document.querySelector('[data-project-field="currency"]'),
  };
  const itemList = document.querySelector("[data-item-list]");
  const resultKicker = document.querySelector("[data-result-kicker]");
  const mainResult = document.querySelector("[data-main-result]");
  const resultSubtitle = document.querySelector("[data-result-subtitle]");
  const resultNote = document.querySelector("[data-result-note]");
  const liveSummary = document.querySelector("[data-live-summary]");
  const summaryGrid = document.querySelector("[data-summary-grid]");
  const groupBreakdown = document.querySelector("[data-group-breakdown]");
  const categoryBreakdown = document.querySelector("[data-category-breakdown]");
  const topItems = document.querySelector("[data-top-items]");
  const practicalSection = document.querySelector("[data-practical-section]");
  const practicalList = document.querySelector("[data-practical-list]");
  const errorsBox = document.querySelector("[data-errors]");
  const copyButton = document.querySelector("[data-copy-result]");
  const copyLabel = document.querySelector("[data-copy-label]");
  const exportButton = document.querySelector("[data-export-csv]");
  const actionStatus = document.querySelector("[data-action-status]");
  const mobileKicker = document.querySelector("[data-mobile-kicker]");
  const mobileTotal = document.querySelector("[data-mobile-total]");
  const mobileStatus = document.querySelector("[data-mobile-status]");

  let project = { ...defaultProject };
  let sequence = 0;
  let items = [
    createBlankItem({ name: "Servicio", category: "servicio", group: "mantenimiento" }),
    createBlankItem({ name: "Seguro", category: "seguro", group: "propiedad" }),
  ];
  let currentResult = null;
  let statusTimer = 0;
  let saveTimer = 0;

  function createBlankItem(overrides = {}) {
    sequence += 1;
    const category = VEHICLE_ANNUAL_COST_CATEGORIES.includes(overrides.category)
      ? overrides.category
      : "servicio";

    return {
      id: `vehicle-cost-item-${Date.now()}-${sequence}`,
      name: "",
      category,
      group: DEFAULT_CATEGORY_GROUP[category],
      amount: "",
      frequency: "anual",
      interval: "1",
      notes: "",
      expanded: true,
      ...overrides,
    };
  }

  function syncProjectFields() {
    projectFields.vehicleName.value = project.vehicleName;
    projectFields.annualKilometers.value = project.annualKilometers;
    projectFields.currency.value = CURRENCIES.includes(project.currency)
      ? project.currency
      : "MXN";
  }

  function syncProjectFromFields() {
    project = {
      vehicleName: projectFields.vehicleName.value,
      annualKilometers: projectFields.annualKilometers.value,
      currency: projectFields.currency.value,
    };
  }

  function renderItems(focusId) {
    itemList.innerHTML = items.map(renderItem).join("");
    updateIntervalControls();
    updateItemPreviews();

    if (focusId) {
      const target = itemList.querySelector(`[data-item-id="${focusId}"]`);
      target?.querySelector("[data-item-field]")?.focus();
    }
  }

  function renderItem(item) {
    const categoryOptions = VEHICLE_ANNUAL_COST_CATEGORIES.map(
      (category) =>
        `<option value="${category}" ${item.category === category ? "selected" : ""}>${escapeHtml(VEHICLE_ANNUAL_COST_CATEGORY_LABELS[category])}</option>`,
    ).join("");
    const groupOptions = VEHICLE_ANNUAL_COST_GROUPS.map(
      (group) =>
        `<option value="${group}" ${item.group === group ? "selected" : ""}>${escapeHtml(VEHICLE_ANNUAL_COST_GROUP_LABELS[group])}</option>`,
    ).join("");
    const frequencyOptions = VEHICLE_ANNUAL_COST_FREQUENCIES.map(
      (frequency) =>
        `<option value="${frequency}" ${item.frequency === frequency ? "selected" : ""}>${escapeHtml(VEHICLE_ANNUAL_COST_FREQUENCY_LABELS[frequency])}</option>`,
    ).join("");

    return `
      <details class="rounded-lg border border-gray-800 bg-gray-900/70 p-3" data-item-id="${escapeAttribute(item.id)}" ${item.expanded ? "open" : ""}>
        <summary class="cursor-pointer list-none">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h4 class="break-words text-base font-semibold text-white" data-item-title="${escapeAttribute(item.id)}"></h4>
              <p class="mt-1 break-words text-sm text-gray-400" data-item-preview="${escapeAttribute(item.id)}"></p>
            </div>
            <span class="shrink-0 rounded-full border border-gray-700 px-2 py-1 text-xs font-semibold text-gray-400">editar</span>
          </div>
        </summary>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <label class="vehicle-field-label" for="${escapeAttribute(item.id)}-name">Nombre</label>
            <input
              id="${escapeAttribute(item.id)}-name"
              class="vehicle-field mt-2"
              type="text"
              maxlength="80"
              autocomplete="off"
              placeholder="Gasto"
              value="${escapeAttribute(item.name)}"
              data-item-field="name"
              data-id="${escapeAttribute(item.id)}"
            />
          </div>

          <div>
            <label class="vehicle-field-label" for="${escapeAttribute(item.id)}-amount">Costo por evento</label>
            <div class="vehicle-field-shell">
              <span class="vehicle-field-affix">$</span>
              <input
                id="${escapeAttribute(item.id)}-amount"
                class="vehicle-field-input"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="0"
                value="${escapeAttribute(item.amount)}"
                data-item-field="amount"
                data-id="${escapeAttribute(item.id)}"
              />
            </div>
          </div>

          <div>
            <label class="vehicle-field-label" for="${escapeAttribute(item.id)}-category">Categoria</label>
            <select
              id="${escapeAttribute(item.id)}-category"
              class="vehicle-field mt-2"
              data-item-field="category"
              data-id="${escapeAttribute(item.id)}"
            >
              ${categoryOptions}
            </select>
          </div>

          <div>
            <label class="vehicle-field-label" for="${escapeAttribute(item.id)}-group">Grupo</label>
            <select
              id="${escapeAttribute(item.id)}-group"
              class="vehicle-field mt-2"
              data-item-field="group"
              data-id="${escapeAttribute(item.id)}"
            >
              ${groupOptions}
            </select>
          </div>

          <div>
            <label class="vehicle-field-label" for="${escapeAttribute(item.id)}-frequency">Frecuencia</label>
            <select
              id="${escapeAttribute(item.id)}-frequency"
              class="vehicle-field mt-2"
              data-item-field="frequency"
              data-id="${escapeAttribute(item.id)}"
            >
              ${frequencyOptions}
            </select>
          </div>

          <div data-interval-wrap="${escapeAttribute(item.id)}">
            <label class="vehicle-field-label" for="${escapeAttribute(item.id)}-interval" data-interval-label="${escapeAttribute(item.id)}">Intervalo</label>
            <div class="vehicle-field-shell">
              <input
                id="${escapeAttribute(item.id)}-interval"
                class="vehicle-field-input"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                value="${escapeAttribute(item.interval)}"
                data-item-field="interval"
                data-id="${escapeAttribute(item.id)}"
              />
              <span class="vehicle-field-affix" data-interval-affix="${escapeAttribute(item.id)}">meses</span>
            </div>
          </div>

          <div class="sm:col-span-2">
            <label class="vehicle-field-label" for="${escapeAttribute(item.id)}-notes">Notas</label>
            <input
              id="${escapeAttribute(item.id)}-notes"
              class="vehicle-field mt-2"
              type="text"
              maxlength="140"
              autocomplete="off"
              placeholder="Opcional"
              value="${escapeAttribute(item.notes)}"
              data-item-field="notes"
              data-id="${escapeAttribute(item.id)}"
            />
          </div>
        </div>

        <p class="vehicle-field-error hidden" data-item-error="${escapeAttribute(item.id)}"></p>

        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          <button class="vehicle-item-action" type="button" data-item-action="duplicate" data-id="${escapeAttribute(item.id)}">
            Duplicar
          </button>
          <button class="vehicle-item-action vehicle-item-action-danger" type="button" data-item-action="delete" data-id="${escapeAttribute(item.id)}">
            Eliminar
          </button>
        </div>
      </details>
    `;
  }

  function updateIntervalControls() {
    items.forEach((item) => {
      const wrap = document.querySelector(`[data-interval-wrap="${item.id}"]`);
      const label = document.querySelector(`[data-interval-label="${item.id}"]`);
      const affix = document.querySelector(`[data-interval-affix="${item.id}"]`);
      const needsInterval =
        item.frequency === "cada_n_meses" || item.frequency === "cada_n_km";

      wrap?.classList.toggle("hidden", !needsInterval);

      if (label) {
        label.textContent =
          item.frequency === "cada_n_km" ? "Cada cuantos km" : "Cada cuantos meses";
      }

      if (affix) {
        affix.textContent = item.frequency === "cada_n_km" ? "km" : "meses";
      }
    });
  }

  function updateItemPreviews() {
    items.forEach((item, index) => {
      const title = document.querySelector(`[data-item-title="${item.id}"]`);
      const preview = document.querySelector(`[data-item-preview="${item.id}"]`);
      const label = VEHICLE_ANNUAL_COST_CATEGORY_LABELS[item.category] ?? "Gasto";
      const name = item.name.trim() || `Gasto ${index + 1}`;
      const amount = item.amount.trim() ? `$${item.amount.trim()}` : "sin importe";
      const frequency = VEHICLE_ANNUAL_COST_FREQUENCY_LABELS[item.frequency];
      const interval =
        item.frequency === "cada_n_meses" || item.frequency === "cada_n_km"
          ? ` cada ${item.interval || "?"} ${item.frequency === "cada_n_km" ? "km" : "meses"}`
          : "";

      if (title) title.textContent = name;
      if (preview) preview.textContent = `${label} - ${amount} - ${frequency}${interval}`;
    });
  }

  function readInput() {
    clearValidation();
    const errors = [];
    const annualKilometers = readOptionalNumberField(
      project.annualKilometers,
      "annualKilometers",
      "Kilometros anuales debe ser 0 o mayor.",
      errors,
      { max: 10_000_000 },
    );

    if (project.vehicleName.trim().length > 80) {
      errors.push("El nombre del vehiculo debe tener 80 caracteres o menos.");
    }

    return {
      input: {
        vehicleName: project.vehicleName,
        annualKilometers: annualKilometers ?? 0,
        currency: CURRENCIES.includes(project.currency) ? project.currency : "MXN",
        items: readItems(errors),
      },
      errors,
    };
  }

  function readItems(errors) {
    return items.map((item) => {
      const itemErrors = [];
      const parsedAmount = item.amount.trim()
        ? parseVehicleAnnualCostNumberInput(item.amount)
        : { ok: true, value: 0 };
      const parsedInterval = item.interval.trim()
        ? parseVehicleAnnualCostNumberInput(item.interval)
        : { ok: false, error: "required" };
      const needsInterval =
        item.frequency === "cada_n_meses" || item.frequency === "cada_n_km";

      if (!parsedAmount.ok) itemErrors.push("costo invalido");
      if (needsInterval && (!parsedInterval.ok || parsedInterval.value <= 0)) {
        itemErrors.push("intervalo mayor que cero requerido");
      }
      if (item.name.trim().length > 80) itemErrors.push("nombre demasiado largo");
      if (item.notes.trim().length > 140) itemErrors.push("notas demasiado largas");

      setItemError(item.id, itemErrors.join(". "));

      if (itemErrors.length) {
        errors.push(`${item.name.trim() || "Partida"}: ${itemErrors.join(", ")}.`);
      }

      return {
        id: item.id,
        name: item.name,
        category: VEHICLE_ANNUAL_COST_CATEGORIES.includes(item.category)
          ? item.category
          : "otro",
        group: VEHICLE_ANNUAL_COST_GROUPS.includes(item.group)
          ? item.group
          : DEFAULT_CATEGORY_GROUP[item.category] ?? "uso",
        amount: parsedAmount.ok ? parsedAmount.value : 0,
        amountMissing: !item.amount.trim(),
        frequency: VEHICLE_ANNUAL_COST_FREQUENCIES.includes(item.frequency)
          ? item.frequency
          : "anual",
        interval: needsInterval && parsedInterval.ok ? parsedInterval.value : undefined,
        notes: item.notes,
      };
    });
  }

  function readOptionalNumberField(value, field, message, errors, options = {}) {
    if (!value.trim()) {
      setFieldError(field);
      return 0;
    }

    const parsed = parseVehicleAnnualCostNumberInput(value);
    const invalid =
      !parsed.ok ||
      parsed.value < 0 ||
      (typeof options.max === "number" && parsed.value > options.max);

    if (invalid) {
      setFieldError(field, message);
      errors.push(message);
      return 0;
    }

    setFieldError(field);
    return parsed.value;
  }

  function updateCalculator() {
    syncProjectFromFields();
    updateIntervalControls();
    updateItemPreviews();
    queueSaveProject();

    const parsed = readInput();

    if (parsed.errors.length) {
      currentResult = null;
      renderErrors(parsed.errors);
      renderNeutral("Revisa los datos marcados.", "No se pudo calcular todavia.");
      setActionsEnabled(false);
      return;
    }

    try {
      const result = calculateVehicleAnnualCosts(parsed.input);
      currentResult = result;
      renderErrors([]);

      if (result.isEmptyEstimate) {
        renderNeutral(
          "Agrega al menos un importe.",
          "Los importes en blanco cuentan como cero.",
        );
        setActionsEnabled(false);
        return;
      }

      renderResult(result);
      setActionsEnabled(true);
    } catch (error) {
      currentResult = null;
      renderErrors([error instanceof Error ? error.message : "No fue posible calcular."]);
      renderNeutral("No fue posible calcular.", "Revisa los gastos capturados.");
      setActionsEnabled(false);
    }
  }

  function renderNeutral(title, subtitle) {
    resultKicker.textContent = "Reserva mensual";
    mainResult.textContent = "Agrega gastos";
    resultSubtitle.textContent = title;
    resultNote.textContent = subtitle;
    liveSummary.textContent = `${title} ${subtitle}`;
    mobileKicker.textContent = "Reserva mensual";
    mobileTotal.textContent = "Agrega gastos";
    mobileStatus.textContent = title;
    summaryGrid.innerHTML = [
      summaryCard("Promedio anual", "$0.00"),
      summaryCard("Reserva anual", "$0.00"),
      summaryCard("Costo por km", "Sin km"),
      summaryCard("Partidas", String(items.length)),
    ].join("");
    groupBreakdown.innerHTML = emptyRow("Sin importes capturados.");
    categoryBreakdown.innerHTML = emptyRow("Sin categorias con costo.");
    topItems.innerHTML = emptyRow("Sin partidas con costo.");
    practicalSection.classList.add("hidden");
  }

  function renderResult(result) {
    const monthlyReserve = formatVehicleAnnualCostCurrency(
      result.suggestedMonthlyReserve,
      result.currency,
    );
    const annualAverage = formatVehicleAnnualCostCurrency(
      result.totalAnnualAverage,
      result.currency,
    );

    resultKicker.textContent = "Reserva mensual";
    mainResult.textContent = monthlyReserve;
    resultSubtitle.textContent = `Promedio mensual: ${formatVehicleAnnualCostCurrency(
      result.averageMonthlyCost,
      result.currency,
    )}`;
    resultNote.textContent = `Costo anual promedio: ${annualAverage}. Reserva anual practica: ${formatVehicleAnnualCostCurrency(
      result.practicalAnnualReserve,
      result.currency,
    )}.`;
    liveSummary.textContent = `${monthlyReserve}. ${resultNote.textContent}`;
    mobileKicker.textContent = "Reserva mensual";
    mobileTotal.textContent = monthlyReserve;
    mobileStatus.textContent = `${annualAverage} al ano`;

    summaryGrid.innerHTML = buildSummaryMetrics(result)
      .map(([label, value]) => summaryCard(label, value))
      .join("");
    groupBreakdown.innerHTML = renderBreakdownRows(result.groupBreakdown, result.currency);
    categoryBreakdown.innerHTML = renderBreakdownRows(
      result.categoryBreakdown,
      result.currency,
    );
    topItems.innerHTML = result.topItems.length
      ? result.topItems
          .map((item) =>
            breakdownRow(
              item.name,
              formatVehicleAnnualCostCurrency(item.averageAnnualCost, result.currency),
              `${formatVehicleAnnualCostNumber(item.eventsTheoretical)} eventos prom.`,
            ),
          )
          .join("")
      : emptyRow("Sin partidas con costo.");
    renderPracticalNotes(result);
  }

  function buildSummaryMetrics(result) {
    const costPerKm =
      result.averageCostPerKm === null
        ? "Sin km"
        : `${formatVehicleAnnualCostCurrency(result.averageCostPerKm, result.currency)}/km`;
    const practicalPerKm =
      result.practicalCostPerKm === null
        ? "Sin km"
        : `${formatVehicleAnnualCostCurrency(result.practicalCostPerKm, result.currency)}/km`;

    return [
      [
        "Anual promedio",
        formatVehicleAnnualCostCurrency(result.totalAnnualAverage, result.currency),
      ],
      [
        "Reserva anual",
        formatVehicleAnnualCostCurrency(result.practicalAnnualReserve, result.currency),
      ],
      ["Costo/km prom.", costPerKm],
      ["Costo/km pract.", practicalPerKm],
      ["Partidas", String(result.items.length)],
      ["Incompletas", String(result.incompleteItems.length)],
    ];
  }

  function renderBreakdownRows(rows, currency) {
    if (!rows.length) return emptyRow("Sin importes capturados.");

    return rows
      .map((row) => {
        const percent =
          row.percentageOfAverageTotal === null
            ? "sin porcentaje"
            : `${formatVehicleAnnualCostNumber(row.percentageOfAverageTotal, 1)}% del total`;

        return breakdownRow(
          row.label,
          formatVehicleAnnualCostCurrency(row.subtotalAverage, currency),
          percent,
        );
      })
      .join("");
  }

  function renderPracticalNotes(result) {
    if (!result.hasPracticalDifference) {
      practicalSection.classList.add("hidden");
      practicalList.innerHTML = "";
      return;
    }

    practicalSection.classList.remove("hidden");
    practicalList.innerHTML = result.items
      .filter(
        (item) =>
          Math.abs(item.practicalAnnualCost - item.averageAnnualCost) > 0.000001,
      )
      .map(
        (item) =>
          `<p>${escapeHtml(item.name)}: ${formatVehicleAnnualCostNumber(
            item.eventsTheoretical,
          )} eventos promedio, reserva para ${formatVehicleAnnualCostNumber(
            item.eventsPractical,
            0,
          )}.</p>`,
      )
      .join("");
  }

  function summaryCard(label, value) {
    return `
      <div class="rounded-lg border border-gray-800 bg-gray-950/70 p-3">
        <span class="block text-xs font-semibold uppercase tracking-wide text-gray-500">${escapeHtml(label)}</span>
        <strong class="mt-2 block break-words text-base font-semibold text-white">${escapeHtml(value)}</strong>
      </div>
    `;
  }

  function breakdownRow(label, value, note) {
    return `
      <div class="flex items-start justify-between gap-3 rounded-lg border border-gray-800 bg-gray-950/70 p-3 text-sm">
        <div class="min-w-0">
          <span class="block break-words text-gray-300">${escapeHtml(label)}</span>
          <span class="mt-1 block text-xs text-gray-500">${escapeHtml(note)}</span>
        </div>
        <strong class="shrink-0 text-right text-white">${escapeHtml(value)}</strong>
      </div>
    `;
  }

  function emptyRow(text) {
    return `<p class="rounded-lg border border-gray-800 bg-gray-950/70 p-3 text-sm text-gray-500">${escapeHtml(text)}</p>`;
  }

  function renderErrors(errors) {
    errorsBox.innerHTML = errors.map((error) => `<p>${escapeHtml(error)}</p>`).join("");
    errorsBox.classList.toggle("hidden", !errors.length);
  }

  function clearValidation() {
    document.querySelectorAll("[data-field-error]").forEach((error) => {
      error.textContent = "";
    });
    document.querySelectorAll("[data-field-error-target]").forEach((field) => {
      field.removeAttribute("aria-invalid");
    });
    items.forEach((item) => setItemError(item.id));
  }

  function setFieldError(field, message = "") {
    const error = document.querySelector(`[data-field-error="${field}"]`);
    const target = document.querySelector(`[data-field-error-target="${field}"]`);

    if (error) error.textContent = message;
    if (target) {
      if (message) target.setAttribute("aria-invalid", "true");
      else target.removeAttribute("aria-invalid");
    }
  }

  function setItemError(id, message = "") {
    const error = document.querySelector(`[data-item-error="${id}"]`);

    if (!error) return;
    error.textContent = message;
    error.classList.toggle("hidden", !message);
  }

  function setActionsEnabled(enabled) {
    copyButton.disabled = !enabled;
    exportButton.disabled = !enabled;
  }

  function addItem() {
    if (items.length >= MAX_ITEMS) {
      setActionStatus(`El limite es de ${MAX_ITEMS} partidas.`, true);
      return;
    }

    const item = createBlankItem({ name: `Gasto ${items.length + 1}` });
    items.push(item);
    renderItems(item.id);
    updateCalculator();
  }

  function addSuggestedItems() {
    const suggestions = [
      createBlankItem({ name: "Llantas", category: "llantas", group: "mantenimiento", frequency: "cada_n_meses", interval: "36" }),
      createBlankItem({ name: "Verificacion", category: "impuestos_verificacion", group: "propiedad", frequency: "cada_n_meses", interval: "6" }),
      createBlankItem({ name: "Estacionamiento", category: "estacionamiento_peajes", group: "uso", frequency: "mensual" }),
      createBlankItem({ name: "Reparaciones", category: "reparacion", group: "mantenimiento", frequency: "anual" }),
    ];
    const available = MAX_ITEMS - items.length;

    if (available <= 0) {
      setActionStatus(`El limite es de ${MAX_ITEMS} partidas.`, true);
      return;
    }

    items.push(...suggestions.slice(0, available));
    renderItems();
    updateCalculator();
    setActionStatus("Conceptos agregados sin precios.");
  }

  function duplicateItem(id) {
    if (items.length >= MAX_ITEMS) {
      setActionStatus(`El limite es de ${MAX_ITEMS} partidas.`, true);
      return;
    }

    const index = items.findIndex((item) => item.id === id);
    if (index < 0) return;
    const source = items[index];
    const duplicate = {
      ...source,
      id: `vehicle-cost-item-${Date.now()}-${Math.random().toString(16).slice(2)}`,
      name: `${source.name.trim() || "Gasto"} copia`.slice(0, 80),
      expanded: true,
    };
    items.splice(index + 1, 0, duplicate);
    renderItems(duplicate.id);
    updateCalculator();
  }

  function deleteItem(id) {
    items = items.filter((item) => item.id !== id);

    if (!items.length) {
      items = [createBlankItem({ name: "Gasto 1" })];
    }

    renderItems();
    updateCalculator();
  }

  function fillExample() {
    project = {
      vehicleName: "Auto familiar",
      annualKilometers: "15000",
      currency: "MXN",
    };
    sequence = 0;
    items = [
      createBlankItem({
        name: "Servicio",
        category: "servicio",
        group: "mantenimiento",
        amount: "3000",
        frequency: "cada_n_km",
        interval: "10000",
        expanded: false,
      }),
      createBlankItem({
        name: "Seguro",
        category: "seguro",
        group: "propiedad",
        amount: "9500",
        frequency: "anual",
        expanded: false,
      }),
      createBlankItem({
        name: "Verificacion",
        category: "impuestos_verificacion",
        group: "propiedad",
        amount: "700",
        frequency: "cada_n_meses",
        interval: "6",
        expanded: false,
      }),
      createBlankItem({
        name: "Llantas",
        category: "llantas",
        group: "mantenimiento",
        amount: "12000",
        frequency: "cada_n_meses",
        interval: "36",
        expanded: false,
      }),
    ];
    syncProjectFields();
    renderItems();
    updateCalculator();
    setActionStatus("Ejemplo cargado.");
  }

  function clearAll() {
    project = { ...defaultProject };
    sequence = 0;
    items = [
      createBlankItem({ name: "Servicio", category: "servicio", group: "mantenimiento" }),
      createBlankItem({ name: "Seguro", category: "seguro", group: "propiedad" }),
    ];
    currentResult = null;
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {}
    syncProjectFields();
    renderItems();
    updateCalculator();
    setActionStatus("Formulario limpio.");
  }

  async function copyResult() {
    if (!currentResult) return;
    const text = buildVehicleAnnualCostsShareText(currentResult);

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
      } else {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.setAttribute("readonly", "");
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.append(textArea);
        textArea.select();
        document.execCommand("copy");
        textArea.remove();
      }

      copyLabel.textContent = "Copiado";
      setActionStatus("Resumen copiado.");
      window.setTimeout(() => {
        copyLabel.textContent = "Copiar resumen";
      }, 2000);
    } catch {
      setActionStatus("No fue posible copiar automaticamente.", true);
    }
  }

  function exportCsv() {
    if (!currentResult) return;
    const csv = buildVehicleAnnualCostsCsv(currentResult);
    const url = URL.createObjectURL(
      new Blob([`\uFEFF${csv}`], { type: "text/csv;charset=utf-8" }),
    );
    const link = document.createElement("a");

    link.href = url;
    link.download = "gastos-anuales-vehiculo.csv";
    document.body.append(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
    setActionStatus("CSV generado.");
  }

  function queueSaveProject() {
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(saveProject, 250);
  }

  function saveProject() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ project, items }));
    } catch {}
  }

  function loadSavedProject() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const saved = JSON.parse(raw);

      if (saved?.project && typeof saved.project === "object") {
        project = {
          vehicleName: String(saved.project.vehicleName ?? ""),
          annualKilometers: String(saved.project.annualKilometers ?? ""),
          currency: CURRENCIES.includes(saved.project.currency)
            ? saved.project.currency
            : "MXN",
        };
      }

      if (Array.isArray(saved?.items) && saved.items.length) {
        items = saved.items.slice(0, MAX_ITEMS).map((item) =>
          createBlankItem({
            name: String(item.name ?? ""),
            category: VEHICLE_ANNUAL_COST_CATEGORIES.includes(item.category)
              ? item.category
              : "servicio",
            group: VEHICLE_ANNUAL_COST_GROUPS.includes(item.group)
              ? item.group
              : undefined,
            amount: String(item.amount ?? ""),
            frequency: VEHICLE_ANNUAL_COST_FREQUENCIES.includes(item.frequency)
              ? item.frequency
              : "anual",
            interval: String(item.interval ?? "1"),
            notes: String(item.notes ?? ""),
            expanded: Boolean(item.expanded),
          }),
        );
      }
    } catch {}
  }

  function setActionStatus(message, isError = false) {
    window.clearTimeout(statusTimer);
    actionStatus.textContent = message;
    actionStatus.className = `mt-3 min-h-5 text-sm ${isError ? "text-red-200" : "text-emerald-100"}`;
    statusTimer = window.setTimeout(() => {
      actionStatus.textContent = "";
    }, 3500);
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function escapeAttribute(value) {
    return escapeHtml(value);
  }

  form.addEventListener("submit", (event) => event.preventDefault());

  form.addEventListener("input", (event) => {
    const projectField = event.target.closest("[data-project-field]");
    if (projectField) {
      updateCalculator();
      return;
    }

    const itemField = event.target.closest("[data-item-field]");
    if (!itemField) return;
    const item = items.find((entry) => entry.id === itemField.dataset.id);
    if (!item) return;
    item[itemField.dataset.itemField] = itemField.value;

    if (itemField.dataset.itemField === "category") {
      item.group = DEFAULT_CATEGORY_GROUP[item.category] ?? "uso";
      renderItems();
    }

    updateCalculator();
  });

  form.addEventListener("change", (event) => {
    const projectField = event.target.closest("[data-project-field]");
    if (projectField) {
      updateCalculator();
      return;
    }

    const itemField = event.target.closest("[data-item-field]");
    if (!itemField) return;
    const item = items.find((entry) => entry.id === itemField.dataset.id);
    if (!item) return;
    item[itemField.dataset.itemField] = itemField.value;

    if (itemField.dataset.itemField === "category") {
      item.group = DEFAULT_CATEGORY_GROUP[item.category] ?? "uso";
      renderItems();
    }

    updateCalculator();
  });

  form.addEventListener(
    "toggle",
    (event) => {
      const card = event.target.closest("[data-item-id]");
      if (!card) return;
      const item = items.find((entry) => entry.id === card.dataset.itemId);
      if (item) item.expanded = card.open;
      queueSaveProject();
    },
    true,
  );

  form.addEventListener("click", (event) => {
    const action = event.target.closest("[data-item-action]");
    if (!action) return;

    if (action.dataset.itemAction === "duplicate") {
      duplicateItem(action.dataset.id);
    }

    if (action.dataset.itemAction === "delete") {
      deleteItem(action.dataset.id);
    }
  });

  document.querySelector("[data-add-item]").addEventListener("click", addItem);
  document.querySelector("[data-add-suggested]").addEventListener("click", addSuggestedItems);
  document.querySelector("[data-example]").addEventListener("click", fillExample);
  document.querySelector("[data-clear]").addEventListener("click", clearAll);
  copyButton.addEventListener("click", copyResult);
  exportButton.addEventListener("click", exportCsv);

  loadSavedProject();
  syncProjectFields();
  renderItems();
  updateCalculator();
</script>
