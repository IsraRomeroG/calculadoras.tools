---
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogPostCard from "@components/blog/BlogPostCard.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import PageHero from "@components/shared/PageHero.astro";
import {
  getBlogCategories,
  getCategorySlug,
  getCategoryUrl,
  getPublishedBlogPosts,
  type BlogCategory,
  type BlogPost,
} from "@lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  const categories = getBlogCategories(posts);

  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      posts: posts.filter(
        (post) => getCategorySlug(post.data.category) === category.slug,
      ),
    },
  }));
}

interface Props {
  category: BlogCategory;
  posts: BlogPost[];
}

const { category, posts } = Astro.props;
const title = `Blog de ${category.label}`;
const description = `Artículos de ${category.label.toLowerCase()} con explicaciones claras, fórmulas prácticas y ejemplos.`;
const canonical = getCategoryUrl(category.label);
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <PageShell>
    <PageHero
      title={`Artículos de ${category.label.toLowerCase()}`}
      description={`Guías y ejemplos para resolver cálculos de ${category.label.toLowerCase()} con más contexto.`}
      kicker={category.label}
      collapseBreadcrumbOnMobile
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Blog", href: "/blog", optional: true },
        { label: category.label, truncate: true },
      ]}
    />

    <Container as="section" class="py-8 md:py-10">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <BlogPostCard post={post} headingLevel="h2" cta="Leer artículo" />
          ))
        }
      </div>
    </Container>
  </PageShell>
</BaseLayout>
