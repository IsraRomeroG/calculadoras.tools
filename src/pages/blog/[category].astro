---
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/ads/AdSlot.astro";
import BlogPostCard from "@components/blog/BlogPostCard.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import Pagination from "@components/shared/Pagination.astro";
import PageHero from "@components/shared/PageHero.astro";
import {
  assertNoBlogRouteConflicts,
  getBlogPostsByCategorySlug,
  getBlogCategories,
  getCategoryPageUrl,
  getCategoryUrl,
  getPublishedBlogPosts,
  paginateItems,
  type BlogCategory,
  type BlogPost,
  type PaginatedItems,
} from "@lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  assertNoBlogRouteConflicts(posts);
  const categories = getBlogCategories(posts);

  return categories.map((category) => {
    const categoryPosts = getBlogPostsByCategorySlug(posts, category.slug);
    const pagination = paginateItems(categoryPosts, 1);

    return {
      params: { category: category.slug },
      props: {
        category,
        posts: pagination.items,
        pagination,
      },
    };
  });
}

interface Props {
  category: BlogCategory;
  posts: BlogPost[];
  pagination: PaginatedItems<BlogPost>;
}

const { category, posts, pagination } = Astro.props;
const title = `Blog de ${category.label}`;
const description = `Artículos de ${category.label.toLowerCase()} con explicaciones claras, fórmulas prácticas y ejemplos.`;
const canonical = getCategoryUrl(category.slug);
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    {
      pagination.nextPage && (
        <link
          rel="next"
          href={getCategoryPageUrl(category.slug, pagination.nextPage)}
        />
      )
    }
  </Fragment>

  <PageShell>
    <PageHero
      title={`Artículos de ${category.label.toLowerCase()}`}
      description={`Guías y ejemplos para resolver cálculos de ${category.label.toLowerCase()} con más contexto.`}
      kicker={category.label}
      collapseBreadcrumbOnMobile
      breadcrumbs={[
        { label: "Inicio", href: "/", ariaLabel: "Inicio" },
        { label: "Blog", href: "/blog", optional: true },
        { label: category.label, truncate: true },
      ]}
    />

    <AdSlot placement="blog-category-after-intro" />

    <Container as="section" class="py-8 md:py-10">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <BlogPostCard post={post} headingLevel="h2" cta="Leer artículo" />
          ))
        }
      </div>

      <Pagination
        currentPage={pagination.currentPage}
        totalPages={pagination.totalPages}
        getPageUrl={(page) => getCategoryPageUrl(category.slug, page)}
        class="mt-8"
      />
    </Container>
  </PageShell>
</BaseLayout>
