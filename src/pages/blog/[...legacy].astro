---
import {
  assertNoBlogRouteConflicts,
  getBlogCategories,
  getBlogPostSlug,
  getBlogPostUrl,
  getBlogPostsByCategorySlug,
  getCategoryPageUrl,
  getCategoryUrl,
  getPublishedBlogPosts,
  paginateItems,
} from "@lib/blog";
import { getCategoryLegacySlugs } from "@lib/constants/categories";

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  assertNoBlogRouteConflicts(posts);
  const categories = getBlogCategories(posts);
  const legacyPaths = posts.map((post) => ({
    params: { legacy: getBlogPostSlug(post) },
    props: { target: getBlogPostUrl(post) },
  }));

  categories.forEach((category) => {
    const categoryPosts = getBlogPostsByCategorySlug(posts, category.slug);
    const firstPage = paginateItems(categoryPosts, 1);
    const categoryLegacySlugs = [
      category.slug,
      ...getCategoryLegacySlugs(category.slug),
    ];

    categoryLegacySlugs.forEach((sourceSlug) => {
      legacyPaths.push({
        params: { legacy: `categoria/${sourceSlug}` },
        props: { target: getCategoryUrl(category.slug) },
      });

      if (sourceSlug !== category.slug) {
        legacyPaths.push({
          params: { legacy: sourceSlug },
          props: { target: getCategoryUrl(category.slug) },
        });

        categoryPosts.forEach((post) => {
          legacyPaths.push({
            params: { legacy: `${sourceSlug}/${getBlogPostSlug(post)}` },
            props: { target: getBlogPostUrl(post) },
          });
        });
      }

      for (let page = 2; page <= firstPage.totalPages; page += 1) {
        legacyPaths.push({
          params: { legacy: `categoria/${sourceSlug}/pagina/${page}` },
          props: { target: getCategoryPageUrl(category.slug, page) },
        });

        if (sourceSlug !== category.slug) {
          legacyPaths.push({
            params: { legacy: `${sourceSlug}/pagina/${page}` },
            props: { target: getCategoryPageUrl(category.slug, page) },
          });
        }
      }
    });
  });

  return legacyPaths;
}

interface Props {
  target: string;
}

const { target } = Astro.props;

return Astro.redirect(target, 301);
---
