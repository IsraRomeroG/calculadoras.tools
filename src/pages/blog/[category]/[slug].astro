---
import BlogArticlePage from "@components/blog/BlogArticlePage.astro";
import {
  assertNoBlogRouteConflicts,
  getBlogPostAlternatePaths,
  getBlogPostCategorySlug,
  getBlogPostSlug,
  getBlogPostUrl,
  getPublishedBlogPostsByLocale,
  type BlogPost,
} from "@lib/blog";
import type { Locale } from "@lib/i18n/config";
import { buildAlternateLinks } from "@lib/i18n/routing";

const locale = "es";

export async function getStaticPaths() {
  const pathLocale = "es";
  const posts = await getPublishedBlogPostsByLocale(pathLocale);
  const englishPosts = await getPublishedBlogPostsByLocale("en");
  const allPosts = [...posts, ...englishPosts];
  assertNoBlogRouteConflicts(allPosts);

  return posts.map((post) => ({
    params: {
      category: getBlogPostCategorySlug(post),
      slug: getBlogPostSlug(post),
    },
    props: {
      post,
      alternatePaths: getBlogPostAlternatePaths(post, allPosts),
    },
  }));
}

interface Props {
  post: BlogPost;
  alternatePaths: Partial<Record<Locale, string>>;
}

const { post, alternatePaths } = Astro.props;
const canonical = getBlogPostUrl(post);
const alternates = buildAlternateLinks(alternatePaths, Astro.site ?? Astro.url);
---

<BlogArticlePage
  locale={locale}
  post={post}
  canonical={canonical}
  alternates={alternates}
/>
