---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/shared/Card.astro";
import Breadcrumb from "@components/shared/Breadcrumb.astro";

const featuredPost = {
  href: "/blog/como-calcular-porcentajes",
  title: "Cómo calcular porcentajes sin complicarte",
  description:
    "Guía rápida para entender porcentajes, aumentos, descuentos y variaciones con ejemplos claros.",
  category: "Matemáticas",
  readTime: "4 min",
};

const posts = [
  {
    href: "/blog/porcentaje-de-descuento",
    title: "Cómo calcular un descuento",
    description: "Aprende a calcular descuentos reales antes de comprar.",
    cta: "Leer artículo →",
  },
  {
    href: "/blog/aumento-porcentual",
    title: "Qué es el aumento porcentual",
    description: "Compara valores iniciales y finales de forma sencilla.",
    cta: "Leer artículo →",
  },
  {
    href: "/blog/regla-de-tres",
    title: "Regla de tres: explicación práctica",
    description: "Resuelve proporciones comunes con pasos claros.",
    cta: "Leer artículo →",
  },
];

const categories = [
  "Matemáticas",
  "Finanzas",
  "Salud",
  "Fechas",
  "Conversores",
];
---

<BaseLayout title="Blog">
  <main class="bg-gray-900 text-gray-100">
    <section class="border-b border-gray-700">
      <div class="mx-auto max-w-5xl px-6 py-10">
        <Breadcrumb
          class="mb-8"
          items={[
            { label: "Inicio", href: "/", ariaLabel: "Inicio" },
            { label: "Blog" },
          ]}
        />

        <div class="mt-4 max-w-3xl">
          <h1 class="text-4xl font-bold tracking-tight md:text-6xl">
            Guías simples para entender tus cálculos diarios
          </h1>

          <p class="mt-6 text-lg leading-relaxed text-gray-400">
            Explicaciones claras, fórmulas prácticas y ejemplos para usar mejor
            las calculadoras de calculadoras.tools.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          {
            categories.map((category) => (
              <a
                href={`/blog?categoria=${category.toLowerCase()}`}
                class="rounded-full border border-gray-700 px-4 py-2 text-sm text-gray-300 transition hover:border-amber-400 hover:text-white"
              >
                {category}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 py-10">
      <article
        class="grid gap-8 rounded-xl border border-gray-700 bg-gray-950 p-6 md:grid-cols-[1.1fr_0.9fr] md:p-8"
      >
        <div>
          <p class="text-sm text-amber-400">
            {featuredPost.category} · {featuredPost.readTime}
          </p>

          <h2 class="mt-3 text-3xl font-semibold tracking-tight">
            {featuredPost.title}
          </h2>

          <p class="mt-4 text-gray-400">
            {featuredPost.description}
          </p>

          <a
            href={featuredPost.href}
            class="mt-6 inline-flex rounded-lg bg-amber-400 px-5 py-3 text-sm font-semibold text-gray-900 transition hover:bg-gray-700 hover:text-white"
          >
            Leer guía destacada
          </a>
        </div>

        <div class="rounded-lg border border-gray-700 bg-gray-900 p-5">
          <p class="text-sm font-semibold text-gray-300">En esta guía</p>
          <ul class="mt-4 space-y-3 text-sm text-gray-400">
            <li>Fórmula básica del porcentaje</li>
            <li>Ejemplos con descuentos y aumentos</li>
            <li>Errores comunes al interpretar resultados</li>
            <li>Cuándo usar una calculadora automática</li>
          </ul>
        </div>
      </article>
    </section>

    <section class="mx-auto max-w-5xl px-6 pb-10">
      <div class="mb-8">
        <h2 class="text-2xl font-semibold">Últimos artículos</h2>
        <p class="mt-2 text-sm text-gray-400">
          Contenido pensado para acompañar cada herramienta del sitio.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
        {
          posts.map((post) => (
            <Card
              href={post.href}
              title={post.title}
              description={post.description}
              cta={post.cta}
            />
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
