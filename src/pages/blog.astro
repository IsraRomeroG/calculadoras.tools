---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumb from "@components/shared/Breadcrumb.astro";
import {
  formatBlogDate,
  getBlogCategories,
  getBlogPostUrl,
  getCategoryUrl,
  getPublishedBlogPosts,
} from "@lib/blog";

const title = "Blog";
const description =
  "Guías simples, fórmulas prácticas y ejemplos para usar mejor las calculadoras de calculadoras.tools.";
const canonical = "/blog";

const posts = await getPublishedBlogPosts();
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.id !== featuredPost?.id);
const categories = getBlogCategories(posts);
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <main class="bg-gray-900 text-gray-100">
    <section class="border-b border-gray-700">
      <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 md:py-10">
        <Breadcrumb
          class="mb-6"
          items={[
            { label: "Inicio", href: "/", ariaLabel: "Inicio" },
            { label: "Blog" },
          ]}
        />

        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">
            Blog
          </p>
          <h1 class="mt-3 text-4xl font-bold leading-tight md:text-5xl">
            Guías simples para entender tus cálculos diarios
          </h1>

          <p class="mt-4 text-base leading-relaxed text-gray-400 md:text-lg">
            Explicaciones claras, fórmulas prácticas y ejemplos para usar mejor
            las calculadoras de calculadoras.tools.
          </p>
        </div>

        {
          categories.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3">
              {categories.map((category) => (
                <a
                  href={getCategoryUrl(category.label)}
                  class="inline-flex items-center gap-2 rounded-full border border-gray-700 px-4 py-2 text-sm text-gray-300 transition hover:border-amber-400 hover:text-white"
                >
                  <span>{category.label}</span>
                  <span class="text-xs text-gray-500">{category.count}</span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    {
      featuredPost && (
        <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 md:py-10">
          <article class="grid gap-6 rounded-lg border border-gray-700 bg-gray-950 p-6 md:grid-cols-[minmax(0,1fr)_16rem] md:p-8">
            <div>
              <p class="text-sm font-semibold text-amber-400">
                {featuredPost.data.category}
                {featuredPost.data.readTime && ` · ${featuredPost.data.readTime}`}
              </p>

              <h2 class="mt-3 text-3xl font-semibold tracking-tight">
                <a
                  href={getBlogPostUrl(featuredPost)}
                  class="transition hover:text-amber-300"
                >
                  {featuredPost.data.title}
                </a>
              </h2>

              <p class="mt-4 text-gray-400">
                {featuredPost.data.description}
              </p>

              <a
                href={getBlogPostUrl(featuredPost)}
                class="mt-6 inline-flex min-h-11 items-center rounded-lg bg-amber-400 px-5 py-3 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
              >
                Leer guía destacada
              </a>
            </div>

            <dl class="grid content-start gap-4 border-t border-gray-800 pt-5 text-sm md:border-l md:border-t-0 md:pl-6 md:pt-0">
              <div>
                <dt class="text-gray-500">Publicado</dt>
                <dd class="mt-1 font-medium text-gray-200">
                  <time datetime={featuredPost.data.pubDate.toISOString()}>
                    {formatBlogDate(featuredPost.data.pubDate)}
                  </time>
                </dd>
              </div>

              <div>
                <dt class="text-gray-500">Categoría</dt>
                <dd class="mt-1">
                  <a
                    href={getCategoryUrl(featuredPost.data.category)}
                    class="font-medium text-gray-200 transition hover:text-amber-300"
                  >
                    {featuredPost.data.category}
                  </a>
                </dd>
              </div>
            </dl>
          </article>
        </section>
      )
    }

    <section class="mx-auto max-w-5xl px-4 pb-12 sm:px-6">
      <div class="mb-6">
        <h2 class="text-2xl font-semibold">Últimos artículos</h2>
        <p class="mt-2 text-sm text-gray-400">
          Contenido pensado para acompañar cada herramienta del sitio.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          latestPosts.map((post) => (
            <a
              href={getBlogPostUrl(post)}
              class="group rounded-lg border border-gray-700 p-5 transition hover:border-amber-400"
            >
              <p class="text-sm text-amber-400">
                {post.data.category}
                {post.data.readTime && ` · ${post.data.readTime}`}
              </p>

              <h3 class="mt-3 text-lg font-semibold group-hover:text-white">
                {post.data.title}
              </h3>

              <p class="mt-2 text-sm leading-relaxed text-gray-400">
                {post.data.description}
              </p>

              <span class="mt-4 inline-block text-sm text-amber-400 group-hover:underline">
                Leer artículo
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
