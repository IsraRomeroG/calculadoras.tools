---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/shared/Card.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import type { Locale } from "@lib/i18n/config";
import { t } from "@lib/i18n/messages";
import type { AlternateLink } from "@lib/i18n/routing";
import {
  getCalculatorCategories,
  getCalculatorCategoryUrl,
  getPublishedCalculators,
} from "@lib/calculator-directory";
import {
  CATEGORY_IDS,
  getCategory,
} from "@lib/constants/categories";

interface Props {
  locale: Locale;
  canonical: string;
  alternates: AlternateLink[];
}

const { locale, canonical, alternates } = Astro.props;
const calculators = getPublishedCalculators(locale);
const categories =
  locale === "en"
    ? CATEGORY_IDS.map((categoryId) => {
        const metadata = getCategory(categoryId, locale);

        return {
          id: categoryId,
          slug: metadata.slug,
          label: metadata.label,
          description: metadata.description,
          count: calculators.filter(
            (calculator) => calculator.categoryId === categoryId,
          ).length,
        };
      })
    : getCalculatorCategories(calculators, locale);
const categoryCards = categories.flatMap((category) => {
  const href = getCalculatorCategoryUrl(category.id, locale);

  return href ? [{ ...category, href }] : [];
});
const useCta = `${t(locale, "common.use")} ->`;
const calculatorCountLabel =
  calculators.length === 1
    ? t(locale, "common.calculator")
    : t(locale, "common.calculators");
const categoryCountLabel =
  categoryCards.length === 1
    ? t(locale, "common.category")
    : t(locale, "common.categories");
const getToolCountLabel = (count: number) =>
  count === 1 ? t(locale, "common.tool") : t(locale, "common.tools");
---

<BaseLayout
  title={t(locale, "home.title")}
  description={t(locale, "home.description")}
  canonical={canonical}
  locale={locale}
  alternates={alternates}
>
  <PageShell>
    <section class="border-b border-gray-700">
      <Container class="py-8 md:py-12">
        <div
          class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(21rem,0.74fr)] lg:items-end"
        >
          <div>
            <h1
              class="mt-4 max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl md:text-6xl"
            >
              {t(locale, "home.heroTitle")}
              <span class="text-amber-400">
                {" "}
                {t(locale, "home.heroAccent")}
              </span>
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">
              {t(locale, "home.heroDescription")}
            </p>
          </div>

          <div
            class="rounded-lg border border-gray-700 bg-gray-950 p-4 shadow-xl shadow-gray-950/30"
          >
            <label
              for="calculator-search"
              class="block text-2xl font-semibold text-gray-200"
            >
              {t(locale, "home.searchLabel")}
            </label>
            <input
              id="calculator-search"
              class="mt-2 min-h-12 w-full rounded-lg border border-gray-700 bg-gray-900 px-4 text-base text-white outline-none placeholder:text-gray-600 transition focus:border-amber-400 focus:ring-3 focus:ring-amber-400/15"
              type="search"
              placeholder={t(locale, "home.searchPlaceholder")}
              data-calculator-search
            />
            <div class="mt-4 grid grid-cols-3 gap-3">
              <div class="rounded-lg border border-gray-800 bg-gray-900 p-3">
                <p class="text-2xl font-bold text-white">
                  {calculators.length}
                </p>
                <p class="mt-1 text-xs text-gray-400">
                  {calculatorCountLabel}
                </p>
              </div>
              <div class="rounded-lg border border-gray-800 bg-gray-900 p-3">
                <p class="text-2xl font-bold text-white">
                  {categoryCards.length}
                </p>
                <p class="mt-1 text-xs text-gray-400">
                  {categoryCountLabel}
                </p>
              </div>
              <a
                href="#calculadoras"
                class="rounded-lg border border-amber-400/60 bg-amber-400 px-3 py-3 text-sm font-semibold text-gray-950 transition hover:bg-amber-300 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/40"
              >
                {t(locale, "home.viewAll")}
              </a>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <section class="border-b border-gray-800 bg-gray-950/45">
      <Container class="py-6">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            categoryCards.map((category) => (
              <a
                href={category.href}
                class="rounded-lg border border-gray-700 p-4 transition hover:border-amber-400 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/30"
              >
                <span class="block text-sm font-semibold text-white">
                  {category.label}
                </span>
                <span class="mt-1 block text-xs text-gray-500">
                  {category.count} {getToolCountLabel(category.count)}
                </span>
              </a>
            ))
          }
        </div>
      </Container>
    </section>

    <section
      id="calculadoras"
      data-calculator-directory
      data-empty-summary={t(locale, "home.selectTool")}
      data-results-template={t(locale, "home.resultsFor")}
      data-result-singular={t(locale, "common.result")}
      data-result-plural={t(locale, "common.results")}
    >
      <Container class="py-8 md:py-12">
        <div class="mb-6">
          <h2 class="text-2xl font-semibold">
            {t(locale, "home.availableCalculators")}
          </h2>
          <p class="mt-1 text-sm text-gray-400" data-search-summary>
            {t(locale, "home.selectTool")}
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
          {
            calculators.map((calculator) => (
              <Card
                href={calculator.href}
                title={calculator.title}
                description={calculator.description}
                cta={useCta}
                data-calculator-card
                data-title={calculator.title.toLowerCase()}
                data-description={calculator.description.toLowerCase()}
              />
            ))
          }
        </div>
      </Container>
    </section>
  </PageShell>
</BaseLayout>

<script>
  const directory = document.querySelector<HTMLElement>(
    "[data-calculator-directory]",
  );
  const searchInput = document.querySelector<HTMLInputElement>(
    "[data-calculator-search]",
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-calculator-card]"),
  );
  const summary = document.querySelector<HTMLElement>(
    "[data-search-summary]",
  );

  const emptySummary = directory?.dataset.emptySummary ?? "";
  const resultsTemplate = directory?.dataset.resultsTemplate ?? "";
  const resultSingular = directory?.dataset.resultSingular ?? "";
  const resultPlural = directory?.dataset.resultPlural ?? "";

  const renderResultSummary = (count: number, query: string) =>
    resultsTemplate
      .replace("{count}", String(count))
      .replace("{resultLabel}", count === 1 ? resultSingular : resultPlural)
      .replace("{query}", query);

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const haystack = `${card.dataset.title ?? ""} ${card.dataset.description ?? ""}`;
      const matches = !query || haystack.includes(query);
      card.classList.toggle("hidden", !matches);
      if (matches) visible += 1;
    });

    if (summary) {
      summary.textContent = query
        ? renderResultSummary(visible, query)
        : emptySummary;
    }
  });
</script>
