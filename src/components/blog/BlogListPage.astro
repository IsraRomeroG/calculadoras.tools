---
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogPostCard from "@components/blog/BlogPostCard.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import PageHero from "@components/shared/PageHero.astro";
import Pagination from "@components/shared/Pagination.astro";
import type { BreadcrumbItem } from "@components/shared/Breadcrumb.astro";
import type { BlogPost, PaginatedItems } from "@lib/blog";
import { type Locale } from "@lib/i18n/config";
import type { AlternateLink } from "@lib/i18n/routing";
import { getBlogUi } from "@lib/i18n/blog";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonical: string;
  alternates: AlternateLink[];
  heroTitle: string;
  heroDescription: string;
  kicker: string;
  breadcrumbs: BreadcrumbItem[];
  posts: BlogPost[];
  pagination: PaginatedItems<BlogPost>;
  getPageUrl: (page: number) => string;
}

const {
  locale,
  title,
  description,
  canonical,
  alternates,
  heroTitle,
  heroDescription,
  kicker,
  breadcrumbs,
  posts,
  pagination,
  getPageUrl,
} = Astro.props;
const ui = getBlogUi(locale);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  alternates={alternates}
>
  <Fragment slot="head">
    {
      pagination.previousPage && (
        <link rel="prev" href={getPageUrl(pagination.previousPage)} />
      )
    }
    {
      pagination.nextPage && (
        <link rel="next" href={getPageUrl(pagination.nextPage)} />
      )
    }
  </Fragment>

  <PageShell>
    <PageHero
      locale={locale}
      title={heroTitle}
      description={heroDescription}
      kicker={kicker}
      collapseBreadcrumbOnMobile
      breadcrumbs={breadcrumbs}
    />

    <Container as="section" class="py-8 md:py-10">
      {
        pagination.currentPage > 1 && (
          <div class="mb-6">
            <h2 class="text-2xl font-semibold">{ui.page.listTitle}</h2>
            <p class="mt-2 text-sm text-gray-400">
              {ui.page.listDescription(
                pagination.currentPage,
                pagination.totalPages,
              )}
            </p>
          </div>
        )
      }

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <BlogPostCard post={post} locale={locale} headingLevel="h2" />
          ))
        }
      </div>

      <Pagination
        locale={locale}
        currentPage={pagination.currentPage}
        totalPages={pagination.totalPages}
        getPageUrl={getPageUrl}
        class="mt-8"
      />
    </Container>
  </PageShell>
</BaseLayout>
