---
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogPostCard from "@components/blog/BlogPostCard.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import Button from "@components/shared/Button.astro";
import Pagination from "@components/shared/Pagination.astro";
import PageHero from "@components/shared/PageHero.astro";
import {
  formatBlogDate,
  getBlogCategoryUrl,
  getBlogIndexPageUrl,
  getBlogListingPosts,
  getBlogCategories,
  getFeaturedBlogPost,
  getBlogPostCategory,
  getBlogPostCategoryId,
  getBlogPostUrl,
  paginateItems,
  type BlogPost,
} from "@lib/blog";
import {
  getCategory,
  type CategoryId,
} from "@lib/constants/categories";
import { LOCALE_CONFIG, type Locale } from "@lib/i18n/config";
import type { AlternateLink } from "@lib/i18n/routing";
import { getBlogUi } from "@lib/i18n/blog";
import { t } from "@lib/i18n/messages";

interface Props {
  locale: Locale;
  posts: BlogPost[];
  canonical: string;
  alternates: AlternateLink[];
}

const { locale, posts, canonical, alternates } = Astro.props;
const ui = getBlogUi(locale);
const featuredPost = getFeaturedBlogPost(posts);
const featuredPostCategory = featuredPost
  ? getBlogPostCategory(featuredPost)
  : undefined;
const featuredPostCategoryId = featuredPost
  ? getBlogPostCategoryId(featuredPost)
  : undefined;
const featuredPostCategoryHref = featuredPostCategoryId
  ? getBlogCategoryUrl(featuredPostCategoryId, locale)
  : undefined;
const latestPosts = getBlogListingPosts(posts, featuredPost);
const latestPostsPage = paginateItems(latestPosts, 1);
const publishedCategories = getBlogCategories(posts, locale);
const englishBlogCategoryIds: CategoryId[] = [
  "conversores",
  "finanzas",
  "inmuebles",
  "legal-impuestos",
  "matematicas",
  "salud",
];
const categories =
  locale === "en"
    ? englishBlogCategoryIds.map((categoryId) => {
        const metadata = getCategory(categoryId, locale);

        return {
          id: categoryId,
          label: metadata.label,
          slug: metadata.slug,
          count:
            publishedCategories.find((category) => category.id === categoryId)
              ?.count ?? 0,
        };
      })
    : publishedCategories;
const homeHref = LOCALE_CONFIG[locale].urlPrefix || "/";
---

<BaseLayout
  title={ui.index.title}
  description={ui.index.description}
  canonical={canonical}
  locale={locale}
  alternates={alternates}
>
  <Fragment slot="head">
    {
      latestPostsPage.nextPage && (
        <link
          rel="next"
          href={getBlogIndexPageUrl(latestPostsPage.nextPage, locale)}
        />
      )
    }
  </Fragment>

  <PageShell>
    <PageHero
      locale={locale}
      title={ui.index.heroTitle}
      description={ui.index.heroDescription}
      kicker="Blog"
      breadcrumbs={[
        { label: t(locale, "breadcrumbs.home"), href: homeHref, ariaLabel: t(locale, "breadcrumbs.home") },
        { label: "Blog" },
      ]}
    >
      <Fragment slot="after">
        {
          categories.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3">
              {categories.map((category) => (
                <a
                  href={getBlogCategoryUrl(category.id, locale)}
                  class="inline-flex items-center gap-2 rounded-full border border-gray-700 px-4 py-2 text-sm text-gray-300 transition hover:border-amber-400 hover:text-white"
                >
                  <span>{category.label}</span>
                  <span class="text-xs text-gray-500">{category.count}</span>
                </a>
              ))}
            </div>
          )
        }
      </Fragment>
    </PageHero>

    {
      featuredPost && (
        <Container as="section" class="py-8 md:py-10">
          <article class="grid gap-6 rounded-lg border border-gray-700 bg-gray-950 p-6 md:grid-cols-[minmax(0,1fr)_16rem] md:p-8">
            <div>
              <p class="text-sm font-semibold text-amber-400">
                {featuredPostCategory?.label}
                {featuredPost.data.readTime && ` - ${featuredPost.data.readTime}`}
              </p>

              <h2 class="mt-3 text-3xl font-semibold tracking-tight">
                <a
                  href={getBlogPostUrl(featuredPost)}
                  class="transition hover:text-amber-300"
                >
                  {featuredPost.data.title}
                </a>
              </h2>

              <p class="mt-4 text-gray-400">
                {featuredPost.data.description}
              </p>

              <Button href={getBlogPostUrl(featuredPost)} class="mt-6">
                {ui.index.featuredCta}
              </Button>
            </div>

            <dl class="grid content-start gap-4 border-t border-gray-800 pt-5 text-sm md:border-l md:border-t-0 md:pl-6 md:pt-0">
              <div>
                <dt class="text-gray-500">{ui.index.publishedLabel}</dt>
                <dd class="mt-1 font-medium text-gray-200">
                  <time datetime={featuredPost.data.pubDate.toISOString()}>
                    {formatBlogDate(featuredPost.data.pubDate, locale)}
                  </time>
                </dd>
              </div>

              <div>
                <dt class="text-gray-500">{ui.index.categoryLabel}</dt>
                <dd class="mt-1">
                  {
                    featuredPostCategoryHref && (
                      <a
                        href={featuredPostCategoryHref}
                        class="font-medium text-gray-200 transition hover:text-amber-300"
                      >
                        {featuredPostCategory?.label}
                      </a>
                    )
                  }
                </dd>
              </div>
            </dl>
          </article>
        </Container>
      )
    }

    <Container as="section" class="pb-12">
      <div class="mb-6">
        <h2 class="text-2xl font-semibold">{ui.index.latestTitle}</h2>
        <p class="mt-2 text-sm text-gray-400">
          {ui.index.latestDescription}
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          latestPostsPage.items.map((post) => (
            <BlogPostCard post={post} locale={locale} />
          ))
        }
      </div>

      <Pagination
        locale={locale}
        currentPage={latestPostsPage.currentPage}
        totalPages={latestPostsPage.totalPages}
        getPageUrl={(page) => getBlogIndexPageUrl(page, locale)}
        class="mt-8"
      />
    </Container>
  </PageShell>
</BaseLayout>
