---
import { getBlogPostCategory, getBlogPostUrl, type BlogPost } from "@lib/blog";

interface Props {
  post: BlogPost;
  headingLevel?: "h2" | "h3";
  cta: string;
  class?: string;
}

const {
  post,
  headingLevel: Heading = "h3",
  cta,
  class: className = "",
} = Astro.props;
const category = getBlogPostCategory(post);
---

<a
  href={getBlogPostUrl(post)}
  class:list={[
    "group rounded-lg border border-gray-700 p-5 transition hover:border-amber-400",
    className,
  ]}
>
  <p class="text-sm text-amber-400">
    {category.label}
    {post.data.readTime && ` · ${post.data.readTime}`}
  </p>

  <Heading class="mt-3 text-lg font-semibold group-hover:text-white">
    {post.data.title}
  </Heading>

  <p class="mt-2 text-sm leading-relaxed text-gray-400">
    {post.data.description}
  </p>

  <span class="mt-4 inline-block text-sm text-amber-400 group-hover:underline">
    {cta}
  </span>
</a>
