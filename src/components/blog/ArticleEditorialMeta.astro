---
import { formatBlogDate } from "@lib/blog";
import { getEditorialAuthor } from "@lib/editorial";
import type { BlogFrontmatter } from "@lib/blog-schema";
import { DEFAULT_LOCALE, type Locale } from "@lib/i18n/config";
import { getBlogUi } from "@lib/i18n/blog";

interface Props {
  data: BlogFrontmatter;
  locale?: Locale;
}

const { data, locale = DEFAULT_LOCALE } = Astro.props;
const ui = getBlogUi(locale).article;
const author = getEditorialAuthor(data.author, locale);
const publishedDate = data.pubDate.toISOString();
---

<div class="mt-6 space-y-3 text-sm text-gray-500">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <span>
      {ui.by}{" "}
      {
        author.url ? (
          <a href={author.url} class="font-medium text-gray-300 hover:text-white">
            {author.name}
          </a>
        ) : (
          <span class="font-medium text-gray-300">{author.name}</span>
        )
      }
    </span>
    <span aria-hidden="true">&middot;</span>
    <span>
      {ui.published}{" "}
      <time datetime={publishedDate}>{formatBlogDate(data.pubDate, locale)}</time>
    </span>
    {
      data.updatedDate && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span>
            {ui.updated}{" "}
            <time datetime={data.updatedDate.toISOString()}>
              {formatBlogDate(data.updatedDate, locale)}
            </time>
          </span>
        </>
      )
    }
    {
      data.readTime && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span>{data.readTime}</span>
        </>
      )
    }
  </div>

  {
    data.reviewer && data.reviewedDate && (
      <p>
        {ui.reviewedBy}{" "}
        {data.reviewer.url ? (
          <a
            href={data.reviewer.url}
            class="font-medium text-gray-300 hover:text-white"
          >
            {data.reviewer.name}
          </a>
        ) : (
          <span class="font-medium text-gray-300">{data.reviewer.name}</span>
        )}
        {data.reviewer.role && `, ${data.reviewer.role}`} &middot;{" "}
        <time datetime={data.reviewedDate.toISOString()}>
          {formatBlogDate(data.reviewedDate, locale)}
        </time>
      </p>
    )
  }

  {
    data.reviewNote && (
      <p class="max-w-2xl leading-relaxed text-gray-400">
        {ui.editorialReview}: {data.reviewNote}
      </p>
    )
  }
</div>
