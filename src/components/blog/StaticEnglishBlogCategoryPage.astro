---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import PageShell from "@components/layout/PageShell.astro";
import PageHero from "@components/shared/PageHero.astro";
import Panel from "@components/shared/Panel.astro";
import Button from "@components/shared/Button.astro";
import { getBlogCategoryUrl, getBlogIndexPageUrl } from "@lib/blog";
import {
  getCategory,
  type CategoryId,
} from "@lib/constants/categories";
import { getBlogUi } from "@lib/i18n/blog";
import { buildAlternateLinks } from "@lib/i18n/routing";

interface Props {
  categoryId: CategoryId;
}

const { categoryId } = Astro.props;
const locale = "en";
const category = getCategory(categoryId, locale);
const ui = getBlogUi(locale);
const canonical = getBlogCategoryUrl(categoryId, locale);
const blogHref = getBlogIndexPageUrl(1, locale);
const alternates = buildAlternateLinks(
  {
    es: getBlogCategoryUrl(categoryId, "es"),
    en: canonical,
  },
  Astro.site ?? Astro.url,
);
---

<BaseLayout
  locale={locale}
  title={ui.category.title(category.label)}
  description={ui.category.description(category.label)}
  canonical={canonical}
  alternates={alternates}
>
  <PageShell>
    <PageHero
      locale={locale}
      title={ui.category.heroTitle(category.label)}
      description={category.description}
      kicker={category.label}
      breadcrumbs={[
        { label: "Home", href: "/en", ariaLabel: "Home" },
        { label: "Blog", href: blogHref, optional: true },
        { label: category.label, truncate: true },
      ]}
    />

    <Container as="section" class="py-8 md:py-10">
      <Panel as="section" padding="lg">
        <h2 class="text-xl font-semibold">English articles are on the way</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-gray-400">
          Guides in this category are being translated and reviewed. Until
          they are ready, browse the English articles that are already
          published.
        </p>
        <Button href={blogHref} class="mt-6">
          Browse English articles
        </Button>
      </Panel>
    </Container>
  </PageShell>
</BaseLayout>
