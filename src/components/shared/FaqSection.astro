---
import Container from "@components/layout/Container.astro";

export interface FaqItem {
  question: string;
  answer: string;
  relatedHref?: string;
  relatedLabel?: string;
}

interface Props {
  faqs: FaqItem[];
  title?: string;
  class?: string;
}

const { faqs, title = "Preguntas frecuentes", class: className = "" } = Astro.props;
---

<Container as="section" class={`py-8 pb-12 ${className}`}>
  <h2 class="text-2xl font-semibold">{title}</h2>
  <div class="mt-6 divide-y divide-gray-800 rounded-lg border border-gray-700 bg-gray-950">
    {
      faqs.map((faq) => (
        <details class="group p-5">
          <summary class="cursor-pointer list-none text-base font-semibold text-white">
            <span>{faq.question}</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">{faq.answer}</p>
          {faq.relatedHref && faq.relatedLabel && (
            <a
              href={faq.relatedHref}
              class="mt-3 inline-flex text-sm font-semibold text-amber-400 transition hover:text-amber-300 hover:underline"
            >
              {faq.relatedLabel}
            </a>
          )}
        </details>
      ))
    }
  </div>
</Container>
