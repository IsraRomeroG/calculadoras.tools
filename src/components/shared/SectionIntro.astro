---
interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = "" } = Astro.props;
---

<div class:list={["mb-6 max-w-3xl", className]}>
  <h2 class="text-2xl font-semibold">{title}</h2>
  {description && <p class="mt-2 text-sm leading-relaxed text-gray-400">{description}</p>}
  <slot />
</div>
