---
interface Props {
  href: string;
  title: string;
  description: string;
  cta?: string;
  [key: string]: unknown;
}

const { href, title, description, cta, ...anchorAttributes } = Astro.props;
---

<a
  {...anchorAttributes}
  href={href}
  class="group border border-gray-700 rounded-lg p-5 hover:border-amber-400 transition"
>
  <h3 class="font-semibold text-lg group-hover:text-white">
    {title}
  </h3>

  <p class="text-sm text-gray-400 mt-2">
    {description}
  </p>

  <span class="inline-block mt-4 text-sm text-amber-400 group-hover:underline">
    {cta}
  </span>
</a>
