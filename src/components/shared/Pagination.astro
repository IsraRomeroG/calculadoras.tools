---
import { DEFAULT_LOCALE, type Locale } from "@lib/i18n/config";
import { getBlogUi } from "@lib/i18n/blog";

interface Props {
  currentPage: number;
  totalPages: number;
  getPageUrl: (page: number) => string;
  locale?: Locale;
  class?: string;
}

const { currentPage, totalPages, getPageUrl, locale = DEFAULT_LOCALE, class: className = "" } =
  Astro.props;
const pagination = getBlogUi(locale).pagination;

const maxVisiblePages = 5;
const rangeSize = Math.min(maxVisiblePages, totalPages);
let startPage = Math.max(1, currentPage - Math.floor(rangeSize / 2));
let endPage = startPage + rangeSize - 1;

if (endPage > totalPages) {
  endPage = totalPages;
  startPage = Math.max(1, endPage - rangeSize + 1);
}

const pageNumbers = Array.from(
  { length: endPage - startPage + 1 },
  (_, index) => startPage + index,
);

const previousPage = currentPage > 1 ? currentPage - 1 : null;
const nextPage = currentPage < totalPages ? currentPage + 1 : null;
const pageLinkClass =
  "inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg border px-3 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-amber-400/30";
---

{
  totalPages > 1 && (
    <nav
      aria-label={pagination.ariaLabel}
      class:list={["flex justify-center", className]}
    >
      <ul class="flex flex-wrap items-center justify-center gap-2">
        <li>
          {previousPage ? (
            <a
              href={getPageUrl(previousPage)}
              class={`${pageLinkClass} border-gray-700 text-gray-300 hover:border-amber-400 hover:text-white`}
            >
              {pagination.previous}
            </a>
          ) : (
            <span
              aria-disabled="true"
              class={`${pageLinkClass} cursor-not-allowed border-gray-800 text-gray-600`}
            >
              {pagination.previous}
            </span>
          )}
        </li>

        {pageNumbers.map((pageNumber) => {
          const isCurrent = pageNumber === currentPage;

          return (
            <li>
              <a
                href={getPageUrl(pageNumber)}
                aria-current={isCurrent ? "page" : undefined}
                aria-label={
                  isCurrent
                    ? pagination.currentPage(pageNumber)
                    : pagination.page(pageNumber)
                }
                class:list={[
                  pageLinkClass,
                  isCurrent
                    ? "border-amber-400 bg-amber-400 text-gray-950"
                    : "border-gray-700 text-gray-300 hover:border-amber-400 hover:text-white",
                ]}
              >
                {pageNumber}
              </a>
            </li>
          );
        })}

        <li>
          {nextPage ? (
            <a
              href={getPageUrl(nextPage)}
              class={`${pageLinkClass} border-gray-700 text-gray-300 hover:border-amber-400 hover:text-white`}
            >
              {pagination.next}
            </a>
          ) : (
            <span
              aria-disabled="true"
              class={`${pageLinkClass} cursor-not-allowed border-gray-800 text-gray-600`}
            >
              {pagination.next}
            </span>
          )}
        </li>
      </ul>
    </nav>
  )
}
