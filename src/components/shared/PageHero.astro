---
import Container from "@components/layout/Container.astro";
import Breadcrumb, { type BreadcrumbItem } from "@components/shared/Breadcrumb.astro";

interface Props {
  as?: "section" | "header";
  title: string;
  description?: string;
  kicker?: string;
  kickerHref?: string;
  breadcrumbs?: BreadcrumbItem[];
  collapseBreadcrumbOnMobile?: boolean;
  showHomeIcon?: boolean;
  size?: "4xl" | "5xl";
  class?: string;
  containerClass?: string;
  contentClass?: string;
  breadcrumbClass?: string;
  titleClass?: string;
  descriptionClass?: string;
}

const {
  as: Tag = "section",
  title,
  description,
  kicker,
  kickerHref,
  breadcrumbs,
  collapseBreadcrumbOnMobile = false,
  showHomeIcon = true,
  size = "5xl",
  class: className = "",
  containerClass = "py-8 md:py-10",
  contentClass = "max-w-3xl",
  breadcrumbClass = "mb-6",
  titleClass = "mt-3 text-4xl font-bold leading-tight md:text-5xl",
  descriptionClass = "mt-4 text-base leading-relaxed text-gray-400 md:text-lg",
} = Astro.props;
---

<Tag class:list={["border-b border-gray-700", className]}>
  <Container size={size} class={containerClass}>
    {
      breadcrumbs && (
        <Breadcrumb
          class={breadcrumbClass}
          collapseOnMobile={collapseBreadcrumbOnMobile}
          showHomeIcon={showHomeIcon}
          items={breadcrumbs}
        />
      )
    }

    <div class={contentClass}>
      {
        kicker &&
          (kickerHref ? (
            <a
              href={kickerHref}
              class="text-sm font-semibold uppercase tracking-wide text-amber-400 transition hover:text-amber-300"
            >
              {kicker}
            </a>
          ) : (
            <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">
              {kicker}
            </p>
          ))
      }

      <h1 class={titleClass}>{title}</h1>

      {description && <p class={descriptionClass}>{description}</p>}

      <slot />
    </div>

    <slot name="after" />
  </Container>
</Tag>
