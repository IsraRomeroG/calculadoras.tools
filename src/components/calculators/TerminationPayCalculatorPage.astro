      endDate: "Último día de la relación laboral",
      inclusive: "El último día seleccionado se incluye.",
      contract: "Tipo de contrato",
      indefinite: "Por tiempo indeterminado",
      fixedUnderYear: "Determinado menor de un año",
      fixedYearOrMore: "Determinado de un año o más",
      unknown: "No lo sé",
      salary: "Salario base",
      frequency: "Frecuencia de pago",
      daily: "Diario",
      weekly: "Semanal",
      biweekly: "Quincenal",
      monthly: "Mensual",
