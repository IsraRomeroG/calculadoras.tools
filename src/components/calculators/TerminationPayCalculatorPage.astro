    }
  : {
      title: "Calculadora de finiquito y liquidación en México",
      metaTitle: "Calculadora de finiquito y liquidación en México",
      description:
        "Estima tu finiquito bruto, prestaciones proporcionales y escenarios condicionados de indemnización bajo la LFT.",
      hero:
        "Separa el finiquito generado de una posible indemnización y compara el resultado con una oferta.",
      category: "Legal e impuestos",
      categoryHref: "/legal-impuestos",
      breadcrumb: "Finiquito y liquidación",
      step: "Paso 1 · Tu situación",
      formTitle: "Estima tu finiquito",
      formDescription:
        "Esta estimación es para una relación privada continua en México con salario fijo.",
      scope:
        "Confirmo que es una relación laboral privada general bajo la Ley Federal del Trabajo.",
      scopeHelp:
        "El empleo público, regímenes especiales, trabajo de temporada o discontinuo y salario predominantemente variable requieren otra revisión.",
      situation: "¿Qué ocurrió?",
      situations: {
        resignation: "Renuncié voluntariamente",
        dismissal: "Me despidieron",
        workerCause: "Me separé por una causa atribuible al patrón",
        contractEnd: "Terminó mi contrato u obra",
        agreement: "Llegamos a un acuerdo",
