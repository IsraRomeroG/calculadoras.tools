              <dt class="min-w-0 break-words">{phase2.tardyPenalty}</dt><dd class="min-w-0 break-words text-right" data-detail-tardy-penalty></dd>
              <dt class="min-w-0 break-words" data-detail-tardy-remainder-label>{phase2.tardyRemainder}</dt><dd class="min-w-0 break-words text-right" data-detail-tardy-remainder></dd>
              <dt class="min-w-0 break-words">{t.minimumShort}</dt><dd class="min-w-0 break-words text-right" data-detail-minimum></dd>
              <dt class="min-w-0 break-words">{t.margin}</dt><dd class="min-w-0 break-words text-right" data-detail-margin></dd>
              <dt class="min-w-0 break-words">{t.remainingShort}</dt><dd class="min-w-0 break-words text-right" data-detail-remaining></dd>
              <dt class="min-w-0 break-words" data-known-detail>{t.finalTotal}</dt><dd class="min-w-0 break-words text-right" data-known-detail data-detail-final-total></dd>
              <dt class="min-w-0 break-words" data-known-detail>{t.maxAbsences}</dt><dd class="min-w-0 break-words text-right" data-known-detail data-detail-max-absences></dd>
              <dt class="min-w-0 break-words" data-known-detail data-excess-detail>{t.excess}</dt><dd class="min-w-0 break-words text-right" data-known-detail data-excess-detail data-detail-excess></dd>
              <dt class="min-w-0 break-words" data-known-detail>{t.maxFinal}</dt><dd class="min-w-0 break-words text-right" data-known-detail data-detail-max-final></dd>
              <dt class="col-span-2 mt-2">{t.recovery}</dt><dd class="col-span-2 break-words text-left text-gray-100" data-detail-recovery></dd>
              <dt class="min-w-0 break-words" data-phase2-detail>{phase2.effective}</dt><dd class="min-w-0 break-words text-right" data-phase2-detail data-detail-effective></dd>
            </dl>
          </details>
        </div>
        <section class="mt-4 hidden rounded-lg border border-amber-800 bg-amber-950/20 p-4" data-history-comparison aria-live="polite">
          <h3 class="font-semibold text-amber-200" data-history-comparison-heading></h3>
          <div class="mt-3 grid min-w-0 gap-3 sm:grid-cols-2">
            <div class="min-w-0 rounded-lg border border-gray-800 bg-gray-950 p-3">
              <h4 class="text-sm font-semibold text-gray-200" data-history-saved-label></h4>
              <p class="mt-2 whitespace-pre-line break-words text-sm text-gray-300" data-history-saved-result></p>
            </div>
            <div class="min-w-0 rounded-lg border border-gray-800 bg-gray-950 p-3">
              <h4 class="text-sm font-semibold text-gray-200" data-history-recalculated-label></h4>
