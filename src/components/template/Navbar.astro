---
import { getMenuItems } from "@lib/constants/menu";
import { DEFAULT_LOCALE, LOCALE_CONFIG, type Locale } from "@lib/i18n/config";
import { normalizePath } from "@lib/i18n/routing";
import { t } from "@lib/i18n/messages";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const currentPath = normalizePath(Astro.url.pathname);
const menuItems = getMenuItems(locale);
const homePath = LOCALE_CONFIG[locale].urlPrefix || "/";
const openMenuLabel = t(locale, "nav.openMenu");
const closeMenuLabel = t(locale, "nav.closeMenu");

function isActiveRoute(currentPath: string, path: string): boolean {
  const normalizedPath = normalizePath(path);

  if (normalizedPath === homePath) {
    return currentPath === normalizedPath;
  }

  return (
    currentPath === normalizedPath ||
    currentPath.startsWith(`${normalizedPath}/`)
  );
}
---

<header class="bg-gray-950 border-b border-gray-700">
  <div
    class="relative flex justify-between items-center max-w-5xl mx-auto px-6 py-3 text-white"
  >
    <div class="font-semibold text-xl">
      <a href={homePath}>
        calculadoras<span class="text-amber-400">.tools</span>
      </a>
    </div>

    <button
      id="menuBtn"
      class="md:hidden focus:outline-none"
      type="button"
      aria-label={openMenuLabel}
      aria-controls="menu"
      aria-expanded="false"
      data-open-label={openMenuLabel}
      data-close-label={closeMenuLabel}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <nav
      id="menu"
      class="hidden absolute top-full left-0 w-full bg-gray-900 md:static md:block md:w-auto"
    >
      <ul class="flex flex-col md:flex-row">
        {
          menuItems.map((menuItem) => (
            <li>
              <a
                href={menuItem.slug}
                aria-current={
                  isActiveRoute(currentPath, menuItem.slug)
                    ? "page"
                    : undefined
                }
                class:list={[
                  "block px-4 py-2",
                  isActiveRoute(currentPath, menuItem.slug)
                    ? "bg-gray-800 text-white"
                    : "hover:bg-gray-700",
                ]}
              >
                {menuItem.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("menuBtn");
  const menu = document.getElementById("menu");

  if (menuBtn && menu) {
    menuBtn.addEventListener("click", () => {
      const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
      const nextExpanded = !isExpanded;
      const openLabel = menuBtn.dataset.openLabel ?? "Open navigation menu";
      const closeLabel = menuBtn.dataset.closeLabel ?? "Close navigation menu";

      menuBtn.setAttribute("aria-expanded", String(nextExpanded));
      menuBtn.setAttribute("aria-label", nextExpanded ? closeLabel : openLabel);
      menu.classList.toggle("hidden", !nextExpanded);
    });
  }
</script>
